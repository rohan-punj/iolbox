# Debian 12 is an unpinned CANDIDATE. Debian publishes SHA512SUMS only;
# the concrete image URL lets the host name the exact checksum URL.
IOLBOX_IMAGE_URL=https://cloud.debian.org/images/cloud/bookworm/20260806-2562/debian-12-genericcloud-arm64-20260806-2562.qcow2
IOLBOX_IMAGE_DIGEST=PIN-ME
IOLBOX_IMAGE_BYTES=0
IOLBOX_CPUS=4
IOLBOX_MEMORY=4GiB
IOLBOX_DISK=15GiB
