# iolbox Debian 12/bookworm macOS/Lima pin set.
#
# Debian 12 is a CANDIDATE, canary-gated and UNVERIFIED on Apple Silicon
# Rosetta.  Its 6.1 kernel is only inferred safe from the measured 6.3
# AT_RSEQ_ALIGN threshold; it has never been executed on the measured Mac.
# The only honest current label for this profile is CANDIDATE, UNVERIFIED on
# hardware; change that label only after measuring the exact host/kernel pair.
#
# latest/ is a moving symlink directory.  The checksum below is intentionally
# PIN-ME-SHA256 because this sandbox could not fetch Debian's published
# SHA256SUMS.  When pinning, fetch the checksum for this exact image URL from
# https://cloud.debian.org/images/cloud/bookworm/latest/SHA256SUMS, record the
# concrete point release returned by that moving directory, and replace the
# placeholder.  Re-pinning means re-fetching the checksum for the image bytes;
# editing the URL alone is not a re-pin.
# Concrete point release for this outstanding placeholder: NOT RECORDED because
# the checksum fetch was unavailable in this sandbox.
#
# The Debian genericcloud arm64 image is approximately 342 MB.  Keep the M0
# geometry explicit (4 vCPUs, 4 GiB RAM, 15 GiB disk) so this candidate differs
# from Jammy only in the guest image/profile and kernel policy.

IOLBOX_DEBIAN12_IMAGE_URL=https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-arm64.qcow2
IOLBOX_DEBIAN12_IMAGE_SHA256=PIN-ME-SHA256
IOLBOX_CPUS=4
IOLBOX_MEMORY=4GiB
IOLBOX_DISK=15GiB
IOLBOX_MACHINE_NAME=iolbox-debian12
