# iolbox Debian 13/trixie macOS/Lima pin set.
#
# Debian 13 is BLOCKED on the measured macOS 13.5 baseline, not a candidate
# today: its 6.12 kernel is expected to emit AT_RSEQ_ALIGN and macOS 13.5
# Rosetta aborts on that auxv entry.  It becomes a candidate only after a
# canary measurement handles auxv type 28.  Run tests/canary-probe.sh
# --profile debian13 on the target Mac; do not infer the result from a macOS
# version number.
#
# latest/ is a moving symlink directory.  The checksum is intentionally
# PIN-ME-SHA256 because this sandbox could not fetch Debian's published
# SHA256SUMS.  When pinning, fetch the checksum for this exact image URL from
# https://cloud.debian.org/images/cloud/trixie/latest/SHA256SUMS, record the
# concrete point release returned by that moving directory, and replace the
# placeholder.  Re-pinning means re-fetching the checksum for the image bytes;
# editing the URL alone is not a re-pin.
# Concrete point release for this outstanding placeholder: NOT RECORDED because
# the checksum fetch was unavailable in this sandbox.
#
# The Debian genericcloud arm64 image is approximately 337 MB.  Keep the M0
# geometry explicit (4 vCPUs, 4 GiB RAM, 15 GiB disk) for profile comparability.

IOLBOX_DEBIAN13_IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-arm64.qcow2
IOLBOX_DEBIAN13_IMAGE_SHA256=PIN-ME-SHA256
IOLBOX_CPUS=4
IOLBOX_MEMORY=4GiB
IOLBOX_DISK=15GiB
IOLBOX_MACHINE_NAME=iolbox-debian13
