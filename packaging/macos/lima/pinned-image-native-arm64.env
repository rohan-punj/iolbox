# native-arm64 pins the SAME Debian 13/trixie arm64 cloud image the
# rosetta-amd64 (debian13) profile already uses and has verified in this
# worktree -- see pinned-image-debian13.env for provenance. Phase 3's own
# execution plan independently pinned a slightly different trixie build date
# (20260518-2482) for its own bake-off reproducibility; reusing this
# worktree's already-trusted debian13 pin instead of re-verifying a second
# hash on the physical Mac is a deliberate Phase 4 judgment call, recorded in
# docs/m7-phase4-file-mapping.md. The base guest image is not what makes this
# profile "native" -- Rosetta being disabled in iolbox-native-arm64.yaml, and
# the native-arm64 payload/install path, are what does.
IOLBOX_IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/20260810-2566/debian-13-genericcloud-arm64-20260810-2566.qcow2
IOLBOX_IMAGE_DIGEST=sha512:7a0eeb424f4a0e9fe35a4c04dee92cdded59aa4b056655488caf606cad4711b08c88af69a3d7de8af6837b082609872017e009a845837bde371c17b8fc27cd76
IOLBOX_IMAGE_BYTES=337313792
IOLBOX_CPUS=4
IOLBOX_MEMORY=4GiB
IOLBOX_DISK=15GiB
