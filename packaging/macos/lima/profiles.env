# iolbox macOS/Lima profile data. Both tables are pipe-delimited so
# qualification is an exact lookup, never a version comparison.
#
# Static profile table columns (12, Phase 4 onward):
# name|role|guest_label|pin_env|yaml_template|multiarch_step|kernel_hold_step|kernel_series|expected_uname_r|canary_step|install_step|verify_step
#
# The trailing three columns are Phase-4-era per-profile guest step
# overrides. Every Rosetta-era row keeps the historical fixed filenames
# explicitly for clarity, even though macos_profiles.go's canaryStep()/
# installStep()/verifyStep() would default to the same names if these three
# columns were left empty (parseProfilesEnv also still accepts the old
# 9-field row shape for any external caller that never heard of Phase 4).
#
# native-arm64 is Phase 4's own row: a real arm64 supervisor/vpcs/toollaunch
# build (runtime/pack-native.sh --arch arm64), Rosetta disabled at the VM
# level (packaging/macos/lima/iolbox-native-arm64.yaml), and its own
# canary/install/verify scripts that fail closed if a Rosetta binfmt entry
# is ever found registered in this guest. See docs/m7-phase4-file-mapping.md
# for why this row could not be added until those scripts existed.
IOLBOX_PROFILE_TABLE='debian13|DEFAULT|Debian 13 trixie|pinned-image-debian13.env|iolbox-trixie.yaml|10-multiarch-debian.sh|20-kernel-hold-debian.sh|6.12|6.12.101+deb13-cloud-arm64|30-canary.sh|40-install-payload.sh|50-verify.sh
jammy|COMPATIBILITY|Ubuntu 22.04|pinned-image.env|iolbox-jammy.yaml|10-multiarch.sh|20-kernel-hold.sh|5.15||30-canary.sh|40-install-payload.sh|50-verify.sh
debian12|CANDIDATE|Debian 12 bookworm|pinned-image-debian12.env|iolbox-bookworm.yaml|10-multiarch-debian.sh|20-kernel-hold-debian.sh|6.1||30-canary.sh|40-install-payload.sh|50-verify.sh
native-arm64|NATIVE|Debian 13 trixie (native arm64)|pinned-image-native-arm64.env|iolbox-native-arm64.yaml|10-multiarch-native.sh|20-kernel-hold-debian.sh|6.12|6.12.101+deb13-cloud-arm64|30-canary-native.sh|40-install-payload-native.sh|50-verify-native.sh'

# Exact-host qualification table columns:
# profile|macos_product|macos_build|verdict|status|evidence
IOLBOX_QUALIFICATION_TABLE='jammy|13.5|22G74|PASS|SUPPORTED|docs/macos-m0-result.md
jammy|26.6.1|25G76|PASS|SUPPORTED|docs/macos-m1-result.md 2026-08-14
debian13|26.6.1|25G76|PASS|SUPPORTED|docs/macos-m1-result.md 2026-08-14 full E2E: canary PASS, v0.5.2 installed, two-node IOL 90% (9/10), restart persistence'
