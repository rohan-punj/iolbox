# Build outputs
/app/src-tauri/target/
/app/node_modules/
/app/dist/
/app/.svelte-kit/
/supervisor/bin/
/runtime/build/
*.exe
*.msi
*.dll

# Runtime artifacts (never commit images or appliances)
*.bin
*.iol
*.vmdk
*.vmx
*.vmsd
*.nvram
*.tar
*.tar.gz
rootfs/
appliance/
# The generated IOL license file is always a bare "iourc" (no extension),
# written at runtime to paths like /opt/iolbox/iourc — never inside this repo
# in normal operation. Ignore that bare filename, but re-include the SOURCE
# PACKAGE supervisor/internal/iourc/ (iourc.go + iourc_test.go), which the
# old glob "iourc*" collided with and silently kept out of every commit
# (supervisor failed to build from a fresh clone: package never existed).
iourc
!supervisor/internal/iourc/

# Lab runtime state
*.pcap
*.pcapng
/labs/**/state/

# OS / editor
Thumbs.db
.DS_Store
.vscode/
.idea/

# Go
/supervisor/vendor/

# Embedded GUI build output (real bundle overwrites the committed placeholder
# index.html at build time via "npm run build:embed" -- never commit the bundle)
/supervisor/internal/web/dist/*
!/supervisor/internal/web/dist/index.html

# Launcher binaries (extensionless default-named build outputs; *.exe covers the .exe)
/tools/iolab-launcher/iolab-launcher
/tools/iolab-launcher/iolbox-launcher
/tools/iolab-launcher/bin/
/tools/iolbox-app-stub/bin/

# Local dev-machine launch/proxy configs (private VM IPs, developer-specific)
.claude/

# impeccable local runtime state (design-hook cache + live-session journals).
# The committed .impeccable/ files are the design system: design.json (sidecar)
# and live/config.json (live-mode config).
.impeccable/hook.cache.json
.impeccable/live/sessions/

# P0 spike probe binaries (extensionless Go build outputs)
/tools/p0-launcher/p0-launcher
/tools/p0-reaper/p0-reaper
/tools/p0-stale/p0-stale
/tools/tool-hostile/tool-hostile
/tools/tool-stubgui/tool-stubgui
/tools/iolbox-toollaunch/iolbox-toollaunch

# Per-agent GOCACHE dirs used to avoid concurrent `go build` cache races
.gocache*/

# Session scratch dirs (agent prompt batches, throwaway build caches)
/.tmp-p2-prompts/
/.tmp-secbench-gocache/
/scratch/

# Historical/point-in-time docs — kept on disk for local reference, not
# committed. Live reference docs (INSTALL, architecture, protocol, build,
# providers, roadmap, design-brief, p0-spike, v0.3.0-console-unification,
# v0.2.1-enhancements — the last cited by line number from the doc above)
# stay tracked.
/docs/RELEASE-NOTES-v0.4.1.md
/docs/bridge-fabric-migration.md
/docs/bridge-fabric-retirement-map.md
/docs/slowproto-lacp-lldp.md
.m4-ssh/
.m5-ssh/

# AI-session raw scaffolding (codex/luna run transcripts, one-shot
# continuation prompts for a session that has already run). NOT the
# result/handoff/plan/plan-review docs or docs/m7-evidence/ -- those carry
# real engineering rationale (owner-override reasoning, waiver scope, gate
# evidence) that isn't duplicated anywhere else and stay tracked. See
# docs/macos-m7-result.md for why the evidence directory is load-bearing.
docs/*-session-logs/
.m*-evidence/
docs/macos-m*-prompt.md
docs/macos-m7-phase*-continue-prompt.md
