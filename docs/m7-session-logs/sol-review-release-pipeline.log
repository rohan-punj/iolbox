  339: 		}
  340: 	}
  341: 	return table, p, nil
  342: }
  343: 
  344: // loadProfileTableOnly parses profiles.env without validating any single
  345: // profile's pin/guest assets. resolveProfileSelection needs the table (row
  346: // names, DEFAULT) before it knows which row it is going to select; the
  347: // selected row's pin/guest assets are validated afterwards by the normal
  348: // loadMacOSProfile call.
  349: func loadProfileTableOnly(assetRoot string) (profileTable, error) {
  350: 	profilePath := filepath.Join(assetRoot, "lima", "profiles.env")
  351: 	data, err := os.ReadFile(profilePath)
