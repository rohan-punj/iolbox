===== build-release.sh =====
    1: #!/usr/bin/env bash
    2: # Build a deployable supervisor binary WITH the real GUI embedded.
    3: #
    4: # The embed dir (supervisor/internal/web/dist) holds only a committed
    5: # placeholder in git; the real Svelte bundle is generated and gitignored. So a
    6: # plain `go build` ships the placeholder ("GUI not bundled in this build").
    7: # ALWAYS build the binary through this script (or run build:embed first) ƒ?" it
    8: # is the single source of truth for a deployable binary.
    9: set -euo pipefail
   10: cd "$(dirname "$0")"
   11: 
   12: # Capture the git describe BEFORE any subshell cd's around, so the version
   13: # always reflects the repo commit being built, not wherever go build runs from.
   14: VERSION="$(git describe --tags --always --dirty)"
   15: echo "==> stamping version: $VERSION"
   16: 
   17: echo "==> building GUI bundle into supervisor/internal/web/dist"
   18: ( cd app && npm run build:embed >/dev/null )
   19: 
   20: echo "==> cross-compiling linux/amd64 supervisor (GUI embedded)"
   21: ( cd supervisor && GOOS=linux GOARCH=amd64 go build -ldflags "-X main.version=$VERSION" -o bin/supervisor-linux-amd64 ./cmd/supervisor )
   22: 
   23: # Sanity: the deployed index.html must NOT be the placeholder.
   24: if grep -q "not bundled" supervisor/internal/web/dist/index.html; then
   25:   echo "ERROR: embed dir still holds the placeholder ƒ?" build:embed did not run" >&2
   26:   exit 1
   27: fi
   28: 
   29: echo "==> restoring the committed placeholder so the repo stays clean"
   30: git checkout -- supervisor/internal/web/dist/index.html 2>/dev/null || true
   31: 
   32: ls -la supervisor/bin/supervisor-linux-amd64
   33: echo "OK: supervisor/bin/supervisor-linux-amd64 has the real GUI embedded"
===== runtime/fetch-vpcs.sh =====
    1: #!/usr/bin/env bash
    2: # fetch-vpcs.sh ƒ?" clone and build the community VPCS binary with UDP-tunnel
    3: # support (the same wire format IOL's iol_wrapper uses for inter-node
    4: # links, per docs/protocol.md "Interface addressing (IOL)" ƒ?" VPCS speaks
    5: # UDP tunnels natively, no relay/hub translation needed on that side).
    6: #
    7: # Called by build-rootfs.sh, but also runnable standalone for iterating on
    8: # just the VPCS build without redoing the whole debootstrap. Network
    9: # access is required (git clone + apt build-deps); if the builder is
   10: # airgapped, see the "manual drop path" note below instead.
   11: #
   12: # Output: ./build/vpcs/vpcs  (a single static-ish ELF binary for VPCS_ARCH)
   13: set -euo pipefail
   14: 
   15: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
   16: BUILD_DIR="${IOLBOX_BUILD_DIR:-$SCRIPT_DIR/build}"
   17: VPCS_SRC_DIR="$BUILD_DIR/vpcs-src"
   18: VPCS_OUT_DIR="$BUILD_DIR/vpcs"
   19: 
   20: # Upstream: the maintained community fork (the original vpcs.googlecode.com
   21: # / sourceforge project is unmaintained; GNS3's fork is what every current
   22: # IOL-adjacent lab tool, including our own PNetLab work, actually builds
   23: # from). Pinned to a tag, not a moving branch, for reproducibility ƒ?" bump
   24: # deliberately, not silently on every rebuild.
   25: VPCS_REPO="${VPCS_REPO:-https://github.com/GNS3/vpcs.git}"
   26: VPCS_REF="${VPCS_REF:-v0.8.3}"   # same release the proven iolbox-rt vpcs was built from
   27: VPCS_ARCH="${VPCS_ARCH:-amd64}"
   28: VPCS_CC="${VPCS_CC:-}"
   29: VPCS_ARCH_EXPLICIT=0
   30: 
   31: while [ $# -gt 0 ]; do
   32:     case "$1" in
   33:         --arch) VPCS_ARCH="$2"; VPCS_ARCH_EXPLICIT=1; shift 2 ;;
   34:         --arch=*) VPCS_ARCH="${1#*=}"; VPCS_ARCH_EXPLICIT=1; shift ;;
   35:         --help|-h)
   36:             cat <<EOF
   37: Usage: $0 [--arch amd64|arm64]
   38: 
   39: Build pinned GNS3 VPCS $VPCS_REF from source. The default is amd64. For an
   40: arm64 build, run on an arm64 Linux builder or set VPCS_CC to an arm64 C
   41: compiler (for example aarch64-linux-gnu-gcc) when cross-compiling.
   42: EOF
   43:             exit 0
   44:             ;;
   45:         *) echo "fetch-vpcs: unknown option: $1" >&2; exit 1 ;;
   46:     esac
   47: done
   48: 
   49: case "$VPCS_ARCH" in
   50:     amd64|arm64) ;;
   51:     *) echo "fetch-vpcs: --arch must be amd64 or arm64, got '$VPCS_ARCH'" >&2; exit 1 ;;
   52: esac
   53: 
   54: # Inspect ELF headers with the first available tool. An explicitly qualified
   55: # build must never silently accept a host-architecture binary: if the selected
   56: # inspector is unavailable or fails, the qualification fails closed. The
   57: # historical no-argument amd64 path below intentionally keeps its warning-only
   58: # behavior for compatibility with existing local builds.
   59: require_elf_arch() {
   60:     local path="$1"
   61:     local expected="$2"
   62:     local label="$3"
   63:     local description
   64: 
   65:     if command -v file >/dev/null 2>&1; then
   66:         if ! description="$(file -b -- "$path" 2>&1)"; then
   67:             echo "$label: file failed while inspecting $path: $description" >&2
   68:             return 1
   69:         fi
   70:         case "$expected:$description" in
   71:             amd64:*"ELF 64-bit"*"x86-64"*) ;;
   72:             arm64:*"ELF 64-bit"*"ARM aarch64"*) ;;
   73:             arm64:*"ELF 64-bit"*"AArch64"*) ;;
   74:             *)
   75:                 echo "$label: $path is not a linux/$expected ELF: $description" >&2
   76:                 return 1
   77:                 ;;
   78:         esac
   79:         return 0
   80:     fi
   81: 
   82:     if command -v readelf >/dev/null 2>&1; then
   83:         if ! description="$(readelf -h "$path" 2>&1)"; then
   84:             echo "$label: readelf failed while inspecting $path: $description" >&2
   85:             return 1
   86:         fi
   87:         case "$expected:$description" in
   88:             amd64:*"Class:"*"ELF64"*"Machine:"*"X86-64"*) ;;
   89:             arm64:*"Class:"*"ELF64"*"Machine:"*"AArch64"*) ;;
   90:             *)
   91:                 echo "$label: $path is not a linux/$expected ELF (readelf header did not match)" >&2
   92:                 return 1
   93:                 ;;
   94:         esac
   95:         return 0
   96:     fi
   97: 
   98:     echo "$label: either 'file' or 'readelf' is required for architecture validation" >&2
   99:     return 1
  100: }
  101: 
  102: MAKE_CC_ARGS=()
  103: if [ -n "$VPCS_CC" ]; then
  104:     MAKE_CC_ARGS+=("CC=$VPCS_CC")
  105: fi
  106: 
  107: echo "== fetch-vpcs: $VPCS_REPO @ $VPCS_REF =="
  108: if [ "$VPCS_ARCH" != amd64 ]; then
  109:     echo "fetch-vpcs: target architecture: $VPCS_ARCH"
  110: fi
  111: 
  112: # --- Manual drop path (airgapped builder) ----------------------------------
  113: # If this builder has no network access, skip this script entirely and
  114: # instead place a prebuilt linux/$VPCS_ARCH vpcs binary at:
  115: #
  116: #     runtime/build/vpcs/vpcs
  117: #
  118: # before running build-rootfs.sh (which looks for exactly that path ƒ?" see
  119: # its --vpcs-bin flag / VPCS_BIN default below). build-rootfs.sh does not
  120: # require this script to have run; it just requires the binary to exist.
  121: # -----------------------------------------------------------------------
  122: 
  123: if [ -x "$VPCS_OUT_DIR/vpcs" ]; then
  124:     if [ "$VPCS_ARCH_EXPLICIT" -eq 1 ]; then
  125:         require_elf_arch "$VPCS_OUT_DIR/vpcs" "$VPCS_ARCH" "fetch-vpcs"
  126:     fi
  127:     echo "fetch-vpcs: $VPCS_OUT_DIR/vpcs already built, skipping (delete it to force a rebuild)"
  128:     exit 0
  129: fi
  130: 
  131: command -v git >/dev/null 2>&1 || { echo "fetch-vpcs: git is required" >&2; exit 1; }
  132: command -v make >/dev/null 2>&1 || { echo "fetch-vpcs: make is required (apt install build-essential)" >&2; exit 1; }
  133: command -v cc >/dev/null 2>&1 || command -v gcc >/dev/null 2>&1 || {
  134:     echo "fetch-vpcs: a C compiler is required (apt install build-essential)" >&2
  135:     exit 1
