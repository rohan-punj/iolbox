  452: func printDiagnosticRemediation(machine string) {
  453: 	fmt.Println("last canary:")
  454: 	fmt.Println("  " + readCanaryState(machine))
  455: 	if warning, ok := hostAgentWarningText(machine); ok {
  456: 		fmt.Println("hostagent Rosetta warning:")
  457: 		fmt.Println(warning)
  458: 	} else {
  459: 		fmt.Println("hostagent Rosetta warning: none found or log unavailable")
  460: 	}
  461: 	fmt.Println("remediation: brew reinstall lima")
  462: 	fmt.Println("brew upgrade lima may be a no-op when the current version is already installed; Lima READY is not proof Rosetta was mounted")
  463: }
