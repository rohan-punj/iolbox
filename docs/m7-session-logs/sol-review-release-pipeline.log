   41: func parseDarwinArgs(args []string, stderr io.Writer) (darwinOptions, error) {
   42: 	opts := darwinOptions{
   43: 		Command:          "start",
   44: 		Profile:          os.Getenv("IOLBOX_PROFILE"),
   45: 		Machine:          os.Getenv("IOLBOX_MACHINE"),
   46: 		Limactl:          os.Getenv("LIMACTL"),
   47: 		Tarball:          os.Getenv("IOLBOX_TARBALL"),
   48: 		BootTimeout:      6 * time.Minute,
   49: 		Bind:             os.Getenv("IOLBOX_BIND"),
   50: 		GUIPort:          4001,
   51: 		ConsoleHostStart: darwinConsoleStart,
   52: 		CaptureHostStart: darwinCaptureStart,
   53: 	}
   54: 	if opts.Bind == "" {
   55: 		opts.Bind = "all"
   56: 	}
   57: 	if value := os.Getenv("IOLBOX_GUI_PORT"); value != "" {
   58: 		port, err := strconv.Atoi(value)
   59: 		if err != nil || port < 1 || port > 65535 {
   60: 			return darwinOptions{}, fmt.Errorf("invalid IOLBOX_GUI_PORT %q", value)
   61: 		}
   62: 		opts.GUIPort = port
   63: 	}
   64: 	for _, setting := range []struct {
   65: 		name string
   66: 		dest *int
   67: 	}{
   68: 		{"IOLBOX_CONSOLE_HOST_START", &opts.ConsoleHostStart},
   69: 		{"IOLBOX_CAPTURE_HOST_START", &opts.CaptureHostStart},
   70: 	} {
   71: 		if value := os.Getenv(setting.name); value != "" {
   72: 			port, err := strconv.Atoi(value)
   73: 			if err != nil || port < 1 || port > 65535 {
   74: 				return darwinOptions{}, fmt.Errorf("invalid %s %q", setting.name, value)
   75: 			}
   76: 			*setting.dest = port
   77: 		}
   78: 	}
   79: 	if len(args) > 0 && !strings.HasPrefix(args[0], "-") {
   80: 		opts.Command = args[0]
   81: 		args = args[1:]
   82: 	}
   83: 	validCommands := map[string]bool{"start": true, "stop": true, "status": true, "diagnose": true, "upgrade": true}
   84: 	if !validCommands[opts.Command] {
   85: 		return darwinOptions{}, fmt.Errorf("unknown command %q", opts.Command)
   86: 	}
   87: 	fs := flag.NewFlagSet("iolbox-launcher", flag.ContinueOnError)
   88: 	fs.SetOutput(stderr)
   89: 	fs.StringVar(&opts.Profile, "profile", opts.Profile, "profile name")
   90: 	fs.StringVar(&opts.Machine, "machine", opts.Machine, "Lima machine name")
   91: 	fs.StringVar(&opts.AssetsDir, "assets-dir", "", "M1 macOS asset root")
   92: 	fs.StringVar(&opts.Limactl, "limactl", opts.Limactl, "limactl executable")
   93: 	fs.StringVar(&opts.Tarball, "tarball", opts.Tarball, "payload tarball")
   94: 	fs.DurationVar(&opts.BootTimeout, "boot-timeout", opts.BootTimeout, "readiness timeout")
   95: 	fs.BoolVar(&opts.NoBrowser, "no-browser", false, "do not open the browser")
   96: 	fs.BoolVar(&opts.NoSync, "no-sync", false, "disable macOS host folder sync")
   97: 	fs.StringVar(&opts.ImagesDir, "images-dir", "", "override the macOS images folder")
   98: 	fs.StringVar(&opts.LabsDir, "labs-dir", "", "override the macOS labs folder")
   99: 	fs.IntVar(&opts.ConsoleHostStart, "console-host-start", opts.ConsoleHostStart, "host port for guest console range 9000-9049")
  100: 	fs.IntVar(&opts.CaptureHostStart, "capture-host-start", opts.CaptureHostStart, "host port for guest capture range 5500-5529")
  101: 	fs.IntVar(&opts.CPUs, "cpus", 0, "vCPUs for the guest (0 = use the profile's own default; prompts interactively if unset and stdin is a terminal)")
  102: 	fs.IntVar(&opts.MemoryGiB, "memory-gib", 0, "RAM in GiB for the guest (0 = use the profile's own default; prompts interactively if unset and stdin is a terminal)")
  103: 	if err := fs.Parse(args); err != nil {
  104: 		return darwinOptions{}, err
  105: 	}
  106: 	opts.ExplicitFlags = explicitFlags(func(f func(string)) { fs.Visit(func(fl *flag.Flag) { f(fl.Name) }) })
  107: 	if fs.NArg() != 0 {
  108: 		return darwinOptions{}, fmt.Errorf("unexpected arguments: %s", strings.Join(fs.Args(), " "))
  109: 	}
  110: 	if _, err := newDarwinPortContractWithRanges(opts.GUIPort, opts.ConsoleHostStart, opts.CaptureHostStart); err != nil {
  111: 		return darwinOptions{}, err
  112: 	}
  113: 	return opts, nil
  114: }
  115: 
  116: func resolveAssetRoot(explicit string) (string, error) {
  117: 	if explicit != "" {
  118: 		if _, err := os.Stat(filepath.Join(explicit, "lima", "profiles.env")); err != nil {
  119: 			return "", fmt.Errorf("assets directory is missing lima/profiles.env: %s", explicit)
  120: 		}
  121: 		return filepath.Abs(explicit)
  122: 	}
  123: 	var candidates []string
  124: 	if cwd, err := os.Getwd(); err == nil {
  125: 		candidates = append(candidates, filepath.Join(cwd, "packaging", "macos"), cwd)
  126: 	}
  127: 	if executable, err := os.Executable(); err == nil {
  128: 		dir := filepath.Dir(executable)
  129: 		candidates = append(candidates, filepath.Join(dir, "packaging", "macos"), filepath.Join(dir, "..", "..", "packaging", "macos"), dir)
  130: 	}
  131: 	for _, candidate := range candidates {
  132: 		candidate, _ = filepath.Abs(candidate)
  133: 		if _, err := os.Stat(filepath.Join(candidate, "lima", "profiles.env")); err == nil {
  134: 			return candidate, nil
  135: 		}
  136: 	}
  137: 	return "", errors.New("could not resolve macOS asset root; use --assets-dir")
  138: }
  139: 
  140: func exitCode(err error) int {
  141: 	if err == nil {
  142: 		return exitOK
  143: 	}
  144: 	var coded *launcherError
  145: 	if errors.As(err, &coded) {
  146: 		return coded.code
  147: 	}
  148: 	return exitUsage
  149: }
  150: 
  151: func runDarwinCLI(args []string) int {
  152: 	opts, err := parseDarwinArgs(args, os.Stderr)
  153: 	if err != nil {
  154: 		fmt.Fprintln(os.Stderr, "iolbox-launcher:", err)
  155: 		return exitUsage
  156: 	}
  157: 	assetRoot, err := resolveAssetRoot(opts.AssetsDir)
  158: 	if err != nil {
  159: 		if opts.Command == "diagnose" {
  160: 			fmt.Println("iolbox diagnose")
  161: 			fmt.Println("  assets:", err)
  162: 			return exitOK
  163: 		}
  164: 		fmt.Fprintln(os.Stderr, "iolbox-launcher:", err)
  165: 		return exitUsage
  166: 	}
  167: 	// Resolve the logical profile SELECTION (auto/rosetta-amd64/native-arm64,
  168: 	// or a legacy direct profile-table row name) before loading the concrete
  169: 	// profileTable row. This is where the plan's explicit-flag > persisted >
  170: 	// auto precedence and native-arm64's fail-closed preflight/fallback
  171: 	// live; loadMacOSProfile below only ever sees a concrete row name.
  172: 	earlyTable, err := loadProfileTableOnly(assetRoot)
  173: 	if err != nil {
  174: 		if opts.Command == "diagnose" {
  175: 			fmt.Println("iolbox diagnose")
  176: 			fmt.Println("  profile:", err)
  177: 			return exitOK
  178: 		}
  179: 		fmt.Fprintln(os.Stderr, "iolbox-launcher:", err)
  180: 		return exitCode(err)
  181: 	}
  182: 	preflightFacts := collectHostFacts(context.Background())
  183: 	preflightLimactl, _ := discoverLimactl(opts.Limactl, os.Getenv("LIMACTL"), nil)
  184: 	selection, err := resolveProfileSelection(context.Background(), opts.Profile, earlyTable, preflightFacts, preflightLimactl, assetRoot, nil)
  185: 	if err != nil {
  186: 		if opts.Command == "diagnose" {
  187: 			fmt.Println("iolbox diagnose")
  188: 			fmt.Println("  profile selection:", err)
  189: 			return exitOK
  190: 		}
  191: 		fmt.Fprintln(os.Stderr, "iolbox-launcher:", err)
  192: 		return exitPreflight
  193: 	}
  194: 	if selection.FallbackReason != "" {
  195: 		fmt.Fprintf(os.Stderr, "iolbox-launcher: requested profile %q fell back to %q (%s): %s\n", selection.Requested, selection.Selected, selection.Source, selection.FallbackReason)
  196: 	}
  197: 	table, profile, err := loadMacOSProfile(assetRoot, selection.ProfileName)
  198: 	if err != nil {
  199: 		if opts.Command == "diagnose" {
  200: 			fmt.Println("iolbox diagnose")
  201: 			fmt.Println("  profile:", err)
  202: 			return exitOK
  203: 		}
  204: 		fmt.Fprintln(os.Stderr, "iolbox-launcher:", err)
  205: 		return exitCode(err)
  206: 	}
  207: 	if opts.Machine == "" {
  208: 		opts.Machine = "iolbox-" + profile.Name
  209: 	}
  210: 	facts := preflightFacts // same collectHostFacts() call the selection resolution already ran
  211: 	if opts.Command == "diagnose" {
  212: 		return runDiagnose(opts, table, profile, facts, selection)
  213: 	}
  214: 	if opts.Command == "start" || opts.Command == "upgrade" {
  215: 		if facts.System != "Darwin" || facts.Arch != "arm64" {
  216: 			fmt.Fprintf(os.Stderr, "Apple Silicon macOS is required; detected %s/%s\n", facts.System, facts.Arch)
  217: 			return exitPreflight
  218: 		}
  219: 		if facts.Product == "" || facts.Build == "" {
  220: 			fmt.Fprintln(os.Stderr, "could not read macOS product/build with sw_vers")
  221: 			return exitPreflight
  222: 		}
  223: 		// Editable vCPU/RAM sizing, applied before any VM gets created: an
  224: 		// explicit --cpus/--memory-gib always wins; otherwise, on a real
  225: 		// interactive terminal, ask (defaulting to the profile's own
  226: 		// declared sizing) exactly like the Windows launcher's --smp/--mem
  227: 		// prompt. Never fires for status/diagnose/stop, which don't create
  228: 		// or resize a VM.
  229: 		profile.CPUs, profile.Memory = resolveDarwinResources(stdinIsInteractive(), opts.ExplicitFlags, opts.CPUs, opts.MemoryGiB, profile.CPUs, profile.Memory)
  230: 	}
  231: 	qualification := qualificationFor(table, profile.Name, facts.Product, facts.Build)
  232: 	fmt.Printf("profile=%s role=%s guest=%s qualification=%s\n", profile.Name, profile.Role, profile.GuestLabel, qualification.String())
  233: 	limactlPath, err := discoverLimactl(opts.Limactl, os.Getenv("LIMACTL"), nil)
  234: 	if err != nil {
  235: 		if opts.Command == "status" {
  236: 			fmt.Fprintln(os.Stderr, err)
  237: 		}
  238: 		return exitPreflight
  239: 	}
  240: 	client, info, err := limaClientFor(context.Background(), limactlPath, nil)
  241: 	if err != nil {
  242: 		return exitCode(err)
  243: 	}
  244: 	var syncConfig darwinSyncConfig
  245: 	if opts.Command == "start" || opts.Command == "upgrade" || opts.Command == "stop" {
  246: 		syncConfig, err = resolveDarwinSyncConfig(opts.NoSync, opts.ImagesDir, opts.LabsDir)
  247: 		if err != nil {
  248: 			fmt.Fprintln(os.Stderr, "iolbox-launcher:", err)
  249: 			return exitPreflight
  250: 		}
  251: 	}
  252: 	switch opts.Command {
  253: 	case "start", "upgrade":
  254: 		if facts.FreeDiskErr != nil || facts.FreeDiskKB < minFreeDiskGiB*1024*1024 {
  255: 			fmt.Fprintf(os.Stderr, "free disk is below the %d GiB minimum\n", minFreeDiskGiB)
  256: 			return exitPreflight
  257: 		}
  258: 		payload, err := selectPayload(opts.Tarball, assetRoot)
  259: 		if err != nil {
  260: 			fmt.Fprintln(os.Stderr, err)
  261: 			return exitCode(err)
  262: 		}
  263: 		ports, portErr := newDarwinPortContractWithRanges(opts.GUIPort, opts.ConsoleHostStart, opts.CaptureHostStart)
  264: 		if portErr != nil {
  265: 			fmt.Fprintln(os.Stderr, portErr)
  266: 			return exitUsage
  267: 		}
  268: 		err = runProvision(context.Background(), client, opts.Machine, profile, facts, payload, lifecycleConfig{
  269: 			Bind: opts.Bind, GUIPort: opts.GUIPort, Ports: ports, BootTimeout: opts.BootTimeout, Upgrade: opts.Command == "upgrade", Sync: &syncConfig,
  270: 		})
  271: 		if err != nil {
  272: 			fmt.Fprintln(os.Stderr, "iolbox-launcher:", err)
  273: 			return exitCode(err)
  274: 		}
  275: 		if opts.Command == "start" && !opts.NoBrowser {
  276: 			openBrowser(fmt.Sprintf("http://127.0.0.1:%d/", opts.GUIPort))
  277: 		}
  278: 		return exitOK
  279: 	case "stop":
  280: 		machines, err := client.list(context.Background())
  281: 		if err != nil {
  282: 			fmt.Fprintln(os.Stderr, err)
  283: 			return exitPreflight
  284: 		}
  285: 		state, _ := findMachine(machines, opts.Machine)
  286: 		if err := runDarwinStop(context.Background(), client, opts.Machine, state, syncConfig, opts.BootTimeout, func() (controlClient, func(), error) {
  287: 			control, err := dialControlWS(fmt.Sprintf("127.0.0.1:%d", opts.GUIPort))
  288: 			if err != nil {
  289: 				return nil, nil, err
  290: 			}
  291: 			return &wsControlClient{ws: control}, func() {
  292: 				_ = control.Close()
  293: 			}, nil
  294: 		}); err != nil {
  295: 			fmt.Fprintln(os.Stderr, err)
  296: 			return exitCode(err)
  297: 		}
  298: 		return exitOK
  299: 	case "status":
  300: 		return runStatus(client, opts, table, profile, facts, info, selection)
  301: 	default:
  302: 		return exitUsage
  303: 	}
  304: }
  305: 
  306: func runStatus(client *limaClient, opts darwinOptions, table profileTable, profile macOSProfile, facts hostFacts, info limaInfo, selection profileSelectionResult) int {
  307: 	machines, err := client.list(context.Background())
  308: 	if err != nil {
  309: 		fmt.Fprintln(os.Stderr, err)
  310: 		return exitPreflight
  311: 	}
  312: 	state, exists := findMachine(machines, opts.Machine)
  313: 	fmt.Println("iolbox status")
  314: 	ports, portErr := newDarwinPortContractWithRanges(opts.GUIPort, opts.ConsoleHostStart, opts.CaptureHostStart)
  315: 	if portErr == nil {
  316: 		fmt.Printf("  GUI port: 127.0.0.1:%d\n  console ports: 127.0.0.1:%d-%d\n  capture ports: 127.0.0.1:%d-%d\n  guest control port: not forwarded (127.0.0.1:%d host check)\n", ports.GUIPort, ports.ConsoleHostStart, ports.ConsoleHostStart+darwinConsoleEnd-darwinConsoleStart, ports.CaptureHostStart, ports.CaptureHostStart+darwinCaptureEnd-darwinCaptureStart, darwinControlPort)
  317: 	}
  318: 	printDarwinSyncFacts(opts)
  319: 	q := qualificationFor(table, profile.Name, facts.Product, facts.Build)
  320: 	fmt.Printf("  profile: %s\n  role: %s\n  guest: %s\n  kernel pin: %s\n  macOS: %s\n  host_arch: %s\n  qualification: %s\n  lima: %s (%s)\n  machine: %s\n  state: %s\n", profile.Name, profile.Role, profile.GuestLabel, profile.ExpectedUnameR, hostMACOSString(facts), facts.Arch, q.String(), info.Version, info.Path, opts.Machine, map[bool]string{true: state, false: "not created"}[exists])
  321: 	fmt.Println("  last canary:")
  322: 	for _, line := range strings.Split(readCanaryState(opts.Machine), "\n") {
  323: 		fmt.Println("    " + line)
  324: 	}
  325: 	var helloFn func() (helloResult, error)
  326: 	if exists && strings.EqualFold(state, "running") {
  327: 		helloFn = func() (helloResult, error) {
  328: 			control, err := dialControlWS(fmt.Sprintf("127.0.0.1:%d", opts.GUIPort))
  329: 			if err != nil {
  330: 				return helloResult{}, err
  331: 			}
  332: 			defer control.Close()
  333: 			return control.hello()
  334: 		}
  335: 	}
  336: 	printDiagnosticSummary(os.Stdout, collectDarwinDiagnostics(context.Background(), client, opts.Machine, state, profile, facts, info, diagnosticsOptions{GUIPort: opts.GUIPort, hello: helloFn, Selection: selection}))
  337: 	if !exists || !strings.EqualFold(state, "running") {
  338: 		fmt.Println("  guest kernel: unavailable (machine is not running)")
  339: 		return exitOK
  340: 	}
  341: 	fmt.Println("  guest kernel:", guestValue(context.Background(), client, opts.Machine, "uname", "-r"))
  342: 	fmt.Println("  guest arch:", guestValue(context.Background(), client, opts.Machine, "uname", "-m"))
  343: 	fmt.Println("  Rosetta binfmt:", guestValue(context.Background(), client, opts.Machine, "sudo", "-n", "cat", "/proc/sys/fs/binfmt_misc/rosetta"))
  344: 	fmt.Println("  supervisor service:", guestValue(context.Background(), client, opts.Machine, "sudo", "-n", "systemctl", "is-active", "iolbox-supervisor.service"))
  345: 	fmt.Println("  GET /:", guestValue(context.Background(), client, opts.Machine, "sudo", "-n", "curl", "--silent", "--show-error", "--output", "/dev/null", "--write-out", "%{http_code}", fmt.Sprintf("http://127.0.0.1:%d/", darwinGUIGuestPort)))
  346: 	return exitOK
  347: }
  348: 
  349: func runDiagnose(opts darwinOptions, table profileTable, profile macOSProfile, facts hostFacts, selection profileSelectionResult) int {
  350: 	fmt.Println("iolbox diagnose")
  351: 	if ports, err := newDarwinPortContractWithRanges(opts.GUIPort, opts.ConsoleHostStart, opts.CaptureHostStart); err == nil {
  352: 		fmt.Printf("port contract: GUI=127.0.0.1:%d consoles=127.0.0.1:%d-%d captures=127.0.0.1:%d-%d guest-control=not-forwarded\n", ports.GUIPort, ports.ConsoleHostStart, ports.ConsoleHostStart+darwinConsoleEnd-darwinConsoleStart, ports.CaptureHostStart, ports.CaptureHostStart+darwinCaptureEnd-darwinCaptureStart)
  353: 	}
  354: 	printDarwinSyncFacts(opts)
  355: 	q := qualificationFor(table, profile.Name, facts.Product, facts.Build)
  356: 	fmt.Printf("profile: %s (%s)\nguest: %s\nkernel pin: %s\nqualification: %s\nmacOS product/build: %s\nhost arch: %s\n", profile.Name, profile.Role, profile.GuestLabel, profile.ExpectedUnameR, q.String(), hostMACOSString(facts), facts.Arch)
  357: 	if facts.FreeDiskErr != nil {
  358: 		fmt.Println("free disk: unavailable (", facts.FreeDiskErr, ")")
  359: 	} else {
  360: 		fmt.Printf("free disk: %.2f GiB\n", float64(facts.FreeDiskKB)/1048576)
  361: 	}
  362: 	path, err := discoverLimactl(opts.Limactl, os.Getenv("LIMACTL"), nil)
  363: 	if err != nil {
  364: 		fmt.Println("lima executable: unavailable (", err, ")")
  365: 		printDiagnosticRemediation(opts.Machine)
  366: 		return exitOK
  367: 	}
  368: 	client, info, err := limaClientFor(context.Background(), path, nil)
  369: 	if err != nil {
  370: 		fmt.Println("lima:", err)
  371: 		return exitOK
  372: 	}
  373: 	fmt.Printf("lima executable: %s\nlima raw version: %s\nlima version: %s\nIOLBOX_HOST_LIMA=%s\n", info.Path, strings.TrimSpace(info.RawVersion), info.Version, info.Version)
  374: 	machines, err := client.list(context.Background())
  375: 	if err != nil {
  376: 		fmt.Println("machine listing: unavailable (", err, ")")
  377: 	} else {
  378: 		fmt.Println("machine listing:")
  379: 		for _, machine := range machines {
  380: 			fmt.Printf("  %s|%s\n", machine.Name, machine.State)
  381: 		}
  382: 		state, exists := findMachine(machines, opts.Machine)
  383: 		if !exists {
  384: 			fmt.Println("selected machine: not created")
  385: 		} else {
  386: 			fmt.Println("selected machine state:", state)
  387: 			if strings.EqualFold(state, "running") {
  388: 				fmt.Println("guest kernel:", guestValue(context.Background(), client, opts.Machine, "uname", "-r"))
  389: 				fmt.Println("guest arch:", guestValue(context.Background(), client, opts.Machine, "uname", "-m"))
  390: 				fmt.Println("Rosetta binfmt:", guestValue(context.Background(), client, opts.Machine, "sudo", "-n", "cat", "/proc/sys/fs/binfmt_misc/rosetta"))
  391: 				fmt.Println("supervisor service:", guestValue(context.Background(), client, opts.Machine, "sudo", "-n", "systemctl", "is-active", "iolbox-supervisor.service"))
  392: 				fmt.Println("GET /:", guestValue(context.Background(), client, opts.Machine, "sudo", "-n", "curl", "--silent", "--show-error", "--output", "/dev/null", "--write-out", "%{http_code}", fmt.Sprintf("http://127.0.0.1:%d/", darwinGUIGuestPort)))
  393: 				attestationPath, _ := hostAttestationPath(opts.Machine)
  394: 				if err := requireAttestation(attestationPath, profile, facts, info.Version); err != nil {
  395: 					fmt.Println("host attestation: INVALID (", err, ")")
  396: 				} else {
  397: 					fmt.Println("host attestation: valid")
  398: 				}
  399: 				fmt.Println("guest structural-gate drop-in:", guestValue(context.Background(), client, opts.Machine, "sudo", "-n", "cat", expectedCanaryDropIn))
  400: 				env := guestEnvironment(profile, facts, info.Version, opts.Machine, "unknown.tar.gz", lifecycleConfig{Bind: opts.Bind, GUIPort: opts.GUIPort})
  401: 				canaryOut, canaryErr := client.shell(context.Background(), opts.Machine, guestStepArgs(profile.canaryStep(), env, "--quiet")...)
  402: 				if canaryErr != nil {
  403: 					fmt.Printf("live canary: FAIL (%v): %s\n", canaryErr, strings.TrimSpace(string(canaryOut)))
  404: 				} else {
  405: 					fmt.Println("live canary: PASS")
  406: 				}
  407: 				control, helloErr := dialControlWS(fmt.Sprintf("127.0.0.1:%d", opts.GUIPort))
  408: 				if helloErr != nil {
  409: 					fmt.Println("supervisor hello: unavailable (", helloErr, ")")
  410: 				} else {
  411: 					defer control.Close()
  412: 					hello, helloErr := control.hello()
  413: 					if helloErr != nil {
  414: 						fmt.Println("supervisor hello: unavailable (", helloErr, ")")
  415: 					} else {
  416: 						fmt.Printf("supervisor=%s runtime=%s arch=%s features=%v egress=%s\n", hello.Supervisor, hello.Runtime, hello.Arch, hello.Features, hello.Egress)
  417: 					}
  418: 				}
  419: 			}
  420: 		}
  421: 	}
  422: 	state, exists := findMachine(machines, opts.Machine)
  423: 	var helloFn func() (helloResult, error)
  424: 	if exists && strings.EqualFold(state, "running") {
  425: 		helloFn = func() (helloResult, error) {
  426: 			control, err := dialControlWS(fmt.Sprintf("127.0.0.1:%d", opts.GUIPort))
  427: 			if err != nil {
  428: 				return helloResult{}, err
  429: 			}
  430: 			defer control.Close()
  431: 			return control.hello()
  432: 		}
  433: 	}
  434: 	printDiagnosticSummary(os.Stdout, collectDarwinDiagnostics(context.Background(), client, opts.Machine, state, profile, facts, info, diagnosticsOptions{GUIPort: opts.GUIPort, hello: helloFn, Selection: selection}))
  435: 	printDiagnosticRemediation(opts.Machine)
  436: 	return exitOK
  437: }
  438: 
  439: func printDarwinSyncFacts(opts darwinOptions) {
  440: 	if opts.NoSync {
  441: 		fmt.Println("sync: disabled")
  442: 		return
  443: 	}
  444: 	config, err := resolveDarwinSyncConfig(false, opts.ImagesDir, opts.LabsDir)
  445: 	if err != nil {
  446: 		fmt.Println("sync: unavailable (", err, ")")
  447: 		return
  448: 	}
  449: 	fmt.Printf("sync images: %s\nsync labs: %s\n", config.ImagesDir, config.LabsDir)
  450: }
