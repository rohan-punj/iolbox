  259: func nativePreflight(ctx context.Context, facts hostFacts, table profileTable, limactlPath, assetRoot string) nativePreflightResult {
  260: 	var r nativePreflightResult
  261: 	r.OK = true // flipped false by the first failing record() call
  262: 
  263: 	appleSilicon := facts.System == "Darwin" && facts.Arch == "arm64"
  264: 	r.record("apple_silicon", appleSilicon, fmt.Sprintf("host reports %s/%s", facts.System, facts.Arch))
