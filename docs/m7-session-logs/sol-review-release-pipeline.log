   13: // Phase 4 profile-selection layer. This sits ABOVE the generic, data-driven
   14: // profileTable (macos_profiles.go): callers pick one of three LOGICAL
   15: // selections, and this file resolves that selection to a concrete
   16: // profileTable row name plus a human-readable reason, in this precedence
   17: // order (plan section 10 item 3):
   18: //
   19: //  1. an explicit --profile flag (or IOLBOX_PROFILE env var) value wins;
   20: //  2. otherwise, a previously persisted owner choice wins;
   21: //  3. otherwise, "auto" applies -- which, since the owner's promotion ruling
   22: //     (docs/macos-m7-phase6-handoff.md, "Owner promotion ruling"; plan
   23: //     section 13 PROMOTE), now runs the same non-mutating nativePreflight
   24: //     used for forced/persisted native selections and PREFERS native-arm64
   25: //     whenever that preflight passes. When it does not pass, auto falls back
   26: //     to rosetta-amd64 with a FallbackReason -- the explicit Rosetta
   27: //     fallback the PROMOTE clause requires be retained. There is no
   28: //     test-only preference hook any more; auto's behavior is the same in
   29: //     tests and in production.
   30: //
   31: // nativeProfileName/rosettaAliasName are logical selections, distinct from
   32: // profileTable row names (macos_profiles.go's "debian13"/"jammy"/"debian12"
   33: // pick a *guest OS variant* under the rosetta-amd64 execution mode; this
   34: // file's three values pick the *execution mode*). "rosetta-amd64" resolves
   35: // to the profile table's DEFAULT row (currently debian13); a bare legacy
   36: // profile-table name (e.g. "jammy") is still accepted directly for
   37: // backward compatibility with M1-M6 callers/tests that never heard of the
   38: // three-way selection.
   39: const (
   40: 	selectionAuto         = "auto"
   41: 	selectionRosettaAMD64 = "rosetta-amd64"
   42: 	selectionNativeARM64  = "native-arm64"
   43: 
   44: 	// nativeProfileTableName is the profileTable row (packaging/macos/lima/
   45: 	// profiles.env) that carries the native-arm64 Lima/VZ template, pin, and
   46: 	// guest asset paths. Kept as a single named constant rather than a new
   47: 	// profiles.env column: today there is exactly one native profile, and
   48: 	// the qemu-user translator identity below is likewise a property of
   49: 	// that one profile, not yet a generalized per-row field.
   50: 	nativeProfileTableName = "native-arm64"
   51: 	// nativeTranslatorName is the correctness-eligible translator Phase 3
   52: 	// selected for the native-arm64 guest (see docs/macos-m7-phase3-execution-plan.md,
   53: 	// FEX-Emu was BLOCKED, qemu-user is sole correctness-eligible). Preflight's
   54: 	// "translator" check verifies this identity is what the resolved profile
   55: 	// declares, not that a specific host-side binary is present -- the
   56: 	// translator itself runs inside the guest, installed by guest
   57: 	// provisioning, not by the macOS host.
   58: 	nativeTranslatorName = "qemu-user"
   59: )
   60: 
   61: // profileChoiceFileName is where a successful explicit selection is
   62: // persisted, under the same macOS user config root foldersync already uses
   63: // (~/Library/Application Support/iolbox on a real Mac; see macos_sync.go).
   64: const profileChoiceFileName = "profile-choice.env"
   65: 
   66: // profileSelectionResult is the fully resolved outcome: which profileTable
   67: // row to load, which logical selection it corresponds to, why, and ƒ?" when
   68: // an automatic or forced native attempt could not be honored ƒ?" the fallback
   69: // reason status/diagnose must report truthfully.
   70: type profileSelectionResult struct {
   71: 	// Requested is the logical selection as the caller asked for it, before
   72: 	// any fallback (e.g. "native-arm64" even if it then fell back).
   73: 	Requested string
   74: 	// Selected is the logical selection actually used after any fallback.
   75: 	Selected string
   76: 	// ProfileName is the profileTable row name to pass to loadMacOSProfile.
   77: 	ProfileName string
   78: 	// Source explains where Selected came from: explicit-flag / persisted /
   79: 	// persisted-fallback-rosetta / auto-native / auto-fallback-rosetta.
   80: 	Source string
   81: 	// FallbackReason is non-empty only when Requested != Selected.
   82: 	FallbackReason string
   83: }
   84: 
   85: // resolveProfileSelectionName maps a logical selection or a legacy direct
   86: // profileTable row name to the row name loadMacOSProfile should load. Empty
   87: // stays empty (loadMacOSProfile's own default-row behavior applies).
   88: func resolveProfileSelectionName(selection string, table profileTable) (string, error) {
   89: 	switch selection {
   90: 	case "", selectionAuto:
   91: 		return "", fmt.Errorf("resolveProfileSelectionName: auto/empty must be resolved by resolveProfileSelection, not looked up directly")
   92: 	case selectionRosettaAMD64:
   93: 		if table.Default == "" {
   94: 			return "", fmt.Errorf("profile table has no DEFAULT row to alias rosetta-amd64 to")
   95: 		}
   96: 		return table.Default, nil
   97: 	case selectionNativeARM64:
   98: 		if _, ok := table.Profiles[nativeProfileTableName]; !ok {
   99: 			return "", fmt.Errorf("native-arm64 profile is not present in this asset root's profiles.env (row %q missing)", nativeProfileTableName)
  100: 		}
  101: 		return nativeProfileTableName, nil
  102: 	default:
  103: 		// Legacy direct profile-table name (debian13/jammy/debian12/...):
  104: 		// accept it unchanged so pre-Phase-4 callers keep working.
  105: 		if _, ok := table.Profiles[selection]; ok {
  106: 			return selection, nil
  107: 		}
  108: 		return "", fmt.Errorf("unknown --profile value %q (want auto, rosetta-amd64, native-arm64, or a known profile-table row)", selection)
  109: 	}
  110: }
  111: 
  112: // readPersistedProfileChoice reads a previously persisted owner choice.
  113: // Returns "" with a nil error when nothing has ever been persisted (not an
  114: // error condition ƒ?" "auto" with no history is the common first run).
  115: func readPersistedProfileChoice(configDir func() (string, error)) (string, error) {
  116: 	if configDir == nil {
  117: 		configDir = darwinUserConfigDir
  118: 	}
  119: 	root, err := configDir()
  120: 	if err != nil {
  121: 		return "", fmt.Errorf("resolve macOS user config directory: %w", err)
  122: 	}
  123: 	path := filepath.Join(root, "iolbox", profileChoiceFileName)
  124: 	data, err := os.ReadFile(path)
  125: 	if err != nil {
  126: 		if os.IsNotExist(err) {
  127: 			return "", nil
  128: 		}
  129: 		return "", fmt.Errorf("read persisted profile choice: %w", err)
  130: 	}
  131: 	values, err := parsePinEnv(string(data))
  132: 	if err != nil {
  133: 		return "", fmt.Errorf("parse persisted profile choice %s: %w", path, err)
  134: 	}
  135: 	return values["IOLBOX_PROFILE_SELECTION"], nil
  136: }
  137: 
  138: // persistProfileChoice writes the owner's explicit selection so a future
  139: // bare "auto" run honors it. Only ever called with an explicit, successfully
  140: // preflighted selection ƒ?" never with "auto" itself and never with a
  141: // selection that failed preflight/fell back, so the persisted file always
  142: // names a choice that was proven usable at the time it was written.
  143: func persistProfileChoice(selection string, configDir func() (string, error)) error {
  144: 	if configDir == nil {
  145: 		configDir = darwinUserConfigDir
  146: 	}
  147: 	root, err := configDir()
  148: 	if err != nil {
  149: 		return fmt.Errorf("resolve macOS user config directory: %w", err)
  150: 	}
  151: 	dir := filepath.Join(root, "iolbox")
  152: 	if err := os.MkdirAll(dir, 0o755); err != nil {
  153: 		return fmt.Errorf("create %s: %w", dir, err)
  154: 	}
  155: 	path := filepath.Join(dir, profileChoiceFileName)
  156: 	tmp := path + ".tmp"
  157: 	content := fmt.Sprintf("IOLBOX_PROFILE_SELECTION=%s\n", selection)
  158: 	if err := os.WriteFile(tmp, []byte(content), 0o644); err != nil {
  159: 		return fmt.Errorf("write %s: %w", tmp, err)
  160: 	}
  161: 	return os.Rename(tmp, path)
  162: }
  163: 
  164: // nativePreflightResult is the non-mutating, fail-closed readiness verdict
  165: // for native-arm64. Every check is read-only: no VM is created, started, or
  166: // modified, and no host state is written by running preflight itself.
  167: type nativePreflightResult struct {
  168: 	OK      bool
  169: 	Reason  string // first failing check's explanation, empty when OK
  170: 	Checks  map[string]string
  171: 	// order keeps Checks' human-readable rendering deterministic.
  172: 	order []string
  173: }
  174: 
  175: func (r *nativePreflightResult) record(name string, ok bool, detail string) {
  176: 	if r.Checks == nil {
  177: 		r.Checks = make(map[string]string)
  178: 	}
  179: 	status := "PASS"
  180: 	if !ok {
  181: 		status = "FAIL"
  182: 		if r.OK { // first failure sets Reason/OK; keep evaluating remaining checks for a complete report
  183: 			r.Reason = name + ": " + detail
  184: 		}
  185: 		r.OK = false
  186: 	}
  187: 	r.Checks[name] = status + " (" + detail + ")"
  188: 	r.order = append(r.order, name)
  189: }
  190: 
  191: // String renders every check in evaluation order, PASS or FAIL, for
  192: // status/diagnose truthfulness (plan section 10 item 5).
  193: func (r nativePreflightResult) String() string {
  194: 	var b strings.Builder
  195: 	for _, name := range r.order {
  196: 		fmt.Fprintf(&b, "%s=%s\n", name, r.Checks[name])
  197: 	}
  198: 	return b.String()
  199: }
  200: 
  201: // limaVZInfo is the minimal shape this reads out of `limactl info --json` (a
  202: // read-only query; it starts/stops nothing).
  203: type limaVZInfo struct {
  204: 	VMTypes []string `json:"vmTypes"`
  205: }
  206: 
  207: // limaSupportsVZ shells the read-only `limactl info` and reports whether the
  208: // vz vmType is available. Fails closed: any error, or a response that omits
  209: // "vz" from a real vmTypes list, is treated as "not proven usable" rather
  210: // than assumed present.
  211: func limaSupportsVZ(ctx context.Context, limactlPath string) (bool, string) {
  212: 	if limactlPath == "" {
  213: 		return false, "no limactl executable resolved"
  214: 	}
  215: 	out, err := exec.CommandContext(ctx, limactlPath, "info").Output()
  216: 	if err != nil {
  217: 		return false, "limactl info failed: " + err.Error()
  218: 	}
  219: 	return parseLimaVZSupport(out)
  220: }
  221: 
  222: // parseLimaVZSupport is the pure classifier split out from limaSupportsVZ so
  223: // it can be exercised on any host without a real limactl binary.
  224: func parseLimaVZSupport(raw []byte) (bool, string) {
  225: 	var info limaVZInfo
  226: 	if err := json.Unmarshal(raw, &info); err != nil {
  227: 		return false, "could not parse limactl info JSON: " + err.Error()
  228: 	}
  229: 	for _, vt := range info.VMTypes {
  230: 		if strings.EqualFold(vt, "vz") {
  231: 			return true, "vz present in limactl info vmTypes " + strings.Join(info.VMTypes, ",")
  232: 		}
  233: 	}
  234: 	return false, "vz not present in limactl info vmTypes " + strings.Join(info.VMTypes, ",")
  235: }
  236: 
  237: // nativePreflight runs every non-mutating readiness check plan section 10
  238: // item 3 requires before a native-arm64 attempt: Apple Silicon, Lima/VZ,
  239: // digests, translator, and resources. It never creates, starts, or mutates
  240: // a Lima machine or any host file.
  241: //
  242: // assetRoot is needed for the digests check ONLY when table came from
  243: // loadProfileTableOnly (the real production path: resolveProfileSelection
  244: // must decide the logical selection BEFORE it knows which concrete row to
  245: // hand loadMacOSProfile, so it necessarily only has the shallow,
  246: // pin-file-unaware row shape). Found on real hardware (2026-08-19,
  247: // physical Mac, first live "forced native-arm64" attempt): with a real
  248: // profiles.env row present, this check failed every single time with
  249: // "native-arm64 profile is missing a pinned image URL/digest" ƒ?" table.
  250: // Profiles[native-arm64].ImageDigest/ImageURL are ONLY ever populated by
  251: // loadMacOSProfile (which reads the pin file), never by
  252: // parseProfilesEnv/loadProfileTableOnly alone, so forced native-arm64 could
  253: // never structurally pass this check. Unit tests never caught it because
  254: // testProfileTable() pre-populates ImageURL/ImageDigest directly on a
  255: // synthetic table, bypassing the real loadProfileTableOnly code path
  256: // entirely. Fix: when the table's own row is unpopulated, read and
  257: // validate the pin file directly instead of trusting fields that are
  258: // simply never set at this call site.
  259: func nativePreflight(ctx context.Context, facts hostFacts, table profileTable, limactlPath, assetRoot string) nativePreflightResult {
  260: 	var r nativePreflightResult
  261: 	r.OK = true // flipped false by the first failing record() call
  262: 
  263: 	appleSilicon := facts.System == "Darwin" && facts.Arch == "arm64"
  264: 	r.record("apple_silicon", appleSilicon, fmt.Sprintf("host reports %s/%s", facts.System, facts.Arch))
  265: 
  266: 	vzOK, vzDetail := limaSupportsVZ(ctx, limactlPath)
  267: 	r.record("lima_vz", vzOK, vzDetail)
  268: 
  269: 	profile, hasProfile := table.Profiles[nativeProfileTableName]
  270: 	switch {
  271: 	case !hasProfile:
  272: 		r.record("digests", false, "native-arm64 row missing from profiles.env")
  273: 	case profile.ImageDigest != "" && profile.ImageURL != "":
  274: 		r.record("digests", true, "image digest "+profile.ImageDigest)
  275: 	case assetRoot == "" || profile.PinEnv == "":
  276: 		r.record("digests", false, "native-arm64 profile is missing a pinned image URL/digest")
  277: 	default:
  278: 		pinPath := filepath.Join(assetRoot, "lima", profile.PinEnv)
  279: 		pinData, err := os.ReadFile(pinPath)
  280: 		if err != nil {
  281: 			r.record("digests", false, "could not read native-arm64 pin file "+pinPath+": "+err.Error())
  282: 		} else if values, verr := validatePinMustKeepValues(string(pinData), pinPath); verr != nil {
  283: 			r.record("digests", false, "native-arm64 pin file "+pinPath+" is invalid: "+verr.Error())
  284: 		} else {
  285: 			r.record("digests", true, "image digest "+values["IOLBOX_IMAGE_DIGEST"]+" (read from "+pinPath+")")
  286: 		}
  287: 	}
  288: 
  289: 	r.record("translator", nativeTranslatorName != "", "declared translator: "+nativeTranslatorName)
  290: 
  291: 	minFreeKB := int64(minFreeDiskGiB) * 1024 * 1024
  292: 	if facts.FreeDiskErr != nil {
  293: 		r.record("resources", false, "could not read free disk: "+facts.FreeDiskErr.Error())
  294: 	} else {
  295: 		r.record("resources", facts.FreeDiskKB >= minFreeKB, fmt.Sprintf("%.2f GiB free (need >= %d GiB)", float64(facts.FreeDiskKB)/1048576, minFreeDiskGiB))
  296: 	}
  297: 
  298: 	return r
  299: }
  300: 
  301: // resolveProfileSelection is the single entry point macos_cli.go calls. It
  302: // applies the explicit-flag > persisted > auto precedence, runs native
  303: // preflight whenever native-arm64 is in play (forced, persisted, or auto),
  304: // and fails closed: a FORCED native-arm64 selection that fails preflight is
  305: // returned as an error (never silently downgraded), while a PERSISTED or
  306: // AUTO selection that fails native preflight falls back to rosetta-amd64
  307: // with FallbackReason set.
  308: func resolveProfileSelection(ctx context.Context, explicitFlag string, table profileTable, facts hostFacts, limactlPath, assetRoot string, configDir func() (string, error)) (profileSelectionResult, error) {
  309: 	if explicitFlag != "" && explicitFlag != selectionAuto {
  310: 		// Direct legacy profile-table name or one of the two logical modes.
  311: 		name, err := resolveProfileSelectionName(explicitFlag, table)
  312: 		if err != nil {
  313: 			return profileSelectionResult{}, err
  314: 		}
  315: 		if explicitFlag == selectionNativeARM64 {
  316: 			pf := nativePreflight(ctx, facts, table, limactlPath, assetRoot)
  317: 			if !pf.OK {
  318: 				return profileSelectionResult{}, fmt.Errorf("forced native-arm64 failed preflight, refusing to fall back (fail-closed): %s\n%s", pf.Reason, pf.String())
  319: 			}
  320: 		}
  321: 		if err := persistProfileChoice(explicitFlag, configDir); err != nil {
  322: 			// Persistence failure must not block an otherwise-successful
  323: 			// explicit selection; the launcher just won't remember it.
  324: 			logf("iolbox-launcher: could not persist profile choice: %v", err)
  325: 		}
  326: 		return profileSelectionResult{Requested: explicitFlag, Selected: explicitFlag, ProfileName: name, Source: "explicit-flag"}, nil
  327: 	}
  328: 
  329: 	// No explicit flag (or explicit "auto"): try a persisted owner choice.
  330: 	persisted, err := readPersistedProfileChoice(configDir)
  331: 	if err != nil {
  332: 		logf("iolbox-launcher: could not read persisted profile choice: %v", err)
  333: 		persisted = ""
  334: 	}
  335: 	if persisted != "" {
  336: 		name, err := resolveProfileSelectionName(persisted, table)
  337: 		if err == nil {
  338: 			if persisted == selectionNativeARM64 {
  339: 				pf := nativePreflight(ctx, facts, table, limactlPath, assetRoot)
  340: 				if !pf.OK {
  341: 					rosettaName, rerr := resolveProfileSelectionName(selectionRosettaAMD64, table)
  342: 					if rerr != nil {
  343: 						return profileSelectionResult{}, fmt.Errorf("persisted native-arm64 failed preflight and rosetta-amd64 fallback is unavailable: %v (preflight: %s)", rerr, pf.Reason)
  344: 					}
  345: 					return profileSelectionResult{Requested: persisted, Selected: selectionRosettaAMD64, ProfileName: rosettaName, Source: "persisted-fallback-rosetta", FallbackReason: pf.Reason}, nil
  346: 				}
  347: 			}
  348: 			return profileSelectionResult{Requested: persisted, Selected: persisted, ProfileName: name, Source: "persisted"}, nil
  349: 		}
  350: 		logf("iolbox-launcher: persisted profile choice %q is no longer valid (%v); falling back to auto", persisted, err)
  351: 	}
  352: 
  353: 	// Bare auto, no valid persisted choice. Post-promotion, auto PREFERS
  354: 	// native-arm64: run the same non-mutating preflight the forced and
  355: 	// persisted native paths run, and use native whenever it passes.
  356: 	// Anything short of a clean pass (native row absent, or any failing
  357: 	// check) falls back to rosetta-amd64 with a FallbackReason -- auto never
  358: 	// errors out, it degrades to the retained Rosetta path.
  359: 	rosettaName, err := resolveProfileSelectionName(selectionRosettaAMD64, table)
  360: 	if err != nil {
  361: 		return profileSelectionResult{}, err
  362: 	}
  363: 	nativeName, nerr := resolveProfileSelectionName(selectionNativeARM64, table)
  364: 	if nerr != nil {
  365: 		return profileSelectionResult{Requested: selectionAuto, Selected: selectionRosettaAMD64, ProfileName: rosettaName, Source: "auto-fallback-rosetta", FallbackReason: nerr.Error()}, nil
  366: 	}
  367: 	pf := nativePreflight(ctx, facts, table, limactlPath, assetRoot)
  368: 	if !pf.OK {
  369: 		return profileSelectionResult{Requested: selectionAuto, Selected: selectionRosettaAMD64, ProfileName: rosettaName, Source: "auto-fallback-rosetta", FallbackReason: pf.Reason}, nil
  370: 	}
  371: 	return profileSelectionResult{Requested: selectionAuto, Selected: selectionNativeARM64, ProfileName: nativeName, Source: "auto-native"}, nil
  372: }
