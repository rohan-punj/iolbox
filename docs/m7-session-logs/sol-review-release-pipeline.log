  213:     case "$response" in
  214:         *'"arch":"arm64"'*) : ;;
  215:         *) return 1 ;;
  216:     esac
  217:     case "$response" in
  218:         *'"features"'*'"i386"'*) return 1 ;;
  219:         *) : ;;
  220:     esac
