    1: #!/usr/bin/env bash
    2: # 30-canary-native.sh ƒ?" native-arm64's hard compatibility gate.
    3: #
    4: # This is the native-arm64 counterpart of 30-canary.sh. Where the Rosetta
    5: # canary executes the smallest useful amd64 program THROUGH Rosetta (proving
    6: # translation works), this canary proves the opposite: that the guest's own
    7: # native aarch64 dynamic linker runs WITHOUT any translation layer, and that
    8: # no macOS-host Rosetta binfmt entry is wired into this guest at all. A
    9: # native-arm64 guest that still has a Rosetta interpreter registered has not
   10: # been proven to be running untranslated, even if this canary's own loader
   11: # check passes ƒ?" so an unexpectedly-present Rosetta entry is also a hard
   12: # failure here, not a warning.
   13: #
   14: # The x86_64 IOL device-image binary itself is a separate, orthogonal
   15: # concern: Phase 3 (docs/macos-m7-phase3-execution-plan.md) measured and
   16: # selected qemu-user as the sole correctness-eligible in-guest translator for
   17: # that one binary, and this canary also confirms qemu-user's binfmt
   18: # registration is present ƒ?" "native-arm64" means the supervisor/vpcs/
   19: # toollaunch userspace stack is native, not that literally every executable
   20: # in the guest is native.
   21: #
   22: # Order: inspect Rosetta binfmt (must be ABSENT), inspect the in-guest
   23: # qemu-user binfmt (must be PRESENT), run the native aarch64 loader with a
   24: # timeout, classify the captured result, persist it, then report it.
   25: #
   26: # The classifier and the failure renderer are pure functions so they can be
   27: # exercised on any bash host without Lima, a guest, or qemu-user. Set
   28: # IOLBOX_CANARY_LIB_ONLY=1 before sourcing this file to load those functions
   29: # without running main().
   30: #
   31: # Environment variables used in addition to lib.sh:
   32: #   IOLBOX_CANARY_TIMEOUT       timeout in seconds (default: 10)
   33: #   IOLBOX_NATIVE_LOADER         native aarch64 dynamic linker path
   34: #                                 (default: /lib/ld-linux-aarch64.so.1)
   35: 
   36: set -euo pipefail
   37: 
   38: # shellcheck source=lib.sh
   39: . "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
   40: 
   41: # lib.sh unconditionally sets IOLBOX_LOADER to the amd64 loader path for the
   42: # Rosetta canary's own use; this profile's hard gate is the native loader,
   43: # not that one.
   44: IOLBOX_NATIVE_LOADER="${IOLBOX_NATIVE_LOADER:-/lib/ld-linux-aarch64.so.1}"
   45: 
   46: # native_canary_extract_version <output_text>
   47: #
   48: # Same narrow contract as the Rosetta canary's version extractor: an exit-0
   49: # loader that prints silence, a warning, or an unrelated string is not a
   50: # passing canary.
   51: native_canary_extract_version() {
   52:     local output_text="$1" line
   53:     local glibc_re='(ld\.so[[:space:]]+\([^)]*GLIBC[[:space:]]+[0-9]+\.[0-9]+[0-9A-Za-z._+-]*\))'
   54: 
   55:     while IFS= read -r line; do
   56:         if [[ "$line" =~ $glibc_re ]]; then
   57:             printf '%s' "${BASH_REMATCH[1]}"
   58:             return 0
   59:         fi
   60:     done <<< "$output_text"
   61: 
   62:     return 1
   63: }
   64: 
   65: # native_canary_classify <exit_status> <output_text>
   66: #
   67: # Intentionally independent of files, environment variables, and host facts.
   68: # No FAIL_AUXV verdict here: that failure mode is specific to Rosetta's
   69: # translation of amd64 auxv entries, which does not exist on this path.
   70: native_canary_classify() {
   71:     local exit_status="$1" output_text="$2"
   72: 
   73:     if [[ "$exit_status" =~ ^0$ ]] && native_canary_extract_version "$output_text" >/dev/null; then
   74:         printf 'PASS\n'
   75:     elif [[ "$exit_status" = 127 && "$output_text" == *"No such file or directory"* ]]; then
   76:         printf 'FAIL_MISSING\n'
   77:     elif [[ "$exit_status" = 126 && "$output_text" == *"Exec format error"* ]]; then
   78:         printf 'FAIL_NOEXEC\n'
   79:     else
   80:         printf 'FAIL_OTHER\n'
   81:     fi
   82: }
   83: 
   84: # native_canary_qemu_user_state
   85: #
   86: # Diagnostic context for the qemu-x86_64 binfmt entry the IOL device-image
   87: # binary still needs. Not the hard gate by itself (a missing IOL image is a
   88: # separate, later concern), but its absence is recorded so a native-arm64
   89: # guest that can run the supervisor natively but cannot yet run x86_64 IOL
   90: # images is visibly distinguishable from one that is fully ready.
   91: native_canary_qemu_user_state() {
   92:     local entry='/proc/sys/fs/binfmt_misc/qemu-x86_64'
   93: 
   94:     if [ -r "$entry" ]; then
   95:         printf 'registered: %s' "$(tr '\n' ' ' < "$entry")"
   96:     else
   97:         printf 'absent: %s is unreadable or missing' "$entry"
   98:     fi
   99: }
  100: 
  101: native_canary_qemu_user_present() {
  102:     local entry='/proc/sys/fs/binfmt_misc/qemu-x86_64'
  103:     [ -r "$entry" ] && grep -q '^enabled' "$entry"
  104: }
  105: 
  106: # native_canary_rosetta_state
  107: #
  108: # Mirrors 30-canary.sh's binfmt inspection, but for THIS profile a present
  109: # Rosetta entry is itself an anomaly worth surfacing loudly: the whole point
  110: # of native-arm64 is a guest that never depends on Rosetta.
  111: native_canary_rosetta_state() {
  112:     local entry='/proc/sys/fs/binfmt_misc/rosetta'
  113: 
  114:     if [ -r "$entry" ]; then
  115:         printf 'PRESENT (unexpected for native-arm64): %s' "$(tr '\n' ' ' < "$entry")"
  116:     else
  117:         printf 'absent (expected)'
  118:     fi
  119: }
  120: 
  121: native_canary_rosetta_present() {
  122:     [ -r /proc/sys/fs/binfmt_misc/rosetta ]
  123: }
  124: 
  125: native_canary_remediation() {
  126:     local verdict="$1"
  127: 
  128:     case "$verdict" in
  129:         FAIL_MISSING)
  130:             printf '%s' 'The native aarch64 loader is absent. This guest image should ship glibc for its own architecture by default; verify the pinned image and re-provision.'
  131:             ;;
  132:         FAIL_NOEXEC)
  133:             printf '%s' 'The native aarch64 loader was rejected with Exec format error. This strongly suggests the guest kernel/userspace pair is not actually aarch64; inspect uname -m and the pinned image identity.'
  134:             ;;
  135:         FAIL_ROSETTA_PRESENT)
  136:             printf '%s' 'A Rosetta binfmt entry is registered in this guest even though iolbox-native-arm64.yaml sets rosetta.enabled=false. Recreate the machine from the native-arm64 template; do not reuse a machine that was ever provisioned as rosetta-amd64.'
  137:             ;;
  138:         FAIL_QEMU_USER_ABSENT)
  139:             printf '%s' 'The in-guest qemu-x86_64 binfmt handler required to run the x86_64-only IOL device-image binary is not registered. Run the native-arm64 multiarch step (10-multiarch-native.sh) to install and register qemu-user-static, then re-run this canary.'
  140:             ;;
  141:         FAIL_OTHER)
  142:             printf '%s' 'The native loader did not produce a valid glibc version. Inspect the captured error and the pinned image, correct the guest, and re-run this canary before installing the payload.'
  143:             ;;
  144:         *)
  145:             printf '%s' 'The canary returned an unknown verdict. Treat the guest as not proven native, inspect the captured output, and re-run the canary after correcting the guest.'
  146:             ;;
  147:     esac
  148: }
  149: 
  150: native_canary_render_failure() {
  151:     local verdict="$1" host_macos="$2" host_lima="$3" machine="$4"
  152:     local kernel="$5" arch="$6" rosetta_state="$7" qemu_state="$8" loader_path="$9"
  153:     local loader_exists="${10}" captured_error="${11}"
  154: 
  155:     printf '%s\n' \
  156:         'Native-arm64 canary: FAILED' \
  157:         "Verdict: $verdict" \
  158:         "macOS product/build: $host_macos" \
  159:         "Lima version: $host_lima" \
  160:         "Lima machine: $machine" \
  161:         "Guest kernel: $kernel" \
  162:         "Guest arch: $arch" \
  163:         "Rosetta binfmt state: $rosetta_state" \
  164:         "qemu-user (qemu-x86_64) binfmt state: $qemu_state" \
  165:         "Loader path: $loader_path" \
  166:         "Loader exists: $loader_exists" \
  167:         'Actual captured error text:'
  168: 
  169:     if [ -n "$captured_error" ]; then
  170:         printf '%s\n' "$captured_error"
  171:     else
  172:         printf '%s\n' '<empty>'
  173:     fi
  174: 
  175:     printf 'Remediation: %s\n' "$(native_canary_remediation "$verdict")"
  176: }
  177: 
  178: native_canary_json_object() {
  179:     local verdict="$1" version="$2" kernel="$3" rosetta_state="$4" qemu_state="$5" error_text="$6"
  180:     local macos_product="${7:-unknown}"
  181:     local macos_build="${8:-unknown}"
  182:     local lima_version="${9:-unknown}"
  183:     local profile="${10:-unknown}"
  184:     local timestamp="${11:-}"
  185:     local escaped_verdict escaped_version escaped_kernel escaped_rosetta escaped_qemu escaped_error
  186:     local escaped_product escaped_build escaped_lima escaped_profile escaped_timestamp
  187: 
  188:     [ -n "$timestamp" ] || timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  189: 
  190:     escaped_verdict="$(iolbox_json_escape "$verdict")"
  191:     escaped_version="$(iolbox_json_escape "$version")"
  192:     escaped_kernel="$(iolbox_json_escape "$kernel")"
  193:     escaped_rosetta="$(iolbox_json_escape "$rosetta_state")"
  194:     escaped_qemu="$(iolbox_json_escape "$qemu_state")"
  195:     escaped_error="$(iolbox_json_escape "$error_text")"
  196:     escaped_product="$(iolbox_json_escape "$macos_product")"
  197:     escaped_build="$(iolbox_json_escape "$macos_build")"
  198:     escaped_lima="$(iolbox_json_escape "$lima_version")"
  199:     escaped_profile="$(iolbox_json_escape "$profile")"
  200:     escaped_timestamp="$(iolbox_json_escape "$timestamp")"
  201: 
  202:     printf '{"schema":1,"macos_product":"%s","macos_build":"%s","lima_version":"%s","profile":"%s","kernel":"%s","binfmt":"%s","qemu_user_binfmt":"%s","verdict":"%s","timestamp":"%s","version":"%s","error":"%s"}\n' \
  203:         "$escaped_product" "$escaped_build" "$escaped_lima" "$escaped_profile" \
  204:         "$escaped_kernel" "$escaped_rosetta" "$escaped_qemu" "$escaped_verdict" "$escaped_timestamp" \
  205:         "$escaped_version" "$escaped_error"
  206: }
  207: 
  208: native_canary_write_record() {
  209:     # See canary_write_record's NOTE in 30-canary.sh for why these must be
  210:     # separate `local` statements under set -u.
  211:     local record_dir='/var/lib/iolbox'
  212:     local record_file="$record_dir/macos-canary.json"
  213:     local record_tmp="$record_file.tmp.$$" json="$1"
  214: 
  215:     mkdir -p "$record_dir"
  216:     printf '%s\n' "$json" > "$record_tmp"
  217:     mv -f "$record_tmp" "$record_file"
  218: }
  219: 
  220: canary_tmp_dir=''
  221: 
  222: canary_cleanup() {
  223:     if [ -n "$canary_tmp_dir" ]; then
  224:         rm -rf -- "$canary_tmp_dir"
  225:     fi
  226: }
  227: 
  228: usage() {
  229:     cat <<'USAGE'
  230: Usage: 30-canary-native.sh [--quiet | --json]
  231: 
  232: Run the native-arm64 loader canary: prove Rosetta is absent, the in-guest
  233: qemu-user x86_64 handler is present, and the native aarch64 loader works.
  234: The default prints a human-readable failure diagnostic; --quiet prints only
  235: the verdict and --json prints one JSON object. Both flags preserve the
  236: normal exit-code contract.
  237: USAGE
  238: }
  239: 
  240: main() {
  241:     local quiet=0 json_mode=0 arg
  242:     local timeout_seconds="${IOLBOX_CANARY_TIMEOUT:-10}"
  243:     local tmp_dir stdout_file stderr_file stdout_text stderr_text captured_text
  244:     local exit_status verdict version kernel arch rosetta_state qemu_state loader_exists json_text
  245:     local macos_product macos_build lima_version profile timestamp host_macos
  246: 
  247:     while [ "$#" -gt 0 ]; do
  248:         arg="$1"
  249:         case "$arg" in
  250:             --quiet) quiet=1 ;;
  251:             --json) json_mode=1 ;;
  252:             -h|--help) usage; return "$IOLBOX_EXIT_OK" ;;
  253:             *) usage >&2; return "$IOLBOX_EXIT_USAGE" ;;
  254:         esac
  255:         shift
  256:     done
  257: 
  258:     if [ "$quiet" -eq 1 ] && [ "$json_mode" -eq 1 ]; then
  259:         printf '%s\n' '30-canary-native.sh: --quiet and --json are mutually exclusive' >&2
  260:         return "$IOLBOX_EXIT_USAGE"
  261:     fi
  262: 
  263:     case "$timeout_seconds" in
  264:         ''|*[!0-9]*)
  265:             printf '30-canary-native.sh: IOLBOX_CANARY_TIMEOUT must be a positive integer, got %s\n' \
  266:                 "$timeout_seconds" >&2
  267:             return "$IOLBOX_EXIT_USAGE"
  268:             ;;
  269:     esac
  270:     if [ "$timeout_seconds" -eq 0 ]; then
  271:         printf '%s\n' '30-canary-native.sh: IOLBOX_CANARY_TIMEOUT must be greater than zero' >&2
  272:         return "$IOLBOX_EXIT_USAGE"
  273:     fi
  274:     have timeout || die "$IOLBOX_EXIT_USAGE" 'timeout(1) is required to run the native canary safely'
  275: 
  276:     macos_product="${IOLBOX_HOST_MACOS_PRODUCT:-}"
  277:     macos_build="${IOLBOX_HOST_MACOS_BUILD:-}"
  278:     host_macos="$IOLBOX_HOST_MACOS"
  279:     if [ -z "$macos_product" ] && [[ "$host_macos" == *' ('*')' ]]; then
  280:         macos_product="${host_macos%% (*}"
  281:     fi
  282:     if [ -z "$macos_build" ] && [[ "$host_macos" == *' ('*')' ]]; then
  283:         macos_build="${host_macos##* (}"
  284:         macos_build="${macos_build%)}"
  285:     fi
  286:     [ -n "$macos_product" ] || macos_product='unknown'
  287:     [ -n "$macos_build" ] || macos_build='unknown'
  288:     lima_version="${IOLBOX_HOST_LIMA:-unknown}"
  289:     profile="${IOLBOX_PROFILE:-unknown}"
  290:     timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  291: 
  292:     rosetta_state="$(native_canary_rosetta_state)"
  293:     qemu_state="$(native_canary_qemu_user_state)"
  294:     kernel="$(uname -r)"
  295:     arch="$(uname -m)"
  296:     if [ -e "$IOLBOX_NATIVE_LOADER" ]; then
  297:         loader_exists='yes'
  298:     else
  299:         loader_exists='no'
  300:     fi
  301: 
  302:     tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/iolbox-canary-native.XXXXXX")"
  303:     canary_tmp_dir="$tmp_dir"
  304:     stdout_file="$tmp_dir/stdout"
  305:     stderr_file="$tmp_dir/stderr"
  306:     trap canary_cleanup EXIT
  307: 
  308:     # Fail closed BEFORE running the loader when the guest is structurally
  309:     # wrong for this profile: a present Rosetta entry means this is not
  310:     # proven to be an untranslated guest, regardless of what the loader
  311:     # reports.
  312:     if native_canary_rosetta_present; then
  313:         exit_status=1
  314:         verdict='FAIL_ROSETTA_PRESENT'
  315:         captured_text='Rosetta binfmt entry is registered on a native-arm64 guest.'
  316:     elif ! native_canary_qemu_user_present; then
  317:         exit_status=1
  318:         verdict='FAIL_QEMU_USER_ABSENT'
  319:         captured_text='qemu-x86_64 binfmt handler is not registered.'
  320:     else
  321:         if timeout --foreground --kill-after=2s "${timeout_seconds}s" "$IOLBOX_NATIVE_LOADER" --version >"$stdout_file" 2>"$stderr_file"; then
  322:             exit_status=0
  323:         else
  324:             exit_status=$?
  325:         fi
  326:         stdout_text="$(cat "$stdout_file")"
  327:         stderr_text="$(cat "$stderr_file")"
  328:         captured_text="$stdout_text"
  329:         if [ -n "$stderr_text" ]; then
  330:             if [ -n "$captured_text" ]; then
  331:                 captured_text+=$'\n'
  332:             fi
  333:             captured_text+="$stderr_text"
  334:         fi
  335:         if [ "$exit_status" -eq 0 ]; then
  336:             verdict="$(native_canary_classify "$exit_status" "$stdout_text")"
  337:         else
  338:             verdict="$(native_canary_classify "$exit_status" "$captured_text")"
  339:         fi
  340:     fi
  341: 
  342:     version="$(native_canary_extract_version "${stdout_text:-}" || true)"
  343:     if [ "$verdict" = 'PASS' ]; then
  344:         json_text="$(native_canary_json_object "$verdict" "$version" "$kernel" "$rosetta_state" "$qemu_state" '' \
  345:             "$macos_product" "$macos_build" "$lima_version" "$profile" "$timestamp")"
  346:     else
  347:         json_text="$(native_canary_json_object "$verdict" "$version" "$kernel" "$rosetta_state" "$qemu_state" "$captured_text" \
  348:             "$macos_product" "$macos_build" "$lima_version" "$profile" "$timestamp")"
  349:     fi
  350:     if ! native_canary_write_record "$json_text"; then
  351:         if [ "$verdict" = 'PASS' ]; then
  352:             die "$IOLBOX_EXIT_USAGE" \
  353:                 'could not persist /var/lib/iolbox/macos-canary.json'
  354:         fi
  355:         printf '%s\n' \
  356:             'WARNING: could not persist /var/lib/iolbox/macos-canary.json; continuing to report the canary failure' >&2
  357:     fi
  358: 
  359:     if [ "$verdict" = 'PASS' ]; then
  360:         if [ "$json_mode" -eq 1 ]; then
  361:             printf '%s\n' "$json_text"
  362:         elif [ "$quiet" -eq 1 ]; then
  363:             printf 'PASS\n'
  364:         else
  365:             printf 'PASS: %s\n' "$version"
  366:         fi
  367:         return "$IOLBOX_EXIT_OK"
  368:     fi
  369: 
  370:     if [ "$json_mode" -eq 1 ]; then
  371:         printf '%s\n' "$json_text"
  372:     elif [ "$quiet" -eq 1 ]; then
  373:         printf '%s\n' "$verdict"
  374:     fi
  375: 
  376:     native_canary_render_failure "$verdict" "$IOLBOX_HOST_MACOS" "$IOLBOX_HOST_LIMA" \
  377:         "$IOLBOX_MACHINE" "$kernel" "$arch" "$rosetta_state" "$qemu_state" "$IOLBOX_NATIVE_LOADER" \
  378:         "$loader_exists" "$captured_text" >&2
  379: 
  380:     return "$IOLBOX_EXIT_CANARY"
  381: }
  382: 
  383: if [ "${IOLBOX_CANARY_LIB_ONLY:-0}" != '1' ]; then
  384:     main "$@"
  385: fi
