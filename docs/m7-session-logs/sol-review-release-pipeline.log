  114: 
  115: func extractQuotedAssignment(data, name string) (string, error) {
  116: 	marker := name + "='"
  117: 	start := strings.Index(data, marker)
  118: 	if start < 0 {
  119: 		return "", fmt.Errorf("missing %s multiline assignment", name)
  120: 	}
  121: 	valueStart := start + len(marker)
  122: 	end := strings.IndexByte(data[valueStart:], '\'')
  123: 	if end < 0 {
  124: 		return "", fmt.Errorf("unterminated %s multiline assignment", name)
  125: 	}
  126: 	return data[valueStart : valueStart+end], nil
  127: }
  128: 
  129: func splitTableRows(value string, wantFields int, label string) ([][]string, error) {
  130: 	var rows [][]string
  131: 	for lineNo, line := range strings.Split(value, "\n") {
  132: 		line = strings.TrimSpace(line)
  133: 		if line == "" || strings.HasPrefix(line, "#") {
  134: 			continue
  135: 		}
  136: 		fields := strings.Split(line, "|")
  137: 		if len(fields) != wantFields {
  138: 			return nil, fmt.Errorf("%s row %d has %d fields, want %d", label, lineNo+1, len(fields), wantFields)
  139: 		}
  140: 		for i := range fields {
  141: 			fields[i] = strings.TrimSpace(fields[i])
  142: 		}
  143: 		rows = append(rows, fields)
  144: 	}
  145: 	return rows, nil
  146: }
  147: 
  148: // splitProfileRows tolerates the pre-Phase-4 9-field row shape (name|role|
  149: // guest_label|pin_env|yaml_template|multiarch_step|kernel_hold_step|
  150: // kernel_series|expected_uname_r) alongside the Phase-4 12-field shape that
  151: // appends canary_step|install_step|verify_step. A 9-field row is padded with
  152: // three empty trailing fields, which macOSProfile.canaryStep()/installStep()/
  153: // verifyStep() then resolve to the historical fixed filenames.
  154: func splitProfileRows(value, label string) ([][]string, error) {
  155: 	var rows [][]string
  156: 	for lineNo, line := range strings.Split(value, "\n") {
  157: 		line = strings.TrimSpace(line)
  158: 		if line == "" || strings.HasPrefix(line, "#") {
  159: 			continue
  160: 		}
  161: 		fields := strings.Split(line, "|")
  162: 		switch len(fields) {
  163: 		case 9:
  164: 			fields = append(fields, "", "", "")
  165: 		case 12:
  166: 			// already the Phase-4 shape
  167: 		default:
  168: 			return nil, fmt.Errorf("%s row %d has %d fields, want 9 or 12", label, lineNo+1, len(fields))
  169: 		}
  170: 		for i := range fields {
  171: 			fields[i] = strings.TrimSpace(fields[i])
  172: 		}
  173: 		rows = append(rows, fields)
  174: 	}
  175: 	return rows, nil
  176: }
  177: 
  178: func parseProfilesEnv(data string) (profileTable, error) {
  179: 	profilesText, err := extractQuotedAssignment(data, "IOLBOX_PROFILE_TABLE")
  180: 	if err != nil {
  181: 		return profileTable{}, err
  182: 	}
  183: 	qualText, err := extractQuotedAssignment(data, "IOLBOX_QUALIFICATION_TABLE")
  184: 	if err != nil {
  185: 		return profileTable{}, err
  186: 	}
  187: 	profileRows, err := splitProfileRows(profilesText, "profile")
  188: 	if err != nil {
  189: 		return profileTable{}, err
  190: 	}
  191: 	qualRows, err := splitTableRows(qualText, 6, "qualification")
  192: 	if err != nil {
  193: 		return profileTable{}, err
  194: 	}
  195: 
  196: 	table := profileTable{Profiles: make(map[string]macOSProfile)}
  197: 	defaults := 0
  198: 	for _, row := range profileRows {
  199: 		for i, field := range row[:8] {
  200: 			if field == "" {
  201: 				return profileTable{}, fmt.Errorf("profile %q field %d is empty", row[0], i+1)
  202: 			}
  203: 		}
  204: 		if _, exists := table.Profiles[row[0]]; exists {
  205: 			return profileTable{}, fmt.Errorf("duplicate profile %q", row[0])
  206: 		}
  207: 		p := macOSProfile{
  208: 			Name:           row[0],
  209: 			Role:           row[1],
  210: 			GuestLabel:     row[2],
  211: 			PinEnv:         row[3],
  212: 			YAMLTemplate:   row[4],
  213: 			MultiarchStep:  row[5],
  214: 			KernelHoldStep: row[6],
  215: 			KernelSeries:   row[7],
  216: 			ExpectedUnameR: row[8],
  217: 			CanaryStep:     row[9],
  218: 			InstallStep:    row[10],
  219: 			VerifyStep:     row[11],
  220: 		}
  221: 		if p.Role == "DEFAULT" {
  222: 			defaults++
  223: 			table.Default = p.Name
  224: 		}
  225: 		table.Profiles[p.Name] = p
  226: 	}
  227: 	if defaults != 1 {
  228: 		return profileTable{}, fmt.Errorf("profile table must contain exactly one DEFAULT row (found %d)", defaults)
  229: 	}
  230: 	for _, row := range qualRows {
  231: 		for i, field := range row {
  232: 			if field == "" {
  233: 				return profileTable{}, fmt.Errorf("qualification row for %q field %d is empty", row[0], i+1)
  234: 			}
  235: 		}
  236: 		if _, ok := table.Profiles[row[0]]; !ok {
  237: 			return profileTable{}, fmt.Errorf("qualification references unknown profile %q", row[0])
  238: 		}
  239: 		table.Qualifications = append(table.Qualifications, qualification{
  240: 			Profile: row[0], Product: row[1], Build: row[2], Verdict: row[3], Status: row[4], Evidence: row[5],
  241: 		})
  242: 	}
  243: 	return table, nil
  244: }
  245: 
  246: func qualificationFor(table profileTable, profile, product, build string) qualification {
  247: 	for _, q := range table.Qualifications {
  248: 		if q.Profile == profile && q.Product == product && q.Build == build {
  249: 			return q
  250: 		}
  251: 	}
  252: 	return qualification{}
  253: }
