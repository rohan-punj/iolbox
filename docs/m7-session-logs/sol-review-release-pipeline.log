  641: ## 12. Review record (codex `gpt-5.6-sol`, medium)
  642: 
  643: *Filled in at A10 of the process, after the review runs. See
  644: `docs/m7-session-logs/sol-review-release-pipeline.log`.*
===== .github/workflows/release.yml =====
    1: name: Release
    2: 
    3: # Triggers: a version tag builds+drafts a release; workflow_dispatch lets a
    4: # maintainer dry-run the whole pipeline (build/test artifacts, no publish)
    5: # without cutting a tag.
    6: on:
    7:   push:
    8:     tags: ["v*"]
    9:   workflow_dispatch:
   10: 
   11: permissions:
   12:   contents: write
   13: 
   14: jobs:
   15:   # ---------------------------------------------------------------------
   16:   # Windows: the ACTUAL shipped Windows deliverable is tools/iolab-launcher,
   17:   # a plain Go exe (browser-first GUI ƒ?" the Tauri/Rust shell under app/
   18:   # src-tauri was abandoned when the project pivoted browser-first and is
   19:   # not known to still build). Do not resurrect the Tauri bundle here.
   20:   # ---------------------------------------------------------------------
   21:   build-windows:
   22:     name: Build Windows launcher + capture-helper
   23:     runs-on: windows-latest
   24:     steps:
   25:       # fetch-depth: 0 so `git describe --tags` (used by build-release.sh
   26:       # in the Linux job, and good practice here too for parity) sees real
   27:       # tag history instead of the shallow single commit `checkout` gives
   28:       # by default.
   29:       - uses: actions/checkout@v4
   30:         with:
   31:           fetch-depth: 0
   32: 
   33:       - uses: actions/setup-go@v5
   34:         with:
   35:           go-version: "1.26"
   36: 
   37:       - name: Vet + test iolab-launcher
   38:         working-directory: tools/iolab-launcher
   39:         run: |
   40:           go vet ./...
   41:           go test ./...
   42: 
   43:       - name: Build iolbox-launcher.exe
   44:         working-directory: tools/iolab-launcher
   45:         run: go build -o iolbox-launcher.exe .
   46: 
   47:       - name: Vet + test capture-helper
   48:         working-directory: tools/capture-helper
   49:         run: |
   50:           go vet ./...
   51:           go test ./...
   52: 
   53:       - name: Build capture-helper.exe
   54:         working-directory: tools/capture-helper
   55:         run: go build -o capture-helper.exe .
   56: 
   57:       # NOTE: both exes are UNSIGNED. A code-signing step (e.g. Azure Trusted
   58:       # Signing, or a self-hosted signtool + cert) slots in here later,
   59:       # between the build steps above and this upload. Until then, Windows
   60:       # SmartScreen will warn on first run ƒ?" expected, not a CI bug.
   61:       #
   62:       # NOTE: this job does NOT assemble the full launcher bundle (the
   63:       # qemu/ subdirectory and iolbox-disk.qcow2 that tools/iolab-launcher
   64:       # expects alongside it ƒ?" see runtime/pack-qemu.sh and docs/INSTALL.md
   65:       # "QEMU disk (Windows launcher)"). Neither qemu's third-party binaries
   66:       # nor the multi-GB qcow2 disk live in this repo, so that bundle is
   67:       # assembled by hand on the private builder and attached to the draft
   68:       # release alongside this job's two exes.
   69:       - uses: actions/upload-artifact@v4
   70:         with:
   71:           name: iolbox-windows
   72:           path: |
   73:             tools/iolab-launcher/iolbox-launcher.exe
   74:             tools/capture-helper/capture-helper.exe
   75: 
   76:   # ---------------------------------------------------------------------
   77:   # Linux: builds the GUI-embedded supervisor the ONLY correct way, then
   78:   # bakes every Linux-hostable packaging target that doesn't need loop
   79:   # devices/chroot/grub (those three ƒ?" vmdk/vmx, OVA, qcow2 ƒ?" need a
   80:   # root-capable builder and are attached to the release by hand; see the
   81:   # release job's draft body).
   82:   # ---------------------------------------------------------------------
   83:   build-linux:
   84:     name: Build supervisor + Linux packaging targets
   85:     runs-on: ubuntu-latest
   86:     steps:
   87:       - uses: actions/checkout@v4
   88:         with:
   89:           # build-release.sh stamps the binary's version via
   90:           # `git describe --tags`; a shallow checkout has no tag history,
   91:           # so the stamp silently degrades to a bare commit hash instead of
   92:           # e.g. "v0.4.0". fetch-depth 0 keeps that stamp meaningful.
   93:           fetch-depth: 0
   94: 
   95:       - uses: actions/setup-go@v5
   96:         with:
   97:           go-version: "1.26"
   98: 
   99:       - uses: actions/setup-node@v4
  100:         with:
  101:           node-version: "20"
  102:           cache: npm
  103:           cache-dependency-path: app/package-lock.json
  104: 
  105:       - name: Install frontend deps
  106:         working-directory: app
  107:         run: npm ci
  108: 
  109:       # THE ONLY correct way to produce a deployable supervisor binary.
  110:       # build-release.sh runs `npm run build:embed` before compiling and
  111:       # then asserts the embedded index.html isn't the committed
  112:       # placeholder. A bare `go build ./cmd/supervisor` skips build:embed
  113:       # entirely and ships that placeholder ("GUI not bundled in this
  114:       # build") straight into a release artifact ƒ?" which is exactly what
  115:       # the previous version of this workflow did. Never shortcut this.
  116:       - name: Build supervisor (build-release.sh ƒ?" GUI embedded)
  117:         run: bash build-release.sh
  118: 
  119:       - name: Install rootfs/packaging build deps
  120:         run: |
  121:           sudo apt-get update
  122:           sudo apt-get install -y debootstrap zstd build-essential
  123: 
  124:       # fetch-vpcs.sh needs git + make + a C compiler (all covered by
  125:       # build-essential + the runner's preinstalled git) to clone and
  126:       # statically link the GNS3/vpcs fork; it caches its output at
  127:       # runtime/build/vpcs/vpcs and no-ops on a second run if that binary
  128:       # already exists. build-rootfs.sh does NOT call it automatically ƒ?"
  129:       # it hard-fails if the vpcs binary is missing ƒ?" so it must run here
  130:       # as an explicit step before build-rootfs.sh.
  131:       - name: Fetch/build VPCS
  132:         run: runtime/fetch-vpcs.sh
  133: 
  134:       # build-rootfs.sh must run as root (debootstrap needs to mknod/chroot).
  135:       # Its defaults already match this job's layout: --supervisor-bin
  136:       # defaults to supervisor/bin/supervisor-linux-amd64 (build-release.sh's
  137:       # output) and --build-dir defaults to runtime/build (fetch-vpcs.sh's
  138:       # cache location), so no flags are needed here.
  139:       - name: Bake shared rootfs
  140:         run: sudo runtime/build-rootfs.sh
  141: 
  142:       # pack-wsl.sh doesn't strictly need root (plain tar of an existing
  143:       # dir) but debootstrap can leave a few root-only files behind, so run
  144:       # it as root too, per its own header comment.
  145:       - name: Pack WSL rootfs tarball
  146:         run: sudo runtime/pack-wsl.sh --build-dir runtime/build
  147: 
  148:       # workflow_dispatch runs (no tag) have no meaningful semver ƒ?" fall
  149:       # back to the branch/ref name, which pack-lxc.sh only uses as an
  150:       # opaque label in the output filename (iolbox-ct-<VERSION>.tar.zst).
  151:       - name: Resolve version string
  152:         id: version
  153:         shell: bash
  154:         run: echo "value=${GITHUB_REF_NAME//\//-}" >> "$GITHUB_OUTPUT"
  155: 
  156:       - name: Pack Proxmox LXC template
  157:         run: sudo runtime/pack-lxc.sh --build-dir runtime/build --version "${{ steps.version.outputs.value }}"
  158: 
  159:       # pack-native.sh does NOT consume the debootstrap rootfs at all ƒ?" per
  160:       # its own header, a native install runs on the operator's own distro,
  161:       # so it only needs the supervisor + vpcs binaries plus files under
  162:       # runtime/files/{,native/}. It could run before build-rootfs.sh, but
  163:       # is kept after here so every packaging step reads top-to-bottom in
  164:       # one pass; it needs no root (no loop devices/chroot involved).
  165:       - name: Pack native (systemd) server tarball
  166:         run: runtime/pack-native.sh --supervisor-bin supervisor/bin/supervisor-linux-amd64 --build-dir runtime/build --version "${{ steps.version.outputs.value }}"
  167: 
  168:       - name: Generate checksums
  169:         working-directory: runtime/build
  170:         run: |
  171:           sha256sum iolbox-rootfs.tar iolbox-ct-*.tar.zst iolbox-server-*.tar.gz > SHA256SUMS-ci.txt
  172:           cat SHA256SUMS-ci.txt
  173: 
  174:       - uses: actions/upload-artifact@v4
  175:         with:
  176:           name: iolbox-linux
  177:           path: |
  178:             runtime/build/iolbox-rootfs.tar
  179:             runtime/build/iolbox-ct-*.tar.zst
  180:             runtime/build/iolbox-server-*.tar.gz
  181:             runtime/build/SHA256SUMS-ci.txt
  182: 
  183:   # ---------------------------------------------------------------------
  184:   # macOS: package the Darwin launcher with the exact native payload from
  185:   # build-linux above. This job never rebuilds or discovers a second payload.
  186:   # ---------------------------------------------------------------------
  187:   build-macos:
  188:     name: Build Apple Silicon macOS archive
  189:     needs: build-linux
  190:     runs-on: ubuntu-latest
  191:     steps:
  192:       - uses: actions/checkout@v4
  193:         with:
  194:           fetch-depth: 0
  195: 
  196:       - uses: actions/setup-go@v5
  197:         with:
  198:           go-version: "1.26"
  199:           cache-dependency-path: tools/iolab-launcher/go.mod
  200: 
  201:       - uses: actions/download-artifact@v4
  202:         with:
  203:           name: iolbox-linux
  204:           path: linux-artifact
  205: 
  206:       - name: Resolve release/ref version and source date
  207:         id: version
  208:         shell: bash
  209:         run: |
  210:           set -euo pipefail
  211:           version="${GITHUB_REF_NAME//\//-}"
  212:           test -n "$version"
  213:           epoch="$(git show -s --format=%ct "$GITHUB_SHA")"
  214:           echo "value=$version" >> "$GITHUB_OUTPUT"
  215:           echo "source-date-epoch=$epoch" >> "$GITHUB_OUTPUT"
  216: 
  217:       - name: Select and verify exact build-linux payload
  218:         id: payload
  219:         shell: bash
  220:         env:
  221:           VERSION: ${{ steps.version.outputs.value }}
  222:         run: |
  223:           set -euo pipefail
  224:           mapfile -t payloads < <(find linux-artifact -type f -name "iolbox-server-${VERSION}.tar.gz" -print)
  225:           test "${#payloads[@]}" -eq 1
  226:           payload="${payloads[0]}"
  227:           base="$(basename "$payload")"
  228:           mapfile -t checksum_files < <(find linux-artifact -type f -name SHA256SUMS-ci.txt -print)
  229:           test "${#checksum_files[@]}" -eq 1
  230:           checksums="${checksum_files[0]}"
  231:           expected="$(awk -v b="$base" '
  232:             BEGIN { bad=0; matches=0; digest="" }
  233:             NF != 2 || length($1) != 64 || $1 !~ /^[0-9A-Fa-f]+$/ || $2 !~ /^\*?[^[:space:]]+$/ { bad=1 }
  234:             $2 == b || $2 == "*" b { matches++; digest=$1 }
  235:             END {
  236:               if (bad || matches != 1) exit 1
  237:               print digest
  238:             }
  239:           ' "$checksums")" || {
  240:             echo "checksum manifest is malformed or does not contain exactly one line for $base" >&2
  241:             exit 1
  242:           }
  243:           printf '%s' "$expected" | grep -Eq '^[0-9A-Fa-f]{64}$'
  244:           ( cd "$(dirname "$payload")" && printf '%s  %s\n' "$expected" "$base" | sha256sum -c - )
  245:           echo "path=$payload" >> "$GITHUB_OUTPUT"
  246:           echo "basename=$base" >> "$GITHUB_OUTPUT"
  247:           echo "sha256=$expected" >> "$GITHUB_OUTPUT"
  248:           echo "checksums=$checksums" >> "$GITHUB_OUTPUT"
  249:           echo "build-linux payload: $payload"
  250:           echo "build-linux checksum manifest: $checksums"
  251:           echo "trusted payload sha256: $expected"
  252: 
  253:       - name: Vet and test launcher
  254:         working-directory: tools/iolab-launcher
  255:         run: |
  256:           go vet ./...
  257:           go test ./...
  258: 
  259:       - name: Cross-build Darwin arm64 launcher
  260:         working-directory: tools/iolab-launcher
  261:         run: |
  262:           mkdir -p bin
  263:           CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build -o bin/iolbox-darwin-arm64 .
  264: 
  265:       - name: Pack deterministic macOS archive
  266:         env:
  267:           VERSION: ${{ steps.version.outputs.value }}
  268:           SOURCE_DATE_EPOCH: ${{ steps.version.outputs.source-date-epoch }}
  269:           PAYLOAD: ${{ steps.payload.outputs.path }}
  270:           PAYLOAD_SHA256: ${{ steps.payload.outputs.sha256 }}
  271:         shell: bash
  272:         run: |
  273:           set -euo pipefail
  274:           bash packaging/macos/pack-release.sh \
  275:             --launcher "$GITHUB_WORKSPACE/tools/iolab-launcher/bin/iolbox-darwin-arm64" \
  276:             --payload "$GITHUB_WORKSPACE/$PAYLOAD" \
  277:             --payload-sha256 "$PAYLOAD_SHA256" \
  278:             --version "$VERSION" \
  279:             --output "$GITHUB_WORKSPACE/iolbox-macos-arm64.tar.gz" \
  280:             --source-date-epoch "$SOURCE_DATE_EPOCH"
  281: 
  282:       - name: Verify archive layout and reproducibility
  283:         env:
  284:           VERSION: ${{ steps.version.outputs.value }}
  285:           SOURCE_DATE_EPOCH: ${{ steps.version.outputs.source-date-epoch }}
  286:           PAYLOAD: ${{ steps.payload.outputs.path }}
  287:           PAYLOAD_SHA256: ${{ steps.payload.outputs.sha256 }}
  288:         shell: bash
  289:         run: |
  290:           set -euo pipefail
  291:           bash packaging/macos/tests/release-layout-test.sh \
  292:             --archive "$GITHUB_WORKSPACE/iolbox-macos-arm64.tar.gz" \
  293:             --launcher "$GITHUB_WORKSPACE/tools/iolab-launcher/bin/iolbox-darwin-arm64" \
  294:             --payload "$GITHUB_WORKSPACE/$PAYLOAD" \
  295:             --payload-sha256 "$PAYLOAD_SHA256" \
  296:             --version "$VERSION" \
  297:             --source-date-epoch "$SOURCE_DATE_EPOCH"
  298:           echo "--- tar listing ---"
  299:           tar -tzf "$GITHUB_WORKSPACE/iolbox-macos-arm64.tar.gz"
  300:           echo "--- internal checksums ---"
  301:           work="$(mktemp -d)"
  302:           trap 'rm -rf "$work"' EXIT
  303:           tar -xzf "$GITHUB_WORKSPACE/iolbox-macos-arm64.tar.gz" -C "$work"
  304:           ( cd "$work/iolbox-macos-arm64" && sha256sum -c SHA256SUMS )
  305:           echo "--- launcher file ---"
  306:           file "$work/iolbox-macos-arm64/iolbox"
  307:           echo "--- archive hash ---"
  308:           sha256sum "$GITHUB_WORKSPACE/iolbox-macos-arm64.tar.gz"
  309: 
  310:       - uses: actions/upload-artifact@v4
  311:         with:
  312:           name: iolbox-macos
  313:           path: |
  314:             iolbox-macos-arm64.tar.gz
  315:             iolbox-macos-arm64.tar.gz.sha256
  316: 
  317:   # ---------------------------------------------------------------------
  318:   # Release: only on an actual tag push (workflow_dispatch runs stop after
  319:   # producing/testing artifacts ƒ?" no draft is created). Published as a
  320:   # DRAFT, never live, because three artifacts CI cannot build (vmdk/vmx,
  321:   # OVA, qcow2 ƒ?" all need loop devices/chroot/grub on a root-capable
  322:   # builder) plus the Windows launcher's qemu+disk bundle must be attached
  323:   # by hand before this is fit to publish.
  324:   # ---------------------------------------------------------------------
  325:   release:
  326:     name: Draft GitHub Release
  327:     needs: [build-windows, build-linux, build-macos]
  328:     runs-on: ubuntu-latest
  329:     if: startsWith(github.ref, 'refs/tags/')
  330:     steps:
  331:       - uses: actions/download-artifact@v4
  332: 
  333:       - name: Publish draft GitHub Release
  334:         uses: softprops/action-gh-release@v2
  335:         with:
  336:           draft: true
  337:           files: |
  338:             iolbox-windows/**/*
  339:             iolbox-linux/**/*
  340:             iolbox-macos/**/*
  341:           body: |
  342:             iolbox ${{ github.ref_name }}
  343: 
  344:             **Contains no Cisco software.** Supply your own IOL/IOU images
  345:             and hold the appropriate licenses for them.
  346: 
  347:             ---
  348: 
  349:             **THIS DRAFT IS INCOMPLETE.** CI only builds what it can build
  350:             without loop devices/chroot/grub or a real QEMU disk. Before
  351:             publishing, attach the following ƒ?" built by hand on the private
  352:             root-capable builder ƒ?" to this draft:
  353: 
  354:             - `iolbox-appliance-${{ github.ref_name }}.vmdk` + `.vmx` (VMware Workstation/Player drop-in appliance)
  355:             - `iolbox-appliance-${{ github.ref_name }}.ova` (ESXi / VirtualBox / generic OVF import)
  356:             - `iolbox-disk-${{ github.ref_name }}.qcow2` + the Windows launcher bundle zip (qemu/ + iolbox-launcher.exe + iolbox-disk.qcow2)
  357: 
  358:             Everything else ƒ?" `iolbox-rootfs.tar` (WSL2), `iolbox-ct-${{ github.ref_name }}.tar.zst` (Proxmox LXC), `iolbox-server-${{ github.ref_name }}.tar.gz` (native systemd), `iolbox-launcher.exe`, `capture-helper.exe`, `SHA256SUMS-ci.txt` ƒ?" is already attached by this workflow.
  359: 
  360:             **Apple Silicon macOS (Lima):** the Mac archive requires user-installed Lima and qualifies Apple Silicon macOS with the Debian 13/trixie default profile and Ubuntu 22.04/Jammy compatibility profile. The default guest/kernel is Debian 13 with the pinned 6.12.101+deb13-cloud-arm64 kernel; Jammy is pinned to the qualified 5.15 line. The existing amd64 supervisor/VPCS and **x86_64 IOL only** run through Rosetta; i386/i86bi and arm64-native IOL are unsupported. The archive is unsigned: verify its outer and internal SHA-256 files, inspect quarantine, and if the launcher is quarantined remove that attribute from the launcher only with `xattr -d com.apple.quarantine ./iolbox` before `./iolbox start`. GUI, console, and capture forwards are loopback-only and unauthenticated. No Cisco software is included.
  361: 
  362:             See [docs/INSTALL.md](https://github.com/${{ github.repository }}/blob/main/docs/INSTALL.md) for which artifact matches your situation, and un-draft only once the manually-built artifacts above are attached.
  363:           generate_release_notes: true
===== packaging/macos/pack-release.sh =====
    1: #!/usr/bin/env bash
    2: # Build the unsigned Apple Silicon release archive from explicit inputs.
    3: #
    4: # This script deliberately has no CI-workspace discovery. The caller supplies
    5: # the Darwin launcher, the exact native payload, the trusted payload digest,
    6: # the release/ref version, output path, and SOURCE_DATE_EPOCH.
    7: set -euo pipefail
    8: 
    9: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
   10: REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
   11: MANIFEST="$SCRIPT_DIR/release-manifest.txt"
   12: ARCHIVE_ROOT_NAME="iolbox-macos-arm64"
   13: 
   14: LAUNCHER=""
   15: PAYLOAD=""
   16: PAYLOAD_SHA256=""
   17: VERSION=""
   18: OUTPUT=""
   19: SOURCE_DATE_EPOCH=""
   20: 
   21: usage() {
   22:     cat <<'EOF'
   23: Usage: packaging/macos/pack-release.sh \
   24:   --launcher PATH --payload PATH --payload-sha256 SHA256 \
   25:   --version VERSION --output PATH --source-date-epoch EPOCH
   26: 
   27: All six inputs are required. The payload and launcher are never discovered by
   28: searching a build directory; the caller must identify and authenticate them.
   29: EOF
   30: }
   31: 
   32: die() {
   33:     echo "pack-release: $*" >&2
   34:     exit 1
   35: }
   36: 
   37: while [ "$#" -gt 0 ]; do
   38:     case "$1" in
   39:         --launcher) [ "$#" -ge 2 ] || die "--launcher needs a value"; LAUNCHER="$2"; shift 2 ;;
   40:         --payload) [ "$#" -ge 2 ] || die "--payload needs a value"; PAYLOAD="$2"; shift 2 ;;
   41:         --payload-sha256) [ "$#" -ge 2 ] || die "--payload-sha256 needs a value"; PAYLOAD_SHA256="$2"; shift 2 ;;
   42:         --version) [ "$#" -ge 2 ] || die "--version needs a value"; VERSION="$2"; shift 2 ;;
   43:         --output) [ "$#" -ge 2 ] || die "--output needs a value"; OUTPUT="$2"; shift 2 ;;
   44:         --source-date-epoch) [ "$#" -ge 2 ] || die "--source-date-epoch needs a value"; SOURCE_DATE_EPOCH="$2"; shift 2 ;;
   45:         -h|--help) usage; exit 0 ;;
   46:         *) die "unknown option: $1" ;;
   47:     esac
   48: done
   49: 
   50: [ -n "$LAUNCHER" ] || die "--launcher is required"
   51: [ -n "$PAYLOAD" ] || die "--payload is required"
   52: [ -n "$PAYLOAD_SHA256" ] || die "--payload-sha256 is required"
   53: [ -n "$VERSION" ] || die "--version is required"
   54: [ -n "$OUTPUT" ] || die "--output is required"
   55: [ -n "$SOURCE_DATE_EPOCH" ] || die "--source-date-epoch is required"
   56: 
   57: [[ "$PAYLOAD_SHA256" =~ ^[0-9A-Fa-f]{64}$ ]] || die "--payload-sha256 must be 64 hexadecimal characters"
   58: [[ "$VERSION" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "version contains unsupported filename characters: $VERSION"
   59: [[ "$SOURCE_DATE_EPOCH" =~ ^[0-9]+$ ]] || die "--source-date-epoch must be a non-negative integer"
   60: 
   61: LAUNCHER="$(cd "$(dirname "$LAUNCHER")" && pwd)/$(basename "$LAUNCHER")"
   62: PAYLOAD="$(cd "$(dirname "$PAYLOAD")" && pwd)/$(basename "$PAYLOAD")"
   63: OUTPUT="$(cd "$(dirname "$OUTPUT")" 2>/dev/null || { mkdir -p "$(dirname "$OUTPUT")"; cd "$(dirname "$OUTPUT")"; } && pwd)/$(basename "$OUTPUT")"
   64: 
   65: [ -f "$LAUNCHER" ] && [ ! -L "$LAUNCHER" ] || die "launcher must be a regular non-symlink file: $LAUNCHER"
   66: [ -f "$PAYLOAD" ] && [ ! -L "$PAYLOAD" ] || die "payload must be a regular non-symlink file: $PAYLOAD"
   67: command -v file >/dev/null 2>&1 || die "file is required to verify the Darwin launcher"
   68: command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required on the Ubuntu packer"
   69: command -v tar >/dev/null 2>&1 || die "GNU tar is required"
   70: command -v gzip >/dev/null 2>&1 || die "gzip is required"
   71: tar --version | grep -F 'GNU tar' >/dev/null || die "tar is not GNU tar"
   72: 
   73: EXPECTED_PAYLOAD="iolbox-server-${VERSION}.tar.gz"
   74: [ "$(basename "$PAYLOAD")" = "$EXPECTED_PAYLOAD" ] || die "payload basename is $(basename "$PAYLOAD"), expected $EXPECTED_PAYLOAD"
   75: [ "$(basename "$OUTPUT")" = "${ARCHIVE_ROOT_NAME}.tar.gz" ] || die "output must be named ${ARCHIVE_ROOT_NAME}.tar.gz"
   76: 
   77: LAUNCHER_FILE="$(file -b "$LAUNCHER")"
   78: case "$LAUNCHER_FILE" in
   79:     *"Mach-O 64-bit"*"arm64"*) ;;
   80:     *) die "launcher is not a Mach-O arm64 executable: $LAUNCHER_FILE" ;;
   81: esac
   82: 
   83: ACTUAL_PAYLOAD="$(sha256sum "$PAYLOAD" | awk '{print tolower($1)}')"
   84: [ "$ACTUAL_PAYLOAD" = "$(printf '%s' "$PAYLOAD_SHA256" | tr '[:upper:]' '[:lower:]')" ] || die "payload hash does not match trusted --payload-sha256 (actual $ACTUAL_PAYLOAD)"
   85: 
   86: [ -f "$MANIFEST" ] && [ ! -L "$MANIFEST" ] || die "release manifest is missing or is a symlink: $MANIFEST"
   87: 
   88: declare -a MANIFEST_SOURCES=()
   89: declare -a MANIFEST_DESTS=()
   90: while IFS='|' read -r source dest extra || [ -n "${source:-}" ]; do
   91:     case "${source:-}" in
   92:         ""|\#*) continue ;;
   93:     esac
   94:     [ -n "${dest:-}" ] && [ -z "${extra:-}" ] || die "manifest line must be source|destination: $source|$dest${extra:+|$extra}"
   95:     case "$source" in
   96:         /*|../*|*/../*|.|*/./*) die "manifest source escapes repository: $source" ;;
   97:     esac
   98:     case "$dest" in
   99:         ""|/*|../*|*/../*|.|*/./*) die "manifest destination is unsafe: $dest" ;;
  100:     esac
  101:     source_path="$REPO_ROOT/$source"
  102:     [ -f "$source_path" ] && [ ! -L "$source_path" ] || die "manifest source is not a regular non-symlink file: $source"
  103:     for existing in "${MANIFEST_DESTS[@]}"; do
  104:         [ "$existing" != "$dest" ] || die "manifest destination appears more than once: $dest"
  105:     done
  106:     MANIFEST_SOURCES+=("$source")
  107:     MANIFEST_DESTS+=("$dest")
  108: done < "$MANIFEST"
  109: 
  110: [ "${#MANIFEST_SOURCES[@]}" -eq 18 ] || die "manifest has ${#MANIFEST_SOURCES[@]} entries, expected 18"
  111: 
  112: for required_dest in \
  113:     README.md LICENSE notices/THIRD_PARTY.md \
  114:     lima/profiles.env lima/iolbox-trixie.yaml lima/iolbox-jammy.yaml lima/iolbox-bookworm.yaml \
  115:     lima/pinned-image-debian13.env lima/pinned-image.env lima/pinned-image-debian12.env \
  116:     guest/lib.sh guest/10-multiarch-debian.sh guest/10-multiarch.sh \
  117:     guest/20-kernel-hold-debian.sh guest/20-kernel-hold.sh guest/30-canary.sh \
  118:     guest/40-install-payload.sh guest/50-verify.sh; do
  119:     found=0
  120:     for dest in "${MANIFEST_DESTS[@]}"; do [ "$dest" = "$required_dest" ] && found=1; done
  121:     [ "$found" -eq 1 ] || die "manifest is missing required destination: $required_dest"
  122: done
  123: 
  124: OUTPUT_DIR="$(dirname "$OUTPUT")"
  125: mkdir -p "$OUTPUT_DIR"
  126: WORK="$(mktemp -d "${TMPDIR:-/tmp}/iolbox-macos-pack.XXXXXX")"
  127: cleanup() { rm -rf "$WORK"; }
  128: trap cleanup EXIT
  129: 
  130: copy_manifest_into_stage() {
  131:     local stage="$1"
  132:     local source dest source_path dest_path
  133:     mkdir -p "$stage/$ARCHIVE_ROOT_NAME"
  134:     while IFS='|' read -r source dest extra || [ -n "${source:-}" ]; do
  135:         case "${source:-}" in
  136:             ""|\#*) continue ;;
  137:         esac
  138:         source_path="$REPO_ROOT/$source"
  139:         dest_path="$stage/$ARCHIVE_ROOT_NAME/$dest"
  140:         mkdir -p "$(dirname "$dest_path")"
  141:         if [ "$dest" = "README.md" ]; then
  142:             sed "s|@VERSION@|$VERSION|g" "$source_path" > "$dest_path"
  143:         else
  144:             cp -- "$source_path" "$dest_path"
  145:         fi
  146:         chmod 0644 "$dest_path"
  147:     done < "$MANIFEST"
  148:     cp -- "$LAUNCHER" "$stage/$ARCHIVE_ROOT_NAME/iolbox"
  149:     chmod 0755 "$stage/$ARCHIVE_ROOT_NAME/iolbox"
  150:     cp -- "$PAYLOAD" "$stage/$ARCHIVE_ROOT_NAME/$EXPECTED_PAYLOAD"
  151:     chmod 0644 "$stage/$ARCHIVE_ROOT_NAME/$EXPECTED_PAYLOAD"
  152:     find "$stage/$ARCHIVE_ROOT_NAME" -type d -exec chmod 0755 {} +
  153: }
  154: 
  155: verify_stage_tree() {
  156:     local stage="$1"
  157:     local actual="$stage/actual-members.txt"
  158:     local expected="$stage/expected-members.txt"
  159:     ( cd "$stage" && LC_ALL=C find "$ARCHIVE_ROOT_NAME" -print | LC_ALL=C sort > "$actual" )
  160:     cat > "$expected" <<EOF
  161: $ARCHIVE_ROOT_NAME
  162: $ARCHIVE_ROOT_NAME/LICENSE
  163: $ARCHIVE_ROOT_NAME/README.md
  164: $ARCHIVE_ROOT_NAME/SHA256SUMS
  165: $ARCHIVE_ROOT_NAME/guest
  166: $ARCHIVE_ROOT_NAME/guest/10-multiarch-debian.sh
  167: $ARCHIVE_ROOT_NAME/guest/10-multiarch.sh
  168: $ARCHIVE_ROOT_NAME/guest/20-kernel-hold-debian.sh
  169: $ARCHIVE_ROOT_NAME/guest/20-kernel-hold.sh
  170: $ARCHIVE_ROOT_NAME/guest/30-canary.sh
  171: $ARCHIVE_ROOT_NAME/guest/40-install-payload.sh
  172: $ARCHIVE_ROOT_NAME/guest/50-verify.sh
  173: $ARCHIVE_ROOT_NAME/guest/lib.sh
  174: $ARCHIVE_ROOT_NAME/iolbox
  175: $ARCHIVE_ROOT_NAME/$EXPECTED_PAYLOAD
  176: $ARCHIVE_ROOT_NAME/lima
  177: $ARCHIVE_ROOT_NAME/lima/iolbox-bookworm.yaml
  178: $ARCHIVE_ROOT_NAME/lima/iolbox-jammy.yaml
  179: $ARCHIVE_ROOT_NAME/lima/iolbox-trixie.yaml
  180: $ARCHIVE_ROOT_NAME/lima/pinned-image-debian12.env
  181: $ARCHIVE_ROOT_NAME/lima/pinned-image-debian13.env
  182: $ARCHIVE_ROOT_NAME/lima/pinned-image.env
  183: $ARCHIVE_ROOT_NAME/lima/profiles.env
  184: $ARCHIVE_ROOT_NAME/notices
  185: $ARCHIVE_ROOT_NAME/notices/THIRD_PARTY.md
  186: EOF
  187:     if ! cmp -s "$actual" "$expected"; then
  188:         echo "expected staged members:" >&2
  189:         cat "$expected" >&2
  190:         echo "actual staged members:" >&2
  191:         cat "$actual" >&2
  192:         die "staged member tree is not the exact M6 layout"
  193:     fi
  194: }
  195: 
  196: write_internal_checksums() {
  197:     local stage="$1"
  198:     local root="$stage/$ARCHIVE_ROOT_NAME"
  199:     local list="$stage/internal-members.txt"
  200:     ( cd "$root" && LC_ALL=C find . -type f ! -name SHA256SUMS -print | sed 's#^\./##' | LC_ALL=C sort > "$list" )
  201:     [ "$(wc -l < "$list" | tr -d ' ')" -eq 20 ] || die "staged file count is not 20 before SHA256SUMS"
  202:     ( cd "$root" && sha256sum $(cat "$list") > SHA256SUMS )
  203:     chmod 0644 "$root/SHA256SUMS"
  204: }
  205: 
  206: write_stage_members() {
  207:     local stage="$1"
  208:     ( cd "$stage" && LC_ALL=C find "$ARCHIVE_ROOT_NAME" -print | LC_ALL=C sort > stage-members.txt )
  209: }
  210: 
  211: pack_stage() {
  212:     local stage="$1"
  213:     local output="$2"
  214:     write_stage_members "$stage"
  215:     LC_ALL=C tar --create --format=pax --sort=name --owner=0 --group=0 --numeric-owner \
  216:         --mode='u+rwX,go+rX,go-w' --mtime="@${SOURCE_DATE_EPOCH}" \
  217:         --pax-option=delete=atime,delete=ctime --no-recursion \
  218:         -C "$stage" --files-from="$stage/stage-members.txt" | gzip -n > "$output"
  219: }
  220: 
  221: for n in 1 2; do
  222:     stage="$WORK/stage$n"
  223:     mkdir -p "$stage"
  224:     copy_manifest_into_stage "$stage"
  225:     write_internal_checksums "$stage"
  226:     verify_stage_tree "$stage"
  227:     pack_stage "$stage" "$WORK/archive$n.tar.gz"
  228: done
  229: 
  230: cmp -s "$WORK/archive1.tar.gz" "$WORK/archive2.tar.gz" || die "independent stage archives differ"
  231: HASH1="$(sha256sum "$WORK/archive1.tar.gz" | awk '{print $1}')"
  232: HASH2="$(sha256sum "$WORK/archive2.tar.gz" | awk '{print $1}')"
  233: [ "$HASH1" = "$HASH2" ] || die "independent stage hashes differ"
  234: cp -- "$WORK/archive1.tar.gz" "$OUTPUT"
  235: printf '%s  %s\n' "$HASH1" "$(basename "$OUTPUT")" > "$OUTPUT.sha256"
  236: chmod 0644 "$OUTPUT" "$OUTPUT.sha256"
  237: 
  238: echo "pack-release: launcher=$LAUNCHER_FILE"
  239: echo "pack-release: payload=$(basename "$PAYLOAD") sha256=$ACTUAL_PAYLOAD"
  240: echo "pack-release: source_date_epoch=$SOURCE_DATE_EPOCH"
  241: echo "pack-release: archive=$OUTPUT sha256=$HASH1"
  242: echo "pack-release: independent stages byte-identical (hash=$HASH1)"
===== packaging/macos/tests/release-layout-test.sh =====
    1: #!/usr/bin/env bash
    2: # Verify the exact M6 archive contract and rebuild it twice from independent
    3: # packer staging directories to prove deterministic bytes.
    4: set -euo pipefail
    5: 
    6: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    7: MACOS_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
    8: REPO_ROOT="$(cd "$MACOS_DIR/../.." && pwd)"
    9: PACKER="$MACOS_DIR/pack-release.sh"
   10: 
   11: ARCHIVE=""
   12: LAUNCHER=""
   13: PAYLOAD=""
   14: PAYLOAD_SHA256=""
   15: VERSION=""
   16: SOURCE_DATE_EPOCH=""
   17: 
   18: usage() {
   19:     cat <<'EOF'
   20: Usage: packaging/macos/tests/release-layout-test.sh \
   21:   --archive PATH --launcher PATH --payload PATH --payload-sha256 SHA256 \
   22:   --version VERSION --source-date-epoch EPOCH
   23: EOF
   24: }
   25: die() { echo "release-layout-test: $*" >&2; exit 1; }
   26: while [ "$#" -gt 0 ]; do
   27:     case "$1" in
   28:         --archive) ARCHIVE="$2"; shift 2 ;;
   29:         --launcher) LAUNCHER="$2"; shift 2 ;;
   30:         --payload) PAYLOAD="$2"; shift 2 ;;
   31:         --payload-sha256) PAYLOAD_SHA256="$2"; shift 2 ;;
   32:         --version) VERSION="$2"; shift 2 ;;
   33:         --source-date-epoch) SOURCE_DATE_EPOCH="$2"; shift 2 ;;
   34:         -h|--help) usage; exit 0 ;;
   35:         *) die "unknown option: $1" ;;
   36:     esac
   37: done
   38: for required in ARCHIVE LAUNCHER PAYLOAD PAYLOAD_SHA256 VERSION SOURCE_DATE_EPOCH; do
   39:     [ -n "${!required}" ] || die "--$(echo "$required" | tr '[:upper:]' '[:lower:]' | tr '_' '-') is required"
   40: done
   41: [ -f "$ARCHIVE" ] || die "archive does not exist: $ARCHIVE"
   42: [ "$(basename "$ARCHIVE")" = "iolbox-macos-arm64.tar.gz" ] || die "archive basename is not iolbox-macos-arm64.tar.gz"
   43: 
   44: TMP="$(mktemp -d "${TMPDIR:-/tmp}/iolbox-macos-layout.XXXXXX")"
   45: cleanup() { rm -rf "$TMP"; }
   46: trap cleanup EXIT
   47: 
   48: tar --version | grep -F 'GNU tar' >/dev/null || die "GNU tar is required"
   49: archive_dir="$(cd "$(dirname "$ARCHIVE")" && pwd)"
   50: archive_name="$(basename "$ARCHIVE")"
   51: ( cd "$archive_dir" && sha256sum -c "$archive_name.sha256" ) >/dev/null || die "outer checksum beside archive does not verify"
   52: 
   53: tar -tzf "$ARCHIVE" > "$TMP/raw-list.txt"
   54: sed 's#/$##' "$TMP/raw-list.txt" | LC_ALL=C sort > "$TMP/actual-list.txt"
   55: cat > "$TMP/expected-list.txt" <<EOF
   56: iolbox-macos-arm64
   57: iolbox-macos-arm64/LICENSE
   58: iolbox-macos-arm64/README.md
   59: iolbox-macos-arm64/SHA256SUMS
   60: iolbox-macos-arm64/guest
   61: iolbox-macos-arm64/guest/10-multiarch-debian.sh
   62: iolbox-macos-arm64/guest/10-multiarch.sh
   63: iolbox-macos-arm64/guest/20-kernel-hold-debian.sh
   64: iolbox-macos-arm64/guest/20-kernel-hold.sh
   65: iolbox-macos-arm64/guest/30-canary.sh
   66: iolbox-macos-arm64/guest/40-install-payload.sh
   67: iolbox-macos-arm64/guest/50-verify.sh
   68: iolbox-macos-arm64/guest/lib.sh
   69: iolbox-macos-arm64/iolbox
   70: iolbox-macos-arm64/iolbox-server-${VERSION}.tar.gz
   71: iolbox-macos-arm64/lima
   72: iolbox-macos-arm64/lima/iolbox-bookworm.yaml
   73: iolbox-macos-arm64/lima/iolbox-jammy.yaml
   74: iolbox-macos-arm64/lima/iolbox-trixie.yaml
   75: iolbox-macos-arm64/lima/pinned-image-debian12.env
   76: iolbox-macos-arm64/lima/pinned-image-debian13.env
   77: iolbox-macos-arm64/lima/pinned-image.env
   78: iolbox-macos-arm64/lima/profiles.env
   79: iolbox-macos-arm64/notices
   80: iolbox-macos-arm64/notices/THIRD_PARTY.md
   81: EOF
   82: if ! cmp -s "$TMP/actual-list.txt" "$TMP/expected-list.txt"; then
   83:     echo "expected archive members:" >&2; cat "$TMP/expected-list.txt" >&2
   84:     echo "actual archive members:" >&2; cat "$TMP/actual-list.txt" >&2
   85:     die "archive member set is not exact"
   86: fi
   87: 
   88: # The first character in GNU tar's verbose type flags must be directory or
   89: # regular file. This rejects symlinks, hard links, devices, FIFOs, and other
   90: # special nodes even if their names happen to be allowed.
   91: tar -tvzf "$ARCHIVE" > "$TMP/verbose-list.txt"
   92: while IFS= read -r line; do
   93:     [ -n "$line" ] || continue
   94:     type="${line:0:1}"
   95:     case "$type" in
   96:         d|-) ;;
   97:         *) die "archive contains a non-directory/non-regular member: $line" ;;
   98:     esac
   99: done < "$TMP/verbose-list.txt"
  100: if LC_ALL=C grep -aE -i 'SCHILY\.(xattr|acl)|LIBARCHIVE\.(xattr|acl)|GNU\.sparse|com\.apple\.(ResourceFork|FinderInfo)|PaxHeader' "$ARCHIVE" >/dev/null; then
  101:     die "archive contains xattr/ACL/resource-fork pax metadata"
  102: fi
  103: if LC_ALL=C grep -E -i '(^|/)(\._[^/]*|\.DS_Store|.*namedfork.*|.*resourcefork.*|.*cisco.*|.*\.i86bi[^/]*|.*\.iol[^/]*)$|(^|/)tests(/|$)|iolbox-mac\.sh|pack-release\.sh|release-manifest\.txt' "$TMP/actual-list.txt" >/dev/null; then
  104:     die "archive contains a forbidden AppleDouble/resource/Cisco/test member"
  105: fi
  106: 
  107: mkdir "$TMP/extract"
  108: tar -xzf "$ARCHIVE" -C "$TMP/extract"
  109: ROOT="$TMP/extract/iolbox-macos-arm64"
  110: [ "$(stat -c '%a' "$ROOT")" = 755 ] || die "archive root mode is not 0755"
  111: while IFS= read -r path; do
  112:     [ -n "$path" ] || continue
  113:     full="$TMP/extract/$path"
  114:     [ -e "$full" ] || die "listed member did not extract: $path"
  115:     if [ -d "$full" ]; then
  116:         [ "$(stat -c '%a' "$full")" = 755 ] || die "directory mode is not 0755: $path"
  117:     else
  118:         expected_mode=644
  119:         [ "$path" = "iolbox-macos-arm64/iolbox" ] && expected_mode=755
  120:         [ "$(stat -c '%a' "$full")" = "$expected_mode" ] || die "file mode is not $expected_mode: $path"
  121:     fi
  122: done < "$TMP/actual-list.txt"
  123: 
  124: ( cd "$ROOT" && sha256sum -c SHA256SUMS ) || die "internal checksums do not verify"
  125: [ "$(wc -l < "$ROOT/SHA256SUMS" | tr -d ' ')" = 20 ] || die "internal checksum file does not cover exactly 20 files"
  126: 
  127: file_launcher="$(file -b "$ROOT/iolbox")"
  128: case "$file_launcher" in
  129:     *"Mach-O 64-bit"*"arm64"*) ;;
  130:     *) die "extracted launcher is not Mach-O arm64: $file_launcher" ;;
  131: esac
  132: payload_path="$ROOT/iolbox-server-${VERSION}.tar.gz"
  133: [ -f "$payload_path" ] || die "expected native payload is missing"
  134: [ "$(sha256sum "$payload_path" | awk '{print tolower($1)}')" = "$(printf '%s' "$PAYLOAD_SHA256" | tr '[:upper:]' '[:lower:]')" ] || die "extracted payload is not the trusted build-linux payload"
  135: [ "$(find "$ROOT" -maxdepth 1 -type f -name 'iolbox-server-*.tar.gz' | wc -l | tr -d ' ')" = 1 ] || die "archive does not contain exactly one native payload"
  136: 
  137: while IFS='|' read -r source dest extra || [ -n "${source:-}" ]; do
  138:     case "${source:-}" in ""|\#*) continue ;; esac
  139:     [ -f "$REPO_ROOT/$source" ] && [ ! -L "$REPO_ROOT/$source" ] || die "manifest source is not regular/non-symlink: $source"
  140: done < "$MACOS_DIR/release-manifest.txt"
  141: 
  142: # Re-run the packer twice into fresh output paths. The packer itself creates
  143: # two independent stage directories for each invocation; comparing both fresh
  144: # outputs prevents a single lingering stage from masking nondeterminism.
  145: for n in 1 2; do
  146:     mkdir "$TMP/repro-$n"
  147:     bash "$PACKER" --launcher "$LAUNCHER" --payload "$PAYLOAD" \
  148:         --payload-sha256 "$PAYLOAD_SHA256" --version "$VERSION" \
  149:         --output "$TMP/repro-$n/iolbox-macos-arm64.tar.gz" \
  150:         --source-date-epoch "$SOURCE_DATE_EPOCH" > "$TMP/repro-$n.log"
  151: done
  152: cmp -s "$TMP/repro-1/iolbox-macos-arm64.tar.gz" "$TMP/repro-2/iolbox-macos-arm64.tar.gz" || die "independent reproducibility outputs differ"
  153: repro_hash_1="$(sha256sum "$TMP/repro-1/iolbox-macos-arm64.tar.gz" | awk '{print $1}')"
  154: repro_hash_2="$(sha256sum "$TMP/repro-2/iolbox-macos-arm64.tar.gz" | awk '{print $1}')"
  155: archive_hash="$(sha256sum "$ARCHIVE" | awk '{print $1}')"
  156: [ "$repro_hash_1" = "$repro_hash_2" ] || die "independent reproducibility hashes differ"
  157: [ "$repro_hash_1" = "$archive_hash" ] || die "checked archive differs from deterministic rebuild"
  158: 
  159: echo "release-layout-test: PASS"
  160: echo "release-layout-test: archive=$ARCHIVE sha256=$archive_hash"
  161: echo "release-layout-test: independent-stage/rebuild hash=$repro_hash_1"
  162: echo "release-layout-test: launcher=$file_launcher"
