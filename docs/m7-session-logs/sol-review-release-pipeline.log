  108: 
  109: type profileTable struct {
  110: 	Profiles       map[string]macOSProfile
  111: 	Qualifications []qualification
  112: 	Default        string
  113: }
  114: 
  115: func extractQuotedAssignment(data, name string) (string, error) {
  116: 	marker := name + "='"
  117: 	start := strings.Index(data, marker)
  118: 	if start < 0 {
  119: 		return "", fmt.Errorf("missing %s multiline assignment", name)
  120: 	}
  121: 	valueStart := start + len(marker)
  122: 	end := strings.IndexByte(data[valueStart:], '\'')
  123: 	if end < 0 {
  124: 		return "", fmt.Errorf("unterminated %s multiline assignment", name)
  125: 	}
  126: 	return data[valueStart : valueStart+end], nil
  127: }
  128: 
  129: func splitTableRows(value string, wantFields int, label string) ([][]string, error) {
  130: 	var rows [][]string
  131: 	for lineNo, line := range strings.Split(value, "\n") {
  132: 		line = strings.TrimSpace(line)
  133: 		if line == "" || strings.HasPrefix(line, "#") {
  134: 			continue
  135: 		}
  136: 		fields := strings.Split(line, "|")
  137: 		if len(fields) != wantFields {
  138: 			return nil, fmt.Errorf("%s row %d has %d fields, want %d", label, lineNo+1, len(fields), wantFields)
  139: 		}
  140: 		for i := range fields {
  141: 			fields[i] = strings.TrimSpace(fields[i])
  142: 		}
  143: 		rows = append(rows, fields)
  144: 	}
  145: 	return rows, nil
  146: }
  147: 
  148: // splitProfileRows tolerates the pre-Phase-4 9-field row shape (name|role|
  149: // guest_label|pin_env|yaml_template|multiarch_step|kernel_hold_step|
  150: // kernel_series|expected_uname_r) alongside the Phase-4 12-field shape that
  151: // appends canary_step|install_step|verify_step. A 9-field row is padded with
  152: // three empty trailing fields, which macOSProfile.canaryStep()/installStep()/
  153: // verifyStep() then resolve to the historical fixed filenames.
  154: func splitProfileRows(value, label string) ([][]string, error) {
  155: 	var rows [][]string
  156: 	for lineNo, line := range strings.Split(value, "\n") {
  157: 		line = strings.TrimSpace(line)
  158: 		if line == "" || strings.HasPrefix(line, "#") {
  159: 			continue
  160: 		}
  161: 		fields := strings.Split(line, "|")
  162: 		switch len(fields) {
  163: 		case 9:
  164: 			fields = append(fields, "", "", "")
  165: 		case 12:
  166: 			// already the Phase-4 shape
  167: 		default:
  168: 			return nil, fmt.Errorf("%s row %d has %d fields, want 9 or 12", label, lineNo+1, len(fields))
  169: 		}
  170: 		for i := range fields {
  171: 			fields[i] = strings.TrimSpace(fields[i])
  172: 		}
  173: 		rows = append(rows, fields)
  174: 	}
  175: 	return rows, nil
  176: }
  177: 
  178: func parseProfilesEnv(data string) (profileTable, error) {
  179: 	profilesText, err := extractQuotedAssignment(data, "IOLBOX_PROFILE_TABLE")
  180: 	if err != nil {
  181: 		return profileTable{}, err
  182: 	}
  183: 	qualText, err := extractQuotedAssignment(data, "IOLBOX_QUALIFICATION_TABLE")
  184: 	if err != nil {
  185: 		return profileTable{}, err
  186: 	}
  187: 	profileRows, err := splitProfileRows(profilesText, "profile")
  188: 	if err != nil {
  189: 		return profileTable{}, err
  190: 	}
  191: 	qualRows, err := splitTableRows(qualText, 6, "qualification")
  192: 	if err != nil {
  193: 		return profileTable{}, err
  194: 	}
  195: 
  196: 	table := profileTable{Profiles: make(map[string]macOSProfile)}
  197: 	defaults := 0
  198: 	for _, row := range profileRows {
  199: 		for i, field := range row[:8] {
  200: 			if field == "" {
  201: 				return profileTable{}, fmt.Errorf("profile %q field %d is empty", row[0], i+1)
  202: 			}
  203: 		}
  204: 		if _, exists := table.Profiles[row[0]]; exists {
  205: 			return profileTable{}, fmt.Errorf("duplicate profile %q", row[0])
  206: 		}
  207: 		p := macOSProfile{
  208: 			Name:           row[0],
  209: 			Role:           row[1],
  210: 			GuestLabel:     row[2],
  211: 			PinEnv:         row[3],
  212: 			YAMLTemplate:   row[4],
  213: 			MultiarchStep:  row[5],
  214: 			KernelHoldStep: row[6],
  215: 			KernelSeries:   row[7],
  216: 			ExpectedUnameR: row[8],
  217: 			CanaryStep:     row[9],
  218: 			InstallStep:    row[10],
  219: 			VerifyStep:     row[11],
  220: 		}
  221: 		if p.Role == "DEFAULT" {
  222: 			defaults++
  223: 			table.Default = p.Name
  224: 		}
  225: 		table.Profiles[p.Name] = p
  226: 	}
  227: 	if defaults != 1 {
  228: 		return profileTable{}, fmt.Errorf("profile table must contain exactly one DEFAULT row (found %d)", defaults)
  229: 	}
  230: 	for _, row := range qualRows {
  231: 		for i, field := range row {
  232: 			if field == "" {
  233: 				return profileTable{}, fmt.Errorf("qualification row for %q field %d is empty", row[0], i+1)
  234: 			}
  235: 		}
  236: 		if _, ok := table.Profiles[row[0]]; !ok {
  237: 			return profileTable{}, fmt.Errorf("qualification references unknown profile %q", row[0])
  238: 		}
  239: 		table.Qualifications = append(table.Qualifications, qualification{
  240: 			Profile: row[0], Product: row[1], Build: row[2], Verdict: row[3], Status: row[4], Evidence: row[5],
  241: 		})
  242: 	}
  243: 	return table, nil
  244: }
  245: 
  246: func qualificationFor(table profileTable, profile, product, build string) qualification {
  247: 	for _, q := range table.Qualifications {
  248: 		if q.Profile == profile && q.Product == product && q.Build == build {
  249: 			return q
  250: 		}
  251: 	}
  252: 	return qualification{}
  253: }
  254: 
  255: func parsePinEnv(data string) (map[string]string, error) {
  256: 	values := make(map[string]string)
  257: 	for lineNo, line := range strings.Split(data, "\n") {
  258: 		line = strings.TrimSpace(line)
  259: 		if line == "" || strings.HasPrefix(line, "#") {
  260: 			continue
  261: 		}
  262: 		parts := strings.SplitN(line, "=", 2)
  263: 		if len(parts) != 2 || strings.TrimSpace(parts[0]) == "" {
  264: 			return nil, fmt.Errorf("pin env line %d is not KEY=VALUE", lineNo+1)
  265: 		}
  266: 		key := strings.TrimSpace(parts[0])
  267: 		value := strings.Trim(strings.TrimSpace(parts[1]), `"'`)
  268: 		values[key] = value
  269: 	}
  270: 	return values, nil
  271: }
  272: 
  273: var digestPattern = regexp.MustCompile(`^(sha256|sha512):([0-9a-fA-F]+)$`)
  274: 
  275: func validatePin(values map[string]string, pinPath string) (map[string]string, error) {
  276: 	url := values["IOLBOX_IMAGE_URL"]
  277: 	if !strings.HasPrefix(url, "https://") {
  278: 		return nil, codedError(exitUsage, "invalid or missing pinned image URL in %s", pinPath)
  279: 	}
  280: 	digest := values["IOLBOX_IMAGE_DIGEST"]
  281: 	if digest == "PIN-ME" {
  282: 		return nil, codedError(exitPreflight, "refusing to provision an unpinned image from %s", pinPath)
  283: 	}
  284: 	match := digestPattern.FindStringSubmatch(digest)
  285: 	if match == nil || (match[1] == "sha256" && len(match[2]) != 64) || (match[1] == "sha512" && len(match[2]) != 128) {
  286: 		return nil, codedError(exitUsage, "invalid algorithm-qualified image digest in %s", pinPath)
  287: 	}
  288: 	byteText := values["IOLBOX_IMAGE_BYTES"]
  289: 	imageBytes, err := strconv.ParseInt(byteText, 10, 64)
  290: 	if err != nil || imageBytes < 0 {
  291: 		return nil, codedError(exitUsage, "image byte count must be decimal in %s", pinPath)
  292: 	}
  293: 	for _, key := range []string{"IOLBOX_CPUS", "IOLBOX_MEMORY", "IOLBOX_DISK"} {
  294: 		if strings.TrimSpace(values[key]) == "" {
  295: 			return nil, codedError(exitUsage, "missing %s in %s", key, pinPath)
  296: 		}
  297: 	}
  298: 	return values, nil
  299: }
  300: 
  301: func loadMacOSProfile(assetRoot, selected string) (profileTable, macOSProfile, error) {
  302: 	profilePath := filepath.Join(assetRoot, "lima", "profiles.env")
  303: 	data, err := os.ReadFile(profilePath)
  304: 	if err != nil {
  305: 		return profileTable{}, macOSProfile{}, codedError(exitUsage, "read profile table: %v", err)
  306: 	}
  307: 	table, err := parseProfilesEnv(string(data))
  308: 	if err != nil {
  309: 		return profileTable{}, macOSProfile{}, codedError(exitUsage, "parse profile table: %v", err)
  310: 	}
  311: 	if selected == "" {
  312: 		selected = table.Default
  313: 	}
  314: 	p, ok := table.Profiles[selected]
  315: 	if !ok {
  316: 		return profileTable{}, macOSProfile{}, codedError(exitUsage, "unknown profile %q", selected)
  317: 	}
  318: 	p.AssetRoot = assetRoot
  319: 	p.PinPath = filepath.Join(assetRoot, "lima", p.PinEnv)
  320: 	p.TemplatePath = filepath.Join(assetRoot, "lima", p.YAMLTemplate)
  321: 	p.GuestDir = filepath.Join(assetRoot, "guest")
  322: 	pinData, err := os.ReadFile(p.PinPath)
  323: 	if err != nil {
  324: 		return profileTable{}, macOSProfile{}, codedError(exitUsage, "read pin file: %v", err)
  325: 	}
  326: 	values, err := validatePinMustKeepValues(string(pinData), p.PinPath)
  327: 	if err != nil {
  328: 		return profileTable{}, macOSProfile{}, err
  329: 	}
  330: 	p.ImageURL = values["IOLBOX_IMAGE_URL"]
  331: 	p.ImageDigest = values["IOLBOX_IMAGE_DIGEST"]
  332: 	p.ImageBytes, _ = strconv.ParseInt(values["IOLBOX_IMAGE_BYTES"], 10, 64)
  333: 	p.CPUs = values["IOLBOX_CPUS"]
  334: 	p.Memory = values["IOLBOX_MEMORY"]
  335: 	p.Disk = values["IOLBOX_DISK"]
  336: 	for _, path := range []string{p.TemplatePath, p.GuestDir, filepath.Join(p.GuestDir, "lib.sh"), filepath.Join(p.GuestDir, p.MultiarchStep), filepath.Join(p.GuestDir, p.KernelHoldStep), filepath.Join(p.GuestDir, p.canaryStep()), filepath.Join(p.GuestDir, p.installStep()), filepath.Join(p.GuestDir, p.verifyStep())} {
  337: 		if _, err := os.Stat(path); err != nil {
  338: 			return profileTable{}, macOSProfile{}, codedError(exitUsage, "profile asset is missing: %s", path)
  339: 		}
  340: 	}
  341: 	return table, p, nil
  342: }
  343: 
  344: // loadProfileTableOnly parses profiles.env without validating any single
  345: // profile's pin/guest assets. resolveProfileSelection needs the table (row
  346: // names, DEFAULT) before it knows which row it is going to select; the
  347: // selected row's pin/guest assets are validated afterwards by the normal
  348: // loadMacOSProfile call.
  349: func loadProfileTableOnly(assetRoot string) (profileTable, error) {
  350: 	profilePath := filepath.Join(assetRoot, "lima", "profiles.env")
  351: 	data, err := os.ReadFile(profilePath)
  352: 	if err != nil {
  353: 		return profileTable{}, codedError(exitUsage, "read profile table: %v", err)
  354: 	}
  355: 	table, err := parseProfilesEnv(string(data))
  356: 	if err != nil {
  357: 		return profileTable{}, codedError(exitUsage, "parse profile table: %v", err)
  358: 	}
  359: 	return table, nil
  360: }
  361: 
  362: func validatePinMustKeepValues(data, pinPath string) (map[string]string, error) {
  363: 	values, err := parsePinEnv(data)
  364: 	if err != nil {
  365: 		return nil, codedError(exitUsage, "parse pin file %s: %v", pinPath, err)
  366: 	}
  367: 	return validatePin(values, pinPath)
  368: }
