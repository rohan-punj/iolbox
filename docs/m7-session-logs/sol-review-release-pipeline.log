  272: 		r.record("digests", false, "native-arm64 row missing from profiles.env")
  273: 	case profile.ImageDigest != "" && profile.ImageURL != "":
  274: 		r.record("digests", true, "image digest "+profile.ImageDigest)
  275: 	case assetRoot == "" || profile.PinEnv == "":
  276: 		r.record("digests", false, "native-arm64 profile is missing a pinned image URL/digest")
