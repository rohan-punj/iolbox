  164: // nativePreflightResult is the non-mutating, fail-closed readiness verdict
  165: // for native-arm64. Every check is read-only: no VM is created, started, or
  166: // modified, and no host state is written by running preflight itself.
  167: type nativePreflightResult struct {
  168: 	OK      bool
  169: 	Reason  string // first failing check's explanation, empty when OK
  170: 	Checks  map[string]string
  171: 	// order keeps Checks' human-readable rendering deterministic.
  172: 	order []string
  173: }
  174: 
  175: func (r *nativePreflightResult) record(name string, ok bool, detail string) {
  176: 	if r.Checks == nil {
  177: 		r.Checks = make(map[string]string)
  178: 	}
  179: 	status := "PASS"
  180: 	if !ok {
  181: 		status = "FAIL"
  182: 		if r.OK { // first failure sets Reason/OK; keep evaluating remaining checks for a complete report
  183: 			r.Reason = name + ": " + detail
  184: 		}
  185: 		r.OK = false
  186: 	}
  187: 	r.Checks[name] = status + " (" + detail + ")"
  188: 	r.order = append(r.order, name)
  189: }
  190: 
  191: // String renders every check in evaluation order, PASS or FAIL, for
  192: // status/diagnose truthfulness (plan section 10 item 5).
  193: func (r nativePreflightResult) String() string {
  194: 	var b strings.Builder
  195: 	for _, name := range r.order {
  196: 		fmt.Fprintf(&b, "%s=%s\n", name, r.Checks[name])
  197: 	}
  198: 	return b.String()
  199: }
