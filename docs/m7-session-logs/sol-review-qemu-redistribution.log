  102: func collectLimaInfo(ctx context.Context, path string, runner commandRunner) limaInfo {
  103: 	if runner == nil {
  104: 		runner = execRunner{}
  105: 	}
  106: 	info := limaInfo{Path: path}
  107: 	output, err := runner.Run(ctx, path, "--version")
  108: 	info.RawVersion = string(output)
  109: 	info.Version = parseLimaVersion(info.RawVersion)
  110: 	if err != nil {
  111: 		info.VersionErr = err
  112: 	}
  113: 	return info
  114: }
