   53: func isExecutable(path string) bool {
   54: 	st, err := os.Stat(path)
   55: 	if err != nil || st.IsDir() {
   56: 		return false
   57: 	}
   58: 	if runtime.GOOS == "windows" {
   59: 		return true
   60: 	}
   61: 	return st.Mode()&0o111 != 0
   62: }
