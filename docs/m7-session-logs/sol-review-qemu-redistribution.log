  417: type darwinStopControlFactory func() (controlClient, func(), error)
  418: 
  419: // runDarwinStop performs the mandatory host sync while the guest is still
  420: // running. A sync failure returns before stopMachine, leaving the Lima
  421: // instance available for recovery and retry.
  422: func runDarwinStop(ctx context.Context, l *limaClient, machine, state string, config darwinSyncConfig, timeout time.Duration, connect darwinStopControlFactory) error {
  423: 	if strings.EqualFold(state, "running") && !config.NoSync {
  424: 		if connect == nil {
  425: 			return codedError(exitVerify, "control-plane connection for stop sync is unavailable")
  426: 		}
  427: 		control, closeControl, err := connect()
  428: 		if err != nil {
  429: 			return codedError(exitVerify, "control-plane connection for stop sync failed: %v", err)
  430: 		}
  431: 		syncErr := syncDarwinBeforeStop(control, config)
  432: 		if closeControl != nil {
  433: 			closeControl()
  434: 		}
  435: 		if syncErr != nil {
  436: 			return codedError(exitVerify, "%v", syncErr)
  437: 		}
  438: 	}
  439: 	return stopMachine(ctx, l, machine, state, timeout)
  440: }
