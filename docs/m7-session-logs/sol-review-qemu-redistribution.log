FILE packaging/macos/guest/50-verify-native.sh
    1: #!/usr/bin/env bash
    2: # 50-verify-native.sh ƒ?" prove that the native-arm64 guest is ready and
    3: # persistent.
    4: #
    5: # This is the native-arm64 counterpart of 50-verify.sh. It is IDENTICAL to
    6: # it except for two truthfulness-critical differences: the loader canary
    7: # checked here is the native aarch64 loader (not the Rosetta amd64 one), and
    8: # the correlated hello check requires arch aarch64 (not x86_64) ƒ?" a native
    9: # guest whose supervisor still reports arch x86_64 has not proven anything
   10: # useful, even if every other check here passes.
   11: #
   12: # In order, this step:
   13: #   1. polls systemd and ss until the supervisor is active and the GUI socket
   14: #      is genuinely bound;
   15: #   2. polls GET / until its HTTP status is below 500;
   16: #   3. asserts the native loader canary, image registry, licence, and
   17: #      supervisor;
   18: #   4. prints a compact fact block; and
   19: #   5. optionally compares restart facts with /var/lib/iolbox/macos-verify.json.
   20: #
   21: # A systemd active state alone is insufficient because it can remain active
   22: # during a restart loop. The port and real HTTP request are separate gates.
   23: # There is intentionally no /api/health endpoint: the GUI root is the
   24: # readiness contract. --persistence records restart invariants and fails only
   25: # on a regression (kernel/host identity loss, licence loss, or cache shrink).
   26: set -euo pipefail
   27: 
   28: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
   29: # shellcheck source=lib.sh
   30: . "$SCRIPT_DIR/lib.sh"
   31: 
   32: # lib.sh unconditionally sets IOLBOX_LOADER to the amd64 loader path; this
   33: # profile's hard gate is the native aarch64 loader.
   34: IOLBOX_LOADER="${IOLBOX_NATIVE_LOADER:-/lib/ld-linux-aarch64.so.1}"
   35: 
   36: IOLBOX_VERIFY_TIMEOUT_SECONDS="${IOLBOX_VERIFY_TIMEOUT_SECONDS:-30}"
   37: IOLBOX_VERIFY_JSON="${IOLBOX_VERIFY_JSON:-/var/lib/iolbox/macos-verify.json}"
   38: IOLBOX_IMAGE_CACHE_FILE="${IOLBOX_IMAGE_CACHE_FILE:-/opt/iolbox/images/.image-cache.json}"
   39: IOLBOX_ROSETTA_BINFMT_FILE="${IOLBOX_ROSETTA_BINFMT_FILE:-/proc/sys/fs/binfmt_misc/rosetta}"
   40: IOLBOX_STRUCTURAL_GATE_JSON="${IOLBOX_STRUCTURAL_GATE_JSON:-/var/lib/iolbox/macos-structural-gate.json}"
   41: 
   42: usage() {
   43:     cat <<EOF
   44: Usage: $0 [--persistence]
   45: 
   46:   --persistence  compare restart invariants with
   47:                   $IOLBOX_VERIFY_JSON and update the record on success.
   48:   -h, --help      show this help.
   49: EOF
   50: }
   51: 
   52: port_is_bound() {
   53:     ss -ltn 2>/dev/null | awk -v suffix=":$IOLBOX_GUI_PORT" '
   54:         NR > 1 && length($4) >= length(suffix) && substr($4, length($4) - length(suffix) + 1) == suffix { found = 1 }
   55:         END { exit(found ? 0 : 1) }
   56:     '
   57: }
   58: 
   59: wait_for_service_and_port() {
   60:     local deadline=$((SECONDS + IOLBOX_VERIFY_TIMEOUT_SECONDS))
   61: 
