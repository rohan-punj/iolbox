  439: func guestStep(ctx context.Context, l *limaClient, machine, step string, env map[string]string) error {
  440: 	args := guestStepArgs(step, env)
  441: 	out, err := l.shell(ctx, machine, args...)
  442: 	if err != nil {
  443: 		code := childExitCode(err)
  444: 		if code >= 1 && code <= 5 {
  445: 			return &launcherError{code: code, err: fmt.Errorf("guest step %s exited %d: %s", step, code, strings.TrimSpace(string(out)))}
  446: 		}
  447: 		return codedError(exitUsage, "guest step %s failed: %v: %s", step, err, strings.TrimSpace(string(out)))
  448: 	}
  449: 	return nil
  450: }
  451: 
  452: func guestStepArgs(step string, env map[string]string, extra ...string) []string {
  453: 	args := []string{"sudo", "-E", "env"}
  454: 	keys := make([]string, 0, len(env))
  455: 	for key := range env {
  456: 		keys = append(keys, key)
  457: 	}
  458: 	sort.Strings(keys)
  459: 	for _, key := range keys {
  460: 		args = append(args, key+"="+env[key])
  461: 	}
  462: 	args = append(args, "bash", "/opt/iolbox-provision/"+step)
  463: 	return append(args, extra...)
  464: }
  465: 
  466: func childExitCode(err error) int {
  467: 	var exitErr *exec.ExitError
  468: 	if errors.As(err, &exitErr) {
  469: 		return exitErr.ExitCode()
  470: 	}
  471: 	return 1
  472: }
  473: 
  474: func atomicWriteFile(path string, data []byte, mode os.FileMode) error {
  475: 	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
  476: 		return err
  477: 	}
  478: 	f, err := os.CreateTemp(filepath.Dir(path), ".iolbox-atomic-*")
  479: 	if err != nil {
  480: 		return err
  481: 	}
  482: 	tmp := f.Name()
  483: 	defer os.Remove(tmp)
  484: 	if err := f.Chmod(mode); err != nil {
  485: 		_ = f.Close()
  486: 		return err
  487: 	}
  488: 	if _, err := io.Copy(f, bytes.NewReader(data)); err != nil {
  489: 		_ = f.Close()
  490: 		return err
  491: 	}
  492: 	if err := f.Close(); err != nil {
  493: 		return err
  494: 	}
  495: 	return os.Rename(tmp, path)
  496: }
  497: 
  498: type payloadCandidate struct {
  499: 	Path  string
  500: 	MTime time.Time
  501: }
  502: 
  503: // payloadARM64Suffix is the basename suffix runtime/pack-native.sh gives an
  504: // explicit `--arch arm64` build. The amd64 payload deliberately keeps the
  505: // historical untagged `iolbox-server-<version>.tar.gz` name, so architecture
  506: // is encoded in exactly one place: this suffix.
  507: const payloadARM64Suffix = "-linux-arm64.tar.gz"
  508: 
  509: // payloadMatchesProfile reports whether a payload basename belongs to the
  510: // given profile.
  511: //
  512: // This exists because the release archive now ships BOTH payloads side by
  513: // side, and the untagged amd64 name sorts AFTER the arm64 one: pack-release.sh
  514: // stamps every archive member with the same SOURCE_DATE_EPOCH, so on a clean
  515: // extraction the two mtimes tie and the lexicographic tie-break below decides
  516: // ƒ?" and '-' (0x2D) sorts before '.' (0x2E). Without this filter every Rosetta
  517: // user doing automatic discovery would deterministically be handed the arm64
  518: // payload.
  519: func payloadMatchesProfile(name, profileName string) bool {
  520: 	if !strings.HasPrefix(name, "iolbox-server-") || !strings.HasSuffix(name, ".tar.gz") {
  521: 		return false
  522: 	}
  523: 	if profileName == nativeProfileTableName {
  524: 		return strings.HasSuffix(name, payloadARM64Suffix)
  525: 	}
  526: 	// Rosetta profiles take the untagged historical name, and also accept an
  527: 	// explicitly-tagged amd64 build (pack-native.sh --arch amd64 can produce
  528: 	// one, even though CI does not).
  529: 	return !strings.HasSuffix(name, payloadARM64Suffix)
  530: }
  531: 
  532: // payloadArchLabel describes what a profile needs, for error and warning text.
  533: func payloadArchLabel(profileName string) string {
  534: 	if profileName == nativeProfileTableName {
  535: 		return "arm64"
  536: 	}
  537: 	return "amd64"
  538: }
  539: 
  540: func selectPayload(explicit, assetRoot, profileName string) (string, error) {
  541: 	if explicit != "" {
  542: 		st, err := os.Stat(explicit)
  543: 		if err != nil || !st.Mode().IsRegular() {
  544: 			return "", codedError(exitPreflight, "payload is not a regular file: %s", explicit)
  545: 		}
  546: 		// An explicit --tarball/IOLBOX_TARBALL always wins: every M4-M7
  547: 		// hardware harness points it at a hand-built tarball with an
  548: 		// arbitrary path, so a hard arch check here would break them all.
  549: 		// But a contradiction between the name and the resolved profile is
  550: 		// worth saying out loud, because staging an amd64 payload into a
  551: 		// native guest fails much later and much less legibly.
  552: 		if base := filepath.Base(explicit); !payloadMatchesProfile(base, profileName) {
  553: 			logf("iolbox-launcher: WARNING: explicit payload %q does not look like a %s payload, but profile %q needs one; using it anyway because it was named explicitly",
  554: 				base, payloadArchLabel(profileName), profileName)
  555: 		}
  556: 		return explicit, nil
  557: 	}
  558: 	roots := []string{assetRoot}
  559: 	if cwd, err := os.Getwd(); err == nil && cwd != assetRoot {
  560: 		roots = append(roots, cwd)
  561: 	}
  562: 	var candidates []payloadCandidate
  563: 	for _, root := range roots {
  564: 		entries, err := os.ReadDir(root)
  565: 		if err != nil {
  566: 			continue
  567: 		}
  568: 		for _, entry := range entries {
  569: 			if entry.IsDir() || !payloadMatchesProfile(entry.Name(), profileName) {
  570: 				continue
  571: 			}
  572: 			info, err := entry.Info()
  573: 			if err == nil && info.Mode().IsRegular() {
  574: 				candidates = append(candidates, payloadCandidate{Path: filepath.Join(root, entry.Name()), MTime: info.ModTime()})
  575: 			}
  576: 		}
  577: 	}
  578: 	if len(candidates) == 0 {
  579: 		if profileName == nativeProfileTableName {
  580: 			return "", codedError(exitPreflight, "no iolbox-server-*%s payload found for profile %q", payloadARM64Suffix, profileName)
  581: 		}
  582: 		return "", codedError(exitPreflight, "no amd64 iolbox-server-*.tar.gz payload found for profile %q", profileName)
  583: 	}
  584: 	sort.Slice(candidates, func(i, j int) bool {
  585: 		if candidates[i].MTime.Equal(candidates[j].MTime) {
  586: 			return candidates[i].Path < candidates[j].Path
  587: 		}
  588: 		return candidates[i].MTime.After(candidates[j].MTime)
  589: 	})
  590: 	return candidates[0].Path, nil
  591: }

