FILE packaging/macos/guest/40-install-payload-native.sh
    1: #!/usr/bin/env bash
    2: # 40-install-payload-native.sh ƒ?" install the native arm64 payload.
    3: #
    4: # This is the native-arm64 counterpart of 40-install-payload.sh. The payload
    5: # tarball named by IOLBOX_PAYLOAD_TARBALL is expected to be the output of
    6: # `pack-native.sh --arch arm64` (runtime/pack-native.sh): a real arm64
    7: # supervisor/vpcs/toollaunch build, not the amd64 payload translated by
    8: # Rosetta. In order, this step:
    9: #   1. runs the preceding native canary (30-canary-native.sh) and propagates
   10: #      its exit code ƒ?" including its hard, fail-closed rejection of a guest
   11: #      that still has a Rosetta binfmt entry registered;
   12: #   2. installs the structural ExecStartPre drop-in naming the NATIVE canary,
   13: #      before invoking the payload installer, so its first supervisor start
   14: #      is gated by the correct canary for this profile;
   15: #   3. extracts the staged native tarball and runs ./install.sh --bind (the
   16: #      same install.sh every profile uses; it fail-closes on its own
   17: #      manifest.env architecture mismatch check when the tarball was built
   18: #      with an explicit --arch, per docs/m7-phase4-file-mapping.md);
   19: #   4. reloads and inspects the effective unit, requiring a gated active
   20: #      supervisor whose ExecStart is the PLAIN native supervisor binary ƒ?"
   21: #      never a Rosetta-translated path, which would mean this "native"
   22: #      profile silently regressed to translation; and
   23: #   5. writes the guest structural-gate attestation only after all gates
   24: #      pass.
   25: #
   26: # Reinstalling the same tarball is intentional and safe, for the same reason
   27: # as the Rosetta path: the work directory is disposable, while install.sh
   28: # writes the existing /opt/iolbox binaries and service files without
   29: # deleting images, labs, or /opt/iolbox/iourc.
   30: set -euo pipefail
   31: 
   32: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
   33: # shellcheck source=lib.sh
   34: . "$SCRIPT_DIR/lib.sh"
   35: 
   36: IOLBOX_CANARY_DROP_IN="${IOLBOX_CANARY_DROP_IN:-/etc/systemd/system/iolbox-supervisor.service.d/10-iolbox-macos-canary.conf}"
   37: IOLBOX_STRUCTURAL_GATE_JSON="${IOLBOX_STRUCTURAL_GATE_JSON:-/var/lib/iolbox/macos-structural-gate.json}"
   38: 
   39: usage() {
   40:     cat <<EOF
   41: Usage: $0
   42: 
   43:   Installs the native arm64 payload named by IOLBOX_PAYLOAD_TARBALL using
   44:   IOLBOX_BIND.
   45: EOF
   46: }
   47: 
   48: stop_ungated_supervisor() {
   49:     if systemctl is-active --quiet iolbox-supervisor.service 2>/dev/null; then
   50:         systemctl stop iolbox-supervisor.service || die "$IOLBOX_EXIT_PREFLIGHT" \
   51:             'could not stop an already-active supervisor before installing the structural gate'
   52:     fi
   53: }
   54: 
   55: install_canary_drop_in() {
   56:     local drop_in_tmp
   57: 
   58:     chmod 0755 "$IOLBOX_PROVISION_DIR/30-canary-native.sh" || die "$IOLBOX_EXIT_PREFLIGHT" \
   59:         "could not make the native canary executable: $IOLBOX_PROVISION_DIR/30-canary-native.sh"
   60:     install -d -m 0755 -- "$(dirname "$IOLBOX_CANARY_DROP_IN")" || \
   61:         die "$IOLBOX_EXIT_PREFLIGHT" 'could not create the supervisor drop-in directory'
   62:     drop_in_tmp="$(mktemp "${IOLBOX_CANARY_DROP_IN}.iolbox-tmp.XXXXXX")" || \
   63:         die "$IOLBOX_EXIT_PREFLIGHT" 'could not create the supervisor canary drop-in temporary file'
   64:     printf '%s\n' \
   65:         '[Service]' \
   66:         '# Structural macOS/Lima native-arm64 gate: every boot, restart, crash-restart, and manual start runs the executable canary first.' \
   67:         'Environment=IOLBOX_DISABLE_I386=1' \
   68:         'ExecStartPre=/opt/iolbox-provision/30-canary-native.sh --quiet' > "$drop_in_tmp"
   69:     chmod 0644 -- "$drop_in_tmp" || die "$IOLBOX_EXIT_PREFLIGHT" \
   70:         'could not set supervisor canary drop-in permissions'
   71:     if cmp -s -- "$IOLBOX_CANARY_DROP_IN" "$drop_in_tmp" 2>/dev/null; then
   72:         rm -f -- "$drop_in_tmp"
   73:     else
   74:         mv -f -- "$drop_in_tmp" "$IOLBOX_CANARY_DROP_IN" || \
   75:             die "$IOLBOX_EXIT_PREFLIGHT" 'could not install the supervisor canary drop-in'
   76:     fi
   77:     [ -f "$IOLBOX_CANARY_DROP_IN" ] || die "$IOLBOX_EXIT_PREFLIGHT" \
   78:         "structural gate drop-in is missing after install: $IOLBOX_CANARY_DROP_IN"
   79: }
   80: 
   81: reload_systemd() {
   82:     systemctl daemon-reload || die "$IOLBOX_EXIT_PREFLIGHT" \
   83:         'systemctl daemon-reload failed after installing the structural gate'
   84: }
   85: 
   86: verify_gated_unit() {
   87:     local unit_text show_text
   88: 
   89:     if ! unit_text="$(systemctl cat iolbox-supervisor.service 2>&1)"; then
   90:         die "$IOLBOX_EXIT_VERIFY" \
   91:             "systemctl cat iolbox-supervisor.service failed: $unit_text"
   92:     fi
   93:     case "$unit_text" in
   94:         *'Environment=IOLBOX_DISABLE_I386=1'*) : ;;
   95:         *) die "$IOLBOX_EXIT_VERIFY" \
   96:             'systemctl cat does not show the honest Apple Silicon i386 capability policy' ;;
   97:     esac
   98:     case "$unit_text" in
   99:         *"ExecStartPre=/opt/iolbox-provision/30-canary-native.sh --quiet"*) : ;;
  100:         *) die "$IOLBOX_EXIT_VERIFY" \
  101:             'systemctl cat does not show the required native-arm64 canary ExecStartPre' ;;
  102:     esac
  103:     # This is the load-bearing native-vs-Rosetta assertion: ExecStart must be
  104:     # the plain supervisor binary. Any Rosetta-translated path here would
  105:     # mean this "native-arm64" profile silently installed a translated
  106:     # payload, which is precisely the misrepresentation this project's rules
  107:     # forbid.
  108:     case "$unit_text" in
  109:         *'ExecStart=/opt/iolbox/supervisor'*)
  110:             case "$unit_text" in
  111:                 *'/mnt/lima-rosetta/rosetta'*) die "$IOLBOX_EXIT_VERIFY" \
  112:                     'systemctl cat shows a Rosetta-translated ExecStart on the native-arm64 profile' ;;
  113:                 *) : ;;
  114:             esac
  115:             ;;
  116:         *) die "$IOLBOX_EXIT_VERIFY" \
  117:             'systemctl cat does not show a plain native supervisor ExecStart after the canary gate' ;;
  118:     esac
  119: 
  120:     if ! show_text="$(systemctl show iolbox-supervisor.service -p Environment -p ExecStartPre -p ExecStart 2>&1)"; then
  121:         die "$IOLBOX_EXIT_VERIFY" \
  122:             "systemctl show of the gated supervisor failed: $show_text"
  123:     fi
  124:     case "$show_text" in
  125:         *'Environment='*'IOLBOX_DISABLE_I386=1'*) : ;;
  126:         *) die "$IOLBOX_EXIT_VERIFY" \
  127:             'systemctl show does not expose the honest i386 capability policy' ;;
  128:     esac
  129:     case "$show_text" in
  130:         *'ExecStartPre='*'/opt/iolbox-provision/30-canary-native.sh --quiet'*) : ;;
  131:         *) die "$IOLBOX_EXIT_VERIFY" \
  132:             'systemctl show does not expose the native canary as an effective ExecStartPre' ;;
  133:     esac
  134:     case "$show_text" in
  135:         *'ExecStart='*'/opt/iolbox/supervisor'*)
  136:             case "$show_text" in
  137:                 *'/mnt/lima-rosetta/rosetta'*) die "$IOLBOX_EXIT_VERIFY" \
  138:                     'systemctl show exposes a Rosetta-translated ExecStart on the native-arm64 profile' ;;
  139:                 *) : ;;
  140:             esac
  141:             ;;
  142:         *) die "$IOLBOX_EXIT_VERIFY" \
  143:             'systemctl show does not expose the plain native supervisor ExecStart' ;;
  144:     esac
  145: 
  146:     assert_amd64_native_supervisor_is_not_used
  147: }
  148: 
  149: # assert_amd64_native_supervisor_is_not_used ƒ?" belt-and-braces ELF check.
  150: # systemctl string matching above proves the SERVICE FILE is honest; this
  151: # proves the actual installed binary is an aarch64 ELF, independent of what
  152: # any config file claims.
  153: assert_amd64_native_supervisor_is_not_used() {
  154:     local m
  155:     [ -x /opt/iolbox/supervisor ] || die "$IOLBOX_EXIT_VERIFY" \
  156:         '/opt/iolbox/supervisor is missing or not executable after install'
  157:     m="$(elf_machine /opt/iolbox/supervisor || true)"
  158:     [ "$m" = "b7" ] || die "$IOLBOX_EXIT_VERIFY" \
  159:         "/opt/iolbox/supervisor is not an aarch64 ELF (ELF e_machine=0x${m:-none}); native-arm64 must install a real arm64 binary, not an amd64 one"
  160: }
  161: 
  162: host_macos_product() {
  163:     local value="${IOLBOX_HOST_MACOS_PRODUCT:-}"
  164: 
  165:     if [ -n "$value" ]; then
  166:         printf '%s\n' "$value"
  167:     elif [[ "$IOLBOX_HOST_MACOS" == *' ('*')' ]]; then
  168:         printf '%s\n' "${IOLBOX_HOST_MACOS%% (*}"
  169:     else
  170:         printf '%s\n' 'unknown'
  171:     fi
  172: }
  173: 
  174: host_macos_build() {
  175:     local value="${IOLBOX_HOST_MACOS_BUILD:-}"
  176: 
  177:     if [ -n "$value" ]; then
  178:         printf '%s\n' "$value"
  179:     elif [[ "$IOLBOX_HOST_MACOS" == *' ('*')' ]]; then
  180:         value="${IOLBOX_HOST_MACOS##* (}"
  181:         printf '%s\n' "${value%)}"
  182:     else
  183:         printf '%s\n' 'unknown'
  184:     fi
  185: }
  186: 
  187: write_structural_attestation() {
  188:     local product build kernel timestamp tmp json
  189: 
  190:     product="$(host_macos_product)"
  191:     build="$(host_macos_build)"
  192:     kernel="$(uname -r)"
  193:     timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  194:     [ "$product" != unknown ] && [ "$build" != unknown ] || die "$IOLBOX_EXIT_VERIFY" \
  195:         'cannot attest the structural gate without the host macOS product and build'
  196:     json="$(printf '{"schema":1,"profile":"%s","macos_product":"%s","macos_build":"%s","lima_version":"%s","drop_in":"%s","canary_verdict":"PASS","kernel":"%s","timestamp":"%s"}\n' \
  197:         "$(iolbox_json_escape "$IOLBOX_PROFILE")" \
  198:         "$(iolbox_json_escape "$product")" \
  199:         "$(iolbox_json_escape "$build")" \
  200:         "$(iolbox_json_escape "$IOLBOX_HOST_LIMA")" \
  201:         "$(iolbox_json_escape "$IOLBOX_CANARY_DROP_IN")" \
  202:         "$(iolbox_json_escape "$kernel")" \
  203:         "$(iolbox_json_escape "$timestamp")")"
  204:     install -d -m 0755 -- "$(dirname "$IOLBOX_STRUCTURAL_GATE_JSON")" || \
  205:         die "$IOLBOX_EXIT_VERIFY" 'could not create structural-gate attestation directory'
  206:     tmp="$(mktemp "${IOLBOX_STRUCTURAL_GATE_JSON}.iolbox-tmp.XXXXXX")" || \
  207:         die "$IOLBOX_EXIT_VERIFY" 'could not create structural-gate attestation temporary file'
  208:     printf '%s' "$json" > "$tmp"
  209:     chmod 0644 -- "$tmp" || die "$IOLBOX_EXIT_VERIFY" \
  210:         'could not set structural-gate attestation permissions'
  211:     mv -f -- "$tmp" "$IOLBOX_STRUCTURAL_GATE_JSON" || \
  212:         die "$IOLBOX_EXIT_VERIFY" 'could not install structural-gate attestation'
  213: }
  214: 
  215: main() {
  216:     local canary rc payload_name payload_version install_script install_dir supervisor_version
  217: 
  218:     while [ $# -gt 0 ]; do
  219:         case "$1" in
  220:             -h|--help) usage; return 0 ;;
  221:             *) usage >&2; die "$IOLBOX_EXIT_USAGE" "unknown option: $1" ;;
  222:         esac
  223:     done
  224: 
  225:     [ "$(id -u)" -eq 0 ] || die "$IOLBOX_EXIT_PREFLIGHT" \
  226:         "40-install-payload-native.sh must run as root"
  227:     [ -n "${IOLBOX_PROVISION_DIR:-}" ] || die "$IOLBOX_EXIT_USAGE" \
  228:         'IOLBOX_PROVISION_DIR is not set'
  229:     [ -n "${IOLBOX_PAYLOAD_TARBALL:-}" ] || die "$IOLBOX_EXIT_USAGE" \
  230:         'IOLBOX_PAYLOAD_TARBALL is not set'
  231:     [ -n "${IOLBOX_BIND:-}" ] || die "$IOLBOX_EXIT_USAGE" \
  232:         'IOLBOX_BIND is not set'
  233:     case "$IOLBOX_BIND" in
  234:         local|all) : ;;
  235:         *) die "$IOLBOX_EXIT_USAGE" "IOLBOX_BIND must be local or all, got '$IOLBOX_BIND'" ;;
  236:     esac
  237:     [ -f "$IOLBOX_PROVISION_DIR/30-canary-native.sh" ] || die "$IOLBOX_EXIT_USAGE" \
  238:         "native canary script is missing: $IOLBOX_PROVISION_DIR/30-canary-native.sh"
  239:     [ -f "$IOLBOX_PAYLOAD_TARBALL" ] || die "$IOLBOX_EXIT_USAGE" \
  240:         "payload tarball is missing: $IOLBOX_PAYLOAD_TARBALL"
  241: 
  242:     stop_ungated_supervisor
  243: 
  244:     if "$IOLBOX_PROVISION_DIR/30-canary-native.sh"; then
  245:         :
  246:     else
  247:         canary=$?
  248:         log "30-canary-native.sh failed; refusing payload installation"
  249:         exit "$canary"
  250:     fi
  251: 
  252:     install_canary_drop_in
  253:     reload_systemd
  254: 
  255:     payload_name="$(basename "$IOLBOX_PAYLOAD_TARBALL")"
  256:     payload_version="${payload_name#iolbox-server-}"
  257:     payload_version="${payload_version%.tar.gz}"
  258:     work_dir="$(mktemp -d /tmp/iolbox-payload-native.XXXXXX)" || die "$IOLBOX_EXIT_USAGE" \
  259:         'could not create disposable payload work directory'
  260:     cleanup() {
  261:         [ -n "${work_dir:-}" ] && rm -rf -- "$work_dir"
