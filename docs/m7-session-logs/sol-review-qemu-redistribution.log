  239: func syncGuestAttestation(ctx context.Context, l *limaClient, machine string, p macOSProfile, facts hostFacts, limaVersion string) error {
  240: 	out, err := l.shell(ctx, machine, "sudo", "-n", "cat", "/var/lib/iolbox/macos-structural-gate.json")
  241: 	if err != nil {
  242: 		return codedError(exitVerify, "retrieve guest structural attestation: %v", err)
  243: 	}
  244: 	var att structuralAttestation
  245: 	if err := json.Unmarshal(out, &att); err != nil {
  246: 		return codedError(exitVerify, "decode guest structural attestation: %v", err)
  247: 	}
  248: 	if err := validateAttestation("guest", att, p, facts, limaVersion); err != nil {
  249: 		return codedError(exitVerify, "invalid guest structural attestation: %v", err)
  250: 	}
  251: 	path, err := hostAttestationPath(machine)
  252: 	if err != nil {
  253: 		return codedError(exitVerify, "resolve host attestation path: %v", err)
  254: 	}
  255: 	if err := atomicWriteFile(path, out, 0o600); err != nil {
  256: 		return codedError(exitVerify, "install host structural attestation: %v", err)
  257: 	}
  258: 	return nil
  259: }
