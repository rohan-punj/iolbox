   64: func discoverLimactl(override, env string, lookPath func(string) (string, error)) (string, error) {
   65: 	if override != "" {
   66: 		if isExecutable(override) {
   67: 			return override, nil
   68: 		}
   69: 		return "", fmt.Errorf("configured --limactl is not executable: %s", override)
   70: 	}
   71: 	if env != "" {
   72: 		if isExecutable(env) {
   73: 			return env, nil
   74: 		}
   75: 		return "", fmt.Errorf("configured LIMACTL is not executable: %s", env)
   76: 	}
   77: 	for _, candidate := range []string{"/opt/homebrew/bin/limactl", "/usr/local/bin/limactl"} {
   78: 		if isExecutable(candidate) {
   79: 			return candidate, nil
   80: 		}
   81: 	}
   82: 	if lookPath == nil {
   83: 		lookPath = exec.LookPath
   84: 	}
   85: 	path, err := lookPath("limactl")
   86: 	if err == nil && path != "" {
   87: 		return path, nil
   88: 	}
   89: 	return "", fmt.Errorf("Lima was not found; set --limactl or LIMACTL")
   90: }
   91: 
   92: var limaVersionPattern = regexp.MustCompile(`\b([0-9]+\.[0-9]+\.[0-9]+)\b`)
   93: 
   94: func parseLimaVersion(raw string) string {
   95: 	match := limaVersionPattern.FindStringSubmatch(raw)
   96: 	if match == nil {
   97: 		return ""
   98: 	}
   99: 	return match[1]
  100: }
