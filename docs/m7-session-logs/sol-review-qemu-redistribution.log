   13: packaging/macos/lima/iolbox-jammy.yaml|lima/iolbox-jammy.yaml
   14: packaging/macos/lima/iolbox-bookworm.yaml|lima/iolbox-bookworm.yaml
   15: packaging/macos/lima/pinned-image-debian13.env|lima/pinned-image-debian13.env
   16: packaging/macos/lima/pinned-image.env|lima/pinned-image.env
   17: packaging/macos/lima/pinned-image-debian12.env|lima/pinned-image-debian12.env
   18: packaging/macos/guest/lib.sh|guest/lib.sh
   19: packaging/macos/guest/10-multiarch-debian.sh|guest/10-multiarch-debian.sh
   20: packaging/macos/guest/10-multiarch.sh|guest/10-multiarch.sh
   21: packaging/macos/guest/20-kernel-hold-debian.sh|guest/20-kernel-hold-debian.sh
