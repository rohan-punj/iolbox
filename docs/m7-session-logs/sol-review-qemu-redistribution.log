  181: func recordCanary(machine string, facts hostFacts, limaVersion, result string, code int) error {
  182: 	path, err := canaryStatePath(machine)
  183: 	if err != nil {
  184: 		return err
  185: 	}
  186: 	data := fmt.Sprintf("result=%s\nexit=%d\nhost_macos=%s\nhost_lima=%s\nrecorded_utc=%s\n", result, code, hostMACOSString(facts), limaVersion, time.Now().UTC().Format(time.RFC3339))
  187: 	return atomicWriteFile(path, []byte(data), 0o644)
  188: }
