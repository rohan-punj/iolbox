  337: func runProvision(ctx context.Context, l *limaClient, machine string, p macOSProfile, facts hostFacts, payloadPath string, config lifecycleConfig) error {
  338: 	ports := config.Ports
  339: 	if ports.GUIPort == 0 {
  340: 		var err error
  341: 		ports, err = newDarwinPortContract(config.GUIPort)
  342: 		if err != nil {
  343: 			return codedError(exitUsage, "%v", err)
  344: 		}
  345: 	}
  346: 	templatePath := ""
  347: 	var err error
  348: 	if _, statErr := os.Stat(p.TemplatePath); statErr != nil {
  349: 		return codedError(exitUsage, "profile template is missing: %v", statErr)
  350: 	}
  351: 	// Render and validate before querying or mutating Lima, matching the
  352: 	// documented start sequence. Existing machines do not consume the file,
  353: 	// but rendering still proves the shipped profile is internally coherent.
  354: 	templatePath, err = writeRenderedTemplateForPort("", p, ports.GUIPort)
  355: 	if err != nil {
  356: 		return codedError(exitUsage, "render Lima template: %v", err)
  357: 	}
  358: 	defer os.Remove(templatePath)
  359: 
  360: 	machines, err := l.list(ctx)
  361: 	if err != nil {
  362: 		return codedError(exitPreflight, "%v", err)
  363: 	}
  364: 	state, exists := findMachine(machines, machine)
  365: 	if config.Upgrade && !exists {
  366: 		return codedError(exitPreflight, "upgrade requires existing machine %q", machine)
  367: 	}
  368: 	attestationPath, err := hostAttestationPath(machine)
  369: 	if err != nil {
  370: 		return codedError(exitPreflight, "resolve host attestation path: %v", err)
  371: 	}
  372: 	validAttestation := func() error {
  373: 		return requireAttestation(attestationPath, p, facts, l.info.Version)
  374: 	}
  375: 	created, err := ensureMachineWithPorts(ctx, l, machine, state, templatePath, attestationPath, validAttestation, &ports)
  376: 	if err != nil {
  377: 		return err
  378: 	}
  379: 	if created {
  380: 		// The returned state is now live; the template is removed by the defer
  381: 		// above after the create command has consumed it.
  382: 	}
  383: 	if warning, ok := hostAgentWarningText(machine); ok {
  384: 		fmt.Fprintf(os.Stderr, "WARNING: Lima hostagent Rosetta warning for %s:\n%s\n", machine, warning)
  385: 		fmt.Fprintln(os.Stderr, "Remediation: brew reinstall lima (brew upgrade may be a no-op when Lima is already current).")
  386: 	}
  387: 	payloadBase := filepath.Base(payloadPath)
  388: 	if err := stageFiles(ctx, l, machine, p, payloadPath, payloadBase); err != nil {
  389: 		return err
  390: 	}
  391: 	if err := runGuestSequence(ctx, l, machine, p, facts, l.info.Version, payloadBase, config); err != nil {
  392: 		return err
  393: 	}
  394: 	guiPort := ports.GUIPort
  395: 	if _, err := waitHTTPReady(ctx, nil, fmt.Sprintf("http://127.0.0.1:%d/", guiPort), config.BootTimeout); err != nil {
  396: 		return codedError(exitVerify, "GUI readiness failed: %v", err)
  397: 	}
  398: 	if err := verifyDarwinHostContract(ports, 2*time.Second); err != nil {
  399: 		return err
  400: 	}
  401: 	control, err := dialControlWS(fmt.Sprintf("127.0.0.1:%d", guiPort))
  402: 	if err != nil {
  403: 		return codedError(exitVerify, "control-plane connection failed: %v", err)
  404: 	}
  405: 	defer control.Close()
  406: 	if _, err := control.hello(); err != nil {
  407: 		return codedError(exitVerify, "control-plane hello failed: %v", err)
  408: 	}
  409: 	if config.Sync != nil {
  410: 		if err := syncDarwinStartup(control, fmt.Sprintf("http://127.0.0.1:%d", guiPort), *config.Sync); err != nil {
  411: 			return codedError(exitVerify, "%v", err)
  412: 		}
  413: 	}
  414: 	return nil
  415: }
