  269: func hostAgentWarningText(machine string) (string, bool) {
  270: 	path, err := limaHomePath(machine, "ha.stderr.log")
  271: 	if err != nil {
  272: 		return "", false
  273: 	}
  274: 	data, err := os.ReadFile(path)
  275: 	if err != nil {
  276: 		return "", false
  277: 	}
  278: 	var matches []string
  279: 	for _, line := range strings.Split(string(data), "\n") {
  280: 		if strings.Contains(line, "Unable to configure Rosetta") || strings.Contains(line, "unsupported build target macOS version") {
  281: 			matches = append(matches, line)
  282: 		}
  283: 	}
  284: 	return strings.Join(matches, "\n"), len(matches) > 0
  285: }
