FILE: packaging/macos/tests/release-layout-test.sh
    1: #!/usr/bin/env bash
    2: # Verify the exact archive contract and rebuild it twice from independent
    3: # packer staging directories to prove deterministic bytes.
    4: #
    5: # The archive carries TWO payloads: the historical untagged amd64 tarball the
    6: # Rosetta profiles use, and the linux/arm64 tarball the native-arm64 profile
    7: # uses. Both are checked by name and by trusted digest, because a bare count
    8: # of two would pass on two payloads of the same architecture.
    9: set -euo pipefail
   10: 
   11: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
   12: MACOS_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
   13: REPO_ROOT="$(cd "$MACOS_DIR/../.." && pwd)"
   14: PACKER="$MACOS_DIR/pack-release.sh"
   15: 
   16: ARCHIVE=""
   17: LAUNCHER=""
   18: PAYLOAD=""
   19: PAYLOAD_SHA256=""
   20: PAYLOAD_ARM64=""
   21: PAYLOAD_ARM64_SHA256=""
   22: VERSION=""
   23: SOURCE_DATE_EPOCH=""
   24: 
   25: usage() {
   26:     cat <<'EOF'
   27: Usage: packaging/macos/tests/release-layout-test.sh \
   28:   --archive PATH --launcher PATH --payload PATH --payload-sha256 SHA256 \
   29:   --payload-arm64 PATH --payload-arm64-sha256 SHA256 \
   30:   --version VERSION --source-date-epoch EPOCH
   31: EOF
   32: }
   33: die() { echo "release-layout-test: $*" >&2; exit 1; }
   34: while [ "$#" -gt 0 ]; do
   35:     case "$1" in
   36:         --archive) ARCHIVE="$2"; shift 2 ;;
   37:         --launcher) LAUNCHER="$2"; shift 2 ;;
   38:         --payload) PAYLOAD="$2"; shift 2 ;;
   39:         --payload-sha256) PAYLOAD_SHA256="$2"; shift 2 ;;
   40:         --payload-arm64) PAYLOAD_ARM64="$2"; shift 2 ;;
   41:         --payload-arm64-sha256) PAYLOAD_ARM64_SHA256="$2"; shift 2 ;;
   42:         --version) VERSION="$2"; shift 2 ;;
   43:         --source-date-epoch) SOURCE_DATE_EPOCH="$2"; shift 2 ;;
   44:         -h|--help) usage; exit 0 ;;
   45:         *) die "unknown option: $1" ;;
   46:     esac
   47: done
   48: for required in ARCHIVE LAUNCHER PAYLOAD PAYLOAD_SHA256 PAYLOAD_ARM64 PAYLOAD_ARM64_SHA256 VERSION SOURCE_DATE_EPOCH; do
   49:     [ -n "${!required}" ] || die "--$(echo "$required" | tr '[:upper:]' '[:lower:]' | tr '_' '-') is required"
   50: done
   51: [ -f "$ARCHIVE" ] || die "archive does not exist: $ARCHIVE"
   52: [ "$(basename "$ARCHIVE")" = "iolbox-macos-arm64.tar.gz" ] || die "archive basename is not iolbox-macos-arm64.tar.gz"
   53: 
   54: TMP="$(mktemp -d "${TMPDIR:-/tmp}/iolbox-macos-layout.XXXXXX")"
   55: cleanup() { rm -rf "$TMP"; }
   56: trap cleanup EXIT
   57: 
   58: tar --version | grep -F 'GNU tar' >/dev/null || die "GNU tar is required"
   59: archive_dir="$(cd "$(dirname "$ARCHIVE")" && pwd)"
   60: archive_name="$(basename "$ARCHIVE")"
   61: ( cd "$archive_dir" && sha256sum -c "$archive_name.sha256" ) >/dev/null || die "outer checksum beside archive does not verify"
   62: 
   63: tar -tzf "$ARCHIVE" > "$TMP/raw-list.txt"
   64: sed 's#/$##' "$TMP/raw-list.txt" | LC_ALL=C sort > "$TMP/actual-list.txt"
   65: cat > "$TMP/expected-list.txt" <<EOF
   66: iolbox-macos-arm64
   67: iolbox-macos-arm64/LICENSE
   68: iolbox-macos-arm64/README.md
   69: iolbox-macos-arm64/SHA256SUMS
   70: iolbox-macos-arm64/guest
   71: iolbox-macos-arm64/guest/10-multiarch-debian.sh
   72: iolbox-macos-arm64/guest/10-multiarch-native.sh
   73: iolbox-macos-arm64/guest/10-multiarch.sh
   74: iolbox-macos-arm64/guest/20-kernel-hold-debian.sh
   75: iolbox-macos-arm64/guest/20-kernel-hold.sh
   76: iolbox-macos-arm64/guest/30-canary-native.sh
   77: iolbox-macos-arm64/guest/30-canary.sh
   78: iolbox-macos-arm64/guest/40-install-payload-native.sh
   79: iolbox-macos-arm64/guest/40-install-payload.sh
   80: iolbox-macos-arm64/guest/50-verify-native.sh
   81: iolbox-macos-arm64/guest/50-verify.sh
   82: iolbox-macos-arm64/guest/lib.sh
   83: iolbox-macos-arm64/iolbox
   84: iolbox-macos-arm64/iolbox-server-${VERSION}-linux-arm64.tar.gz
   85: iolbox-macos-arm64/iolbox-server-${VERSION}.tar.gz
   86: iolbox-macos-arm64/lima
   87: iolbox-macos-arm64/lima/iolbox-bookworm.yaml
   88: iolbox-macos-arm64/lima/iolbox-jammy.yaml
   89: iolbox-macos-arm64/lima/iolbox-native-arm64.yaml
   90: iolbox-macos-arm64/lima/iolbox-trixie.yaml
   91: iolbox-macos-arm64/lima/pinned-image-debian12.env
   92: iolbox-macos-arm64/lima/pinned-image-debian13.env
   93: iolbox-macos-arm64/lima/pinned-image-native-arm64.env
   94: iolbox-macos-arm64/lima/pinned-image.env
   95: iolbox-macos-arm64/lima/profiles.env
   96: iolbox-macos-arm64/notices
   97: iolbox-macos-arm64/notices/THIRD_PARTY.md
   98: EOF
   99: if ! cmp -s "$TMP/actual-list.txt" "$TMP/expected-list.txt"; then
  100:     echo "expected archive members:" >&2; cat "$TMP/expected-list.txt" >&2
  101:     echo "actual archive members:" >&2; cat "$TMP/actual-list.txt" >&2
  102:     die "archive member set is not exact"
  103: fi
  104: 
  105: # The first character in GNU tar's verbose type flags must be directory or
  106: # regular file. This rejects symlinks, hard links, devices, FIFOs, and other
  107: # special nodes even if their names happen to be allowed.
  108: tar -tvzf "$ARCHIVE" > "$TMP/verbose-list.txt"
  109: while IFS= read -r line; do
  110:     [ -n "$line" ] || continue
  111:     type="${line:0:1}"
  112:     case "$type" in
  113:         d|-) ;;
  114:         *) die "archive contains a non-directory/non-regular member: $line" ;;
  115:     esac
  116: done < "$TMP/verbose-list.txt"
  117: if LC_ALL=C grep -aE -i 'SCHILY\.(xattr|acl)|LIBARCHIVE\.(xattr|acl)|GNU\.sparse|com\.apple\.(ResourceFork|FinderInfo)|PaxHeader' "$ARCHIVE" >/dev/null; then
  118:     die "archive contains xattr/ACL/resource-fork pax metadata"
  119: fi
  120: if LC_ALL=C grep -E -i '(^|/)(\._[^/]*|\.DS_Store|.*namedfork.*|.*resourcefork.*|.*cisco.*|.*\.i86bi[^/]*|.*\.iol[^/]*)$|(^|/)tests(/|$)|iolbox-mac\.sh|pack-release\.sh|release-manifest\.txt' "$TMP/actual-list.txt" >/dev/null; then
  121:     die "archive contains a forbidden AppleDouble/resource/Cisco/test member"
  122: fi
  123: 
  124: mkdir "$TMP/extract"
  125: tar -xzf "$ARCHIVE" -C "$TMP/extract"
  126: ROOT="$TMP/extract/iolbox-macos-arm64"
  127: [ "$(stat -c '%a' "$ROOT")" = 755 ] || die "archive root mode is not 0755"
  128: while IFS= read -r path; do
  129:     [ -n "$path" ] || continue
  130:     full="$TMP/extract/$path"
  131:     [ -e "$full" ] || die "listed member did not extract: $path"
  132:     if [ -d "$full" ]; then
  133:         [ "$(stat -c '%a' "$full")" = 755 ] || die "directory mode is not 0755: $path"
  134:     else
  135:         expected_mode=644
  136:         [ "$path" = "iolbox-macos-arm64/iolbox" ] && expected_mode=755
  137:         [ "$(stat -c '%a' "$full")" = "$expected_mode" ] || die "file mode is not $expected_mode: $path"
  138:     fi
  139: done < "$TMP/actual-list.txt"
  140: 
  141: ( cd "$ROOT" && sha256sum -c SHA256SUMS ) || die "internal checksums do not verify"
  142: [ "$(wc -l < "$ROOT/SHA256SUMS" | tr -d ' ')" = 27 ] || die "internal checksum file does not cover exactly 27 files"
  143: 
  144: file_launcher="$(file -b "$ROOT/iolbox")"
  145: case "$file_launcher" in
  146:     *"Mach-O 64-bit"*"arm64"*) ;;
  147:     *) die "extracted launcher is not Mach-O arm64: $file_launcher" ;;
  148: esac
  149: payload_path="$ROOT/iolbox-server-${VERSION}.tar.gz"
  150: [ -f "$payload_path" ] || die "expected amd64 payload is missing"
  151: [ "$(sha256sum "$payload_path" | awk '{print tolower($1)}')" = "$(printf '%s' "$PAYLOAD_SHA256" | tr '[:upper:]' '[:lower:]')" ] || die "extracted amd64 payload is not the trusted build-linux payload"
  152: 
  153: payload_arm64_path="$ROOT/iolbox-server-${VERSION}-linux-arm64.tar.gz"
  154: [ -f "$payload_arm64_path" ] || die "expected arm64 payload is missing"
  155: [ "$(sha256sum "$payload_arm64_path" | awk '{print tolower($1)}')" = "$(printf '%s' "$PAYLOAD_ARM64_SHA256" | tr '[:upper:]' '[:lower:]')" ] || die "extracted arm64 payload is not the trusted build-linux payload"
  156: 
  157: # Exactly two payloads, and exactly one of each architecture. A bare count of
  158: # two would pass on two same-architecture payloads.
  159: [ "$(find "$ROOT" -maxdepth 1 -type f -name 'iolbox-server-*.tar.gz' | wc -l | tr -d ' ')" = 2 ] || die "archive does not contain exactly two payloads"
  160: [ "$(find "$ROOT" -maxdepth 1 -type f -name 'iolbox-server-*-linux-arm64.tar.gz' | wc -l | tr -d ' ')" = 1 ] || die "archive does not contain exactly one arm64 payload"
  161: 
  162: # The arm64 payload must actually BE arm64. pack-native.sh writes manifest.env
  163: # for every explicit --arch build; checking it here catches a mislabelled
  164: # payload at packaging time instead of deep inside a guest provision.
  165: arm64_manifest="$(tar -xzOf "$payload_arm64_path" --wildcards '*/manifest.env' 2>/dev/null || true)"
  166: [ -n "$arm64_manifest" ] || die "arm64 payload has no manifest.env (was it built without an explicit --arch?)"
  167: printf '%s\n' "$arm64_manifest" | grep -Eq '^arch=arm64$' || die "arm64 payload manifest.env does not declare arch=arm64: $arm64_manifest"
  168: 
  169: while IFS='|' read -r source dest extra || [ -n "${source:-}" ]; do
  170:     case "${source:-}" in ""|\#*) continue ;; esac
  171:     [ -f "$REPO_ROOT/$source" ] && [ ! -L "$REPO_ROOT/$source" ] || die "manifest source is not regular/non-symlink: $source"
  172: done < "$MACOS_DIR/release-manifest.txt"
  173: 
  174: # Re-run the packer twice into fresh output paths. The packer itself creates
  175: # two independent stage directories for each invocation; comparing both fresh
  176: # outputs prevents a single lingering stage from masking nondeterminism.
  177: for n in 1 2; do
  178:     mkdir "$TMP/repro-$n"
  179:     bash "$PACKER" --launcher "$LAUNCHER" --payload "$PAYLOAD" \
  180:         --payload-sha256 "$PAYLOAD_SHA256" \
  181:         --payload-arm64 "$PAYLOAD_ARM64" \
  182:         --payload-arm64-sha256 "$PAYLOAD_ARM64_SHA256" --version "$VERSION" \
  183:         --output "$TMP/repro-$n/iolbox-macos-arm64.tar.gz" \
  184:         --source-date-epoch "$SOURCE_DATE_EPOCH" > "$TMP/repro-$n.log"
  185: done
  186: cmp -s "$TMP/repro-1/iolbox-macos-arm64.tar.gz" "$TMP/repro-2/iolbox-macos-arm64.tar.gz" || die "independent reproducibility outputs differ"
  187: repro_hash_1="$(sha256sum "$TMP/repro-1/iolbox-macos-arm64.tar.gz" | awk '{print $1}')"
  188: repro_hash_2="$(sha256sum "$TMP/repro-2/iolbox-macos-arm64.tar.gz" | awk '{print $1}')"
  189: archive_hash="$(sha256sum "$ARCHIVE" | awk '{print $1}')"
  190: [ "$repro_hash_1" = "$repro_hash_2" ] || die "independent reproducibility hashes differ"
  191: [ "$repro_hash_1" = "$archive_hash" ] || die "checked archive differs from deterministic rebuild"
  192: 
  193: echo "release-layout-test: PASS"
  194: echo "release-layout-test: archive=$ARCHIVE sha256=$archive_hash"
  195: echo "release-layout-test: independent-stage/rebuild hash=$repro_hash_1"
  196: echo "release-layout-test: launcher=$file_launcher"
  197: echo "release-layout-test: amd64 payload=$(basename "$payload_path")"
  198: echo "release-layout-test: arm64 payload=$(basename "$payload_arm64_path")"
FILE: .github/workflows/release.yml
    1: name: Release
    2: 
    3: # Triggers: a version tag builds+drafts a release; workflow_dispatch lets a
    4: # maintainer dry-run the whole pipeline (build/test artifacts, no publish)
    5: # without cutting a tag.
    6: on:
    7:   push:
    8:     tags: ["v*"]
    9:   workflow_dispatch:
   10: 
   11: permissions:
   12:   contents: write
   13: 
   14: jobs:
   15:   # ---------------------------------------------------------------------
   16:   # Windows: the ACTUAL shipped Windows deliverable is tools/iolab-launcher,
   17:   # a plain Go exe (browser-first GUI ƒ?" the Tauri/Rust shell under app/
   18:   # src-tauri was abandoned when the project pivoted browser-first and is
   19:   # not known to still build). Do not resurrect the Tauri bundle here.
   20:   # ---------------------------------------------------------------------
   21:   build-windows:
   22:     name: Build Windows launcher + capture-helper
   23:     runs-on: windows-latest
   24:     steps:
   25:       # fetch-depth: 0 so `git describe --tags` (used by build-release.sh
   26:       # in the Linux job, and good practice here too for parity) sees real
   27:       # tag history instead of the shallow single commit `checkout` gives
   28:       # by default.
   29:       - uses: actions/checkout@v4
   30:         with:
   31:           fetch-depth: 0
   32: 
   33:       - uses: actions/setup-go@v5
   34:         with:
   35:           go-version: "1.26"
   36: 
   37:       - name: Vet + test iolab-launcher
   38:         working-directory: tools/iolab-launcher
   39:         run: |
   40:           go vet ./...
   41:           go test ./...
   42: 
   43:       - name: Build iolbox-launcher.exe
   44:         working-directory: tools/iolab-launcher
   45:         run: go build -o iolbox-launcher.exe .
   46: 
   47:       - name: Vet + test capture-helper
   48:         working-directory: tools/capture-helper
   49:         run: |
   50:           go vet ./...
   51:           go test ./...
   52: 
   53:       - name: Build capture-helper.exe
   54:         working-directory: tools/capture-helper
   55:         run: go build -o capture-helper.exe .
   56: 
   57:       # NOTE: both exes are UNSIGNED. A code-signing step (e.g. Azure Trusted
   58:       # Signing, or a self-hosted signtool + cert) slots in here later,
   59:       # between the build steps above and this upload. Until then, Windows
   60:       # SmartScreen will warn on first run ƒ?" expected, not a CI bug.
   61:       #
   62:       # NOTE: this job does NOT assemble the full launcher bundle (the
   63:       # qemu/ subdirectory and iolbox-disk.qcow2 that tools/iolab-launcher
   64:       # expects alongside it ƒ?" see runtime/pack-qemu.sh and docs/INSTALL.md
   65:       # "QEMU disk (Windows launcher)"). Neither qemu's third-party binaries
   66:       # nor the multi-GB qcow2 disk live in this repo, so that bundle is
   67:       # assembled by hand on the private builder and attached to the draft
   68:       # release alongside this job's two exes.
   69:       - uses: actions/upload-artifact@v4
   70:         with:
   71:           name: iolbox-windows
   72:           path: |
   73:             tools/iolab-launcher/iolbox-launcher.exe
   74:             tools/capture-helper/capture-helper.exe
   75: 
   76:   # ---------------------------------------------------------------------
   77:   # Linux: builds the GUI-embedded supervisor the ONLY correct way, then
   78:   # bakes every Linux-hostable packaging target that doesn't need loop
   79:   # devices/chroot/grub (those three ƒ?" vmdk/vmx, OVA, qcow2 ƒ?" need a
   80:   # root-capable builder and are attached to the release by hand; see the
   81:   # release job's draft body).
   82:   # ---------------------------------------------------------------------
   83:   build-linux:
   84:     name: Build supervisor + Linux packaging targets
   85:     runs-on: ubuntu-latest
   86:     steps:
   87:       - uses: actions/checkout@v4
   88:         with:
   89:           # build-release.sh stamps the binary's version via
   90:           # `git describe --tags`; a shallow checkout has no tag history,
   91:           # so the stamp silently degrades to a bare commit hash instead of
   92:           # e.g. "v0.4.0". fetch-depth 0 keeps that stamp meaningful.
   93:           fetch-depth: 0
   94: 
   95:       - uses: actions/setup-go@v5
   96:         with:
   97:           go-version: "1.26"
   98: 
   99:       - uses: actions/setup-node@v4
  100:         with:
  101:           node-version: "20"
  102:           cache: npm
  103:           cache-dependency-path: app/package-lock.json
  104: 
  105:       - name: Install frontend deps
  106:         working-directory: app
  107:         run: npm ci
  108: 
  109:       # THE ONLY correct way to produce a deployable supervisor binary.
  110:       # build-release.sh runs `npm run build:embed` before compiling and
  111:       # then asserts the embedded index.html isn't the committed
  112:       # placeholder. A bare `go build ./cmd/supervisor` skips build:embed
  113:       # entirely and ships that placeholder ("GUI not bundled in this
  114:       # build") straight into a release artifact ƒ?" which is exactly what
  115:       # the previous version of this workflow did. Never shortcut this.
  116:       # Both architectures are built by ONE invocation on purpose. The script
  117:       # runs `npm run build:embed` once and restores the committed placeholder
  118:       # when it exits, so any compile placed after it in this job would embed
  119:       # the placeholder instead of the real GUI. One invocation, one embed,
  120:       # two binaries that provably carry the same bundle.
  121:       - name: Build supervisors (build-release.sh ƒ?" GUI embedded, amd64 + arm64)
  122:         run: bash build-release.sh --arch amd64,arm64
  123: 
  124:       # gcc-aarch64-linux-gnu is needed only for the arm64 VPCS build below:
  125:       # VPCS is C, so unlike every Go component it cannot be cross-compiled by
  126:       # the toolchain we already have.
  127:       - name: Install rootfs/packaging build deps
  128:         run: |
  129:           sudo apt-get update
  130:           sudo apt-get install -y debootstrap zstd build-essential gcc-aarch64-linux-gnu
  131: 
  132:       # fetch-vpcs.sh needs git + make + a C compiler (all covered by
  133:       # build-essential + the runner's preinstalled git) to clone and
  134:       # statically link the GNS3/vpcs fork; it caches its output at
  135:       # runtime/build/vpcs/vpcs and no-ops on a second run if that binary
  136:       # already exists. build-rootfs.sh does NOT call it automatically ƒ?"
  137:       # it hard-fails if the vpcs binary is missing ƒ?" so it must run here
  138:       # as an explicit step before build-rootfs.sh.
  139:       - name: Fetch/build VPCS
  140:         run: runtime/fetch-vpcs.sh
  141: 
  142:       # build-rootfs.sh must run as root (debootstrap needs to mknod/chroot).
  143:       # Its defaults already match this job's layout: --supervisor-bin
  144:       # defaults to supervisor/bin/supervisor-linux-amd64 (build-release.sh's
  145:       # output) and --build-dir defaults to runtime/build (fetch-vpcs.sh's
  146:       # cache location), so no flags are needed here.
  147:       - name: Bake shared rootfs
  148:         run: sudo runtime/build-rootfs.sh
  149: 
  150:       # pack-wsl.sh doesn't strictly need root (plain tar of an existing
  151:       # dir) but debootstrap can leave a few root-only files behind, so run
  152:       # it as root too, per its own header comment.
  153:       - name: Pack WSL rootfs tarball
  154:         run: sudo runtime/pack-wsl.sh --build-dir runtime/build
  155: 
  156:       # workflow_dispatch runs (no tag) have no meaningful semver ƒ?" fall
  157:       # back to the branch/ref name, which pack-lxc.sh only uses as an
  158:       # opaque label in the output filename (iolbox-ct-<VERSION>.tar.zst).
  159:       - name: Resolve version string
  160:         id: version
  161:         shell: bash
  162:         run: echo "value=${GITHUB_REF_NAME//\//-}" >> "$GITHUB_OUTPUT"
  163: 
  164:       - name: Pack Proxmox LXC template
  165:         run: sudo runtime/pack-lxc.sh --build-dir runtime/build --version "${{ steps.version.outputs.value }}"
  166: 
  167:       # pack-native.sh does NOT consume the debootstrap rootfs at all ƒ?" per
  168:       # its own header, a native install runs on the operator's own distro,
  169:       # so it only needs the supervisor + vpcs binaries plus files under
  170:       # runtime/files/{,native/}. It could run before build-rootfs.sh, but
  171:       # is kept after here so every packaging step reads top-to-bottom in
  172:       # one pass; it needs no root (no loop devices/chroot involved).
  173:       - name: Pack native (systemd) server tarball
  174:         run: runtime/pack-native.sh --supervisor-bin supervisor/bin/supervisor-linux-amd64 --build-dir runtime/build --version "${{ steps.version.outputs.value }}"
  175: 
  176:       # --- linux/arm64 payload, for the macOS native-arm64 profile only ------
  177:       #
  178:       # IOLBOX_BUILD_DIR must differ from the amd64 build dir: fetch-vpcs.sh
  179:       # writes $BUILD_DIR/vpcs/vpcs for BOTH architectures and short-circuits
  180:       # if that file already exists, so reusing runtime/build would silently
  181:       # skip this build and leave the amd64 binary in place.
  182:       - name: Build VPCS for linux/arm64
  183:         env:
  184:           IOLBOX_BUILD_DIR: runtime/build-arm64
  185:           VPCS_CC: aarch64-linux-gnu-gcc
  186:         run: runtime/fetch-vpcs.sh --arch arm64
  187: 
  188:       # --out runtime/build so the tarball lands beside the amd64 one for the
  189:       # shared checksum manifest; --build-dir keeps its vpcs/toollaunch/pack
  190:       # staging separate. pack-native.sh cross-compiles toollaunch and every
  191:       # tool pack for the target arch itself and hard-fails on a wrong ELF.
  192:       - name: Pack native (systemd) server tarball ƒ?" linux/arm64
  193:         run: |
  194:           runtime/pack-native.sh --arch arm64 \
  195:             --supervisor-bin supervisor/bin/supervisor-linux-arm64 \
  196:             --build-dir runtime/build-arm64 \
  197:             --out runtime/build \
  198:             --version "${{ steps.version.outputs.value }}"
  199: 
  200:       # Two manifests on purpose. SHA256SUMS-ci.txt is itself a PUBLISHED
  201:       # release asset, so it must list exactly the files that are published ƒ?"
  202:       # if it named the macOS-only arm64 payload, `sha256sum -c SHA256SUMS-ci.txt`
  203:       # against the downloaded release assets would fail on a missing file.
  204:       # The arm64 payload gets its own manifest, travelling with it in the
  205:       # CI-only artifact that build-macos consumes.
  206:       - name: Generate checksums
  207:         working-directory: runtime/build
  208:         env:
  209:           VERSION: ${{ steps.version.outputs.value }}
  210:         run: |
  211:           sha256sum iolbox-rootfs.tar iolbox-ct-*.tar.zst "iolbox-server-${VERSION}.tar.gz" > SHA256SUMS-ci.txt
  212:           cat SHA256SUMS-ci.txt
  213:           sha256sum "iolbox-server-${VERSION}-linux-arm64.tar.gz" > SHA256SUMS-macos-arm64.txt
  214:           cat SHA256SUMS-macos-arm64.txt
  215: 
  216:       # PUBLISHED Linux artifacts. The paths are listed EXPLICITLY rather than
  217:       # globbed: the release job publishes iolbox-linux/**/* wholesale, so a
  218:       # wildcard here would silently turn the macOS-only arm64 payload into a
  219:       # public standalone Linux release asset ƒ?" an extra shipped target with
  220:       # its own support expectations that nobody asked for. If a standalone
  221:       # linux/arm64 server target is ever wanted, that is a deliberate product
  222:       # decision with its own docs and install guide, not a side effect.
  223:       - uses: actions/upload-artifact@v4
  224:         with:
  225:           name: iolbox-linux
  226:           path: |
  227:             runtime/build/iolbox-rootfs.tar
  228:             runtime/build/iolbox-ct-*.tar.zst
  229:             runtime/build/iolbox-server-${{ steps.version.outputs.value }}.tar.gz
  230:             runtime/build/SHA256SUMS-ci.txt
  231: 
  232:       # CI-ONLY artifact: consumed by build-macos, never published. It carries
  233:       # the checksum manifest too so build-macos can authenticate the payload
  234:       # the same way it authenticates the amd64 one.
  235:       - uses: actions/upload-artifact@v4
  236:         with:
  237:           name: iolbox-macos-payload-arm64
  238:           path: |
  239:             runtime/build/iolbox-server-${{ steps.version.outputs.value }}-linux-arm64.tar.gz
  240:             runtime/build/SHA256SUMS-macos-arm64.txt
  241: 
  242:   # ---------------------------------------------------------------------
  243:   # macOS: package the Darwin launcher with the exact payloads from
  244:   # build-linux above ƒ?" the untagged amd64 one for the Rosetta profiles and
  245:   # the linux/arm64 one for the native-arm64 profile. This job never rebuilds
  246:   # a payload and never discovers one by searching; both are named exactly and
  247:   # verified against build-linux's checksum manifest before packing.
  248:   # ---------------------------------------------------------------------
  249:   build-macos:
  250:     name: Build Apple Silicon macOS archive
  251:     needs: build-linux
  252:     runs-on: ubuntu-latest
  253:     steps:
  254:       - uses: actions/checkout@v4
  255:         with:
  256:           fetch-depth: 0
  257: 
  258:       - uses: actions/setup-go@v5
  259:         with:
  260:           go-version: "1.26"
  261:           cache-dependency-path: tools/iolab-launcher/go.mod
  262: 
  263:       - uses: actions/download-artifact@v4
  264:         with:
  265:           name: iolbox-linux
  266:           path: linux-artifact
  267: 
  268:       - uses: actions/download-artifact@v4
  269:         with:
  270:           name: iolbox-macos-payload-arm64
  271:           path: linux-artifact-arm64
  272: 
  273:       - name: Resolve release/ref version and source date
  274:         id: version
  275:         shell: bash
  276:         run: |
  277:           set -euo pipefail
  278:           version="${GITHUB_REF_NAME//\//-}"
  279:           test -n "$version"
  280:           epoch="$(git show -s --format=%ct "$GITHUB_SHA")"
  281:           echo "value=$version" >> "$GITHUB_OUTPUT"
  282:           echo "source-date-epoch=$epoch" >> "$GITHUB_OUTPUT"
  283: 
  284:       # Both payloads go through the SAME authentication: exactly one file of
  285:       # the expected name, exactly one well-formed checksum manifest, exactly
  286:       # one line in it for that basename, and a real sha256sum -c. The logic
  287:       # is a shell function invoked twice rather than copied, so the two
  288:       # cannot drift apart ƒ?" this is the security-relevant step of the job.
  289:       - name: Select and verify exact build-linux payloads
  290:         id: payload
  291:         shell: bash
  292:         env:
  293:           VERSION: ${{ steps.version.outputs.value }}
  294:         run: |
  295:           set -euo pipefail
  296: 
  297:           select_and_verify() {
  298:             local label="$1" root="$2" want="$3" manifest="$4"
  299:             local payload base checksums expected
  300:             mapfile -t payloads < <(find "$root" -type f -name "$want" -print)
  301:             test "${#payloads[@]}" -eq 1
  302:             payload="${payloads[0]}"
  303:             base="$(basename "$payload")"
  304:             mapfile -t checksum_files < <(find "$root" -type f -name "$manifest" -print)
  305:             test "${#checksum_files[@]}" -eq 1
  306:             checksums="${checksum_files[0]}"
  307:             expected="$(awk -v b="$base" '
  308:               BEGIN { bad=0; matches=0; digest="" }
  309:               NF != 2 || length($1) != 64 || $1 !~ /^[0-9A-Fa-f]+$/ || $2 !~ /^\*?[^[:space:]]+$/ { bad=1 }
  310:               $2 == b || $2 == "*" b { matches++; digest=$1 }
  311:               END {
  312:                 if (bad || matches != 1) exit 1
  313:                 print digest
  314:               }
  315:             ' "$checksums")" || {
  316:               echo "checksum manifest is malformed or does not contain exactly one line for $base" >&2
  317:               exit 1
  318:             }
  319:             printf '%s' "$expected" | grep -Eq '^[0-9A-Fa-f]{64}$'
  320:             ( cd "$(dirname "$payload")" && printf '%s  %s\n' "$expected" "$base" | sha256sum -c - )
  321:             echo "${label}path=$payload" >> "$GITHUB_OUTPUT"
  322:             echo "${label}basename=$base" >> "$GITHUB_OUTPUT"
  323:             echo "${label}sha256=$expected" >> "$GITHUB_OUTPUT"
  324:             echo "build-linux payload ($label): $payload"
  325:             echo "trusted payload sha256 ($label): $expected"
  326:           }
  327: 
  328:           select_and_verify "" linux-artifact "iolbox-server-${VERSION}.tar.gz" SHA256SUMS-ci.txt
  329:           select_and_verify "arm64-" linux-artifact-arm64 "iolbox-server-${VERSION}-linux-arm64.tar.gz" SHA256SUMS-macos-arm64.txt
  330: 
  331:       - name: Vet and test launcher
  332:         working-directory: tools/iolab-launcher
  333:         run: |
  334:           go vet ./...
  335:           go test ./...
  336: 
  337:       - name: Cross-build Darwin arm64 launcher
  338:         working-directory: tools/iolab-launcher
  339:         run: |
  340:           mkdir -p bin
  341:           CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build -o bin/iolbox-darwin-arm64 .
  342: 
  343:       - name: Pack deterministic macOS archive
  344:         env:
  345:           VERSION: ${{ steps.version.outputs.value }}
  346:           SOURCE_DATE_EPOCH: ${{ steps.version.outputs.source-date-epoch }}
  347:           PAYLOAD: ${{ steps.payload.outputs.path }}
  348:           PAYLOAD_SHA256: ${{ steps.payload.outputs.sha256 }}
  349:           PAYLOAD_ARM64: ${{ steps.payload.outputs.arm64-path }}
  350:           PAYLOAD_ARM64_SHA256: ${{ steps.payload.outputs.arm64-sha256 }}
  351:         shell: bash
  352:         run: |
  353:           set -euo pipefail
  354:           bash packaging/macos/pack-release.sh \
  355:             --launcher "$GITHUB_WORKSPACE/tools/iolab-launcher/bin/iolbox-darwin-arm64" \
  356:             --payload "$GITHUB_WORKSPACE/$PAYLOAD" \
  357:             --payload-sha256 "$PAYLOAD_SHA256" \
  358:             --payload-arm64 "$GITHUB_WORKSPACE/$PAYLOAD_ARM64" \
  359:             --payload-arm64-sha256 "$PAYLOAD_ARM64_SHA256" \
  360:             --version "$VERSION" \
  361:             --output "$GITHUB_WORKSPACE/iolbox-macos-arm64.tar.gz" \
  362:             --source-date-epoch "$SOURCE_DATE_EPOCH"
  363: 
  364:       - name: Verify archive layout and reproducibility
  365:         env:
  366:           VERSION: ${{ steps.version.outputs.value }}
  367:           SOURCE_DATE_EPOCH: ${{ steps.version.outputs.source-date-epoch }}
  368:           PAYLOAD: ${{ steps.payload.outputs.path }}
  369:           PAYLOAD_SHA256: ${{ steps.payload.outputs.sha256 }}
  370:           PAYLOAD_ARM64: ${{ steps.payload.outputs.arm64-path }}
  371:           PAYLOAD_ARM64_SHA256: ${{ steps.payload.outputs.arm64-sha256 }}
  372:         shell: bash
  373:         run: |
  374:           set -euo pipefail
  375:           bash packaging/macos/tests/release-layout-test.sh \
  376:             --archive "$GITHUB_WORKSPACE/iolbox-macos-arm64.tar.gz" \
  377:             --launcher "$GITHUB_WORKSPACE/tools/iolab-launcher/bin/iolbox-darwin-arm64" \
  378:             --payload "$GITHUB_WORKSPACE/$PAYLOAD" \
  379:             --payload-sha256 "$PAYLOAD_SHA256" \
  380:             --payload-arm64 "$GITHUB_WORKSPACE/$PAYLOAD_ARM64" \
  381:             --payload-arm64-sha256 "$PAYLOAD_ARM64_SHA256" \
  382:             --version "$VERSION" \
  383:             --source-date-epoch "$SOURCE_DATE_EPOCH"
  384:           echo "--- tar listing ---"
  385:           tar -tzf "$GITHUB_WORKSPACE/iolbox-macos-arm64.tar.gz"
  386:           echo "--- internal checksums ---"
  387:           work="$(mktemp -d)"
  388:           trap 'rm -rf "$work"' EXIT
  389:           tar -xzf "$GITHUB_WORKSPACE/iolbox-macos-arm64.tar.gz" -C "$work"
  390:           ( cd "$work/iolbox-macos-arm64" && sha256sum -c SHA256SUMS )
  391:           echo "--- launcher file ---"
  392:           file "$work/iolbox-macos-arm64/iolbox"
  393:           echo "--- archive hash ---"
  394:           sha256sum "$GITHUB_WORKSPACE/iolbox-macos-arm64.tar.gz"
  395: 
  396:       - uses: actions/upload-artifact@v4
  397:         with:
  398:           name: iolbox-macos
  399:           path: |
  400:             iolbox-macos-arm64.tar.gz
  401:             iolbox-macos-arm64.tar.gz.sha256
  402: 
  403:   # ---------------------------------------------------------------------
  404:   # Release: only on an actual tag push (workflow_dispatch runs stop after
  405:   # producing/testing artifacts ƒ?" no draft is created). Published as a
  406:   # DRAFT, never live, because three artifacts CI cannot build (vmdk/vmx,
  407:   # OVA, qcow2 ƒ?" all need loop devices/chroot/grub on a root-capable
  408:   # builder) plus the Windows launcher's qemu+disk bundle must be attached
  409:   # by hand before this is fit to publish.
  410:   # ---------------------------------------------------------------------
  411:   release:
  412:     name: Draft GitHub Release
  413:     needs: [build-windows, build-linux, build-macos]
  414:     runs-on: ubuntu-latest
  415:     if: startsWith(github.ref, 'refs/tags/')
  416:     steps:
  417:       - uses: actions/download-artifact@v4
  418: 
  419:       - name: Publish draft GitHub Release
  420:         uses: softprops/action-gh-release@v2
  421:         with:
  422:           draft: true
  423:           files: |
  424:             iolbox-windows/**/*
  425:             iolbox-linux/**/*
  426:             iolbox-macos/**/*
  427:           body: |
  428:             iolbox ${{ github.ref_name }}
  429: 
  430:             **Contains no Cisco software.** Supply your own IOL/IOU images
  431:             and hold the appropriate licenses for them.
  432: 
  433:             ---
  434: 
  435:             **THIS DRAFT IS INCOMPLETE.** CI only builds what it can build
  436:             without loop devices/chroot/grub or a real QEMU disk. Before
  437:             publishing, attach the following ƒ?" built by hand on the private
  438:             root-capable builder ƒ?" to this draft:
  439: 
  440:             - `iolbox-appliance-${{ github.ref_name }}.vmdk` + `.vmx` (VMware Workstation/Player drop-in appliance)
  441:             - `iolbox-appliance-${{ github.ref_name }}.ova` (ESXi / VirtualBox / generic OVF import)
  442:             - `iolbox-disk-${{ github.ref_name }}.qcow2` + the Windows launcher bundle zip (qemu/ + iolbox-launcher.exe + iolbox-disk.qcow2)
  443: 
  444:             Everything else ƒ?" `iolbox-rootfs.tar` (WSL2), `iolbox-ct-${{ github.ref_name }}.tar.zst` (Proxmox LXC), `iolbox-server-${{ github.ref_name }}.tar.gz` (native systemd), `iolbox-launcher.exe`, `capture-helper.exe`, `SHA256SUMS-ci.txt` ƒ?" is already attached by this workflow.
  445: 
  446:             **Apple Silicon macOS (Lima):** the Mac archive requires user-installed Lima and ships **two** Linux payloads; the launcher selects one from the profile it resolves.
  447: 
  448:             - **native-arm64** runs the supervisor, VPCS, and tool packs as **real arm64 binaries** on a Debian 13/trixie guest with the pinned 6.12.101+deb13-cloud-arm64 kernel. x86_64 IOL is still translated, by **qemu-user inside the guest** (installed from Debian at provisioning time), not by Rosetta.
  449:             - **Rosetta profiles** ƒ?" `debian13` (default guest) and `jammy` (compatibility, pinned to the qualified 5.15 line) ƒ?" are unchanged and run the existing amd64 payload under Rosetta.
  450:             - On a qualifying Apple Silicon host with **no existing iolbox install**, `auto` now prefers **native-arm64**. An **existing** install keeps its current profile and Lima machine; migrate deliberately with `--profile native-arm64`. To stay on Rosetta explicitly, set `IOLBOX_PROFILE=rosetta-amd64`. `auto` falls back to Rosetta whenever the native preflight fails; a forced `--profile native-arm64` fails closed instead.
  451:             - **x86_64 IOL only, on both profiles.** i386/i86bi remain unsupported, and arm64-native IOL remains unsupported.
  452:             - native-arm64 has **no host qualification row**, so the launcher reports it as `UNMEASURED ƒ?" CANARY REQUIRED`. It is gated at runtime by its own fail-closed canary, not by a prior qualification result.
  453: 
  454:             The archive is unsigned: verify its outer and internal SHA-256 files, inspect quarantine, and if the launcher is quarantined remove that attribute from the launcher only with `xattr -d com.apple.quarantine ./iolbox` before `./iolbox start`. GUI, console, and capture forwards are loopback-only and unauthenticated. No Cisco software is included.
  455: 
  456:             See [docs/INSTALL.md](https://github.com/${{ github.repository }}/blob/main/docs/INSTALL.md) for which artifact matches your situation, and un-draft only once the manually-built artifacts above are attached.
