   42: func collectHostFacts(ctx context.Context) hostFacts {
   43: 	facts := hostFacts{}
   44: 	facts.System, _ = runHostFact(ctx, "uname", "-s")
   45: 	facts.Arch, _ = runHostFact(ctx, "uname", "-m")
   46: 	facts.Product, _ = runHostFact(ctx, "sw_vers", "-productVersion")
   47: 	facts.Build, _ = runHostFact(ctx, "sw_vers", "-buildVersion")
   48: 	home, err := os.UserHomeDir()
   49: 	if err != nil {
   50: 		facts.FreeDiskErr = err
   51: 		return facts
   52: 	}
   53: 	out, err := runHostFact(ctx, "df", "-Pk", home)
   54: 	if err != nil {
   55: 		facts.FreeDiskErr = err
   56: 		return facts
   57: 	}
   58: 	lines := strings.Split(out, "\n")
   59: 	if len(lines) < 2 {
   60: 		facts.FreeDiskErr = errors.New("df output has no data row")
   61: 		return facts
   62: 	}
   63: 	fields := strings.Fields(lines[len(lines)-1])
   64: 	if len(fields) < 4 {
   65: 		facts.FreeDiskErr = errors.New("df output has too few fields")
   66: 		return facts
   67: 	}
   68: 	facts.FreeDiskKB, err = strconv.ParseInt(fields[3], 10, 64)
   69: 	if err != nil {
   70: 		facts.FreeDiskErr = err
   71: 	}
   72: 	return facts
   73: }
