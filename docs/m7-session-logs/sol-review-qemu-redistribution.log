  302: func ensureMachine(ctx context.Context, l *limaClient, machine, state, template, attestationPath string, validAttestation func() error) (bool, error) {
  303: 	return ensureMachineWithPorts(ctx, l, machine, state, template, attestationPath, validAttestation, nil)
  304: }
  305: 
  306: func ensureMachineWithPorts(ctx context.Context, l *limaClient, machine, state, template, attestationPath string, validAttestation func() error, ports *darwinPortContract) (bool, error) {
  307: 	created := false
  308: 	if ports != nil && !strings.EqualFold(state, "running") {
  309: 		if err := preflightDarwinPorts(*ports); err != nil {
  310: 			return false, err
  311: 		}
  312: 	}
  313: 	if state == "" {
  314: 		if attestationPath != "" {
  315: 			if err := os.Remove(attestationPath); err != nil && !errors.Is(err, os.ErrNotExist) {
  316: 				return false, fmt.Errorf("remove stale attestation: %w", err)
  317: 			}
  318: 		}
  319: 		if err := l.create(ctx, machine, template); err != nil {
  320: 			return false, err
  321: 		}
  322: 		created = true
  323: 		state = "Stopped"
  324: 	}
  325: 	switch strings.ToLower(state) {
  326: 	case "running":
  327: 		if ports != nil {
  328: 			compliant, err := l.hasDarwinPortContract(machine, *ports)
  329: 			if err != nil {
  330: 				return false, codedError(exitPreflight, "could not inspect Lima port contract for running machine %q: %v; stop then start to migrate", machine, err)
  331: 			}
  332: 			if !compliant {
  333: 				return false, codedError(exitPreflight, "running machine %q does not have the Darwin M3 port contract; stop then start to migrate", machine)
  334: 			}
  335: 
  336: 		}
  337: 		return created, nil
  338: 	case "stopped":
  339: 		if !created && validAttestation != nil {
  340: 			if err := validAttestation(); err != nil {
  341: 				return false, codedError(exitPreflight, "refusing to start stopped machine %q: %v", machine, err)
  342: 			}
  343: 		}
  344: 		if ports != nil {
  345: 			if err := l.startWithPortContract(ctx, machine, *ports); err != nil {
  346: 				return false, err
  347: 			}
  348: 		} else if err := l.start(ctx, machine); err != nil {
  349: 			return false, err
  350: 		}
  351: 		return created, nil
  352: 	default:
  353: 		return false, codedError(exitPreflight, "refusing to start machine %q in unrecognized state %q", machine, state)
  354: 	}
  355: }
  356: 
  357: func stopMachine(ctx context.Context, l *limaClient, machine, state string, timeout time.Duration) error {
  358: 	switch strings.ToLower(state) {
  359: 	case "", "stopped":
  360: 		return nil
  361: 	case "running":
  362: 		if err := l.stop(ctx, machine); err != nil {
  363: 			return codedError(exitPreflight, "%v", err)
  364: 		}
  365: 		return waitForMachineState(ctx, l, machine, "stopped", timeout)
  366: 	default:
  367: 		return codedError(exitPreflight, "cannot stop machine %q in unrecognized state %q", machine, state)
  368: 	}
  369: }
  370: 
  371: func waitForMachineState(ctx context.Context, l *limaClient, machine, wanted string, timeout time.Duration) error {
  372: 	if timeout <= 0 {
  373: 		timeout = time.Minute
  374: 	}
  375: 	ctx, cancel := context.WithTimeout(ctx, timeout)
  376: 	defer cancel()
  377: 	ticker := time.NewTicker(200 * time.Millisecond)
  378: 	defer ticker.Stop()
  379: 	for {
  380: 		machines, err := l.list(ctx)
  381: 		if err == nil {
  382: 			if state, ok := findMachine(machines, machine); ok && strings.EqualFold(state, wanted) {
  383: 				return nil
  384: 			}
  385: 		}
  386: 		select {
  387: 		case <-ctx.Done():
  388: 			return codedError(exitPreflight, "timed out waiting for machine %q to become %s", machine, wanted)
  389: 		case <-ticker.C:
  390: 		}
  391: 	}
  392: }
  393: 
  394: func stageFiles(ctx context.Context, l *limaClient, machine string, p macOSProfile, payloadPath, payloadBase string) error {
  395: 	const stageDir = "/tmp/iolbox-provision-stage"
  396: 	const stagePayload = "/tmp/iolbox-payload.tar.gz"
  397: 	const newDir = "/tmp/iolbox-provision-new"
  398: 	const provisionDir = "/opt/iolbox-provision"
  399: 
  400: 	// Build and validate a full replacement tree under newDir before touching
  401: 	// provisionDir, so a failed copy/flatten never leaves the live directory
  402: 	// the structural canary gate depends on empty or partial.
  403: 	if _, err := l.shell(ctx, machine, "sudo", "-n", "rm", "-rf", stageDir, newDir); err != nil {
  404: 		return codedError(exitPreflight, "clear guest staging: %v", err)
  405: 	}
  406: 	if err := l.copy(ctx, p.GuestDir, machine+":"+stageDir); err != nil {
  407: 		return codedError(exitPreflight, "copy guest scripts: %v", err)
  408: 	}
  409: 	if err := l.copy(ctx, payloadPath, machine+":"+stagePayload); err != nil {
  410: 		return codedError(exitPreflight, "copy payload: %v", err)
  411: 	}
  412: 	if _, err := l.shell(ctx, machine, "sudo", "-n", "mkdir", "-p", newDir+"/payload"); err != nil {
  413: 		return codedError(exitPreflight, "create guest staging tree: %v", err)
  414: 	}
  415: 	flatten := "set -e; src=\"$(find '" + stageDir + "' -name 'lib.sh' -print -quit)\"; [ -n \"$src\" ]; src=\"$(dirname \"$src\")\"; cp -f \"$src\"/*.sh '" + newDir + "/'; chmod 0755 '" + newDir + "'/*.sh; rm -rf '" + stageDir + "'"
  416: 	if _, err := l.shell(ctx, machine, "sudo", "-n", "sh", "-c", flatten); err != nil {
  417: 		return codedError(exitPreflight, "flatten guest scripts: %v", err)
  418: 	}
  419: 	if _, err := l.shell(ctx, machine, "sudo", "-n", "mv", stagePayload, newDir+"/payload/"+payloadBase); err != nil {
  420: 		return codedError(exitPreflight, "install guest payload: %v", err)
  421: 	}
  422: 	if _, err := l.shell(ctx, machine, "sudo", "-n", "test", "-f", newDir+"/30-canary.sh"); err != nil {
  423: 		return codedError(exitUsage, "staging failed: %s/30-canary.sh is missing", newDir)
  424: 	}
  425: 
  426: 	// Only now, with a fully validated replacement in hand, swap it into
  427: 	// place. rm+mv run as a single guest command to minimize the window
  428: 	// during which provisionDir is absent.
  429: 	swap := "set -e; rm -rf '" + provisionDir + "'; mv '" + newDir + "' '" + provisionDir + "'"
  430: 	if _, err := l.shell(ctx, machine, "sudo", "-n", "sh", "-c", swap); err != nil {
  431: 		return codedError(exitPreflight, "install guest provision directory: %v", err)
  432: 	}
  433: 	if _, err := l.shell(ctx, machine, "sudo", "-n", "test", "-f", provisionDir+"/30-canary.sh"); err != nil {
  434: 		return codedError(exitUsage, "staging failed: %s/30-canary.sh is missing after install", provisionDir)
  435: 	}
  436: 	return nil
  437: }
