   33: func runHostFact(ctx context.Context, name string, args ...string) (string, error) {
   34: 	out, err := (execRunner{}).Run(ctx, name, args...)
   35: 	value := strings.TrimSpace(string(out))
   36: 	if err != nil {
   37: 		return value, err
   38: 	}
   39: 	return value, nil
   40: }
