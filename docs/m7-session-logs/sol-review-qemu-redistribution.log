  309: func runGuestSequence(ctx context.Context, l *limaClient, machine string, p macOSProfile, facts hostFacts, limaVersion, payloadBase string, config lifecycleConfig) error {
  310: 	env := guestEnvironment(p, facts, limaVersion, machine, payloadBase, config)
  311: 	canaryStep := p.canaryStep()
  312: 	steps := []string{p.MultiarchStep, p.KernelHoldStep, canaryStep, p.installStep(), p.verifyStep()}
  313: 	for _, step := range steps {
  314: 		err := guestStep(ctx, l, machine, step, env)
  315: 		if step == canaryStep {
  316: 			if err != nil {
  317: 				_ = recordCanary(machine, facts, limaVersion, "fail", exitCodeFor(err))
  318: 				return err
  319: 			}
  320: 			_ = recordCanary(machine, facts, limaVersion, "pass", 0)
  321: 		}
  322: 		if err != nil {
  323: 			return err
  324: 		}
  325: 	}
  326: 	return syncGuestAttestation(ctx, l, machine, p, facts, limaVersion)
  327: }
  328: 
  329: func exitCodeFor(err error) int {
  330: 	var coded *launcherError
  331: 	if errors.As(err, &coded) {
  332: 		return coded.code
  333: 	}
  334: 	return childExitCode(err)
  335: }
