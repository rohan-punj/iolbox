  213: 		"IOLBOX_HOST_MACOS_PRODUCT": facts.Product,
  214: 		"IOLBOX_HOST_MACOS_BUILD":   facts.Build,
  215: 		"IOLBOX_HOST_LIMA":          limaVersion,
  216: 		"IOLBOX_MACHINE":            machine,
  217: 		"IOLBOX_PROFILE":            p.Name,
  218: 		"IOLBOX_PROFILE_STATUS":     p.Role,
  219: 		"IOLBOX_KERNEL_SERIES":      kernelRuntimeSeries(p.KernelSeries),
  220: 		"IOLBOX_EXPECTED_UNAME_R":   p.ExpectedUnameR,
  221: 		"IOLBOX_PROVISION_DIR":      "/opt/iolbox-provision",
  222: 		"IOLBOX_PAYLOAD_TARBALL":    "/opt/iolbox-provision/payload/" + payloadBase,
  223: 		"IOLBOX_BIND":               bind,
  224: 		// This is consumed inside the guest by the provisioning and verify
  225: 		// scripts.  The host-side forwarding port is allowed to differ when
  226: 		// another Lima machine owns 4001.
  227: 		"IOLBOX_GUI_PORT": strconv.Itoa(darwinGUIGuestPort),
  228: 	}
  229: }
