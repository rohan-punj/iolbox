  187: func renderTemplate(template []byte, p macOSProfile) ([]byte, error) {
  188: 	return renderTemplateForPort(template, p, defaultDarwinGUIPort)
  189: }
  190: 
  191: func renderTemplateForPort(template []byte, p macOSProfile, guiPort int) ([]byte, error) {
  192: 	contract, err := newDarwinPortContract(guiPort)
  193: 	if err != nil {
  194: 		return nil, err
  195: 	}
  196: 	rendered := string(template)
  197: 	// The supervisor's GUI listener remains fixed at the guest-side 4001
  198: 	// socket.  IOLBOX_GUI_PORT is a host-side escape hatch for Macs where the
  199: 	// default forwarding port is already occupied by another Lima machine.
  200: 	rendered = strings.ReplaceAll(rendered, "guestPort: @IOLBOX_GUI_PORT@", fmt.Sprintf("guestPort: %d", darwinGUIGuestPort))
  201: 	replacements := map[string]string{
  202: 		"@IOLBOX_IMAGE_URL@":    p.ImageURL,
  203: 		"@IOLBOX_IMAGE_DIGEST@": p.ImageDigest,
  204: 		"@CPUS@":                p.CPUs,
  205: 		"@MEMORY@":              p.Memory,
  206: 		"@DISK@":                p.Disk,
  207: 		"@IOLBOX_GUI_PORT@":     strconv.Itoa(contract.GUIPort),
  208: 	}
  209: 	for token, value := range replacements {
  210: 		rendered = strings.ReplaceAll(rendered, token, value)
  211: 	}
  212: 	for _, token := range regexp.MustCompile(`@[A-Z][A-Z0-9_]+@`).FindAllString(rendered, -1) {
  213: 		// The shipped Jammy/Bookworm comments use the prose marker @TOKEN@;
  214: 		// only actual all-caps field tokens are unresolved configuration.
  215: 		if token != "@TOKEN@" {
  216: 			return nil, fmt.Errorf("rendered Lima template still contains an unresolved placeholder")
  217: 		}
  218: 	}
  219: 	return []byte(rendered), nil
  220: }
  221: 
  222: func writeRenderedTemplate(dir string, p macOSProfile) (string, error) {
  223: 	return writeRenderedTemplateForPort(dir, p, defaultDarwinGUIPort)
  224: }
  225: 
  226: func writeRenderedTemplateForPort(dir string, p macOSProfile, guiPort int) (string, error) {
  227: 	data, err := os.ReadFile(p.TemplatePath)
  228: 	if err != nil {
  229: 		return "", err
  230: 	}
  231: 	rendered, err := renderTemplateForPort(data, p, guiPort)
  232: 	if err != nil {
  233: 		return "", err
  234: 	}
  235: 	f, err := os.CreateTemp(dir, "iolbox-*.yaml")
  236: 	if err != nil {
  237: 		return "", err
  238: 	}
  239: 	name := f.Name()
  240: 	defer func() {
  241: 		_ = f.Close()
  242: 	}()
  243: 	if err := f.Chmod(0o600); err != nil {
  244: 		_ = os.Remove(name)
  245: 		return "", err
  246: 	}
  247: 	if _, err := f.Write(rendered); err != nil {
  248: 		_ = os.Remove(name)
  249: 		return "", err
  250: 	}
  251: 	if err := f.Close(); err != nil {
  252: 		_ = os.Remove(name)
  253: 		return "", err
  254: 	}
  255: 	return name, nil
  256: }
