  445:         --create --gzip \
  446:         --file "$OUT_TAR" \
  447:         --directory "$STAGE_ROOT" \
  448:         --numeric-owner \
  449:         --owner=0 --group=0 \
  450:         --sort=name \
  451:         "$PKG_NAME"
  452: else
  453:     tar \
  454:         --create --gzip \
  455:         --file "$OUT_TAR" \
  456:         --directory "$STAGE_ROOT" \
  457:         --uid 0 --gid 0 \
  458:         "$PKG_NAME"
  459: fi
  460: 
  461: rm -rf "$STAGE_ROOT"
  462: 
