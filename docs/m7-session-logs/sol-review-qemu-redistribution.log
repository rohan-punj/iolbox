   82: func homePath(parts ...string) (string, error) {
   83: 	home, err := os.UserHomeDir()
   84: 	if err != nil {
   85: 		return "", err
   86: 	}
   87: 	return filepath.Join(append([]string{home}, parts...)...), nil
   88: }
   89: 
   90: // limaHomeDir resolves Lima's own data directory the same way limactl
   91: // itself does: $LIMA_HOME when set (any isolated Phase 4 LIMA_HOME
   92: // included), else ~/.lima. Every path this launcher builds to read a
   93: // machine's OWN Lima-managed files (its lima.yaml, its hostagent log) must
   94: // go through this, never a hardcoded ".lima".
   95: func limaHomeDir() (string, error) {
   96: 	if dir := os.Getenv("LIMA_HOME"); dir != "" {
   97: 		return dir, nil
   98: 	}
   99: 	home, err := os.UserHomeDir()
  100: 	if err != nil {
  101: 		return "", err
  102: 	}
  103: 	return filepath.Join(home, ".lima"), nil
  104: }
  105: 
  106: // limaHomePath joins limaHomeDir() with parts. Found on real hardware
  107: // (2026-08-19, physical Mac): every caller of this used to build
  108: // homePath(".lima", machine, ...) instead, which always resolved to the
  109: // real default ~/.lima regardless of $LIMA_HOME. Running under Phase 4's
  110: // own required isolated LIMA_HOME, a recovery attempt against an existing
  111: // (half-created) machine failed with "could not inspect Lima port contract
  112: // for running machine ...: open /Users/.../.lima/iolbox-native-arm64/
  113: // lima.yaml: no such file or directory" -- the real file was one directory
  114: // tree over, at $LIMA_HOME/iolbox-native-arm64/lima.yaml. M1-M6 never hit
  115: // this because they always ran against the real default ~/.lima.
  116: func limaHomePath(parts ...string) (string, error) {
  117: 	dir, err := limaHomeDir()
  118: 	if err != nil {
  119: 		return "", err
  120: 	}
  121: 	return filepath.Join(append([]string{dir}, parts...)...), nil
  122: }
