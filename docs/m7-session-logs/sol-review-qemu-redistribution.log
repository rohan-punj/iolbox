  190: func readCanaryState(machine string) string {
  191: 	path, err := canaryStatePath(machine)
  192: 	if err != nil {
  193: 		return "unavailable (" + err.Error() + ")"
  194: 	}
  195: 	data, err := os.ReadFile(path)
  196: 	if err != nil {
  197: 		return "unknown (no host-side canary result recorded)"
  198: 	}
