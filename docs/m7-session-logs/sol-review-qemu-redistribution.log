  263:     }
  264:     trap cleanup EXIT
  265: 
  266:     if tar -xzf "$IOLBOX_PAYLOAD_TARBALL" -C "$work_dir"; then
  267:         :
  268:     else
  269:         rc=$?
  270:         die "$rc" "payload extraction failed (exit $rc): tar -xzf $IOLBOX_PAYLOAD_TARBALL -C $work_dir"
  271:     fi
  272:     install_script="$(find "$work_dir" -type f -name install.sh -perm -u+x -print -quit 2>/dev/null || true)"
  273:     [ -n "$install_script" ] || die "$IOLBOX_EXIT_USAGE" \
  274:         "extracted payload does not contain an executable install.sh: $payload_name"
  275:     install_dir="$(dirname "$install_script")"
  276: 
  277:     # Unlike the Rosetta path, install.sh's uname -m check should now agree
  278:     # WITHOUT the "expected under Rosetta" caveat: this guest is genuinely
  279:     # aarch64 and the payload is genuinely aarch64.
  280:     if (cd "$install_dir" && ./install.sh --bind "$IOLBOX_BIND"); then
  281:         :
  282:     else
  283:         rc=$?
  284:         die "$rc" "payload installer failed (exit $rc): ./install.sh --bind $IOLBOX_BIND"
  285:     fi
  286: 
  287:     if [ -x /opt/iolbox/supervisor ]; then
