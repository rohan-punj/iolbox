  202: func guestEnvironment(p macOSProfile, facts hostFacts, limaVersion, machine, payloadBase string, config lifecycleConfig) map[string]string {
  203: 	bind := config.Bind
  204: 	if bind == "" {
  205: 		bind = "all"
  206: 	}
  207: 	guiPort := config.GUIPort
  208: 	if guiPort == 0 {
  209: 		guiPort = 4001
  210: 	}
  211: 	return map[string]string{
