  291:         else
  292:             warn "payload=$payload_version installed, but /opt/iolbox/supervisor --version could not be executed"
  293:         fi
  294:     else
  295:         log "installed version: payload=$payload_version"
  296:     fi
  297: 
  298:     reload_systemd
  299:     verify_gated_unit
  300:     if ! systemctl is-active --quiet iolbox-supervisor.service; then
  301:         die "$IOLBOX_EXIT_VERIFY" \
  302:             'structural gate failed: iolbox-supervisor.service did not become active after the gated start'
  303:     fi
  304:     write_structural_attestation
  305:     log "structural gate passed and attested at $IOLBOX_STRUCTURAL_GATE_JSON"
  306: }
