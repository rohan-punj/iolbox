  116: // isLimaLogNoise recognizes limactl's own logrus-style diagnostic lines
  117: // (e.g. `time="2026-08-19T14:23:44-04:00" level=warning msg="No instance
  118: // found. Run \`limactl create\` to create an instance."`), which land in
  119: // this parser's input because execRunner.Run uses CombinedOutput (stdout+
  120: // stderr merged) and limactl writes that particular warning to stderr.
  121: // Found on real hardware (2026-08-19, physical Mac): every M1-M6 session up
  122: // to now ran `limactl list` against ~/.lima, which by then already had a
  123: // machine registered from earlier development, so this line never
  124: // appeared. The very first Phase 4 run against a genuinely empty, isolated
  125: // LIMA_HOME (exactly the isolation scenario plan section 10 item 4 asks
  126: // for) hit it immediately: "iolbox-launcher: invalid Lima machine listing
  127: // line 1: ...No instance found...". A truly malformed data line (wrong
  128: // field count, empty name/state) must still fail closed; only limactl's own
  129: // recognizable log-line shape is treated as noise.
  130: func isLimaLogNoise(line string) bool {
  131: 	return strings.HasPrefix(line, `time="`) && strings.Contains(line, "level=")
  132: }
  133: 
  134: func parseMachineListing(output string) ([]machineInfo, error) {
  135: 	var machines []machineInfo
  136: 	for lineNo, line := range strings.Split(strings.ReplaceAll(output, "\r\n", "\n"), "\n") {
  137: 		line = strings.TrimSpace(line)
  138: 		if line == "" || isLimaLogNoise(line) {
  139: 			continue
  140: 		}
  141: 		fields := strings.Split(line, "|")
  142: 		if len(fields) != 2 || fields[0] == "" || fields[1] == "" {
  143: 			return nil, fmt.Errorf("invalid Lima machine listing line %d: %q", lineNo+1, line)
  144: 		}
  145: 		machines = append(machines, machineInfo{Name: fields[0], State: fields[1]})
  146: 	}
  147: 	return machines, nil
  148: }
