  287: func limaClientFor(ctx context.Context, path string, runner commandRunner) (*limaClient, limaInfo, error) {
  288: 	if path == "" {
  289: 		return nil, limaInfo{}, codedError(exitPreflight, "Lima was not found")
  290: 	}
  291: 	info := collectLimaInfo(ctx, path, runner)
  292: 	version := info.Version
  293: 	if version == "" {
  294: 		// D11: a found executable is never represented as unknown in the guest
  295: 		// environment. Preserve the raw diagnostic separately.
  296: 		version = "unparsed"
  297: 		info.Version = version
  298: 	}
  299: 	return &limaClient{info: info, runner: runnerOrExec(runner)}, info, nil
  300: }
  301: 
  302: func runnerOrExec(runner commandRunner) commandRunner {
  303: 	if runner == nil {
  304: 		return execRunner{}
  305: 	}
  306: 	return runner
  307: }
