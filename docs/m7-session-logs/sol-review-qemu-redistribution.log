  132: type structuralAttestation struct {
  133: 	Schema        int    `json:"schema"`
  134: 	Profile       string `json:"profile"`
  135: 	MacOSProduct  string `json:"macos_product"`
  136: 	MacOSBuild    string `json:"macos_build"`
  137: 	LimaVersion   string `json:"lima_version"`
  138: 	DropIn        string `json:"drop_in"`
  139: 	CanaryVerdict string `json:"canary_verdict"`
  140: 	Kernel        string `json:"kernel"`
  141: }
  142: 
  143: const expectedCanaryDropIn = "/etc/systemd/system/iolbox-supervisor.service.d/10-iolbox-macos-canary.conf"
  144: 
  145: func readAttestation(path string) (structuralAttestation, error) {
  146: 	data, err := os.ReadFile(path)
  147: 	if err != nil {
  148: 		return structuralAttestation{}, err
  149: 	}
  150: 	var att structuralAttestation
  151: 	if err := json.Unmarshal(data, &att); err != nil {
  152: 		return structuralAttestation{}, err
  153: 	}
  154: 	return att, nil
  155: }
  156: 
  157: func validateAttestation(path string, att structuralAttestation, p macOSProfile, facts hostFacts, limaVersion string) error {
  158: 	if att.Schema != 1 {
  159: 		return fmt.Errorf("attestation schema is %d, want 1", att.Schema)
  160: 	}
  161: 	if att.Profile != p.Name || att.MacOSProduct != facts.Product || att.MacOSBuild != facts.Build || att.LimaVersion != limaVersion {
  162: 		return fmt.Errorf("attestation host/profile facts do not match the current selection")
  163: 	}
  164: 	if att.CanaryVerdict != "PASS" {
  165: 		return fmt.Errorf("attestation canary verdict is %q", att.CanaryVerdict)
  166: 	}
  167: 	if att.DropIn != expectedCanaryDropIn {
  168: 		return fmt.Errorf("attestation drop-in is %q, want %q", att.DropIn, expectedCanaryDropIn)
  169: 	}
  170: 	return nil
  171: }
  172: 
  173: func requireAttestation(path string, p macOSProfile, facts hostFacts, limaVersion string) error {
  174: 	att, err := readAttestation(path)
  175: 	if err != nil {
  176: 		return err
  177: 	}
  178: 	return validateAttestation(path, att, p, facts, limaVersion)
  179: }
