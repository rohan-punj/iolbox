  316: 		return profileTable{}, macOSProfile{}, codedError(exitUsage, "unknown profile %q", selected)
  317: 	}
  318: 	p.AssetRoot = assetRoot
  319: 	p.PinPath = filepath.Join(assetRoot, "lima", p.PinEnv)
  320: 	p.TemplatePath = filepath.Join(assetRoot, "lima", p.YAMLTemplate)
  321: 	p.GuestDir = filepath.Join(assetRoot, "guest")
  322: 	pinData, err := os.ReadFile(p.PinPath)
  323: 	if err != nil {
  324: 		return profileTable{}, macOSProfile{}, codedError(exitUsage, "read pin file: %v", err)
  325: 	}
  326: 	values, err := validatePinMustKeepValues(string(pinData), p.PinPath)
  327: 	if err != nil {
  328: 		return profileTable{}, macOSProfile{}, err
  329: 	}
  330: 	p.ImageURL = values["IOLBOX_IMAGE_URL"]
  331: 	p.ImageDigest = values["IOLBOX_IMAGE_DIGEST"]
  332: 	p.ImageBytes, _ = strconv.ParseInt(values["IOLBOX_IMAGE_BYTES"], 10, 64)
  333: 	p.CPUs = values["IOLBOX_CPUS"]
  334: 	p.Memory = values["IOLBOX_MEMORY"]
  335: 	p.Disk = values["IOLBOX_DISK"]
  336: 	for _, path := range []string{p.TemplatePath, p.GuestDir, filepath.Join(p.GuestDir, "lib.sh"), filepath.Join(p.GuestDir, p.MultiarchStep), filepath.Join(p.GuestDir, p.KernelHoldStep), filepath.Join(p.GuestDir, p.canaryStep()), filepath.Join(p.GuestDir, p.installStep()), filepath.Join(p.GuestDir, p.verifyStep())} {
  337: 		if _, err := os.Stat(path); err != nil {
  338: 			return profileTable{}, macOSProfile{}, codedError(exitUsage, "profile asset is missing: %s", path)
  339: 		}
  340: 	}
  341: 	return table, p, nil
