  278: 		return nil, codedError(exitUsage, "invalid or missing pinned image URL in %s", pinPath)
  279: 	}
  280: 	digest := values["IOLBOX_IMAGE_DIGEST"]
  281: 	if digest == "PIN-ME" {
  282: 		return nil, codedError(exitPreflight, "refusing to provision an unpinned image from %s", pinPath)
  283: 	}
  284: 	match := digestPattern.FindStringSubmatch(digest)
