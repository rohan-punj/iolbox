  105: 
  106: // limaHomePath joins limaHomeDir() with parts. Found on real hardware
  107: // (2026-08-19, physical Mac): every caller of this used to build
  108: // homePath(".lima", machine, ...) instead, which always resolved to the
  109: // real default ~/.lima regardless of $LIMA_HOME. Running under Phase 4's
  110: // own required isolated LIMA_HOME, a recovery attempt against an existing
  111: // (half-created) machine failed with "could not inspect Lima port contract
  112: // for running machine ...: open /Users/.../.lima/iolbox-native-arm64/
  113: // lima.yaml: no such file or directory" -- the real file was one directory
  114: // tree over, at $LIMA_HOME/iolbox-native-arm64/lima.yaml. M1-M6 never hit
  115: // this because they always ran against the real default ~/.lima.
  116: func limaHomePath(parts ...string) (string, error) {
  117: 	dir, err := limaHomeDir()
  118: 	if err != nil {
  119: 		return "", err
  120: 	}
  121: 	return filepath.Join(append([]string{dir}, parts...)...), nil
  122: }
  123: 
  124: func hostAttestationPath(machine string) (string, error) {
  125: 	return homePath(".iolbox", "macos", machine+"-structural-gate.json")
  126: }
  127: 
  128: func canaryStatePath(machine string) (string, error) {
  129: 	return homePath("Library", "Application Support", "iolbox", "lima-canary-"+machine+".txt")
  130: }
  131: 
  132: type structuralAttestation struct {
  133: 	Schema        int    `json:"schema"`
  134: 	Profile       string `json:"profile"`
  135: 	MacOSProduct  string `json:"macos_product"`
  136: 	MacOSBuild    string `json:"macos_build"`
  137: 	LimaVersion   string `json:"lima_version"`
  138: 	DropIn        string `json:"drop_in"`
  139: 	CanaryVerdict string `json:"canary_verdict"`
  140: 	Kernel        string `json:"kernel"`
  141: }
  142: 
  143: const expectedCanaryDropIn = "/etc/systemd/system/iolbox-supervisor.service.d/10-iolbox-macos-canary.conf"
  144: 
  145: func readAttestation(path string) (structuralAttestation, error) {
  146: 	data, err := os.ReadFile(path)
  147: 	if err != nil {
  148: 		return structuralAttestation{}, err
  149: 	}
  150: 	var att structuralAttestation
  151: 	if err := json.Unmarshal(data, &att); err != nil {
  152: 		return structuralAttestation{}, err
  153: 	}
  154: 	return att, nil
  155: }
  156: 
  157: func validateAttestation(path string, att structuralAttestation, p macOSProfile, facts hostFacts, limaVersion string) error {
  158: 	if att.Schema != 1 {
  159: 		return fmt.Errorf("attestation schema is %d, want 1", att.Schema)
  160: 	}
  161: 	if att.Profile != p.Name || att.MacOSProduct != facts.Product || att.MacOSBuild != facts.Build || att.LimaVersion != limaVersion {
  162: 		return fmt.Errorf("attestation host/profile facts do not match the current selection")
  163: 	}
  164: 	if att.CanaryVerdict != "PASS" {
  165: 		return fmt.Errorf("attestation canary verdict is %q", att.CanaryVerdict)
  166: 	}
  167: 	if att.DropIn != expectedCanaryDropIn {
  168: 		return fmt.Errorf("attestation drop-in is %q, want %q", att.DropIn, expectedCanaryDropIn)
  169: 	}
  170: 	return nil
  171: }
  172: 
  173: func requireAttestation(path string, p macOSProfile, facts hostFacts, limaVersion string) error {
  174: 	att, err := readAttestation(path)
  175: 	if err != nil {
  176: 		return err
  177: 	}
  178: 	return validateAttestation(path, att, p, facts, limaVersion)
  179: }
  180: 
  181: func recordCanary(machine string, facts hostFacts, limaVersion, result string, code int) error {
  182: 	path, err := canaryStatePath(machine)
  183: 	if err != nil {
  184: 		return err
  185: 	}
  186: 	data := fmt.Sprintf("result=%s\nexit=%d\nhost_macos=%s\nhost_lima=%s\nrecorded_utc=%s\n", result, code, hostMACOSString(facts), limaVersion, time.Now().UTC().Format(time.RFC3339))
  187: 	return atomicWriteFile(path, []byte(data), 0o644)
  188: }
  189: 
  190: func readCanaryState(machine string) string {
  191: 	path, err := canaryStatePath(machine)
  192: 	if err != nil {
  193: 		return "unavailable (" + err.Error() + ")"
  194: 	}
  195: 	data, err := os.ReadFile(path)
  196: 	if err != nil {
  197: 		return "unknown (no host-side canary result recorded)"
  198: 	}
  199: 	return strings.TrimSpace(string(data))
  200: }
  201: 
  202: func guestEnvironment(p macOSProfile, facts hostFacts, limaVersion, machine, payloadBase string, config lifecycleConfig) map[string]string {
  203: 	bind := config.Bind
  204: 	if bind == "" {
  205: 		bind = "all"
  206: 	}
  207: 	guiPort := config.GUIPort
  208: 	if guiPort == 0 {
  209: 		guiPort = 4001
  210: 	}
  211: 	return map[string]string{
  212: 		"IOLBOX_HOST_MACOS":         hostMACOSString(facts),
  213: 		"IOLBOX_HOST_MACOS_PRODUCT": facts.Product,
  214: 		"IOLBOX_HOST_MACOS_BUILD":   facts.Build,
  215: 		"IOLBOX_HOST_LIMA":          limaVersion,
  216: 		"IOLBOX_MACHINE":            machine,
  217: 		"IOLBOX_PROFILE":            p.Name,
  218: 		"IOLBOX_PROFILE_STATUS":     p.Role,
  219: 		"IOLBOX_KERNEL_SERIES":      kernelRuntimeSeries(p.KernelSeries),
  220: 		"IOLBOX_EXPECTED_UNAME_R":   p.ExpectedUnameR,
  221: 		"IOLBOX_PROVISION_DIR":      "/opt/iolbox-provision",
  222: 		"IOLBOX_PAYLOAD_TARBALL":    "/opt/iolbox-provision/payload/" + payloadBase,
  223: 		"IOLBOX_BIND":               bind,
  224: 		// This is consumed inside the guest by the provisioning and verify
  225: 		// scripts.  The host-side forwarding port is allowed to differ when
  226: 		// another Lima machine owns 4001.
  227: 		"IOLBOX_GUI_PORT": strconv.Itoa(darwinGUIGuestPort),
  228: 	}
  229: }
  230: 
  231: func kernelRuntimeSeries(series string) string {
  232: 	parts := strings.Split(series, ".")
  233: 	if len(parts) >= 2 {
  234: 		return parts[0] + "." + parts[1]
  235: 	}
  236: 	return series
  237: }
  238: 
  239: func syncGuestAttestation(ctx context.Context, l *limaClient, machine string, p macOSProfile, facts hostFacts, limaVersion string) error {
  240: 	out, err := l.shell(ctx, machine, "sudo", "-n", "cat", "/var/lib/iolbox/macos-structural-gate.json")
  241: 	if err != nil {
  242: 		return codedError(exitVerify, "retrieve guest structural attestation: %v", err)
  243: 	}
  244: 	var att structuralAttestation
  245: 	if err := json.Unmarshal(out, &att); err != nil {
  246: 		return codedError(exitVerify, "decode guest structural attestation: %v", err)
  247: 	}
  248: 	if err := validateAttestation("guest", att, p, facts, limaVersion); err != nil {
  249: 		return codedError(exitVerify, "invalid guest structural attestation: %v", err)
  250: 	}
  251: 	path, err := hostAttestationPath(machine)
  252: 	if err != nil {
  253: 		return codedError(exitVerify, "resolve host attestation path: %v", err)
  254: 	}
  255: 	if err := atomicWriteFile(path, out, 0o600); err != nil {
  256: 		return codedError(exitVerify, "install host structural attestation: %v", err)
  257: 	}
  258: 	return nil
  259: }
  260: 
  261: func guestValue(ctx context.Context, l *limaClient, machine string, args ...string) string {
  262: 	out, err := l.shell(ctx, machine, args...)
  263: 	if err != nil {
  264: 		return "unavailable (" + strings.TrimSpace(string(out)) + ")"
  265: 	}
  266: 	return strings.TrimSpace(string(out))
  267: }
  268: 
  269: func hostAgentWarningText(machine string) (string, bool) {
  270: 	path, err := limaHomePath(machine, "ha.stderr.log")
  271: 	if err != nil {
  272: 		return "", false
  273: 	}
  274: 	data, err := os.ReadFile(path)
  275: 	if err != nil {
  276: 		return "", false
  277: 	}
  278: 	var matches []string
  279: 	for _, line := range strings.Split(string(data), "\n") {
  280: 		if strings.Contains(line, "Unable to configure Rosetta") || strings.Contains(line, "unsupported build target macOS version") {
  281: 			matches = append(matches, line)
  282: 		}
  283: 	}
  284: 	return strings.Join(matches, "\n"), len(matches) > 0
  285: }
  286: 
  287: func limaClientFor(ctx context.Context, path string, runner commandRunner) (*limaClient, limaInfo, error) {
  288: 	if path == "" {
  289: 		return nil, limaInfo{}, codedError(exitPreflight, "Lima was not found")
  290: 	}
  291: 	info := collectLimaInfo(ctx, path, runner)
  292: 	version := info.Version
  293: 	if version == "" {
  294: 		// D11: a found executable is never represented as unknown in the guest
  295: 		// environment. Preserve the raw diagnostic separately.
  296: 		version = "unparsed"
  297: 		info.Version = version
  298: 	}
  299: 	return &limaClient{info: info, runner: runnerOrExec(runner)}, info, nil
  300: }
  301: 
  302: func runnerOrExec(runner commandRunner) commandRunner {
  303: 	if runner == nil {
  304: 		return execRunner{}
  305: 	}
  306: 	return runner
  307: }
  308: 
  309: func runGuestSequence(ctx context.Context, l *limaClient, machine string, p macOSProfile, facts hostFacts, limaVersion, payloadBase string, config lifecycleConfig) error {
  310: 	env := guestEnvironment(p, facts, limaVersion, machine, payloadBase, config)
  311: 	canaryStep := p.canaryStep()
  312: 	steps := []string{p.MultiarchStep, p.KernelHoldStep, canaryStep, p.installStep(), p.verifyStep()}
  313: 	for _, step := range steps {
  314: 		err := guestStep(ctx, l, machine, step, env)
  315: 		if step == canaryStep {
  316: 			if err != nil {
  317: 				_ = recordCanary(machine, facts, limaVersion, "fail", exitCodeFor(err))
  318: 				return err
  319: 			}
  320: 			_ = recordCanary(machine, facts, limaVersion, "pass", 0)
  321: 		}
  322: 		if err != nil {
  323: 			return err
  324: 		}
  325: 	}
  326: 	return syncGuestAttestation(ctx, l, machine, p, facts, limaVersion)
  327: }
  328: 
  329: func exitCodeFor(err error) int {
  330: 	var coded *launcherError
  331: 	if errors.As(err, &coded) {
  332: 		return coded.code
  333: 	}
  334: 	return childExitCode(err)
  335: }
  336: 
  337: func runProvision(ctx context.Context, l *limaClient, machine string, p macOSProfile, facts hostFacts, payloadPath string, config lifecycleConfig) error {
  338: 	ports := config.Ports
  339: 	if ports.GUIPort == 0 {
  340: 		var err error
  341: 		ports, err = newDarwinPortContract(config.GUIPort)
  342: 		if err != nil {
  343: 			return codedError(exitUsage, "%v", err)
  344: 		}
  345: 	}
  346: 	templatePath := ""
  347: 	var err error
  348: 	if _, statErr := os.Stat(p.TemplatePath); statErr != nil {
  349: 		return codedError(exitUsage, "profile template is missing: %v", statErr)
  350: 	}
  351: 	// Render and validate before querying or mutating Lima, matching the
  352: 	// documented start sequence. Existing machines do not consume the file,
  353: 	// but rendering still proves the shipped profile is internally coherent.
  354: 	templatePath, err = writeRenderedTemplateForPort("", p, ports.GUIPort)
  355: 	if err != nil {
  356: 		return codedError(exitUsage, "render Lima template: %v", err)
  357: 	}
  358: 	defer os.Remove(templatePath)
  359: 
  360: 	machines, err := l.list(ctx)
  361: 	if err != nil {
  362: 		return codedError(exitPreflight, "%v", err)
  363: 	}
  364: 	state, exists := findMachine(machines, machine)
  365: 	if config.Upgrade && !exists {
  366: 		return codedError(exitPreflight, "upgrade requires existing machine %q", machine)
  367: 	}
  368: 	attestationPath, err := hostAttestationPath(machine)
  369: 	if err != nil {
  370: 		return codedError(exitPreflight, "resolve host attestation path: %v", err)
  371: 	}
  372: 	validAttestation := func() error {
  373: 		return requireAttestation(attestationPath, p, facts, l.info.Version)
  374: 	}
  375: 	created, err := ensureMachineWithPorts(ctx, l, machine, state, templatePath, attestationPath, validAttestation, &ports)
  376: 	if err != nil {
  377: 		return err
  378: 	}
  379: 	if created {
  380: 		// The returned state is now live; the template is removed by the defer
  381: 		// above after the create command has consumed it.
  382: 	}
  383: 	if warning, ok := hostAgentWarningText(machine); ok {
  384: 		fmt.Fprintf(os.Stderr, "WARNING: Lima hostagent Rosetta warning for %s:\n%s\n", machine, warning)
  385: 		fmt.Fprintln(os.Stderr, "Remediation: brew reinstall lima (brew upgrade may be a no-op when Lima is already current).")
  386: 	}
  387: 	payloadBase := filepath.Base(payloadPath)
  388: 	if err := stageFiles(ctx, l, machine, p, payloadPath, payloadBase); err != nil {
  389: 		return err
  390: 	}
  391: 	if err := runGuestSequence(ctx, l, machine, p, facts, l.info.Version, payloadBase, config); err != nil {
  392: 		return err
  393: 	}
  394: 	guiPort := ports.GUIPort
  395: 	if _, err := waitHTTPReady(ctx, nil, fmt.Sprintf("http://127.0.0.1:%d/", guiPort), config.BootTimeout); err != nil {
  396: 		return codedError(exitVerify, "GUI readiness failed: %v", err)
  397: 	}
  398: 	if err := verifyDarwinHostContract(ports, 2*time.Second); err != nil {
  399: 		return err
  400: 	}
  401: 	control, err := dialControlWS(fmt.Sprintf("127.0.0.1:%d", guiPort))
  402: 	if err != nil {
  403: 		return codedError(exitVerify, "control-plane connection failed: %v", err)
  404: 	}
  405: 	defer control.Close()
  406: 	if _, err := control.hello(); err != nil {
  407: 		return codedError(exitVerify, "control-plane hello failed: %v", err)
  408: 	}
  409: 	if config.Sync != nil {
  410: 		if err := syncDarwinStartup(control, fmt.Sprintf("http://127.0.0.1:%d", guiPort), *config.Sync); err != nil {
  411: 			return codedError(exitVerify, "%v", err)
  412: 		}
  413: 	}
  414: 	return nil
  415: }
  416: 
  417: type darwinStopControlFactory func() (controlClient, func(), error)
  418: 
  419: // runDarwinStop performs the mandatory host sync while the guest is still
  420: // running. A sync failure returns before stopMachine, leaving the Lima
  421: // instance available for recovery and retry.
  422: func runDarwinStop(ctx context.Context, l *limaClient, machine, state string, config darwinSyncConfig, timeout time.Duration, connect darwinStopControlFactory) error {
  423: 	if strings.EqualFold(state, "running") && !config.NoSync {
  424: 		if connect == nil {
  425: 			return codedError(exitVerify, "control-plane connection for stop sync is unavailable")
  426: 		}
  427: 		control, closeControl, err := connect()
  428: 		if err != nil {
  429: 			return codedError(exitVerify, "control-plane connection for stop sync failed: %v", err)
  430: 		}
  110: 	if err != nil {
  111: 		info.VersionErr = err
  112: 	}
  113: 	return info
  114: }
  115: 
  116: // isLimaLogNoise recognizes limactl's own logrus-style diagnostic lines
  117: // (e.g. `time="2026-08-19T14:23:44-04:00" level=warning msg="No instance
  118: // found. Run \`limactl create\` to create an instance."`), which land in
  119: // this parser's input because execRunner.Run uses CombinedOutput (stdout+
  120: // stderr merged) and limactl writes that particular warning to stderr.
  121: // Found on real hardware (2026-08-19, physical Mac): every M1-M6 session up
  122: // to now ran `limactl list` against ~/.lima, which by then already had a
  123: // machine registered from earlier development, so this line never
  124: // appeared. The very first Phase 4 run against a genuinely empty, isolated
  125: // LIMA_HOME (exactly the isolation scenario plan section 10 item 4 asks
  126: // for) hit it immediately: "iolbox-launcher: invalid Lima machine listing
  127: // line 1: ...No instance found...". A truly malformed data line (wrong
  128: // field count, empty name/state) must still fail closed; only limactl's own
  129: // recognizable log-line shape is treated as noise.
  130: func isLimaLogNoise(line string) bool {
  131: 	return strings.HasPrefix(line, `time="`) && strings.Contains(line, "level=")
  132: }
  133: 
  134: func parseMachineListing(output string) ([]machineInfo, error) {
  135: 	var machines []machineInfo
  136: 	for lineNo, line := range strings.Split(strings.ReplaceAll(output, "\r\n", "\n"), "\n") {
  137: 		line = strings.TrimSpace(line)
  138: 		if line == "" || isLimaLogNoise(line) {
  139: 			continue
  140: 		}
  141: 		fields := strings.Split(line, "|")
  142: 		if len(fields) != 2 || fields[0] == "" || fields[1] == "" {
  143: 			return nil, fmt.Errorf("invalid Lima machine listing line %d: %q", lineNo+1, line)
  144: 		}
  145: 		machines = append(machines, machineInfo{Name: fields[0], State: fields[1]})
  146: 	}
  147: 	return machines, nil
  148: }
  149: 
  150: func (l *limaClient) list(ctx context.Context) ([]machineInfo, error) {
  151: 	out, err := l.run(ctx, "list", "--format", "{{.Name}}|{{.Status}}")
  152: 	if err != nil {
  153: 		return nil, fmt.Errorf("limactl list: %w: %s", err, strings.TrimSpace(string(out)))
  154: 	}
  155: 	return parseMachineListing(string(out))
  156: }
