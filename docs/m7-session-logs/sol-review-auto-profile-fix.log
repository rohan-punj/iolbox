  158: func readStoredLimaConfig(machine string) ([]byte, error) {
  159: 	path, err := limaHomePath(machine, "lima.yaml")
  160: 	if err != nil {
  161: 		return nil, err
  162: 	}
  163: 	return os.ReadFile(path)
  164: }
