  295:             --payload-sha256 "$PAYLOAD_SHA256" \
  296:             --version "$VERSION" \
  297:             --source-date-epoch "$SOURCE_DATE_EPOCH"
  298:           echo "--- tar listing ---"
  299:           tar -tzf "$GITHUB_WORKSPACE/iolbox-macos-arm64.tar.gz"
  300:           echo "--- internal checksums ---"
  301:           work="$(mktemp -d)"
  302:           trap 'rm -rf "$work"' EXIT
  303:           tar -xzf "$GITHUB_WORKSPACE/iolbox-macos-arm64.tar.gz" -C "$work"
  304:           ( cd "$work/iolbox-macos-arm64" && sha256sum -c SHA256SUMS )
