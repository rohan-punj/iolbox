  109: 
  110: # Override of the sourced launcher_start(). Identical to hardware-m4.sh's own
  111: # except for the two optional host-port-range flags described in the header;
  112: # with neither variable set, the argv this builds is byte-for-byte what the
  113: # frozen function builds. Kept as an explicit override rather than an edit to
  114: # hardware-m4.sh, which is frozen (see hardware-m4-phase5.sh's header for the
  115: # same convention).
  116: launcher_start() {
  117:     local label
  118:     label="$1"
  119:     set -- env IOLBOX_GUI_PORT="$gui_port" IOLBOX_TARBALL="$tarball_path" "$launcher_path" \
  120:         start --assets-dir "$assets_dir" --machine "$machine" --limactl "$limactl_bin" --no-browser
  121:     [ -z "$console_host_start" ] || set -- "$@" --console-host-start "$console_host_start"
  122:     [ -z "$capture_host_start" ] || set -- "$@" --capture-host-start "$capture_host_start"
  123:     record_command "launcher-start-$label" "$@" || return $?
  124:     record_command "readiness-$label" curl --silent --show-error --fail --connect-timeout 5 "http://127.0.0.1:$gui_port/" || return $?
  125: }
