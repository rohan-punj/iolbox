  255: func parsePinEnv(data string) (map[string]string, error) {
  256: 	values := make(map[string]string)
  257: 	for lineNo, line := range strings.Split(data, "\n") {
  258: 		line = strings.TrimSpace(line)
  259: 		if line == "" || strings.HasPrefix(line, "#") {
  260: 			continue
  261: 		}
  262: 		parts := strings.SplitN(line, "=", 2)
  263: 		if len(parts) != 2 || strings.TrimSpace(parts[0]) == "" {
  264: 			return nil, fmt.Errorf("pin env line %d is not KEY=VALUE", lineNo+1)
  265: 		}
  266: 		key := strings.TrimSpace(parts[0])
  267: 		value := strings.Trim(strings.TrimSpace(parts[1]), `"'`)
  268: 		values[key] = value
  269: 	}
  270: 	return values, nil
  271: }
