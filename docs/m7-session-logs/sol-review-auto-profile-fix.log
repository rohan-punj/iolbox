    1: package main
    2: 
    3: import (
    4: 	"context"
    5: 	"encoding/json"
    6: 	"fmt"
    7: 	"io"
    8: 	"strings"
    9: )
   10: 
   11: var allowedCanaryVerdicts = map[string]bool{
   12: 	"PASS": true, "FAIL_AUXV": true, "FAIL_MISSING": true, "FAIL_NOEXEC": true, "FAIL_OTHER": true,
   13: }
   14: 
   15: // macOS canary JSON is deliberately distinct from the structural attestation:
   16: // this is the real /var/lib/iolbox/macos-canary.json shape and its verdict
   17: // vocabulary. Do not read canary_verdict from the attestation as a live canary.
   18: type macOSCanaryRecord struct {
   19: 	Schema       int    `json:"schema"`
   20: 	MacOSProduct string `json:"macos_product"`
   21: 	MacOSBuild   string `json:"macos_build"`
   22: 	LimaVersion  string `json:"lima_version"`
   23: 	Profile      string `json:"profile"`
   24: 	Kernel       string `json:"kernel"`
   25: 	Binfmt       string `json:"binfmt"`
   26: 	Verdict      string `json:"verdict"`
   27: 	Timestamp    string `json:"timestamp"`
   28: 	Version      string `json:"version"`
   29: 	Error        string `json:"error"`
   30: }
   31: 
   32: func parseMacOSCanary(data []byte) (macOSCanaryRecord, error) {
   33: 	var record macOSCanaryRecord
   34: 	if err := json.Unmarshal(data, &record); err != nil {
   35: 		return macOSCanaryRecord{}, fmt.Errorf("decode macOS canary JSON: %w", err)
   36: 	}
   37: 	if record.Schema != 1 {
   38: 		return macOSCanaryRecord{}, fmt.Errorf("macOS canary schema is %d, want 1", record.Schema)
   39: 	}
   40: 	if !allowedCanaryVerdicts[record.Verdict] {
   41: 		return macOSCanaryRecord{}, fmt.Errorf("unknown macOS canary verdict %q", record.Verdict)
   42: 	}
   43: 	return record, nil
   44: }
   45: 
   46: func rosettaBinfmtEnabled(raw string) bool {
   47: 	normalized := strings.ToLower(raw)
   48: 	return strings.Contains(normalized, "enabled") && strings.Contains(raw, "/mnt/lima-rosetta/rosetta")
   49: }
   50: 
   51: // rosettaPresenceString renders the raw /proc/sys/fs/binfmt_misc/rosetta read
   52: // as a truthful tri-state string for status/diagnose (plan section 10 item
   53: // 5's "rosetta_present"). Distinct from rosettaBinfmtEnabled, which requires
   54: // the exact Lima interpreter path and is used to decide the execution mode;
   55: // this is a plain presence/absence report of the binfmt entry itself.
   56: func rosettaPresenceString(raw string) string {
   57: 	normalized := strings.ToLower(strings.TrimSpace(raw))
   58: 	switch {
   59: 	// Checked BEFORE the generic "unavailable" fallback: unavailableValue()
   60: 	// wraps a failed `cat` as "unavailable (cat: ... No such file or
   61: 	// directory)", and on a genuine native-arm64 guest that specific
   62: 	// failure IS the truthful answer (the file plainly does not exist,
   63: 	// i.e. Rosetta is absent) ƒ?" not an unknown result. Found on real
   64: 	// hardware (2026-08-19): the unqualified "unavailable" prefix check
   65: 	// used to run first and reported "unknown (unavailable (cat: ...No
   66: 	// such file or directory)))" for a perfectly healthy, correctly
   67: 	// Rosetta-less native-arm64 guest.
   68: 	case strings.Contains(normalized, "no such file") || strings.Contains(normalized, "cannot open"):
   69: 		return "false"
   70: 	case strings.HasPrefix(normalized, "unavailable"):
   71: 		return "unknown (" + raw + ")"
   72: 	case strings.Contains(normalized, "enabled"):
   73: 		return "true"
   74: 	case strings.Contains(normalized, "disabled"):
   75: 		return "true (registered but disabled)"
   76: 	case raw == "":
   77: 		return "false"
   78: 	default:
   79: 		return "unknown (" + raw + ")"
   80: 	}
   81: }
   82: 
   83: type darwinDiagnostics struct {
   84: 	GuestArch             string
   85: 	GuestKernel           string
   86: 	Execution             string
   87: 	CanaryVerdict         string
   88: 	CanarySource          string
   89: 	Service               string
   90: 	HTTP                  string
   91: 	Hello                 string
   92: 	CapabilityPolicy      string
   93: 	RosettaBinfmt         string
   94: 	StructuralAttestation string
   95: 	EffectiveDropIn       string
   96: 	// Phase 4: profile-selection and translator truthfulness (plan section
   97: 	// 10 item 5). Requested/Selected/Source/FallbackReason mirror
   98: 	// profileSelectionResult; Backend/Translator/SupervisorArch/
   99: 	// RosettaPresent report what the resolved profile and live guest probe
  100: 	// actually are, independent of what was requested.
  101: 	RequestedProfile string
