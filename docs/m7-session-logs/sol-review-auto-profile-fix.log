   16: type darwinOptions struct {
   17: 	Command          string
   18: 	Profile          string
   19: 	Machine          string
   20: 	AssetsDir        string
   21: 	Limactl          string
   22: 	Tarball          string
   23: 	BootTimeout      time.Duration
   24: 	NoBrowser        bool
   25: 	NoSync           bool
   26: 	ImagesDir        string
   27: 	LabsDir          string
   28: 	Bind             string
   29: 	GUIPort          int
   30: 	ConsoleHostStart int
   31: 	CaptureHostStart int
   32: 	CPUs             int
   33: 	MemoryGiB        int
   34: 	// ExplicitFlags records which flag names were actually passed (flag.Visit
   35: 	// only walks SET flags) ƒ?" an explicit --cpus/--memory-gib is a deliberate
   36: 	// choice and must never be second-guessed by the interactive prompt, same
   37: 	// contract as prompt.go's Windows --smp/--mem handling.
   38: 	ExplicitFlags map[string]bool
   39: }
   40: 
   41: func parseDarwinArgs(args []string, stderr io.Writer) (darwinOptions, error) {
   42: 	opts := darwinOptions{
   43: 		Command:          "start",
   44: 		Profile:          os.Getenv("IOLBOX_PROFILE"),
   45: 		Machine:          os.Getenv("IOLBOX_MACHINE"),
   46: 		Limactl:          os.Getenv("LIMACTL"),
   47: 		Tarball:          os.Getenv("IOLBOX_TARBALL"),
   48: 		BootTimeout:      6 * time.Minute,
   49: 		Bind:             os.Getenv("IOLBOX_BIND"),
   50: 		GUIPort:          4001,
   51: 		ConsoleHostStart: darwinConsoleStart,
   52: 		CaptureHostStart: darwinCaptureStart,
   53: 	}
   54: 	if opts.Bind == "" {
   55: 		opts.Bind = "all"
   56: 	}
   57: 	if value := os.Getenv("IOLBOX_GUI_PORT"); value != "" {
   58: 		port, err := strconv.Atoi(value)
   59: 		if err != nil || port < 1 || port > 65535 {
   60: 			return darwinOptions{}, fmt.Errorf("invalid IOLBOX_GUI_PORT %q", value)
   61: 		}
   62: 		opts.GUIPort = port
   63: 	}
   64: 	for _, setting := range []struct {
   65: 		name string
   66: 		dest *int
   67: 	}{
   68: 		{"IOLBOX_CONSOLE_HOST_START", &opts.ConsoleHostStart},
   69: 		{"IOLBOX_CAPTURE_HOST_START", &opts.CaptureHostStart},
   70: 	} {
   71: 		if value := os.Getenv(setting.name); value != "" {
   72: 			port, err := strconv.Atoi(value)
   73: 			if err != nil || port < 1 || port > 65535 {
   74: 				return darwinOptions{}, fmt.Errorf("invalid %s %q", setting.name, value)
   75: 			}
   76: 			*setting.dest = port
   77: 		}
   78: 	}
   79: 	if len(args) > 0 && !strings.HasPrefix(args[0], "-") {
   80: 		opts.Command = args[0]
   81: 		args = args[1:]
   82: 	}
   83: 	validCommands := map[string]bool{"start": true, "stop": true, "status": true, "diagnose": true, "upgrade": true}
   84: 	if !validCommands[opts.Command] {
   85: 		return darwinOptions{}, fmt.Errorf("unknown command %q", opts.Command)
   86: 	}
   87: 	fs := flag.NewFlagSet("iolbox-launcher", flag.ContinueOnError)
   88: 	fs.SetOutput(stderr)
   89: 	fs.StringVar(&opts.Profile, "profile", opts.Profile, "profile name")
   90: 	fs.StringVar(&opts.Machine, "machine", opts.Machine, "Lima machine name")
   91: 	fs.StringVar(&opts.AssetsDir, "assets-dir", "", "M1 macOS asset root")
   92: 	fs.StringVar(&opts.Limactl, "limactl", opts.Limactl, "limactl executable")
   93: 	fs.StringVar(&opts.Tarball, "tarball", opts.Tarball, "payload tarball")
   94: 	fs.DurationVar(&opts.BootTimeout, "boot-timeout", opts.BootTimeout, "readiness timeout")
   95: 	fs.BoolVar(&opts.NoBrowser, "no-browser", false, "do not open the browser")
   96: 	fs.BoolVar(&opts.NoSync, "no-sync", false, "disable macOS host folder sync")
   97: 	fs.StringVar(&opts.ImagesDir, "images-dir", "", "override the macOS images folder")
   98: 	fs.StringVar(&opts.LabsDir, "labs-dir", "", "override the macOS labs folder")
   99: 	fs.IntVar(&opts.ConsoleHostStart, "console-host-start", opts.ConsoleHostStart, "host port for guest console range 9000-9049")
  100: 	fs.IntVar(&opts.CaptureHostStart, "capture-host-start", opts.CaptureHostStart, "host port for guest capture range 5500-5529")
  101: 	fs.IntVar(&opts.CPUs, "cpus", 0, "vCPUs for the guest (0 = use the profile's own default; prompts interactively if unset and stdin is a terminal)")
  102: 	fs.IntVar(&opts.MemoryGiB, "memory-gib", 0, "RAM in GiB for the guest (0 = use the profile's own default; prompts interactively if unset and stdin is a terminal)")
  103: 	if err := fs.Parse(args); err != nil {
  104: 		return darwinOptions{}, err
  105: 	}
  106: 	opts.ExplicitFlags = explicitFlags(func(f func(string)) { fs.Visit(func(fl *flag.Flag) { f(fl.Name) }) })
  107: 	if fs.NArg() != 0 {
  108: 		return darwinOptions{}, fmt.Errorf("unexpected arguments: %s", strings.Join(fs.Args(), " "))
  109: 	}
  110: 	if _, err := newDarwinPortContractWithRanges(opts.GUIPort, opts.ConsoleHostStart, opts.CaptureHostStart); err != nil {
  111: 		return darwinOptions{}, err
  112: 	}
  113: 	return opts, nil
  114: }
  115: 
  116: func resolveAssetRoot(explicit string) (string, error) {
  117: 	if explicit != "" {
  118: 		if _, err := os.Stat(filepath.Join(explicit, "lima", "profiles.env")); err != nil {
  119: 			return "", fmt.Errorf("assets directory is missing lima/profiles.env: %s", explicit)
  120: 		}
  121: 		return filepath.Abs(explicit)
  122: 	}
  123: 	var candidates []string
  124: 	if cwd, err := os.Getwd(); err == nil {
  125: 		candidates = append(candidates, filepath.Join(cwd, "packaging", "macos"), cwd)
  126: 	}
  127: 	if executable, err := os.Executable(); err == nil {
  128: 		dir := filepath.Dir(executable)
  129: 		candidates = append(candidates, filepath.Join(dir, "packaging", "macos"), filepath.Join(dir, "..", "..", "packaging", "macos"), dir)
  130: 	}
  131: 	for _, candidate := range candidates {
  132: 		candidate, _ = filepath.Abs(candidate)
  133: 		if _, err := os.Stat(filepath.Join(candidate, "lima", "profiles.env")); err == nil {
  134: 			return candidate, nil
  135: 		}
  136: 	}
  137: 	return "", errors.New("could not resolve macOS asset root; use --assets-dir")
  138: }
