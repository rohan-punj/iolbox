===== MAIN HEAD =====
   1: // iolbox-launcher â€” a single Windows exe that gets a user from zero to
   2: // http://localhost:4001, picking the right Linux backend automatically.
   3: //
   4: // Two backends:
   5: //   - qemu : bundled qemu-system-x86_64 (TCG software emulation), works
   6: //     everywhere, conflicts with nothing, no admin. The fallback.
   7: //   - wsl  : the `iolbox` WSL2 distro (imported from iolbox-rootfs.tar). Fastest,
   8: //     but only usable when an active Windows hypervisor is present.
   9: //
  10: // Backend selection implements docs/providers.md: WSL2 is preferred ONLY when
  11: // actually usable (wsl.exe + `wsl --version` OK + an active hypervisor);
  12: // otherwise QEMU. The launcher NEVER enables a Windows feature.
  13: package main
  14: 
  15: import (
  16: 	"context"
  17: 	"flag"
  18: 	"fmt"
  19: 	"os"
  20: 	"os/signal"
  21: 	"strings"
  22: 	"syscall"
  23: 	"time"
  24: )
  25: 
  26: // launchOpts holds the resolved CLI options passed to a backend.
  27: type launchOpts struct {
  28: 	memMB int
  29: 	smp   int
  30: 
  31: 	noBrowser bool
  32: 	verbose   bool
  33: 
  34: 	bootTimeout   time.Duration
  35: 	shutdownGrace time.Duration
  36: 
  37: 	// dev / override paths
  38: 	qemuExe  string
  39: 	diskPath string
  40: 	wslTar   string
  41: 	wslDir   string
  42: 
  43: 	// folder sync (images\/labs\ <-> guest, see foldersync.go)
  44: 	noSync    bool
  45: 	imagesDir string
  46: 	labsDir   string
  47: }
  48: 
  49: func windowsMain() {
  50: 	var (
  51: 		// mem/smp defaults mirror runtime/resources.env (IOLBOX_RAM_MB=4096,
  52: 		// IOLBOX_VCPUS=4), the single source of truth for vCPU/RAM across every
  53: 		// iolbox deployment target; still overridable here via --mem/--smp.
  54: 		backendFlag = flag.String("backend", "auto", "backend: qemu | wsl | auto")
  55: 		memMB       = flag.Int("mem", 4096, "guest RAM in MB")
  56: 		smp         = flag.Int("smp", 4, "guest vCPU count")
  57: 		noBrowser   = flag.Bool("no-browser", false, "do not open the default browser when the GUI is up")
  58: 		portsOvr    = flag.String("ports", "", "override port ranges: gui:cStart:cCount:capStart:capCount (empty fields keep defaults)")
  59: 		bootTO      = flag.Duration("boot-timeout", 6*time.Minute, "how long to wait for the GUI (TCG boots are slow)")
  60: 		grace       = flag.Duration("shutdown-grace", 30*time.Second, "how long to wait for a clean guest powerdown")
  61: 		verbose     = flag.Bool("v", false, "verbose (print the qemu command line)")
  62: 
  63: 		qemuExe    = flag.String("qemu", "", "override path to qemu-system-x86_64.exe (dev)")
  64: 		diskPath   = flag.String("disk", "", "override path to iolbox-disk.qcow2 (dev)")
  65: 		wslTar     = flag.String("wsl-tar", "", "override path to iolbox-rootfs.tar (dev)")
  66: 		wslDir     = flag.String("wsl-dir", "", "override WSL install dir (default %LOCALAPPDATA%\\iolbox)")
  67: 		detectOnly = flag.Bool("detect", false, "print backend detection and exit (no launch)")
  68: 
  69: 		noSync    = flag.Bool("no-sync", false, "disable images\\/labs\\ folder sync (pure ephemeral; folders untouched)")
  70: 		imagesDir = flag.String("images-dir", "", "override the images folder (default <exeDir>\\images)")
  71: 		labsDir   = flag.String("labs-dir", "", "override the labs folder (default <exeDir>\\labs)")
  72: 	)
  73: 	flag.Parse()
  74: 
  75: 	sel := backend(strings.ToLower(strings.TrimSpace(*backendFlag)))
  76: 	switch sel {
  77: 	case backendQEMU, backendWSL, backendAuto:
  78: 	default:
  79: 		fmt.Fprintf(os.Stderr, "invalid --backend %q (want qemu|wsl|auto)\n", *backendFlag)
  80: 		os.Exit(2)
  81: 	}
  82: 
  83: 	ranges := defaultPortRanges()
  84: 	if r, err := parsePortsOverride(*portsOvr, ranges); err != nil {
  85: 		fmt.Fprintln(os.Stderr, err)
  86: 		os.Exit(2)
  87: 	} else {
  88: 		ranges = r
  89: 	}
  90: 
