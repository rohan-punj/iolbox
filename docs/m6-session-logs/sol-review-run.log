  13: # This is the VZ + Rosetta shape used by M0.  The arm64 guest runs the
  14: # existing unmodified linux/amd64 payload through Rosetta.
  15: vmType: "vz"
  16: rosetta:
  17:   enabled: true
  18:   binfmt: true
  19: 
  20: # Keep geometry identical to Jammy; the smaller Debian image is already the
  21: # disk-saving difference and changing VM geometry would confound a canary.
  22: cpus: @CPUS@
