===== packaging/macos/lima/iolbox-jammy.yaml =====
   1: # iolbox Jammy Lima template â€” render this file before giving it to Lima.
   2: #
   3: # This is deliberately shipped as `iolbox-jammy.yaml`, not as a ready-to-use
   4: # YAML document: packaging/macos/iolbox-mac.sh sources
   5: # `lima/pinned-image.env` and replaces the @...@ tokens in a temporary file at
   6: # run time.  Keeping the URL, digest, and geometry out of this template avoids
   7: # two sources of truth.  Do not pass this tokenized file directly to limactl.
   8: #
   9: # The image is Ubuntu 22.04 arm64. Jammy is retained as the compatibility
  10: # profile; the live canary remains authoritative for the current host build.
  11: # The image URL and digest are rendered from the pinned env file rather than
  12: # replaced with template://ubuntu-22.04, whose meaning can drift.
  13: 
  14: # Lima verifies the downloaded bytes against this digest before booting.  The
  15: # image URL is the exact release directory pinned in pinned-image.env.
  16: images:
  17:   - location: "@IOLBOX_IMAGE_URL@"
  18:     arch: aarch64
  19:     digest: "@IOLBOX_IMAGE_DIGEST@"
  20: 
  21: # VZ plus Rosetta is the configuration exercised by M0 on the Apple M1
  22: # (docs/macos-m0-result.md:23-32).  binfmt registration is required so the
  23: # existing, unmodified linux/amd64 payload can execute in the arm64 guest.
  24: vmType: "vz"
  25: rosetta:
  26:   enabled: true
  27:   binfmt: true
  28: 
  29: # Do not inherit Lima or host-specific defaults.  These values are rendered
  30: # from pinned-image.env and correspond to the qualified M0 geometry.
  31: cpus: @CPUS@
  32: memory: "@MEMORY@"
  33: disk: "@DISK@"
  34: 
  35: # VZ requires virtiofs for the host filesystem mount implementation.  The
  36: # home mount is read-only on purpose: provisioning enters through limactl copy
  37: # and the guest owns its durable lab data, so a writable Mac home is not a
  38: # hidden dependency or a path for accidental host writes.
  39: mountType: "virtiofs"
  40: mounts:
  41:   - location: "~"
  42:     writable: false
  43: 
  44: portForwards:
  45:   - guestPort: @IOLBOX_GUI_PORT@
  46:     hostPort: @IOLBOX_GUI_PORT@
  47:     hostIP: "127.0.0.1"
  48:     proto: "tcp"
  49:   - guestPortRange: [9000, 9049]
  50:     hostPortRange: [9000, 9049]
  51:     hostIP: "127.0.0.1"
  52:     proto: "tcp"
  53:   - guestPortRange: [5500, 5529]
  54:     hostPortRange: [5500, 5529]
  55:     hostIP: "127.0.0.1"
  56:     proto: "tcp"
  57:   - guestIP: "127.0.0.1"
  58:     guestPortRange: [1, 65535]
  59:     proto: "any"
  60:     ignore: true
  61: 
  62: # There are intentionally no provision scripts or readiness probes here.
  63: # Ordered, re-runnable provisioning belongs to packaging/macos/guest/, and
  64: # guest/30-canary.sh is a hard gate whose failure must fail the whole run.
