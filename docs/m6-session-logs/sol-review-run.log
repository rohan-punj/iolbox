  27: # dependent on limactl copy and prevents accidental host writes.
  28: mountType: "virtiofs"
  29: mounts:
  30:   - location: "~"
  31:     writable: false
  32: 
  33: portForwards:
  34:   - guestPort: @IOLBOX_GUI_PORT@
  35:     hostPort: @IOLBOX_GUI_PORT@
  36:     hostIP: "127.0.0.1"
  37:     proto: "tcp"
  38:   - guestPortRange: [9000, 9049]
  39:     hostPortRange: [9000, 9049]
  40:     hostIP: "127.0.0.1"
  41:     proto: "tcp"
  42:   - guestPortRange: [5500, 5529]
  43:     hostPortRange: [5500, 5529]
  44:     hostIP: "127.0.0.1"
  45:     proto: "tcp"
  46:   - guestIP: "127.0.0.1"
  47:     guestPortRange: [1, 65535]
  48:     proto: "any"
  49:     ignore: true
  50: 
  51: # No provision scripts or readiness probes live in the Lima template.  The
  52: # selected, ordered guest steps are staged and run by iolbox-mac.sh.
