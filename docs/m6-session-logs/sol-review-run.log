 106: func resolveAssetRoot(explicit string) (string, error) {
 107: 	if explicit != "" {
 108: 		if _, err := os.Stat(filepath.Join(explicit, "lima", "profiles.env")); err != nil {
 109: 			return "", fmt.Errorf("assets directory is missing lima/profiles.env: %s", explicit)
 110: 		}
 111: 		return filepath.Abs(explicit)
 112: 	}
 113: 	var candidates []string
 114: 	if cwd, err := os.Getwd(); err == nil {
 115: 		candidates = append(candidates, filepath.Join(cwd, "packaging", "macos"), cwd)
 116: 	}
 117: 	if executable, err := os.Executable(); err == nil {
 118: 		dir := filepath.Dir(executable)
 119: 		candidates = append(candidates, filepath.Join(dir, "packaging", "macos"), filepath.Join(dir, "..", "..", "packaging", "macos"), dir)
 120: 	}
 121: 	for _, candidate := range candidates {
 122: 		candidate, _ = filepath.Abs(candidate)
 123: 		if _, err := os.Stat(filepath.Join(candidate, "lima", "profiles.env")); err == nil {
 124: 			return candidate, nil
 125: 		}
 126: 	}
 127: 	return "", errors.New("could not resolve macOS asset root; use --assets-dir")
 128: }
