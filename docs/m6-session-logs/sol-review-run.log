 130: func exitCode(err error) int {
 131: 	if err == nil {
 132: 		return exitOK
 133: 	}
 134: 	var coded *launcherError
 135: 	if errors.As(err, &coded) {
 136: 		return coded.code
 137: 	}
 138: 	return exitUsage
 139: }
