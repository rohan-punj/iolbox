===== .github/workflows/release.yml =====
   1: name: Release
   2: 
   3: # Triggers: a version tag builds+drafts a release; workflow_dispatch lets a
   4: # maintainer dry-run the whole pipeline (build/test artifacts, no publish)
   5: # without cutting a tag.
   6: on:
   7:   push:
   8:     tags: ["v*"]
   9:   workflow_dispatch:
  10: 
  11: permissions:
  12:   contents: write
  13: 
  14: jobs:
  15:   # ---------------------------------------------------------------------
  16:   # Windows: the ACTUAL shipped Windows deliverable is tools/iolab-launcher,
  17:   # a plain Go exe (browser-first GUI â€” the Tauri/Rust shell under app/
  18:   # src-tauri was abandoned when the project pivoted browser-first and is
  19:   # not known to still build). Do not resurrect the Tauri bundle here.
  20:   # ---------------------------------------------------------------------
  21:   build-windows:
  22:     name: Build Windows launcher + capture-helper
  23:     runs-on: windows-latest
  24:     steps:
  25:       # fetch-depth: 0 so `git describe --tags` (used by build-release.sh
  26:       # in the Linux job, and good practice here too for parity) sees real
  27:       # tag history instead of the shallow single commit `checkout` gives
  28:       # by default.
  29:       - uses: actions/checkout@v4
  30:         with:
  31:           fetch-depth: 0
  32: 
  33:       - uses: actions/setup-go@v5
  34:         with:
  35:           go-version: "1.26"
  36: 
  37:       - name: Vet + test iolab-launcher
  38:         working-directory: tools/iolab-launcher
  39:         run: |
  40:           go vet ./...
  41:           go test ./...
  42: 
  43:       - name: Build iolbox-launcher.exe
  44:         working-directory: tools/iolab-launcher
  45:         run: go build -o iolbox-launcher.exe .
  46: 
  47:       - name: Vet + test capture-helper
  48:         working-directory: tools/capture-helper
  49:         run: |
  50:           go vet ./...
  51:           go test ./...
  52: 
  53:       - name: Build capture-helper.exe
  54:         working-directory: tools/capture-helper
  55:         run: go build -o capture-helper.exe .
  56: 
  57:       # NOTE: both exes are UNSIGNED. A code-signing step (e.g. Azure Trusted
  58:       # Signing, or a self-hosted signtool + cert) slots in here later,
  59:       # between the build steps above and this upload. Until then, Windows
  60:       # SmartScreen will warn on first run â€” expected, not a CI bug.
  61:       #
  62:       # NOTE: this job does NOT assemble the full launcher bundle (the
  63:       # qemu/ subdirectory and iolbox-disk.qcow2 that tools/iolab-launcher
  64:       # expects alongside it â€” see runtime/pack-qemu.sh and docs/INSTALL.md
  65:       # "QEMU disk (Windows launcher)"). Neither qemu's third-party binaries
  66:       # nor the multi-GB qcow2 disk live in this repo, so that bundle is
  67:       # assembled by hand on the private builder and attached to the draft
  68:       # release alongside this job's two exes.
  69:       - uses: actions/upload-artifact@v4
  70:         with:
  71:           name: iolbox-windows
  72:           path: |
  73:             tools/iolab-launcher/iolbox-launcher.exe
  74:             tools/capture-helper/capture-helper.exe
  75: 
  76:   # ---------------------------------------------------------------------
  77:   # Linux: builds the GUI-embedded supervisor the ONLY correct way, then
  78:   # bakes every Linux-hostable packaging target that doesn't need loop
  79:   # devices/chroot/grub (those three â€” vmdk/vmx, OVA, qcow2 â€” need a
  80:   # root-capable builder and are attached to the release by hand; see the
  81:   # release job's draft body).
  82:   # ---------------------------------------------------------------------
  83:   build-linux:
  84:     name: Build supervisor + Linux packaging targets
  85:     runs-on: ubuntu-latest
  86:     steps:
  87:       - uses: actions/checkout@v4
  88:         with:
  89:           # build-release.sh stamps the binary's version via
  90:           # `git describe --tags`; a shallow checkout has no tag history,
  91:           # so the stamp silently degrades to a bare commit hash instead of
  92:           # e.g. "v0.4.0". fetch-depth 0 keeps that stamp meaningful.
  93:           fetch-depth: 0
  94: 
  95:       - uses: actions/setup-go@v5
  96:         with:
  97:           go-version: "1.26"
  98: 
  99:       - uses: actions/setup-node@v4
 100:         with:
 101:           node-version: "20"
 102:           cache: npm
 103:           cache-dependency-path: app/package-lock.json
 104: 
 105:       - name: Install frontend deps
 106:         working-directory: app
 107:         run: npm ci
 108: 
 109:       # THE ONLY correct way to produce a deployable supervisor binary.
 110:       # build-release.sh runs `npm run build:embed` before compiling and
 111:       # then asserts the embedded index.html isn't the committed
 112:       # placeholder. A bare `go build ./cmd/supervisor` skips build:embed
 113:       # entirely and ships that placeholder ("GUI not bundled in this
 114:       # build") straight into a release artifact â€” which is exactly what
 115:       # the previous version of this workflow did. Never shortcut this.
 116:       - name: Build supervisor (build-release.sh â€” GUI embedded)
 117:         run: bash build-release.sh
 118: 
 119:       - name: Install rootfs/packaging build deps
 120:         run: |
 121:           sudo apt-get update
 122:           sudo apt-get install -y debootstrap zstd build-essential
 123: 
 124:       # fetch-vpcs.sh needs git + make + a C compiler (all covered by
 125:       # build-essential + the runner's preinstalled git) to clone and
 126:       # statically link the GNS3/vpcs fork; it caches its output at
 127:       # runtime/build/vpcs/vpcs and no-ops on a second run if that binary
 128:       # already exists. build-rootfs.sh does NOT call it automatically â€”
 129:       # it hard-fails if the vpcs binary is missing â€” so it must run here
 130:       # as an explicit step before build-rootfs.sh.
 131:       - name: Fetch/build VPCS
 132:         run: runtime/fetch-vpcs.sh
 133: 
 134:       # build-rootfs.sh must run as root (debootstrap needs to mknod/chroot).
 135:       # Its defaults already match this job's layout: --supervisor-bin
 136:       # defaults to supervisor/bin/supervisor-linux-amd64 (build-release.sh's
 137:       # output) and --build-dir defaults to runtime/build (fetch-vpcs.sh's
 138:       # cache location), so no flags are needed here.
 139:       - name: Bake shared rootfs
 140:         run: sudo runtime/build-rootfs.sh
 141: 
 142:       # pack-wsl.sh doesn't strictly need root (plain tar of an existing
 143:       # dir) but debootstrap can leave a few root-only files behind, so run
 144:       # it as root too, per its own header comment.
 145:       - name: Pack WSL rootfs tarball
 146:         run: sudo runtime/pack-wsl.sh --build-dir runtime/build
 147: 
 148:       # workflow_dispatch runs (no tag) have no meaningful semver â€” fall
 149:       # back to the branch/ref name, which pack-lxc.sh only uses as an
 150:       # opaque label in the output filename (iolbox-ct-<VERSION>.tar.zst).
 151:       - name: Resolve version string
 152:         id: version
 153:         run: echo "value=${{ github.ref_name }}" >> "$GITHUB_OUTPUT"
 154: 
 155:       - name: Pack Proxmox LXC template
 156:         run: sudo runtime/pack-lxc.sh --build-dir runtime/build --version "${{ steps.version.outputs.value }}"
 157: 
 158:       # pack-native.sh does NOT consume the debootstrap rootfs at all â€” per
 159:       # its own header, a native install runs on the operator's own distro,
 160:       # so it only needs the supervisor + vpcs binaries plus files under
 161:       # runtime/files/{,native/}. It could run before build-rootfs.sh, but
 162:       # is kept after here so every packaging step reads top-to-bottom in
 163:       # one pass; it needs no root (no loop devices/chroot involved).
 164:       - name: Pack native (systemd) server tarball
 165:         run: runtime/pack-native.sh --supervisor-bin supervisor/bin/supervisor-linux-amd64 --build-dir runtime/build --version "${{ steps.version.outputs.value }}"
 166: 
 167:       - name: Generate checksums
 168:         working-directory: runtime/build
 169:         run: |
 170:           sha256sum iolbox-rootfs.tar iolbox-ct-*.tar.zst iolbox-server-*.tar.gz > SHA256SUMS-ci.txt
 171:           cat SHA256SUMS-ci.txt
 172: 
 173:       - uses: actions/upload-artifact@v4
 174:         with:
 175:           name: iolbox-linux
 176:           path: |
 177:             runtime/build/iolbox-rootfs.tar
 178:             runtime/build/iolbox-ct-*.tar.zst
 179:             runtime/build/iolbox-server-*.tar.gz
 180:             runtime/build/SHA256SUMS-ci.txt
 181: 
