 479: 
 480: type payloadCandidate struct {
 481: 	Path  string
 482: 	MTime time.Time
 483: }
 484: 
 485: func selectPayload(explicit, assetRoot string) (string, error) {
 486: 	if explicit != "" {
 487: 		if st, err := os.Stat(explicit); err == nil && st.Mode().IsRegular() {
 488: 			return explicit, nil
 489: 		}
 490: 		return "", codedError(exitPreflight, "payload is not a regular file: %s", explicit)
 491: 	}
 492: 	roots := []string{assetRoot}
 493: 	if cwd, err := os.Getwd(); err == nil && cwd != assetRoot {
 494: 		roots = append(roots, cwd)
 495: 	}
 496: 	var candidates []payloadCandidate
 497: 	for _, root := range roots {
 498: 		entries, err := os.ReadDir(root)
 499: 		if err != nil {
 500: 			continue
 501: 		}
 502: 		for _, entry := range entries {
 503: 			if entry.IsDir() || !strings.HasPrefix(entry.Name(), "iolbox-server-") || !strings.HasSuffix(entry.Name(), ".tar.gz") {
 504: 				continue
 505: 			}
 506: 			info, err := entry.Info()
 507: 			if err == nil && info.Mode().IsRegular() {
 508: 				candidates = append(candidates, payloadCandidate{Path: filepath.Join(root, entry.Name()), MTime: info.ModTime()})
 509: 			}
 510: 		}
 511: 	}
 512: 	if len(candidates) == 0 {
 513: 		return "", codedError(exitPreflight, "no iolbox-server-*.tar.gz payload found")
 514: 	}
 515: 	sort.Slice(candidates, func(i, j int) bool {
 516: 		if candidates[i].MTime.Equal(candidates[j].MTime) {
 517: 			return candidates[i].Path < candidates[j].Path
 518: 		}
 519: 		return candidates[i].MTime.After(candidates[j].MTime)
 520: 	})
 521: 	return candidates[0].Path, nil
 522: }
