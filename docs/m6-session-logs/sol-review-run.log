 141: func runDarwinCLI(args []string) int {
 142: 	opts, err := parseDarwinArgs(args, os.Stderr)
 143: 	if err != nil {
 144: 		fmt.Fprintln(os.Stderr, "iolbox-launcher:", err)
 145: 		return exitUsage
 146: 	}
 147: 	assetRoot, err := resolveAssetRoot(opts.AssetsDir)
 148: 	if err != nil {
 149: 		if opts.Command == "diagnose" {
 150: 			fmt.Println("iolbox diagnose")
 151: 			fmt.Println("  assets:", err)
 152: 			return exitOK
 153: 		}
 154: 		fmt.Fprintln(os.Stderr, "iolbox-launcher:", err)
 155: 		return exitUsage
 156: 	}
 157: 	table, profile, err := loadMacOSProfile(assetRoot, opts.Profile)
 158: 	if err != nil {
 159: 		if opts.Command == "diagnose" {
 160: 			fmt.Println("iolbox diagnose")
 161: 			fmt.Println("  profile:", err)
 162: 			return exitOK
 163: 		}
 164: 		fmt.Fprintln(os.Stderr, "iolbox-launcher:", err)
 165: 		return exitCode(err)
 166: 	}
 167: 	if opts.Machine == "" {
 168: 		opts.Machine = "iolbox-" + profile.Name
 169: 	}
 170: 	facts := collectHostFacts(context.Background())
 171: 	if opts.Command == "diagnose" {
 172: 		return runDiagnose(opts, table, profile, facts)
 173: 	}
 174: 	if opts.Command == "start" || opts.Command == "upgrade" {
 175: 		if facts.System != "Darwin" || facts.Arch != "arm64" {
 176: 			fmt.Fprintf(os.Stderr, "Apple Silicon macOS is required; detected %s/%s\n", facts.System, facts.Arch)
