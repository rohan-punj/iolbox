+cd "/Users/<clean-user>/Downloads/iolbox-m6-curl"
+test "$(pwd)" = "/Users/<clean-user>/Downloads/iolbox-m6-curl"
+set +x
+curl --fail --location --header "Accept: application/octet-stream" \
