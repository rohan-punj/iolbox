	if opts.NoSync {
		fmt.Println("sync: disabled")
		return
	}
	config, err := resolveDarwinSyncConfig(false, opts.ImagesDir, opts.LabsDir)
	if err != nil {
		fmt.Println("sync: unavailable (", err, ")")
