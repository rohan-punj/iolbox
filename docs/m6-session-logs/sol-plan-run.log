    status)
        status_command
        ;;
    destroy)
        destroy_command
        ;;
    doctor)
        doctor_command
        ;;
    profiles)
        print_profiles_command
        ;;
    *)
        die 1 "unknown command: $COMMAND"
        ;;
esac


