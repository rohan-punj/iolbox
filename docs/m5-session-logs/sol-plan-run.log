1039: func (s *Server) buildSpec(ll *loadedLab, n *lab.Node, nr *nodeRuntime) (node.Spec, error) {
1040: 	spec := node.Spec{
1041: 		NodeID:      n.ID,
1042: 		Kind:        string(n.Kind),
1043: 		Name:        n.Name,
1044: 		WorkDir:     ll.workDir(n.ID),
1045: 		ConsolePort: nr.consolePort,
1046: 		ConsoleBind: s.cfg.ConsoleBind,
1047: 		RAM:         n.RAM,
1048: 	}
1049: 	switch n.Kind {
1050: 	case lab.KindIOL:
1051: 		info, ok := s.lookupImage(nr.imageID)
1052: 		if !ok {
1053: 			return spec, protocol.Errorf(protocol.CodeImageNotFound, "node %d: image %s not registered", n.ID, nr.imageID)
1054: 		}
1055: 		spec.ImagePath = s.cfg.ImageDir + "/" + info.Filename
1056: 		spec.Ethernet = intOr(n.Ethernet, 1)
1057: 		spec.Serial = intOr(n.Serial, 1)
1058: 		// Size NVRAM to hold the injected startup-config (P0 correction #3:
1059: 		// boot pre-configured so IOS-XE PnP never engages). -n must be >= the
1060: 		// nvram_<id> file prepareLabDir writes, which carries the *effective*
1061: 		// config (the generated minimal default when the node has none).
1062: 		spec.NVRAMKiB = node.NVRAMKiBFor(len(effectiveStartupConfig(n)))
1063: 	case lab.KindVPCS:
1064: 		spec.VPCSCount = 1
1065: 		if nr.vtap != nil {
1066: 			// The PC's UDP tunnel points at its udp<->tap shim. vtapPorts =
1067: 			// [vpcsBind, shimBind]: VPCS binds vpcsBind (-s) and sends to shimBind
1068: 			// (-c, the shim's bind port).
1069: 			spec.VPCSUDPLocal = nr.vtapPorts[0]
1070: 			spec.VPCSUDPRemote = nr.vtapPorts[1]

