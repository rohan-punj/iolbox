 146: 		if err != nil {
 147: 			t.Fatal(err)
 148: 		}
 149: 		raw = b
 150: 	}
 151: 	return s.Dispatcher().Dispatch(&protocol.Request{ID: "t", Op: op, Args: raw})
 152: }
