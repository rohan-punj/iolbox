  30:    *  existing dev click-through flow working with no backend). */
  31:   async function onFileChosen(e: Event) {
  32:     const input = e.currentTarget as HTMLInputElement;
  33:     const file = input.files?.[0];
  34:     input.value = ""; // allow re-selecting the same file later
  35:     if (!file) return;
  36: 
  37:     uploadError = null;
  38:     busy = true;
  39:     try {
  40:       const path =
  41:         labStore.transportKind === "mock"
  42:           ? `C:\\fake\\path\\${file.name}`
  43:           : await uploadImageFile(file);
  44:       await labStore.client.imageRegister(path);
  45:       const { images } = await labStore.client.imageList();
  46:       // Adopt + reconcile + push to the supervisor: on a fresh runtime this
  47:       // is the moment seed labs become startable.
