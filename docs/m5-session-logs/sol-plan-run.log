  34: # build-release.sh), iolbox-toollaunch is trivial to cross-compile here with
  35: # CGO disabled, matching how runtime/build-rootfs.sh builds it (see that
  36: # script's `go build -trimpath` invocation for TOOLLAUNCH_BIN).
  37: TOOLLAUNCH_SRC_DEFAULT="$SCRIPT_DIR/../tools/iolbox-toollaunch"
  38: TOOLLAUNCH_SRC=""
  39: TOOLLAUNCH_BIN=""
  40: # Learning-tool packs (see docs/ for the P2/P3 plans). Each simple pack is a
  41: # single static Go binary that is both the pack's AF_UNIX GUI and its
  42: # lab-facing service; "pc" is the built-in netprobe pack PC/VPCS nodes require
  43: # (see supervisor/internal/server/toolpacks.go). secbench additionally ships a
  44: # directory of standalone attack binaries under tools/secbench-attacks-go.
