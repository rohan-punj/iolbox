   1: #!/usr/bin/env bash
   2: # pack-native.sh â€” package iolbox as a standalone installer tarball for ANY
   3: # systemd x86-64 glibc Linux server (bare metal, cloud VM, on-prem
   4: # hypervisor guest â€” not the WSL2/VMware appliance rootfs the other pack-*
   5: # scripts build). See docs/providers.md's `remote` provider and
   6: # runtime/files/native/README.txt for what ships inside.
   7: #
   8: # Unlike pack-wsl.sh/pack-vmware.sh, this does NOT consume the debootstrap
   9: # rootfs from build-rootfs.sh â€” a native install runs on the OPERATOR's own
  10: # distro, whatever it already has, so this script only needs the two
  11: # binaries (supervisor, vpcs) plus the support files under
  12: # runtime/files/{,native/}. No root required to run this script.
  13: #
  14: # Output: runtime/build/iolbox-server-<version>.tar.gz
  15: set -euo pipefail
  16: 
  17: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  18: BUILD_DIR="${IOLBOX_BUILD_DIR:-$SCRIPT_DIR/build}"
  19: FILES_DIR="$SCRIPT_DIR/files"
  20: NATIVE_DIR="$FILES_DIR/native"
  21: 
  22: VERSION="dev"
  23: # Same default search order build-rootfs.sh uses for the supervisor binary;
  24: # see that script's SUPERVISOR_BIN comment (matches PLAN.md repo layout +
  25: # .gitignore's /supervisor/bin/). Preferred over the rootfs copy when both
  26: # exist, per this script's brief ("prefer the explicit --supervisor-bin
  27: # flag like the other pack scripts" â€” --supervisor-bin always wins).
  28: SUPERVISOR_BIN_DEFAULT_1="$SCRIPT_DIR/../supervisor/bin/supervisor-linux-amd64"
  29: SUPERVISOR_BIN_DEFAULT_2="$BUILD_DIR/rootfs/opt/iolbox/supervisor"
  30: SUPERVISOR_BIN=""
  31: VPCS_BIN_DEFAULT="$BUILD_DIR/vpcs/vpcs"     # fetch-vpcs.sh's output path
  32: VPCS_BIN=""
