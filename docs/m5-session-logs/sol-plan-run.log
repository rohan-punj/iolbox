 153: pack-native: 'go' is not on PATH, needed to build iolbox-toollaunch from
 154:   $TOOLLAUNCH_SRC
 155: 
 156: Install Go, or pass --toollaunch-bin PATH to use a prebuilt linux/amd64
 157: binary instead.
 158: EOF
 159:         exit 1
 160:     }
 161:     TOOLLAUNCH_BIN="$BUILD_DIR/iolbox-toollaunch"
 162:     echo "== pack-native: building iolbox-toollaunch from $TOOLLAUNCH_SRC =="
 163:     ( cd "$TOOLLAUNCH_SRC" && GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -trimpath -o "$TOOLLAUNCH_BIN" . )
 164: fi
