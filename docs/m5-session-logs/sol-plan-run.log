 122: 
 123: func validateAttestation(path string, att structuralAttestation, p macOSProfile, facts hostFacts, limaVersion string) error {
 124: 	if att.Schema != 1 {
 125: 		return fmt.Errorf("attestation schema is %d, want 1", att.Schema)
 126: 	}
 127: 	if att.Profile != p.Name || att.MacOSProduct != facts.Product || att.MacOSBuild != facts.Build || att.LimaVersion != limaVersion {
