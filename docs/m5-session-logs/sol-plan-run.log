  70:                            binary. Default: cross-compiled on the fly from
  71:                            $TOOLLAUNCH_SRC_DEFAULT (requires 'go' on PATH).
  72:   --no-packs               Skip building/staging the learning-tool packs
  73:                            (aaa/webserver/httpclient/syslog/netsvc/pc/secbench).
  74:                            PC/VPCS nodes will not work without them.
  75:   --build-dir DIR          Output root (default: $BUILD_DIR)
  76:   --out DIR                Where to write the tarball (default: --build-dir)
  77:   -h, --help               This help
  78: 
  79: Output: <out>/iolbox-server-<version>.tar.gz
  80: EOF
  81: }
  82: 
  83: while [ $# -gt 0 ]; do
  84:     case "$1" in
  85:         --version) VERSION="$2"; shift 2 ;;
  86:         --supervisor-bin) SUPERVISOR_BIN="$2"; shift 2 ;;
  87:         --vpcs-bin) VPCS_BIN="$2"; shift 2 ;;
