   1: #!/usr/bin/env bash
   2: # Build a deployable supervisor binary WITH the real GUI embedded.
   3: #
   4: # The embed dir (supervisor/internal/web/dist) holds only a committed
   5: # placeholder in git; the real Svelte bundle is generated and gitignored. So a
   6: # plain `go build` ships the placeholder ("GUI not bundled in this build").
   7: # ALWAYS build the binary through this script (or run build:embed first) â€” it
   8: # is the single source of truth for a deployable binary.
   9: set -euo pipefail
  10: cd "$(dirname "$0")"
  11: 
  12: # Capture the git describe BEFORE any subshell cd's around, so the version
  13: # always reflects the repo commit being built, not wherever go build runs from.
  14: VERSION="$(git describe --tags --always --dirty)"
  15: echo "==> stamping version: $VERSION"
  16: 
  17: echo "==> building GUI bundle into supervisor/internal/web/dist"
  18: ( cd app && npm run build:embed >/dev/null )
  19: 
  20: echo "==> cross-compiling linux/amd64 supervisor (GUI embedded)"
  21: ( cd supervisor && GOOS=linux GOARCH=amd64 go build -ldflags "-X main.version=$VERSION" -o bin/supervisor-linux-amd64 ./cmd/supervisor )
  22: 
  23: # Sanity: the deployed index.html must NOT be the placeholder.
  24: if grep -q "not bundled" supervisor/internal/web/dist/index.html; then
  25:   echo "ERROR: embed dir still holds the placeholder â€” build:embed did not run" >&2
  26:   exit 1
  27: fi
  28: 
  29: echo "==> restoring the committed placeholder so the repo stays clean"
  30: git checkout -- supervisor/internal/web/dist/index.html 2>/dev/null || true
  31: 
  32: ls -la supervisor/bin/supervisor-linux-amd64
  33: echo "OK: supervisor/bin/supervisor-linux-amd64 has the real GUI embedded"

