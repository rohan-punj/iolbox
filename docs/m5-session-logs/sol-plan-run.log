  49: SKIP_PACKS=0
  50: OUT_DIR="$BUILD_DIR"
  51: 
  52: usage() {
  53:     cat <<EOF
  54: Usage: $0 [options]
  55: 
  56:   --version X.Y.Z         Version string embedded in the output filename and
  57:                            the top-level directory inside the tarball
  58:                            (default: $VERSION)
  59:   --supervisor-bin PATH   Path to the built Go supervisor binary. Build it
  60:                            with the repo's build-release.sh (the GUI bundle
  61:                            must be embedded â€” a plain 'go build' ships a
  62:                            placeholder GUI). Default: first of
  63:                              $SUPERVISOR_BIN_DEFAULT_1
  64:                              $SUPERVISOR_BIN_DEFAULT_2
  65:                            that exists.
  66:   --vpcs-bin PATH          Path to a prebuilt linux/amd64 vpcs binary.
