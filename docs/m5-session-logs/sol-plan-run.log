  57: 
  58:   /** POST the file to /api/upload/image with progress via XHR (fetch has no
  59:    *  upload-progress event). Resolves with the server-reported path. */
  60:   function uploadImageFile(file: File): Promise<string> {
  61:     return new Promise((resolve, reject) => {
  62:       const xhr = new XMLHttpRequest();
  63:       const url = `/api/upload/image?filename=${encodeURIComponent(file.name)}`;
  64:       xhr.open("POST", url);
  65:       xhr.setRequestHeader("Content-Type", "application/octet-stream");
  66:       uploadProgress = 0;
  67: 
  68:       xhr.upload.onprogress = (ev) => {
  69:         if (ev.lengthComputable) uploadProgress = Math.round((ev.loaded / ev.total) * 100);
  70:       };
  71: 
  72:       xhr.onload = () => {
  73:         let body: { path?: string; error?: string } = {};
  74:         try {
  75:           body = JSON.parse(xhr.responseText);
  76:         } catch {
  77:           // fall through to status-based handling below
  78:         }
  79:         if (xhr.status >= 200 && xhr.status < 300 && body.path) {
  80:           resolve(body.path);
  81:         } else {
  82:           reject(new Error(body.error || `upload failed (HTTP ${xhr.status})`));
  83:         }
  84:       };
  85:       xhr.onerror = () => reject(new Error("network error during upload"));
  86:       xhr.onabort = () => reject(new Error("upload aborted"));
  87: 
  88:       xhr.send(file);
  89:     });
  90:   }
