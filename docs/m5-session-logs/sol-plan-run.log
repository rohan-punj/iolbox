   1: # iolbox supervisor â€” the Go control-plane + embedded browser GUI the Windows
   2: # side talks to. Installed to /etc/systemd/system/iolbox-supervisor.service and
   3: # enabled at build time (build-rootfs.sh symlinks it into
   4: # multi-user.target.wants).
   5: #
   6: # The flag set below mirrors the PROVEN reference runtime's start-sup.sh
   7: # (J:\iolbox-runtime-vm, see iolbox-p0-runtime-vm memory topic) exactly:
   8: #   -control-addr 127.0.0.1:4000   raw NDJSON control API, guest-loopback only
   9: #   -ws-addr 0.0.0.0:4001          WS bridge + embedded GUI, reachable from the
  10: #                                  Windows host (browser-first product, P1)
  11: #   -console-bind 0.0.0.0          native `telnet <vm-ip>:<port>` consoles
  12: #   -capture-bind 0.0.0.0          native `wireshark -k -i TCP@<vm-ip>:<port>`
  13: #   -labs-dir                      durable lab store (seed labs materialize
  14: #                                  here on first connect when empty)
  15: #   -iourc                         generated at first boot by
  16: #                                  iolbox-firstboot-iourc.service
  17: [Unit]
  18: Description=iolbox supervisor (IOL/VPCS control plane + GUI)
  19: After=network.target iolbox-firstboot-iourc.service
  20: Wants=network.target
  21: Requires=iolbox-firstboot-iourc.service
  22: 
  23: [Service]
  24: Type=simple
  25: # /opt/iolbox on PATH: the supervisor spawns `vpcs` by bare name (see
  26: # supervisor/internal/node/argv.go) and expects it resolvable via PATH.
  27: # sbin dirs for `ip`/`sysctl`/`iptables` (extnet's `sudo -n` path uses
  28: # sudo's own secure_path, but keep them here too for direct spawns).
  29: Environment=PATH=/opt/iolbox:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  30: # Clean up what a crashed/SIGKILLed previous run can leave behind: stale
  31: # iolnatN tap devices (extnet.Close never ran) and the per-lab run dirs.
  32: # Mirrors the reference runtime's start-sup.sh cleanup loop.
  33: ExecStartPre=/opt/iolbox/prestart-clean.sh
  34: ExecStart=/opt/iolbox/supervisor \
  35:     -control-addr 127.0.0.1:4000 \
  36:     -ws-addr 0.0.0.0:4001 \
  37:     -console-bind 0.0.0.0 \
  38:     -capture-bind 0.0.0.0 \
  39:     -image-dir /opt/iolbox/images \
  40:     -run-dir /opt/iolbox/run \
  41:     -labs-dir /opt/iolbox/labs \
  42:     -iourc /opt/iolbox/iourc
  43: Restart=always
  44: RestartSec=1
  45: 
  46: # Runs as root: IOL spawn, tap creation, NVRAM files. Single-tenant
  47: # disposable runtime â€” there's nobody else on the box to protect.
  48: # KillMode=control-group (the default, stated explicitly) is load-bearing:
  49: # stopping/restarting the unit also kills the IOL/VPCS/iouyap children, so
  50: # no orphaned vpcs busy-spinners survive a supervisor bounce (the orphan
  51: # problem the dev VM needed pkill loops for).
  52: User=root
  53: WorkingDirectory=/opt/iolbox
  54: KillMode=control-group
  55: 
  56: # systemd delegates a writable subtree to the supervisor. The supervisor
  57: # creates <D>/supervisor/ and migrates itself there before enabling controllers
  58: # on <D>; this is required by cgroup v2's no-internal-processes rule, so <D>
  59: # remains available for the sibling tool cages.
  60: Delegate=yes
  61: Delegate=memory pids cpu
  62: CPUAccounting=yes
  63: MemoryAccounting=yes
  64: TasksAccounting=yes
  65: IOAccounting=yes
  66: 
  67: # Supervisor + child IOL/VPCS output lands in the journal; invaluable when
  68: # debugging a runtime interactively (journalctl -u iolbox-supervisor).
  69: StandardOutput=journal
  70: StandardError=journal
  71: 
  72: # No sandboxing directives on purpose: the supervisor creates UDP sockets,
  73: # taps, telnet/capture listeners on high ports, runs `sudo -n ip/iptables`.
  74: # This is not a hardened multi-tenant service.
  75: 
  76: [Install]
  77: WantedBy=multi-user.target

