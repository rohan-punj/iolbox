 118: // generateIourc writes the ~/.iourc license file content for this host to w.
 119: func generateIourc(w io.Writer) error {
 120: 	hostname, err := os.Hostname()
 121: 	if err != nil {
 122: 		return fmt.Errorf("hostname: %w", err)
 123: 	}
 124: 	hostid, err := hostID()
 125: 	if err != nil {
 126: 		return err
 127: 	}
 128: 	content, err := iourc.File(hostid, hostname)
 129: 	if err != nil {
 130: 		return err
 131: 	}
 132: 	_, err = io.WriteString(w, content)
 133: 	return err
 134: }
 135: 
 136: // hostID returns the 8-hex-digit host id used as the keygen input, matching the
 137: // output of the Linux `hostid` command (the community keygen's expected input).
 138: // Falls back to reading /etc/hostid (4 bytes, host-endian) if the command is
 139: // unavailable.
 140: func hostID() (string, error) {
 141: 	if out, err := exec.Command("hostid").Output(); err == nil {
 142: 		if s := strings.TrimSpace(string(out)); s != "" {
 143: 			return s, nil
 144: 		}
 145: 	}
 146: 	if b, err := os.ReadFile("/etc/hostid"); err == nil && len(b) >= 4 {
 147: 		return fmt.Sprintf("%08x", binary.LittleEndian.Uint32(b[:4])), nil
 148: 	}
 149: 	return "", fmt.Errorf("could not determine hostid (no `hostid` command and no /etc/hostid)")
 150: }

