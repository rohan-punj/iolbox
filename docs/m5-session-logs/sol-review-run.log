 342: // ListenAndServe binds the control address and serves connections until ctx is
 343: // cancelled. It refuses non-loopback bind hosts.
 344: func (s *Server) ListenAndServe(ctx context.Context) error {
 345: 	// Materialize the embedded starter labs on first run (no-op once the
 346: 	// store holds any lab).
 347: 	s.seedLabs()
 348: 
 349: 	// Rebuild the image registry from ImageDir: the registry is in-memory
 350: 	// only, so without this a supervisor restart forgets every registered
 351: 	// image even though the files persist on disk.
 352: 	s.rescanImages()
 353: 
 354: 	host, _, err := net.SplitHostPort(s.cfg.ControlAddr)
 355: 	if err != nil {
 356: 		return fmt.Errorf("control addr %q: %w", s.cfg.ControlAddr, err)
 357: 	}
 358: 	if ip := net.ParseIP(host); ip == nil || !ip.IsLoopback() {
 359: 		return fmt.Errorf("control addr host %q must be loopback (127.0.0.1)", host)
 360: 	}
 361: 
 362: 	ln, err := net.Listen("tcp", s.cfg.ControlAddr)
 363: 	if err != nil {
 364: 		return err
 365: 	}
 366: 	defer ln.Close()
 367: 
 368: 	go func() {
 369: 		<-ctx.Done()
 370: 		_ = ln.Close()
 371: 	}()
 372: 
 373: 	// Per-link throughput sampler: polls relay counters every statsInterval and
 374: 	// emits link.stats events. Tied to ctx so it exits with the server.
 375: 	go s.statsLoop(ctx)
 376: 
 377: 	var wg sync.WaitGroup
 378: 	for {
 379: 		conn, err := ln.Accept()
 380: 		if err != nil {
 381: 			select {
 382: 			case <-ctx.Done():
 383: 				wg.Wait()
 384: 				s.shutdown()
 385: 				return nil
 386: 			default:
 387: 				return err
 388: 			}
 389: 		}
 390: 		wg.Add(1)
 391: 		go func() {
 392: 			defer wg.Done()
 393: 			s.serveConn(ctx, conn)
 394: 		}()
 395: 	}
 396: }
 397: 
 398: // serveConn handles one TCP client connection by delegating to ServeConn, the
 399: // transport-agnostic NDJSON connection core also used by the WebSocket
 400: // bridge (internal/wsbridge) so both transports share identical dispatch,
 401: // event-subscription, and error-handling behaviour.
 402: func (s *Server) serveConn(ctx context.Context, conn net.Conn) {
 403: 	defer conn.Close()
 404: 	s.ServeConn(ctx, conn)
 405: }
 406: 
 407: // ServeConn runs the NDJSON control-protocol loop over rwc until the stream
 408: // ends, ctx is cancelled, or a write fails: it reads one NDJSON request per
 409: // line, dispatches it through the shared verb dispatcher, writes the
 410: // response, and subscribes rwc to server-pushed events for the connection's
 411: // lifetime. It does not close rwc; the caller owns that.
 412: //
 413: // This is the seam that lets the TCP control listener (server.go) and the
 414: // WebSocket /control endpoint (internal/wsbridge) behave identically: both
 415: // hand ServeConn an io.ReadWriteCloser (a net.Conn for TCP, a small adapter
 416: // over WebSocket text frames for WS) and get the same request/response/event
 417: // semantics with no duplicated verb-handling logic.
 418: func (s *Server) ServeConn(ctx context.Context, rwc io.ReadWriteCloser) {
 419: 	dec := protocol.NewDecoder(rwc)
 420: 	enc := protocol.NewEncoder(rwc)
 421: 
 422: 	unsub := s.bc.subscribe(enc)
 423: 	defer unsub()
 424: 
 425: 	done := make(chan struct{})
 426: 	defer close(done)
 427: 	go func() {
 428: 		select {
 429: 		case <-ctx.Done():
 430: 			_ = rwc.Close()
 431: 		case <-done:
 432: 		}
 433: 	}()
 434: 
 435: 	for {
 436: 		req, err := dec.ReadRequest()
 437: 		if err != nil {
 438: 			return // EOF or malformed; drop the connection
 439: 		}
 440: 		resp := s.disp.Dispatch(req)
 441: 		if err := enc.WriteResponse(resp); err != nil {
 442: 			return
 443: 		}
 444: 	}
 445: }
 446: 
 447: // shutdown stops all nodes and tears down the fabric on server exit.
 448: func (s *Server) shutdown() {
 449: 	s.labMu.Lock()
 450: 	defer s.labMu.Unlock()
 451: 	s.mu.Lock()
 452: 	ll := s.lab
 453: 	s.mu.Unlock()
 454: 	if ll != nil {
 455: 		ll.stopAll()
 456: 		s.teardownFabric(ll)
 457: 	}
 458: }
 459: 
 460: // emit pushes an event to all subscribers.
 461: func (s *Server) emit(name string, data any) {
 462: 	s.bc.publish(protocol.NewEvent(name, data))
 463: }
