 393:   private clearToastTimer(id: string) {
 394:     const timer = this.toastTimers.get(id);
 395:     if (timer) clearTimeout(timer);
 396:     this.toastTimers.delete(id);
 397:     this.toastTimerStartedAt.delete(id);
 398:   }
 399: 
 400:   private clearToastExitTimer(id: string) {
 401:     const timer = this.toastExitTimers.get(id);
 402:     if (timer) clearTimeout(timer);
 403:     this.toastExitTimers.delete(id);
 404:   }
 405: 
 406:   private startToastTimer(id: string) {
 407:     const toast = this.toasts.find((item) => item.id === id);
 408:     if (!toast || toast.dismissing || this.toastPauseCounts.get(id)) return;
 409:     this.clearToastTimer(id);
 410:     const remaining = this.toastRemaining.get(id) ?? toast.duration;
 411:     if (remaining <= 0) {
 412:       this.dismissToast(id);
 413:       return;
 414:     }
 415:     this.toastTimerStartedAt.set(id, Date.now());
 416:     this.toastTimers.set(id, setTimeout(() => this.dismissToast(id), remaining));
 417:   }
 418: 
 419:   private promoteToast() {
 420:     while (this.toasts.length < 4 && this.toastQueue.length > 0) {
 421:       const next = this.toastQueue.shift()!;
 422:       this.toasts = [...this.toasts, next];
 423:       this.startToastTimer(next.id);
 424:     }
 425:   }
