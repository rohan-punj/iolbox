 214: // register wires every verb to its handler.
 215: func (s *Server) register() {
 216: 	// The dispatcher is intentionally shared by all control connections. Wrap
 217: 	// every handler, including reads, because several read handlers return
 218: 	// pointers into loaded-lab runtime state and must not race a topology or
 219: 	// lifecycle mutation halfway through a response. Non-lab operations are
 220: 	// cheap and using the same wrapper keeps the registration audit-proof.
 221: 	handle := func(op string, h protocol.Handler) { s.disp.Handle(op, s.serializedHandler(h)) }
 222: 	handle("hello", s.handleHello)
 223: 	handle("tool.listPacks", s.handleToolListPacks)
 224: 	handle("pc.syncState", s.handlePCSyncState)
 225: 	handle("image.list", s.handleImageList)
 226: 	handle("image.register", s.handleImageRegister)
 227: 	handle("lab.load", s.handleLabLoad)
 228: 	handle("lab.saveDoc", s.handleLabSaveDoc)
 229: 	handle("lab.listDocs", s.handleLabListDocs)
 230: 	handle("lab.getDoc", s.handleLabGetDoc)
 231: 	handle("lab.deleteDoc", s.handleLabDeleteDoc)
 232: 	handle("lab.start", s.handleLabStart)
 233: 	handle("lab.stop", s.handleLabStop)
 234: 	handle("lab.wipe", s.handleLabWipe)
 235: 	handle("lab.reap", s.handleLabReap)
 236: 	handle("node.add", s.handleNodeAdd)
 237: 	handle("node.remove", s.handleNodeRemove)
 238: 	handle("node.start", s.handleNodeStart)
 239: 	handle("node.stop", s.handleNodeStop)
 240: 	handle("node.restart", s.handleNodeRestart)
 241: 	handle("node.setImage", s.handleNodeSetImage)
 242: 	handle("node.macs", s.handleNodeMACs)
 243: 	handle("link.add", s.handleLinkAdd)
 244: 	handle("link.remove", s.handleLinkRemove)
 245: 	handle("link.setFault", s.handleLinkSetFault)
 246: 	handle("capture.start", s.handleCaptureStart)
 247: 	handle("capture.stop", s.handleCaptureStop)
 248: 	handle("config.save", s.handleConfigExtract)
 249: 	handle("config.extract", s.handleConfigExtract)
 250: 	handle("painter.collect", s.handlePainterCollect)
 251: 	handle("painter.stpVlans", s.handlePainterSTPVlans)
 252: 	handle("status", s.handleStatus)
 253: }
