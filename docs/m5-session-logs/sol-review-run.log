1085: 		// nat: Close deletes the tap and removes the iptables rules by exact -D
1086: 		// spec, then release the subnet index back to the pool.
1087: 		_ = nr.extnet.Close()
1088: 		nr.extnet = nil
1089: 		if nr.natSubnet != 0 {
1090: 			s.natSubnets.Release(nr.natSubnet)
1091: 			nr.natSubnet = 0
1092: 		}
1093: 		nr.machine.To(node.StateStopped)
1094: 		return
1095: 	}
1096: 	if nr.tool != nil {
1097: 		// handleLabReap (the GUI's "Force clean") already loops stopNode and
1098: 		// teardownFabric, so tool endpoints are covered by that path as well.
1099: 		if n := ll.findNode(id); n != nil && n.Kind == lab.KindPC {
1100: 			// Pull before closing the GUI socket. A failed pull leaves the previous
1101: 			// document state intact and is intentionally non-fatal to teardown.
1102: 			_ = s.syncPCNode(ll, id)
1103: 		}
1104: 		if nr.proc != nil {
1105: 			_ = nr.proc.Stop()
1106: 			nr.proc = nil
1107: 		}
1108: 		_ = nr.tool.Stop()
1109: 		nr.tool = nil
1110: 		nr.machine.To(node.StateStopped)
1111: 		return
1112: 	}
1113: 	if nr.proc != nil {
1114: 		_ = nr.proc.Stop()
1115: 		nr.proc = nil
1116: 	} else {
1117: 		nr.machine.To(node.StateStopped)
1118: 	}
1119: 	// Fabric VPCS: stop its shim, delete its tap, release its udp ports.
1120: 	if nr.vtap != nil || nr.vtapName != "" {
1121: 		s.teardownVPCS(nr)
1122: 	}
1123: }
