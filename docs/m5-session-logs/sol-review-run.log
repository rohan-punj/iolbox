1802:   async setNodeImage(nodeId: number, imageId: string) {
1803:     const node = this.lab.nodes.find((n) => n.id === nodeId);
1804:     const img = this.images.find((i) => i.id === imageId);
1805:     if (!node || !img) return;
1806:     // Local doc first, and persist it: the user's choice must stick even when
1807:     // the supervisor sync needs the fallback below.
1808:     node.image = { id: img.id, filename: img.filename, class: img.class };
1809:     this.scheduleAutosave();
1810:     try {
1811:       await this.client.nodeSetImage(this.lab.id, nodeId, imageId);
1812:     } catch {
1813:       // Typically "unknown lab": the doc never loaded (e.g. it predates the
1814:       // image upload and lab.load failed). Now that it carries a valid image
1815:       // the full doc can load â€” re-send it when nothing is running.
1816:       await this.resyncAfterImageChange();
1817:     }
1818:   }
1819: 
1820:   replaceImageEverywhere(fromId: string, toId: string) {
1821:     const img = this.images.find((i) => i.id === toId);
1822:     if (!img) return;
1823:     let failed = false;
1824:     const applied: Promise<unknown>[] = [];
1825:     for (const node of this.lab.nodes) {
1826:       if (node.image?.id === fromId) {
1827:         node.image = { id: img.id, filename: img.filename, class: img.class };
1828:         applied.push(this.client.nodeSetImage(this.lab.id, node.id, img.id).catch(() => (failed = true)));
1829:       }
1830:     }
1831:     if (applied.length === 0) return;
1832:     this.scheduleAutosave();
1833:     void Promise.all(applied).then(() => {
1834:       if (failed) return this.resyncAfterImageChange();
1835:     });
1836:   }
1837: 
1838:   /** Fallback sync when node.setImage was rejected (lab not loaded at the
1839:    *  supervisor): re-send the whole doc, unless nodes are running. */
1840:   private async resyncAfterImageChange() {
1841:     const busy = this.lab.nodes.some(
1842:       (n) => this.nodeStates[n.id] === "running" || this.nodeStates[n.id] === "starting"
1843:     );
1844:     if (busy) {
1845:       this.lastError = "image change saved locally â€” restart the lab to apply it";
1846:       this.pushLog("warn", this.lastError);
1847:       return;
1848:     }
1849:     try {
1850:       await this.loadLab(this.lab);
1851:     } catch (e) {
1852:       this.lastError = `apply image change: ${(e as Error).message}`;
1853:       this.pushLog("error", this.lastError);
1854:     }
1855:   }
