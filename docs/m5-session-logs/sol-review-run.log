1125: // handleNodeAdd registers a node the GUI just dropped onto an already-loaded
   1: // Package protocol implements the NDJSON control protocol between the iolbox GUI
   2: // and the supervisor (see docs/protocol.md). One request, response, or event
   3: // per line, UTF-8, correlated by id.
   4: package protocol
   5: 
   6: import (
   7: 	"encoding/json"
   8: 	"fmt"
   9: )
  10: 
  11: // Request is a client-to-server message: {"id","op","args"}.
  12: type Request struct {
  13: 	ID   string          `json:"id"`
  14: 	Op   string          `json:"op"`
  15: 	Args json.RawMessage `json:"args,omitempty"`
  16: }
  17: 
  18: // Response is a server-to-client reply correlated to a Request by ID.
  19: // Exactly one of Result / Error is set depending on OK.
  20: type Response struct {
  21: 	ID     string          `json:"id"`
  22: 	OK     bool            `json:"ok"`
  23: 	Result json.RawMessage `json:"result,omitempty"`
  24: 	Error  *Error          `json:"error,omitempty"`
  25: }
  26: 
  27: // Error is a structured failure with a stable code (see docs/protocol.md).
  28: type Error struct {
  29: 	Code    string `json:"code"`
  30: 	Message string `json:"message"`
  31: }
  32: 
  33: // Error implements the error interface so Error values can flow as errors.
  34: func (e *Error) Error() string { return e.Code + ": " + e.Message }
  35: 
  36: // Event is an unsolicited server-to-client push: {"event","data"}.
  37: type Event struct {
  38: 	Event string          `json:"event"`
  39: 	Data  json.RawMessage `json:"data,omitempty"`
  40: }
  41: 
  42: // Error codes defined by the protocol.
  43: const (
  44: 	CodeSchemaInvalid     = "schema_invalid"
  45: 	CodeImageNotFound     = "image_not_found"
  46: 	CodeImageArchMismatch = "image_arch_mismatch"
  47: 	CodeIourcFailed       = "iourc_failed"
  48: 	CodeNodeSpawnFailed   = "node_spawn_failed"
  49: 	CodePortUnavailable   = "port_unavailable"
  50: 	CodeNvramCodecFailed  = "nvram_codec_failed"
  51: 	CodeNotLoaded         = "not_loaded"
  52: 	CodeUnsupported       = "unsupported"
  53: 	// CodeNotFound is returned when a requested durable lab document does not
  54: 	// exist in the store (lab.getDoc).
  55: 	CodeNotFound = "not_found"
  56: 	// CodeBadRequest is used for malformed frames / unknown verbs; it is a
  57: 	// superset error not enumerated in the protocol but needed in practice.
  58: 	CodeBadRequest = "bad_request"
  59: )
  60: 
  61: // Event names defined by the protocol.
  62: const (
  63: 	EventNodeState      = "node.state"
  64: 	EventNodeConsole    = "node.console"
  65: 	EventNodePCState    = "node.pcState"
  66: 	EventLinkUp         = "link.up"
  67: 	EventLinkDown       = "link.down"
  68: 	EventCaptureStarted = "capture.started"
  69: 	EventCaptureStopped = "capture.stopped"
  70: 	EventLinkStats      = "link.stats"
  71: 	EventLinkFault      = "link.fault"
  72: 	EventHostStats      = "host.stats"
  73: 	EventLog            = "log"
  74: )
  75: 
  76: // Errorf builds an *Error with a formatted message.
  77: func Errorf(code, format string, args ...any) *Error {
  78: 	return &Error{Code: code, Message: fmt.Sprintf(format, args...)}
  79: }
  80: 
  81: // NewError builds an *Error with a literal message.
  82: func NewError(code, message string) *Error {
  83: 	return &Error{Code: code, Message: message}
  84: }
  85: 
  86: // mustMarshal marshals v to JSON, panicking on failure. Used only for values we
  87: // control (protocol results/events), which never fail to marshal.
  88: func mustMarshal(v any) json.RawMessage {
  89: 	b, err := json.Marshal(v)
  90: 	if err != nil {
  91: 		panic("protocol: marshal: " + err.Error())
  92: 	}
  93: 	return b
  94: }

