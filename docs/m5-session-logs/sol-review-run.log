1668: func (s *Server) handleStatus(raw json.RawMessage) (any, error) {
1669: 	var args protocol.LabSelectArgs
1670: 	if err := decode(raw, &args); err != nil {
1671: 		return nil, err
1672: 	}
1673: 	s.mu.Lock()
1674: 	ll := s.lab
1675: 	s.mu.Unlock()
1676: 	if ll == nil {
1677: 		return protocol.StatusResult{Nodes: []protocol.StatusNode{}, Links: []protocol.StatusLink{}}, nil
1678: 	}
1679: 	doc := ll.docSnapshot()
1680: 	res := protocol.StatusResult{
1681: 		LabID: doc.ID,
1682: 		Nodes: []protocol.StatusNode{},
1683: 		Links: []protocol.StatusLink{},
1684: 	}
1685: 	for _, dn := range doc.Nodes {
1686: 		nr := ll.get(dn.ID)
1687: 		sn := protocol.StatusNode{ID: dn.ID, State: string(node.StateStopped), RAM: dn.RAM}
1688: 		if dn.Image != nil {
1689: 			sn.Image = dn.Image.ID
1690: 		}
1691: 		if nr != nil {
1692: 			sn.State = string(nr.machine.State())
1693: 			sn.ConsolePort = nr.consolePort
1694: 			if nr.proc != nil {
1695: 				sn.PID = nr.proc.PID()
1696: 			}
1697: 			if sn.PID == 0 && nr.tool != nil {
1698: 				sn.PID = nr.tool.PID()
1699: 			}
1700: 		}
1701: 		res.Nodes = append(res.Nodes, sn)
1702: 	}
1703: 	ll.mu.Lock()
1704: 	for _, dl := range doc.Links {
1705: 		sl := protocol.StatusLink{ID: dl.ID}
1706: 		if port, ok := ll.captures[dl.ID]; ok {
1707: 			p := port
1708: 			sl.CapturePort = &p
1709: 		}
1710: 		res.Links = append(res.Links, sl)
1711: 	}
1712: 	ll.mu.Unlock()
1713: 	return res, nil
1714: }
1715: 
1716: func intOr(p *int, def int) int {
1717: 	if p == nil {
1718: 		return def
1719: 	}
1720: 	return *p
1721: }
1722: 
1723: // netmapFor renders the whole-lab NETMAP: a static-tap line for every IOL
1724: // interface, pointing it at its own pseudo-instance/tap whether or not a link
1725: // exists for it â€” the topology-independent NETMAP that makes hot-connect work
1726: // (IOL reads NETMAP once at boot, so a link drawn later must not require a new
1727: // line). It is written once, into the shared lab dir, before any IOL node spawns
1728: // (Linux prepareLabDir); the fabric must be refreshed first (prepareLabDir's
1729: // caller does that).
1730: func (s *Server) netmapFor(ll *loadedLab) string {
1731: 	return netmap.BuildStatic(staticNetmapEntries(ll.staticTapsSnapshot()))
1732: }
