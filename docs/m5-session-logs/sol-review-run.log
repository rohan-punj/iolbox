1735:   // ---- canvas annotations (Excalidraw-style) ----
1736: 
1737:   /** Add a new annotation and return its id (so the caller can arm inline edit). */
1738:   addAnnotation(anno: Annotation): string {
1739:     this.lab.annotations = [...(this.lab.annotations ?? []), anno];
1740:     this.scheduleAutosave();
1741:     return anno.id;
1742:   }
1743: 
1744:   /** Shallow-merge a patch into one annotation, preserving its discriminant. */
1745:   updateAnnotation(id: string, patch: Partial<Annotation>) {
1746:     const list = this.lab.annotations;
1747:     if (!list) return;
1748:     const idx = list.findIndex((a) => a.id === id);
1749:     if (idx < 0) return;
1750:     // Merge in place; the caller only ever patches fields valid for the type.
1751:     list[idx] = { ...list[idx], ...patch } as Annotation;
1752:     this.scheduleAutosave();
1753:   }
1754: 
1755:   removeAnnotation(id: string) {
1756:     if (!this.lab.annotations) return;
1757:     this.lab.annotations = this.lab.annotations.filter((a) => a.id !== id);
1758:     if (this.selectedAnnotationId === id) this.selectedAnnotationId = null;
1759:     this.scheduleAutosave();
1760:   }
1761: 
1762:   newAnnotationId(): string {
1763:     return uuid();
1764:   }
1765: 
1766:   /** Clone an annotation: fresh id, same content, offset +40/+40 (both
1767:    *  endpoints for a line) so the copy doesn't sit exactly on top of the
1768:    *  source. Mirrors duplicateNode. Returns the new annotation's id, or null
1769:    *  if src is missing. */
1770:   duplicateAnnotation(id: string): string | null {
1771:     const src = this.lab.annotations?.find((a) => a.id === id);
1772:     if (!src) return null;
1773:     const clone = { ...structuredClone($state.snapshot(src)), id: this.newAnnotationId() } as Annotation;
1774:     if (clone.type === "line") {
1775:       clone.x1 += 40;
1776:       clone.y1 += 40;
1777:       clone.x2 += 40;
1778:       clone.y2 += 40;
1779:     } else {
1780:       clone.x += 40;
1781:       clone.y += 40;
1782:     }
1783:     return this.addAnnotation(clone);
1784:   }
