 351: // --- painter (topology-decision overlays) ---
 352: 
 353: // PainterArgs targets the painter.collect verb: which protocol to scrape and,
 354: // for the routing protocols, the destination to trace toward.
 355: type PainterArgs struct {
 356: 	LabID string `json:"labId"`
 357: 	// Proto is one of "stp", "ospf", "eigrp", "bgp".
 358: 	Proto string `json:"proto"`
 359: 	// Dest is the routing destination (a prefix "10.0.0.0/24", a host
 360: 	// "10.0.0.1", or a nodeId reference the caller has resolved to an address).
 361: 	// Ignored for STP. Optional for OSPF/EIGRP (path highlight only when set).
 362: 	Dest string `json:"dest,omitempty"`
 363: 	// VLAN scopes an STP collect to one VLAN's spanning tree (proto == "stp"
 364: 	// only). STP is per-VLAN with exactly one root per VLAN, so a paint always
 365: 	// targets a single VLAN chosen via the painter.stpVlans step; VLAN==0 is
 366: 	// invalid for a "stp" collect (the handler rejects it) rather than
 367: 	// silently falling back to "first VLAN found", which is what produced the
 368: 	// old two-roots-per-lab bug.
 369: 	VLAN int `json:"vlan,omitempty"`
 370: 	// Nodes optionally restricts the scrape to these node ids; empty = all
 371: 	// running IOL nodes in the lab (all L2 bridges, auto-queried for the
