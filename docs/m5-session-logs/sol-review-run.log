  68: // Server is the supervisor control server.
  69: type Server struct {
  70: 	cfg  Config
  71: 	disp *protocol.Dispatcher
  72: 
  73: 	consolePorts *node.PortAllocator
  74: 	capturePorts *node.PortAllocator
  75: 	udpPorts     *node.PortAllocator
  76: 	natSubnets   *extnet.SubnetAllocator
  77: 
  78: 	// caps reports which external-net node kinds (nat/mgmt) the runtime supports,
  79: 	// detected once at startup. Advertised in hello; enforced at lab.start.
  80: 	caps extnet.Capabilities
  81: 	// toolCaps reports whether the runtime can safely host tool process trees.
  82: 	// It is populated by InitRuntime and remains zero when startup cannot
  83: 	// establish the required delegation.
  84: 	toolCaps tool.Capabilities
  85: 	// toolRoot is the delegated cgroup root used by tool cages.
  86: 	toolRoot tool.CgroupRoot
  87: 	// toolPacks is the validated installed-pack registry used by tool handlers.
  88: 	toolPacks []tool.Pack
  89: 	// pcPack is the supervisor-owned built-in netprobe pack. It is deliberately
  90: 	// absent from toolPacks so ordinary tool.listPacks/config.pack cannot select
  91: 	// it.
  92: 	pcPack   tool.Pack
  93: 	pcPackOK bool
  94: 	// toolStop stops the supervisor-scope orphan reaper, when runtime startup
  95: 	// reached the point at which the reaper was started.
  96: 	toolStop func()
  97: 
  98: 	// egress is the resolved internet-egress capability ("slirp" or "routed"),
  99: 	// from the -egress flag / auto-detection at startup. Advertised in hello so
 100: 	// the GUI can badge the NAT node when it can't pass ICMP/traceroute.
 101: 	egress string
 102: 
 103: 	mu     sync.Mutex
 104: 	images map[string]image.Info // by id
 105: 	lab    *loadedLab
 106: 
 107: 	// labMu serializes every control-plane operation that can observe or mutate
 108: 	// the loaded lab. Dispatch runs one goroutine per connection, and fault
 109: 	// timers plus the console/capture bridge call paths can enter the same state
 110: 	// outside that dispatcher. Keeping one lock at this boundary prevents two
 111: 	// lab lifecycles from interleaving kernel operations or publishing one lab
 112: 	// before the previous lab has finished tearing down.
 113: 	labMu sync.Mutex
 114: 
 115: 	// cacheMu serializes read-modify-write cycles on the sidecar image
 116: 	// fingerprint cache in ImageDir (see imagescan.go).
 117: 	cacheMu sync.Mutex
 118: 
 119: 	// broadcaster fans events out to connected clients.
 120: 	bc *broadcaster
 121: }
 122: 
 123: // New builds a Server with default port bases (console 9000+, capture 5500+,
 124: // udp 10000+ per docs/protocol.md).
 125: func New(cfg Config) *Server {
 126: 	if cfg.Version == "" {
 127: 		cfg.Version = "0.1.0"
 128: 	}
 129: 	if cfg.Runtime == "" {
 130: 		cfg.Runtime = "debian-slim-12"
 131: 	}
 132: 	if cfg.Arch == "" {
 133: 		cfg.Arch = "x86_64"
 134: 	}
 135: 	if cfg.LabsDir == "" {
 136: 		cfg.LabsDir = "/opt/iolbox/labs"
 137: 	}
 138: 	if cfg.Egress == "" {
 139: 		cfg.Egress = "auto"
 140: 	}
 141: 	if cfg.ToolPacksDir == "" {
 142: 		cfg.ToolPacksDir = "/opt/iolbox/tools/packs"
 143: 	}
 144: 	if cfg.StateDir == "" {
 145: 		cfg.StateDir = "/var/lib/iolbox"
 146: 	}
 147: 	s := &Server{
 148: 		cfg:          cfg,
 149: 		disp:         protocol.NewDispatcher(),
 150: 		consolePorts: node.NewPortAllocator(9000, 1000),
 151: 		capturePorts: node.NewPortAllocator(5500, 1000),
 152: 		udpPorts:     node.NewPortAllocator(10000, 20000),
 153: 		natSubnets:   extnet.NewSubnetAllocator(),
 154: 		images:       make(map[string]image.Info),
 155: 		toolPacks:    []tool.Pack{},
 156: 		bc:           newBroadcaster(),
 157: 	}
 158: 	// Detect nat support once: nat needs /dev/net/tun + passwordless sudo. Off
 159: 	// Linux this is always false, so the dev box never advertises the feature.
 160: 	// See extnet.Detect / handleHello.
 161: 	s.caps = extnet.Detect(extnet.SudoOK())
 162: 	// Resolve the NAT egress capability once (auto-detects the QEMU slirp
 163: 	// signature; -egress slirp|routed forces it). Best-effort, never fails.
 164: 	s.egress = egress.Resolve(cfg.Egress)
 165: 	s.register()
 166: 	return s
 167: }
 168: 
 169: // InitRuntime performs the kernel-affecting tool startup sequence only for
 170: // the real supervisor process. Keeping it out of New lets control-plane tests
 171: // construct servers without migrating their own PID or creating probe cages.
 172: func (s *Server) InitRuntime() error {
 173: 	if err := tool.SetSubreaper(); err != nil {
 174: 		return fmt.Errorf("tool: set subreaper: %w", err)
 175: 	}
 176: 
 177: 	root, err := tool.InitCgroupRoot()
 178: 	if err != nil {
 179: 		return fmt.Errorf("tool: initialize cgroup root: %w", err)
 180: 	}
 181: 	s.toolRoot = root
 182: 
 183: 	instanceID, err := tool.InstanceID(s.cfg.StateDir)
 184: 	if err != nil {
 185: 		return fmt.Errorf("tool: establish instance identity: %w", err)
 186: 	}
 187: 	if err := tool.ReapStale(tool.ReapConfig{
 188: 		Root:       s.toolRoot,
 189: 		StateDir:   s.cfg.StateDir,
 190: 		RunDir:     s.cfg.RunDir,
 191: 		InstanceID: instanceID,
 192: 	}); err != nil {
 193: 		return fmt.Errorf("tool: reap stale objects: %w", err)
 194: 	}
 195: 
 196: 	s.toolStop = tool.StartReaper(tool.Registry)
 197: 	s.toolCaps = tool.Detect(s.toolRoot)
 198: 	s.toolpacksLoad(s.cfg.ToolPacksDir)
 199: 	return nil
 200: }
 201: 
 202: // StopRuntime closes the supervisor-scope reaper after listeners have
 203: // stopped accepting work. Clearing the function first makes repeated cleanup
 204: // calls harmless, including when InitRuntime failed before the reaper started.
 205: func (s *Server) StopRuntime() {
 206: 	if s.toolStop == nil {
 207: 		return
 208: 	}
 209: 	stop := s.toolStop
 210: 	s.toolStop = nil
 211: 	stop()
 212: }
