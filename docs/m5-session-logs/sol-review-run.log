  27: // decode unmarshals raw args into v, returning a schema_invalid protocol error
  28: // on failure. nil args decode to the zero value.
  29: func decode(raw json.RawMessage, v any) error {
  30: 	if len(raw) == 0 {
  31: 		return nil
  32: 	}
  33: 	if err := json.Unmarshal(raw, v); err != nil {
  34: 		return protocol.Errorf(protocol.CodeBadRequest, "bad args: %v", err)
  35: 	}
  36: 	return nil
  37: }
  38: 
  39: func (s *Server) handleHello(raw json.RawMessage) (any, error) {
  40: 	var args protocol.HelloArgs
  41: 	if err := decode(raw, &args); err != nil {
  42: 		return nil, err
  43: 	}
  44: 	// Base features are always present; nat and tools are advertised only when
  45: 	// their runtime probes detected support at startup.
  46: 	features := []string{"nvram", "capture", "i386"}
  47: 	features = append(features, s.caps.GateFeatures()...)
  48: 	features = append(features, s.toolCaps.GateFeatures()...)
  49: 	return protocol.HelloResult{
  50: 		Supervisor: s.cfg.Version,
  51: 		Runtime:    s.cfg.Runtime,
  52: 		Arch:       s.cfg.Arch,
  53: 		Features:   features,
  54: 		Egress:     s.egress,
  55: 		EgressNote: egress.Note(s.egress),
  56: 	}, nil
  57: }
  58: 
  59: func (s *Server) handleImageList(_ json.RawMessage) (any, error) {
  60: 	s.mu.Lock()
  61: 	defer s.mu.Unlock()
  62: 	out := protocol.ImageListResult{Images: []protocol.ImageInfo{}}
  63: 	for _, info := range s.images {
  64: 		out.Images = append(out.Images, toImageInfo(info))
  65: 	}
  66: 	return out, nil
  67: }
  68: 
  69: func (s *Server) handleImageRegister(raw json.RawMessage) (any, error) {
  70: 	var args protocol.ImageRegisterArgs
  71: 	if err := decode(raw, &args); err != nil {
  72: 		return nil, err
  73: 	}
  74: 	if args.Path == "" {
  75: 		return nil, protocol.NewError(protocol.CodeBadRequest, "path is required")
  76: 	}
  77: 	info, err := inspectOrTrustHint(args)
  78: 	if err != nil {
  79: 		return nil, protocol.Errorf(protocol.CodeImageNotFound, "inspect %s: %v", args.Path, err)
  80: 	}
  81: 	s.mu.Lock()
  82: 	s.images[info.ID] = *info
  83: 	s.mu.Unlock()
  84: 	// Seed the sidecar fingerprint cache so the startup rescan re-registers
  85: 	// this file after a restart without re-hashing it (see imagescan.go).
  86: 	s.cacheRegisteredImage(args.Path, info)
  87: 	return protocol.ImageRegisterResult{
  88: 		ID:     info.ID,
  89: 		Class:  string(info.Class),
  90: 		Arch:   string(info.Arch),
  91: 		SHA256: info.SHA256,
  92: 	}, nil
  93: }
  94: 
  95: func toImageInfo(info image.Info) protocol.ImageInfo {
  96: 	return protocol.ImageInfo{
  97: 		ID:       info.ID,
  98: 		Filename: info.Filename,
  99: 		Class:    string(info.Class),
 100: 		Arch:     string(info.Arch),
 101: 		SHA256:   info.SHA256,
 102: 		Size:     info.Size,
 103: 	}
 104: }
