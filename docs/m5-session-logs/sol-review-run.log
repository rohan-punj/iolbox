1038: // buildSpec assembles a node.Spec from the lab node + runtime state.
1039: func (s *Server) buildSpec(ll *loadedLab, n *lab.Node, nr *nodeRuntime) (node.Spec, error) {
1040: 	spec := node.Spec{
1041: 		NodeID:      n.ID,
1042: 		Kind:        string(n.Kind),
1043: 		Name:        n.Name,
1044: 		WorkDir:     ll.workDir(n.ID),
1045: 		ConsolePort: nr.consolePort,
1046: 		ConsoleBind: s.cfg.ConsoleBind,
1047: 		RAM:         n.RAM,
1048: 	}
1049: 	switch n.Kind {
1050: 	case lab.KindIOL:
1051: 		info, ok := s.lookupImage(nr.imageID)
1052: 		if !ok {
1053: 			return spec, protocol.Errorf(protocol.CodeImageNotFound, "node %d: image %s not registered", n.ID, nr.imageID)
1054: 		}
1055: 		spec.ImagePath = s.cfg.ImageDir + "/" + info.Filename
1056: 		spec.Ethernet = intOr(n.Ethernet, 1)
1057: 		spec.Serial = intOr(n.Serial, 1)
1058: 		// Size NVRAM to hold the injected startup-config (P0 correction #3:
1059: 		// boot pre-configured so IOS-XE PnP never engages). -n must be >= the
1060: 		// nvram_<id> file prepareLabDir writes, which carries the *effective*
1061: 		// config (the generated minimal default when the node has none).
1062: 		spec.NVRAMKiB = node.NVRAMKiBFor(len(effectiveStartupConfig(n)))
1063: 	case lab.KindVPCS:
1064: 		spec.VPCSCount = 1
1065: 		if nr.vtap != nil {
1066: 			// The PC's UDP tunnel points at its udp<->tap shim. vtapPorts =
1067: 			// [vpcsBind, shimBind]: VPCS binds vpcsBind (-s) and sends to shimBind
1068: 			// (-c, the shim's bind port).
1069: 			spec.VPCSUDPLocal = nr.vtapPorts[0]
1070: 			spec.VPCSUDPRemote = nr.vtapPorts[1]
1071: 		}
1072: 	}
1073: 	return spec, nil
1074: }
1075: 
1076: func (s *Server) stopNode(ll *loadedLab, id int) {
1077: 	nr := ll.get(id)
1078: 	if nr == nil {
1079: 		return
1080: 	}
1081: 	// Scheduled fault intents are runtime-only and must not fire after the
1082: 	// endpoint they target has been stopped.
1083: 	s.cancelFaultTimersForNode(ll, id)
1084: 	if nr.extnet != nil {
1085: 		// nat: Close deletes the tap and removes the iptables rules by exact -D
1086: 		// spec, then release the subnet index back to the pool.
1087: 		_ = nr.extnet.Close()
1088: 		nr.extnet = nil
1089: 		if nr.natSubnet != 0 {
1090: 			s.natSubnets.Release(nr.natSubnet)
1091: 			nr.natSubnet = 0
1092: 		}
1093: 		nr.machine.To(node.StateStopped)
1094: 		return
1095: 	}
1096: 	if nr.tool != nil {
1097: 		// handleLabReap (the GUI's "Force clean") already loops stopNode and
1098: 		// teardownFabric, so tool endpoints are covered by that path as well.
1099: 		if n := ll.findNode(id); n != nil && n.Kind == lab.KindPC {
1100: 			// Pull before closing the GUI socket. A failed pull leaves the previous
1101: 			// document state intact and is intentionally non-fatal to teardown.
1102: 			_ = s.syncPCNode(ll, id)
1103: 		}
1104: 		if nr.proc != nil {
1105: 			_ = nr.proc.Stop()
1106: 			nr.proc = nil
1107: 		}
1108: 		_ = nr.tool.Stop()
1109: 		nr.tool = nil
1110: 		nr.machine.To(node.StateStopped)
1111: 		return
1112: 	}
1113: 	if nr.proc != nil {
1114: 		_ = nr.proc.Stop()
1115: 		nr.proc = nil
1116: 	} else {
1117: 		nr.machine.To(node.StateStopped)
1118: 	}
1119: 	// Fabric VPCS: stop its shim, delete its tap, release its udp ports.
1120: 	if nr.vtap != nil || nr.vtapName != "" {
1121: 		s.teardownVPCS(nr)
1122: 	}
1123: }
1124: 
1125: // handleNodeAdd registers a node the GUI just dropped onto an already-loaded
1126: // lab: appends it to the loaded doc, allocates a console port, and creates its
1127: // runtime â€” exactly what lab.load does per node â€” so it can start WITHOUT a
1128: // page refresh. Without this a freshly dropped node was unknown to the
1129: // supervisor (node.start -> "unknown node") until the next lab.load; NAT nodes
1130: // were the visible victim since they're typically dropped and started
1131: // mid-session. Validation runs on a candidate copy of the whole doc so a bad
1132: // node (dup id, unknown kind, bad name) is rejected without side effects.
1133: func (s *Server) handleNodeAdd(raw json.RawMessage) (any, error) {
1134: 	var args protocol.NodeAddArgs
1135: 	if err := decode(raw, &args); err != nil {
1136: 		return nil, err
1137: 	}
1138: 	ll, err := s.currentLab(args.LabID)
1139: 	if err != nil {
1140: 		return nil, err
1141: 	}
1142: 	if ll.get(args.Node.ID) != nil {
1143: 		return nil, protocol.Errorf(protocol.CodeBadRequest, "node %d already exists", args.Node.ID)
1144: 	}
1145: 	current := ll.docSnapshot()
1146: 	candidate := *current
1147: 	candidate.Nodes = append(append([]lab.Node{}, current.Nodes...), args.Node)
1148: 	if err := candidate.Validate(); err != nil {
1149: 		return nil, protocol.Errorf(protocol.CodeSchemaInvalid, "%v", err)
1150: 	}
1151: 
1152: 	port, err := s.consolePorts.Next()
1153: 	if err != nil {
1154: 		return nil, protocol.Errorf(protocol.CodePortUnavailable, "%v", err)
1155: 	}
1156: 	n := args.Node
1157: 	nr := &nodeRuntime{
1158: 		id:          n.ID,
1159: 		consolePort: port,
1160: 		machine:     node.NewMachine(s.nodeStateCallback(n.ID)),
1161: 		ram:         n.RAM,
1162: 	}
1163: 	if n.Kind == lab.KindIOL && n.Image != nil {
1164: 		nr.imageID = n.Image.ID
1165: 	}
1166: 	ll.mu.Lock()
1167: 	ll.doc.Nodes = append(ll.doc.Nodes, n)
1168: 	ll.nodes[n.ID] = nr
1169: 	ll.mu.Unlock()
1170: 	s.emit(protocol.EventNodeConsole, protocol.NodeConsoleData{Node: n.ID, ConsolePort: port})
1171: 	return protocol.NodeAddResult{Node: n.ID, ConsolePort: port}, nil
1172: }
1173: 
1174: // handleNodeRemove is node.add's inverse for GUI deletes: stop the node (full
1175: // runtime cleanup), drop it and every link touching it from the loaded doc,
1176: // detach those links' fabric bridges, release its console port, and refresh the
1177: // fabric so the remaining wiring stays consistent.
1178: func (s *Server) handleNodeRemove(raw json.RawMessage) (any, error) {
1179: 	var args protocol.NodeArgs
1180: 	if err := decode(raw, &args); err != nil {
1181: 		return nil, err
1182: 	}
1183: 	ll, err := s.currentLab(args.LabID)
1184: 	if err != nil {
1185: 		return nil, err
1186: 	}
1187: 	nr := ll.get(args.Node)
1188: 	if nr == nil {
1189: 		return nil, protocol.Errorf(protocol.CodeBadRequest, "unknown node %d", args.Node)
1190: 	}
1191: 	var orphanTaps []string
1192: 	staticTaps := ll.staticTapsSnapshot()
1193: 	for _, tap := range staticTaps[args.Node] {
1194: 		orphanTaps = append(orphanTaps, tap.tapName)
1195: 	}
1196: 	s.stopNode(ll, args.Node)
1197: 	s.consolePorts.Release(nr.consolePort)
1198: 
1199: 	doc := ll.docSnapshot()
1200: 	fabricOK := fabricNodes(doc)
1201: 	kept := doc.Links[:0]
1202: 	for i := range doc.Links {
1203: 		l := &doc.Links[i]
1204: 		touches := false
1205: 		for _, ep := range l.Endpoints {
1206: 			if ep.Node == args.Node {
1207: 				touches = true
1208: 				break
1209: 			}
1210: 		}
1211: 		if touches {
1212: 			if isFabricLink(l, fabricOK) {
1213: 				s.detachFabricLink(ll, l)
1214: 			}
1215: 		} else {
1216: 			kept = append(kept, *l)
1217: 		}
1218: 	}
1219: 	doc.Links = kept
1220: 	var nodes []lab.Node
1221: 	for _, n := range doc.Nodes {
1222: 		if n.ID != args.Node {
1223: 			nodes = append(nodes, n)
1224: 		}
1225: 	}
1226: 	doc.Nodes = nodes
1227: 	ll.mu.Lock()
1228: 	delete(ll.nodes, args.Node)
1229: 	ll.doc = doc
1230: 	ll.mu.Unlock()
1231: 	s.evictStaticTaps(ll, orphanTaps)
1232: 	s.refreshFabric(ll)
1233: 	s.emit(protocol.EventNodeState, protocol.NodeStateData{Node: args.Node, State: "stopped"})
1234: 	return protocol.NodeArgs{LabID: doc.ID, Node: args.Node}, nil
1235: }
