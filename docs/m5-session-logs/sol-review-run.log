 270: // Dispatcher exposes the verb dispatcher (used by tests).
 271: func (s *Server) Dispatcher() *protocol.Dispatcher { return s.disp }
 272: 
 273: // ConsolePort returns the allocated telnet console port for nodeID in the
 274: // currently loaded lab. Used by the WebSocket console bridge
 275: // (internal/wsbridge) to dial the right local port for GET /console/{nodeId}.
 276: // ok is false if no lab is loaded or the node id is unknown.
 277: func (s *Server) ConsolePort(nodeID int) (port int, ok bool) {
 278: 	s.labMu.Lock()
 279: 	defer s.labMu.Unlock()
 280: 	s.mu.Lock()
 281: 	ll := s.lab
 282: 	s.mu.Unlock()
 283: 	if ll == nil {
 284: 		return 0, false
 285: 	}
 286: 	nr := ll.get(nodeID)
 287: 	if nr == nil {
 288: 		return 0, false
 289: 	}
 290: 	return nr.consolePort, true
 291: }
 292: 
 293: // ConsoleSubscribe attaches an in-process subscriber to nodeID's console hub
 294: // (v0.3.0 Phase 2), letting internal/wsbridge consume decoded console output
 295: // and write keystrokes without dialing ConsolePort over loopback TCP â€” see
 296: // node.Process.Subscribe / node.consoleHub.Subscribe. Returns nil if no lab is
 297: // loaded, the node id is unknown, the node hasn't started, or the node has no
 298: // console hub at all (VPCS, which is its own telnet server â€” see the
 299: // node.Process doc comment). Mirrors ConsolePort's existing precedent for
 300: // crossing the internal/node boundary into the server/wsbridge layer.
 301: func (s *Server) ConsoleSubscribe(nodeID int) *node.Subscription {
 302: 	s.labMu.Lock()
 303: 	defer s.labMu.Unlock()
 304: 	s.mu.Lock()
 305: 	ll := s.lab
 306: 	s.mu.Unlock()
 307: 	if ll == nil {
 308: 		return nil
 309: 	}
 310: 	nr := ll.get(nodeID)
 311: 	if nr == nil || nr.proc == nil {
 312: 		return nil
 313: 	}
 314: 	return nr.proc.Subscribe()
 315: }
 316: 
 317: // CapturePort returns the local TCP port serving the live pcapng stream for
 318: // linkID in the currently loaded lab, if that link has an active capture. Used
 319: // by the WebSocket capture bridge (internal/wsbridge) to dial the right local
 320: // port for GET /capture/{linkId}. ok is false if no lab is loaded or the link
 321: // has no active capture. The port is the one capture.start recorded in the
 322: // lab's capture bookkeeping (ll.captures), which mirrors the relay's own
 323: // CapturePort().
 324: func (s *Server) CapturePort(linkID int) (port int, ok bool) {
 325: 	s.labMu.Lock()
 326: 	defer s.labMu.Unlock()
 327: 	s.mu.Lock()
 328: 	ll := s.lab
 329: 	s.mu.Unlock()
 330: 	if ll == nil {
 331: 		return 0, false
 332: 	}
 333: 	ll.mu.Lock()
 334: 	port, ok = ll.captures[linkID]
 335: 	ll.mu.Unlock()
 336: 	if !ok || port == 0 {
 337: 		return 0, false
 338: 	}
 339: 	return port, true
 340: }
