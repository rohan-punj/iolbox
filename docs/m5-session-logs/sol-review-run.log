1271: func (s *Server) handleNodeMACs(raw json.RawMessage) (any, error) {
1272: 	var args protocol.NodeMACsArgs
1273: 	if err := decode(raw, &args); err != nil {
1274: 		return nil, err
1275: 	}
1276: 	ll, err := s.currentLab("")
1277: 	if err != nil {
1278: 		return nil, err
1279: 	}
1280: 	n := ll.findNode(args.Node)
1281: 	nr := ll.get(args.Node)
1282: 	if n == nil || nr == nil {
1283: 		return nil, protocol.Errorf(protocol.CodeBadRequest, "unknown node %d", args.Node)
1284: 	}
1285: 
1286: 	interfaces := lab.Interfaces(*n)
1287: 	macs := make([]protocol.NodeMAC, 0, len(interfaces))
1288: 	switch n.Kind {
1289: 	case lab.KindVPCS:
1290: 		macs = append(macs, protocol.NodeMAC{
1291: 			Interface: interfaces[0],
1292: 			MAC:       node.VPCSMAC(args.Node, 0),
1293: 			Source:    "derived",
1294: 			State:     "known",
1295: 		})
1296: 	case lab.KindPC, lab.KindTool:
1297: 		for _, iface := range interfaces {
1298: 			mac := protocol.NodeMAC{Interface: iface, State: "unknown"}
1299: 			if nr.machine.State() != node.StateRunning {
1300: 				mac.Reason = "node not running"
1301: 			} else if address, readErr := readNetnsMAC(args.Node); readErr != nil {
1302: 				mac.Reason = "MAC unavailable"
1303: 			} else {
1304: 				mac.MAC = address
1305: 				mac.Source = "read"
1306: 				mac.State = "known"
1307: 			}
1308: 			macs = append(macs, mac)
1309: 		}
1310: 	case lab.KindIOL:
1311: 		macs = make([]protocol.NodeMAC, len(interfaces))
1312: 		rowForInterface := make(map[string]int, len(interfaces))
1313: 		for i, iface := range interfaces {
1314: 			macs[i] = protocol.NodeMAC{Interface: iface, State: "unknown"}
1315: 			if parsed, parseErr := netmap.ParseIface(iface); parseErr == nil {
1316: 				rowForInterface[parsed.String()] = i
1317: 				if parsed.Type == netmap.Serial {
1318: 					macs[i].Reason = "interface has no IEEE MAC address"
1319: 				} else {
1320: 					macs[i].Reason = "hardware address not reported by IOS"
1321: 				}
1322: 			} else {
1323: 				macs[i].Reason = "hardware address not reported by IOS"
1324: 			}
1325: 		}
1326: 
1327: 		if nr.proc == nil || nr.machine == nil || nr.machine.State() != node.StateRunning {
1328: 			for i := range macs {
1329: 				macs[i].Reason = "node not running"
1330: 			}
1331: 			break
1332: 		}
1333: 		out, showErr := s.runShow(context.Background(), ll, args.Node,
1334: 			"show interfaces | include ^[A-Za-z].* is |Hardware is .*address is")
1335: 		if showErr != nil {
1336: 			for i := range macs {
1337: 				macs[i].Reason = "MAC unavailable (console busy or unreachable)"
1338: 			}
1339: 			break
1340: 		}
1341: 		for _, parsedMAC := range painter.ParseInterfaceMACs(out) {
1342: 			parsedIface, parseErr := netmap.ParseIface(parsedMAC.Interface)
1343: 			if parseErr != nil {
1344: 				continue
1345: 			}
1346: 			row, ok := rowForInterface[parsedIface.String()]
1347: 			if !ok {
1348: 				continue
1349: 			}
1350: 			macs[row].MAC = parsedMAC.MAC
1351: 			macs[row].Source = "read"
1352: 			macs[row].State = "known"
1353: 			macs[row].Reason = ""
1354: 		}
1355: 		break
1356: 
1357: 	case lab.KindNAT:
1358: 		for _, iface := range interfaces {
1359: 			macs = append(macs, protocol.NodeMAC{
1360: 				Interface: iface,
1361: 				State:     "unknown",
1362: 				Reason:    "not tracked for the NAT gateway",
1363: 			})
1364: 		}
1365: 	}
1366: 	return protocol.NodeMACsResult{Node: args.Node, MACs: macs}, nil
1367: }
1368: 
1369: func readNetnsMAC(nodeID int) (string, error) {
1370: 	argv := tool.NetnsExecArgs(nodeID, []string{"cat", "/sys/class/net/" + tool.GuestIface + "/address"})
1371: 	cmd := exec.Command(argv[0], argv[1:]...)
1372: 	var output bytes.Buffer
1373: 	cmd.Stdout = &output
1374: 	cmd.Stderr = &output
1375: 	err := tool.Registry.StartAndAdd(cmd.Start, func() int { return cmd.Process.Pid })
1376: 	if err == nil {
1377: 		err = cmd.Wait()
1378: 		tool.Registry.Remove(cmd.Process.Pid)
1379: 	}
1380: 	if err != nil {
1381: 		return "", fmt.Errorf("read guest MAC: %w: %s", err, strings.TrimSpace(output.String()))
1382: 	}
1383: 	address := strings.ToLower(strings.TrimSpace(output.String()))
1384: 	if address == "" {
1385: 		return "", fmt.Errorf("read guest MAC: empty address")
1386: 	}
1387: 	return address, nil
1388: }
1389: 
1390: func (s *Server) handleLinkAdd(raw json.RawMessage) (any, error) {
1391: 	var args protocol.LinkArgs
1392: 	if err := decode(raw, &args); err != nil {
1393: 		return nil, err
1394: 	}
1395: 	ll, err := s.currentLab(args.LabID)
1396: 	if err != nil {
1397: 		return nil, err
1398: 	}
1399: 
1400: 	// Keep the LOADED doc in sync (upsert by link id): the fabric and future
1401: 	// refreshes all derive from ll.doc.Links, so a link that only lived in the
1402: 	// GUI's copy would never be wired until the next lab.load.
1403: 	replaced := false
1404: 	doc := ll.docSnapshot()
1405: 	for i := range doc.Links {
1406: 		if doc.Links[i].ID == args.Link.ID {
1407: 			doc.Links[i] = args.Link
1408: 			replaced = true
1409: 			break
1410: 		}
1411: 	}
1412: 	if !replaced {
1413: 		doc.Links = append(doc.Links, args.Link)
1414: 	}
1415: 	ll.mu.Lock()
1416: 	ll.doc = doc
1417: 	ll.mu.Unlock()
1418: 
1419: 	// The HOT-CONNECT path. Every interface already has its own static tap
1420: 	// (created at boot, topology-independent NETMAP), so wiring this link is a
1421: 	// pure runtime bridge-attach that never touches a running node â€” no relay, no
1422: 	// port churn, no restart. Refresh the fabric (so a newly reconnected interface
1423: 	// gets/keeps its static tap) then ensure the bridge + attach every member's
1424: 	// tap (both idempotent). An unlinked node whose tap isn't up yet is attached
1425: 	// by startFabric.
1426: 	s.refreshFabric(ll)
1427: 	if err := s.startFabric(ll, nil); err != nil {
1428: 		return nil, err
1429: 	}
1430: 	s.emit(protocol.EventLinkUp, protocol.LinkData{Link: args.Link.ID})
1431: 	return protocol.LinkData{Link: args.Link.ID}, nil
1432: }
1433: 
1434: func (s *Server) handleLinkRemove(raw json.RawMessage) (any, error) {
1435: 	var args protocol.LinkArgs
1436: 	if err := decode(raw, &args); err != nil {
1437: 		return nil, err
1438: 	}
1439: 	ll, err := s.currentLab(args.LabID)
1440: 	if err != nil {
1441: 		return nil, err
1442: 	}
1443: 	// Detach the fabric link's taps + delete its bridge (the taps persist â€” the
1444: 	// interfaces are unconnected again, still tap-ready for a future hot-connect).
1445: 	// Classify from the CURRENT doc before we drop the link.
1446: 	doc := ll.docSnapshot()
1447: 	if isFabricLink(&args.Link, fabricNodes(doc)) {
1448: 		s.detachFabricLink(ll, &args.Link)
1449: 	}
1450: 	ll.mu.Lock()
1451: 	delete(ll.linkFaults, args.Link.ID)
1452: 	ll.mu.Unlock()
1453: 	// Mirror the removal into the loaded doc (see handleLinkAdd's upsert) so the
1454: 	// wiring a later start/refresh derives never resurrects this link.
1455: 	kept := doc.Links[:0]
1456: 	for _, l := range doc.Links {
1457: 		if l.ID != args.Link.ID {
1458: 			kept = append(kept, l)
1459: 		}
1460: 	}
1461: 	doc.Links = kept
1462: 	ll.mu.Lock()
1463: 	ll.doc = doc
1464: 	ll.mu.Unlock()
1465: 	s.refreshFabric(ll)
1466: 	s.emit(protocol.EventLinkDown, protocol.LinkData{Link: args.Link.ID})
1467: 	return protocol.LinkData{Link: args.Link.ID}, nil
1468: }
1469: 
1470: func (s *Server) handleCaptureStart(raw json.RawMessage) (any, error) {
1471: 	var args protocol.CaptureArgs
1472: 	if err := decode(raw, &args); err != nil {
1473: 		return nil, err
1474: 	}
1475: 	ll, err := s.currentLab(args.LabID)
1476: 	if err != nil {
1477: 		return nil, err
1478: 	}
1479: 	link := ll.findLink(args.Link)
1480: 	if link == nil {
1481: 		return nil, protocol.Errorf(protocol.CodeBadRequest, "unknown link %d", args.Link)
1482: 	}
1483: 	// Reuse an already-armed port (doc auto-arm at lab start, or a repeated
1484: 	// capture.start): allocating a fresh one would orphan the old port without
1485: 	// release AND leave GUI/native clients pointing at a dead capture. wasArmed
1486: 	// gates the rollback path so a pre-existing port is never released by a
1487: 	// failed re-request.
1488: 	ll.mu.Lock()
1489: 	port, wasArmed := ll.captures[link.ID]
1490: 	ll.mu.Unlock()
1491: 	if !wasArmed {
1492: 		var err error
1493: 		port, err = s.capturePorts.Next()
1494: 		if err != nil {
1495: 			return nil, protocol.Errorf(protocol.CodePortUnavailable, "%v", err)
1496: 		}
1497: 	}
1498: 
1499: 	// Capture the link's Linux bridge with tcpdump and serve it as pcapng on the
1500: 	// port model the GUI /capture/<id> path reads (ll.captures[link]). Every link
1501: 	// is capturable live with no node restart.
1502: 	actual, err := s.startBridgeCapture(ll, link.ID, port)
1503: 	if err != nil {
1504: 		if !wasArmed {
1505: 			s.capturePorts.Release(port)
1506: 		}
1507: 		return nil, protocol.Errorf(protocol.CodeBadRequest, "%v", err)
1508: 	}
1509: 	ll.mu.Lock()
1510: 	ll.captures[link.ID] = actual
1511: 	ll.mu.Unlock()
1512: 	s.emit(protocol.EventCaptureStarted, protocol.CaptureData{Link: link.ID, CapturePort: actual})
1513: 	res := protocol.CaptureResult{Link: link.ID, CapturePort: actual}
1514: 	if args.Mode == "file" {
1515: 		res.File = args.File
1516: 	}
1517: 	return res, nil
1518: }
1519: 
1520: func (s *Server) handleCaptureStop(raw json.RawMessage) (any, error) {
1521: 	var args protocol.CaptureArgs
1522: 	if err := decode(raw, &args); err != nil {
1523: 		return nil, err
1524: 	}
1525: 	ll, err := s.currentLab(args.LabID)
1526: 	if err != nil {
1527: 		return nil, err
1528: 	}
1529: 	ll.mu.Lock()
1530: 	port, ok := ll.captures[args.Link]
1531: 	delete(ll.captures, args.Link)
1532: 	ll.mu.Unlock()
1533: 	if ok {
1534: 		s.capturePorts.Release(port)
1535: 	}
1536: 	// Stop the link's tcpdump/pcapng bridge capture; nothing else to do.
1537: 	s.stopBridgeCapture(ll, args.Link)
1538: 	s.emit(protocol.EventCaptureStopped, protocol.CaptureData{Link: args.Link, CapturePort: port})
1539: 	return protocol.CaptureResult{Link: args.Link, CapturePort: port}, nil
1540: }
1541: 
1542: // armDocCaptures allocates a capture port for every doc link with
1543: // capture.enabled that has no runtime capture yet, recording it in ll.captures
1544: // so startFabric can auto-start a bridge capture on it once the link's bridge is
1545: // up. Links already armed (capture.start, or a previous lab start) keep their
1546: // port. Called by startNodes BEFORE startFabric. On allocator exhaustion the
1547: // newly armed links are rolled back and the start fails.
1548: func (s *Server) armDocCaptures(ll *loadedLab) error {
1549: 	ll.mu.Lock()
1550: 	defer ll.mu.Unlock()
1551: 	var added []int
1552: 	for i := range ll.doc.Links {
1553: 		l := &ll.doc.Links[i]
1554: 		if l.Capture == nil || !l.Capture.Enabled {
1555: 			continue
1556: 		}
1557: 		if _, ok := ll.captures[l.ID]; ok {
1558: 			continue
1559: 		}
1560: 		port, err := s.capturePorts.Next()
1561: 		if err != nil {
1562: 			for _, id := range added {
1563: 				s.capturePorts.Release(ll.captures[id])
1564: 				delete(ll.captures, id)
1565: 			}
1566: 			return protocol.Errorf(protocol.CodePortUnavailable, "capture link %d: %v", l.ID, err)
1567: 		}
1568: 		ll.captures[l.ID] = port
1569: 		added = append(added, l.ID)
1570: 	}
1571: 	return nil
1572: }
1573: 
1574: // releaseCaptures returns every armed capture port to the allocator and clears
1575: // the lab's capture bookkeeping, and emits capture.stopped per link when
1576: // emitStops is true (the full-lab-stop behaviour). With emitStops false it is
1577: // the silent cleanup path for a lab being replaced by lab.load. The bridge
1578: // captures themselves are stopped by teardownFabric, which every caller runs
1579: // first.
1580: func (s *Server) releaseCaptures(ll *loadedLab, emitStops bool) {
1581: 	ll.mu.Lock()
1582: 	captures := make(map[int]int, len(ll.captures))
1583: 	for link, port := range ll.captures {
1584: 		captures[link] = port
1585: 	}
1586: 	ll.captures = make(map[int]int)
1587: 	ll.mu.Unlock()
1588: 	for link, port := range captures {
1589: 		s.capturePorts.Release(port)
1590: 		if emitStops {
1591: 			s.emit(protocol.EventCaptureStopped, protocol.CaptureData{Link: link, CapturePort: port})
1592: 		}
1593: 	}
1594: }
1595: 
1596: func (s *Server) handleConfigExtract(raw json.RawMessage) (any, error) {
1597: 	var args protocol.ConfigArgs
1598: 	if err := decode(raw, &args); err != nil {
1599: 		return nil, err
1600: 	}
1601: 	ll, err := s.currentLab(args.LabID)
1602: 	if err != nil {
1603: 		return nil, err
1604: 	}
1605: 	ids := args.Nodes
1606: 	if ids == nil {
1607: 		for _, n := range ll.docSnapshot().Nodes {
1608: 			ids = append(ids, n.ID)
1609: 		}
1610: 	}
1611: 	out := protocol.ConfigResult{Configs: []protocol.NodeConfig{}}
1612: 	for _, id := range ids {
1613: 		cfg, err := s.extractNVRAM(ll, id)
1614: 		if err != nil {
1615: 			return nil, err
1616: 		}
1617: 		out.Configs = append(out.Configs, protocol.NodeConfig{Node: id, StartupConfig: cfg})
1618: 	}
1619: 	return out, nil
1620: }
