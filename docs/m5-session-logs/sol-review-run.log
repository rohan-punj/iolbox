 265:   private toastDuration(severity: ToastSeverity): number {
 266:     switch (severity) {
 267:       case "success":
 268:         return 4_000;
 269:       case "info":
 270:         return 4_500;
 271:       case "warning":
 272:         return 6_000;
 273:       case "danger":
 274:         return 6_000;
 275:       case "error":
 276:         return 8_000;
 277:     }
 278:   }
 279: 
 280:   enqueueToast(input: ToastInput): string {
 281:     const now = Date.now();
 282:     const duration = input.duration ?? this.toastDuration(input.severity);
 283:     const existingIndex = input.key
 284:       ? this.toasts.findIndex((toast) => toast.key === input.key)
 285:       : -1;
 286:     const queuedIndex = input.key
 287:       ? this.toastQueue.findIndex((toast) => toast.key === input.key)
 288:       : -1;
 289: 
 290:     if (existingIndex >= 0 || queuedIndex >= 0) {
 291:       const visible = existingIndex >= 0;
 292:       const existing = visible ? this.toasts[existingIndex] : this.toastQueue[queuedIndex];
 293:       const updated: ToastNotification = {
 294:         ...existing,
 295:         severity: input.severity,
 296:         message: input.message,
 297:         createdAt: now,
 298:         duration,
 299:         count: input.count,
 300:         dismissing: false,
 301:       };
 302:       this.clearToastExitTimer(existing.id);
 303:       this.toastRemaining.set(existing.id, duration);
 304:       this.clearToastTimer(existing.id);
 305:       if (visible) {
 306:         this.toasts = this.toasts.map((toast, index) => (index === existingIndex ? updated : toast));
 307:         if (!this.toastPauseCounts.get(existing.id)) this.startToastTimer(existing.id);
 308:       } else {
 309:         this.toastQueue[queuedIndex] = updated;
 310:       }
 311:       return existing.id;
 312:     }
 313: 
 314:     const toast: ToastNotification = {
 315:       id: `toast-${now}-${++this.toastId}`,
 316:       key: input.key,
 317:       severity: input.severity,
 318:       message: input.message,
 319:       createdAt: now,
 320:       duration,
 321:       count: input.count,
 322:     };
 323:     while (this.toasts.length + this.toastQueue.length >= 20 && this.toastQueue.length > 0) {
 324:       const dropIndex = this.toastQueue.findIndex((queued) => queued.severity !== "error");
 325:       if (dropIndex < 0 && toast.severity !== "error") return toast.id;
 326:       const [dropped] = this.toastQueue.splice(dropIndex >= 0 ? dropIndex : 0, 1);
 327:       if (dropped) this.toastRemaining.delete(dropped.id);
 328:     }
 329:     this.toastRemaining.set(toast.id, duration);
 330:     if (this.toasts.length < 4) {
 331:       this.toasts = [toast, ...this.toasts];
 332:       this.startToastTimer(toast.id);
 333:     } else {
 334:       this.toastQueue.push(toast);
 335:     }
 336:     return toast.id;
 337:   }
 338: 
 339:   dismissToast(id: string) {
 340:     const visibleIndex = this.toasts.findIndex((toast) => toast.id === id);
 341:     if (visibleIndex < 0) {
 342:       const queuedIndex = this.toastQueue.findIndex((toast) => toast.id === id);
 343:       if (queuedIndex >= 0) this.toastQueue.splice(queuedIndex, 1);
 344:       return;
 345:     }
 346:     const toast = this.toasts[visibleIndex];
 347:     if (toast.dismissing) return;
 348:     this.clearToastTimer(id);
 349:     this.toastPauseCounts.delete(id);
 350:     this.toasts = this.toasts.map((item, index) =>
 351:       index === visibleIndex ? { ...item, dismissing: true } : item
 352:     );
 353:     this.clearToastExitTimer(id);
 354:     this.toastExitTimers.set(
 355:       id,
 356:       setTimeout(() => {
 357:         this.toastExitTimers.delete(id);
 358:         this.toasts = this.toasts.filter((item) => item.id !== id);
 359:         this.toastRemaining.delete(id);
 360:         this.promoteToast();
 361:       }, 120)
 362:     );
 363:   }
 364: 
 365:   pauseToast(id: string) {
 366:     const toast = this.toasts.find((item) => item.id === id);
 367:     if (!toast || toast.dismissing) return;
 368:     const count = this.toastPauseCounts.get(id) ?? 0;
 369:     this.toastPauseCounts.set(id, count + 1);
 370:     if (count > 0) return;
 371:     const startedAt = this.toastTimerStartedAt.get(id);
 372:     if (startedAt !== undefined) {
 373:       const remaining = this.toastRemaining.get(id) ?? toast.duration;
 374:       this.toastRemaining.set(id, Math.max(0, remaining - (Date.now() - startedAt)));
 375:     }
 376:     this.clearToastTimer(id);
 377:   }
 378: 
 379:   resumeToast(id: string) {
 380:     const count = this.toastPauseCounts.get(id) ?? 0;
 381:     if (count === 0) return;
 382:     if (count <= 1) this.toastPauseCounts.delete(id);
 383:     else this.toastPauseCounts.set(id, count - 1);
 384:     if (count > 1) return;
 385:     const toast = this.toasts.find((item) => item.id === id);
 386:     if (toast && !toast.dismissing) this.startToastTimer(id);
 387:   }
