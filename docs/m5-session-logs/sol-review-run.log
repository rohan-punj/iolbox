 542: 
 543: func (s *Server) handleNodeRestart(raw json.RawMessage) (any, error) {
 544: 	var args protocol.NodeArgs
 545: 	if err := decode(raw, &args); err != nil {
 546: 		return nil, err
 547: 	}
 548: 	ll, err := s.currentLab(args.LabID)
 549: 	if err != nil {
 550: 		return nil, err
 551: 	}
 552: 	// stopNode is synchronous all the way down: node.Process.Stop and
 553: 	// tool.Endpoint.Stop each block (bounded) until the killed process is
 554: 	// observed gone, and teardownVPCS/extnet.Close release the tap and UDP
 555: 	// ports before returning. So by the time startNodes runs, the old
 556: 	// instance's NETIO socket dir, console port and tap are genuinely free â€”
 557: 	// no old/new overlap for the same node id.
 558: 	s.stopNode(ll, args.Node)
 559: 	return s.startNodes(ll, []int{args.Node})
 560: }
 561: 
 562: // startNodes spawns the given nodes (Linux) or records the attempt (other OS).
 563: //
 564: // Before spawning, it (re)prepares the shared lab dir: the whole-lab NETMAP
 565: // (native IOL<->IOL links), the shared iourc, and each IOL node's NVRAM with its
 566: // startupConfig injected. IOL reads all of these from its cwd at boot, so they
 567: // must exist first. prepareLabDir is a no-op off Linux.
 568: func (s *Server) startNodes(ll *loadedLab, ids []int) (any, error) {
 569: 	// Auto-arm capture for every doc link with capture.enabled BEFORE the fabric
 570: 	// is realised, so startFabric can start a bridge capture on its port the
 571: 	// moment the link's bridge is up. Without this, a lab (re)started with capture
 572: 	// enabled in its doc had an empty ll.captures, so /capture/{id} 404'd forever
 573: 	// â€” "enable capture and restart the lab" never worked. Ports persist across
 574: 	// per-node restarts (armDocCaptures only arms missing links) and are released
 575: 	// by lab.stop / capture.stop / lab.load.
 576: 	if err := s.armDocCaptures(ll); err != nil {
 577: 		return nil, err
 578: 	}
 579: 	// (Re)compute the whole-lab static-tap fabric first: prepareLabDir's NETMAP
 580: 	// and the netio<->tap iouyaps both derive from it, so it must exist before
 581: 	// either. It is deterministic and runs on every platform so control-plane
 582: 	// tests see the same NETMAP.
 583: 	s.refreshFabric(ll)
 584: 	if err := s.prepareLabDir(ll, ids); err != nil {
 585: 		return nil, err
 586: 	}
 587: 	// Announce every armed capture (idempotent): the GUI (re)learns each
 588: 	// capturing link's port on every start â€” including after a supervisor
 589: 	// restart or page reload where its event-derived state began empty â€” and
 590: 	// uses it to (re)connect live capture tabs.
 591: 	ll.mu.Lock()
 592: 	armed := make(map[int]int, len(ll.captures))
 593: 	for link, port := range ll.captures {
 594: 		armed[link] = port
 595: 	}
 596: 	ll.mu.Unlock()
 597: 	for link, port := range armed {
 598: 		s.emit(protocol.EventCaptureStarted, protocol.CaptureData{Link: link, CapturePort: port})
 599: 	}
 600: 	out := protocol.StartResult{Started: []protocol.StartedNode{}}
 601: 	for _, id := range ids {
 602: 		nr := ll.get(id)
 603: 		if nr == nil {
 604: 			err := protocol.Errorf(protocol.CodeBadRequest, "unknown node %d", id)
 605: 			if len(ids) == 1 {
 606: 				return nil, err
 607: 			}
 608: 			out.Failed = append(out.Failed, startFailure(id, nil, err))
 609: 			continue
 610: 		}
 611: 		docNode := ll.findNode(id)
 612: 		if docNode == nil {
 613: 			err := protocol.Errorf(protocol.CodeBadRequest, "unknown node %d", id)
 614: 			if len(ids) == 1 {
 615: 				return nil, err
 616: 			}
 617: 			out.Failed = append(out.Failed, startFailure(id, nil, err))
 618: 			continue
 619: 		}
 620: 		if docNode.Kind == lab.KindIOL || docNode.Kind == lab.KindVPCS {
 621: 			state := nr.machine.State()
 622: 			if nr.proc != nil && (state == node.StateStarting || state == node.StateRunning) {
 623: 				out.Started = append(out.Started, protocol.StartedNode{
 624: 					Node: id, ConsolePort: nr.consolePort, PID: nr.proc.PID(),
 625: 					State: string(state),
 626: 				})
 627: 				continue
 628: 			}
 629: 			// An unexpected exit leaves the Process pointer in the runtime record
 630: 			// until the next start. Do not mistake that stale handle for a live
 631: 			// node; Spawn is allowed to advance crashed/stopped state to starting.
 632: 			if nr.proc != nil {
 633: 				nr.proc = nil
 634: 			}
 635: 		}
 636: 
 637: 		// A nat node is a supervisor-internal tap endpoint, not a spawned
 638: 		// process: start an extnet.Endpoint that owns an fd instead of a
 639: 		// node.Process. The node state machine still flips to running so the GUI
 640: 		// treats it uniformly. It has no console.
 641: 		if docNode.Kind == lab.KindNAT {
 642: 			started, err := s.startExtnetNode(ll, docNode, nr)
 643: 			if err != nil {
 644: 				if len(ids) == 1 {
 645: 					return nil, err
 646: 				}
 647: 				out.Failed = append(out.Failed, startFailure(id, nr, err))
 648: 				continue
 649: 			}
 650: 			out.Started = append(out.Started, started)
 651: 			continue
 652: 		}
 653: 
 654: 		if docNode.Kind == lab.KindTool {
 655: 			started, err := s.startToolNode(ll, docNode, nr)
 656: 			if err != nil {
 657: 				if len(ids) == 1 {
 658: 					return nil, err
 659: 				}
 660: 				out.Failed = append(out.Failed, startFailure(id, nr, err))
 661: 				continue
 662: 			}
 663: 			out.Started = append(out.Started, started)
 664: 			continue
 665: 		}
 666: 
 667: 		if docNode.Kind == lab.KindPC {
 668: 			started, err := s.startPCNode(ll, docNode, nr)
 669: 			if err != nil {
 670: 				if len(ids) == 1 {
 671: 					return nil, err
 672: 				}
 673: 				out.Failed = append(out.Failed, startFailure(id, nr, err))
 674: 				continue
 675: 			}
 676: 			out.Started = append(out.Started, started)
 677: 			continue
 678: 		}
 679: 
 680: 		// VPCS: bring up its udp<->tap shim BEFORE buildSpec, so VPCS is launched
 681: 		// with argv pointing at the shim's ports. Its tap is bridge-attached at
 682: 		// link time (hot-connect).
 683: 		if docNode.Kind == lab.KindVPCS {
 684: 			if err := s.setupVPCSFabric(ll, nr, docNode); err != nil {
 685: 				if len(ids) == 1 {
 686: 					return nil, err
 687: 				}
 688: 				out.Failed = append(out.Failed, startFailure(id, nr, err))
 689: 				continue
 690: 			}
 691: 		}
 692: 
 693: 		spec, err := s.buildSpec(ll, docNode, nr)
 694: 		if err != nil {
 695: 			if nr.vtap != nil || nr.vtapName != "" {
 696: 				s.teardownVPCS(nr)
 697: 			}
 698: 			if len(ids) == 1 {
 699: 				return nil, err
 700: 			}
 701: 			out.Failed = append(out.Failed, startFailure(id, nr, err))
 702: 			continue
 703: 		}
 704: 		proc, err := node.Spawn(spec, nr.machine)
 705: 		if err != nil {
 706: 			if nr.vtap != nil || nr.vtapName != "" {
 707: 				s.teardownVPCS(nr)
 708: 			}
 709: 			spawnErr := protocol.Errorf(protocol.CodeNodeSpawnFailed, "%v", err)
 710: 			if len(ids) == 1 {
 711: 				return nil, spawnErr
 712: 			}
 713: 			out.Failed = append(out.Failed, startFailure(id, nr, spawnErr))
 714: 			continue
 715: 		}
 716: 		nr.proc = proc
 717: 		// The console listener is bound synchronously inside Spawn (before it
 718: 		// returns), so ConsolePort is reachable the moment we get here: the
 719: 		// pty->telnet bridge accepts clients immediately, buffering the live
 720: 		// pty stream. Flip to running and announce the console.
 721: 		if !nr.machine.To(node.StateRunning) {
 722: 			_ = proc.Stop()
 723: 			nr.proc = nil
 724: 			if nr.vtap != nil || nr.vtapName != "" {
 725: 				s.teardownVPCS(nr)
 726: 			}
 727: 			out.Failed = append(out.Failed, startFailure(id, nr,
 728: 				protocol.Errorf(protocol.CodeNodeSpawnFailed, "node %d exited before becoming running", id)))
 729: 			continue
 730: 		}
 731: 		// Attach a fabric VPCS's tap to its link bridge now (its bridge was created
 732: 		// by startFabric before this node started). No-op for IOL / legacy VPCS /
 733: 		// an unlinked VPCS â€” link.add attaches it then.
 734: 		if nr.vtap != nil {
 735: 			if err := s.attachFabricForNode(ll, id); err != nil {
 736: 				_ = proc.Stop()
 737: 				nr.proc = nil
 738: 				s.teardownVPCS(nr)
 739: 				nr.machine.To(node.StateCrashed)
 740: 				if len(ids) == 1 {
 741: 					return nil, err
 742: 				}
 743: 				out.Failed = append(out.Failed, startFailure(id, nr, err))
 744: 				continue
 745: 			}
 746: 		}
 747: 		s.emit(protocol.EventNodeConsole, protocol.NodeConsoleData{Node: id, ConsolePort: nr.consolePort})
 748: 		out.Started = append(out.Started, protocol.StartedNode{
 749: 			Node:        id,
 750: 			ConsolePort: nr.consolePort,
 751: 			PID:         proc.PID(),
 752: 			State:       string(nr.machine.State()),
 753: 		})
 754: 	}
 755: 	return out, nil
 756: }
 757: 
 758: func startFailure(id int, nr *nodeRuntime, err error) protocol.StartFailure {
 759: 	failure := protocol.StartFailure{Node: id, Error: err.Error()}
 760: 	if nr != nil && nr.machine != nil {
 761: 		failure.State = string(nr.machine.State())
 762: 	}
 763: 	return failure
 764: }
 765: 
 766: // startExtnetNode brings up a nat node's tap endpoint and flips its state
 767: // machine to running. It requires runtime capability support (gated at startup
 768: // via extnet.Detect) and resolves the default-route interface plus a subnet
 769: // index. The endpoint is idempotent per node: if one is already running it is
 770: // left as-is. Returns the StartedNode summary.
 771: func (s *Server) startExtnetNode(ll *loadedLab, n *lab.Node, nr *nodeRuntime) (protocol.StartedNode, error) {
 772: 	if !s.caps.Supports(extnet.Kind(n.Kind)) {
 773: 		return protocol.StartedNode{}, protocol.Errorf(protocol.CodeUnsupported,
 774: 			"runtime does not support %s nodes", n.Kind)
 775: 	}
 776: 	if nr.extnet != nil {
 777: 		// Already running; report current state without re-creating the device.
 778: 		return protocol.StartedNode{Node: n.ID, State: string(nr.machine.State())}, nil
 779: 	}
 780: 	if !nr.machine.To(node.StateStarting) {
 781: 		return protocol.StartedNode{}, protocol.Errorf(protocol.CodeNodeSpawnFailed,
 782: 			"node %d: not in a startable state", n.ID)
 783: 	}
 784: 
 785: 	// A NAT node uses the static-tap bridge data plane: tap created unbridged,
 786: 	// gateway/NAT wired onto the link bridge by AttachBridge (so a NAT dropped
 787: 	// before its link is drawn still hot-connects).
 788: 	cfg := extnet.Config{Kind: extnet.Kind(n.Kind), NodeID: n.ID}
 789: 
 790: 	switch n.Kind {
 791: 	case lab.KindNAT:
 792: 		idx, err := s.natSubnets.Next()
 793: 		if err != nil {
 794: 			nr.machine.To(node.StateCrashed)
 795: 			return protocol.StartedNode{}, protocol.Errorf(protocol.CodeNodeSpawnFailed, "node %d: %v", n.ID, err)
 796: 		}
 797: 		def, err := extnet.DefaultRouteIface()
 798: 		if err != nil {
 799: 			s.natSubnets.Release(idx)
 800: 			nr.machine.To(node.StateCrashed)
 801: 			return protocol.StartedNode{}, protocol.Errorf(protocol.CodeNodeSpawnFailed, "node %d: %v", n.ID, err)
 802: 		}
 803: 		cfg.SubnetIndex = idx
 804: 		cfg.DefaultIface = def
 805: 		nr.natSubnet = idx
 806: 	}
 807: 
 808: 	ep, err := extnet.Start(cfg)
 809: 	if err != nil {
 810: 		if nr.natSubnet != 0 {
 811: 			s.natSubnets.Release(nr.natSubnet)
 812: 			nr.natSubnet = 0
 813: 		}
 814: 		nr.machine.To(node.StateCrashed)
 815: 		return protocol.StartedNode{}, protocol.Errorf(protocol.CodeNodeSpawnFailed, "node %d: %v", n.ID, err)
 816: 	}
 817: 	nr.extnet = ep
 818: 	nr.machine.To(node.StateRunning)
 819: 	// Attach this NAT to its link bridge now (created by startFabric before this
 820: 	// node started). No-op if its link isn't drawn yet â€” link.add attaches it then.
 821: 	if err := s.attachFabricForNode(ll, n.ID); err != nil {
 822: 		_ = nr.extnet.Close()
 823: 		nr.extnet = nil
 824: 		if nr.natSubnet != 0 {
 825: 			s.natSubnets.Release(nr.natSubnet)
 826: 			nr.natSubnet = 0
 827: 		}
 828: 		nr.machine.To(node.StateCrashed)
 829: 		return protocol.StartedNode{}, err
 830: 	}
 831: 	return protocol.StartedNode{Node: n.ID, State: string(nr.machine.State())}, nil
 832: }
 833: 
 834: // startToolNode starts the pack GUI through internal/tool, which owns the
 835: // ordered preclean, cage, netns/veth, socket/options-file, launch, readiness,
 836: // and exit-watcher lifecycle. The endpoint turns Options into the 0600,
 837: // ioltool-owned options.json read through IOLBOX_TOOL_OPTIONS; a tool node
 838: // cannot start without that file existing, so the handler passes the document
 839: // payload through and lets tool.Start create {} when it is absent.
 840: func (s *Server) startToolNode(ll *loadedLab, n *lab.Node, nr *nodeRuntime) (protocol.StartedNode, error) {
 841: 	if !s.toolCaps.Supports(tool.KindTool) {
 842: 		return protocol.StartedNode{}, protocol.Errorf(protocol.CodeUnsupported,
 843: 			"tool: runtime does not support %s nodes: %v", tool.KindTool, s.toolCaps.Reasons)
 844: 	}
 845: 	if nr.tool != nil {
 846: 		// Already running; report current state without recreating the endpoint.
 847: 		return protocol.StartedNode{Node: n.ID, State: string(nr.machine.State())}, nil
 848: 	}
 849: 	if !nr.machine.To(node.StateStarting) {
 850: 		return protocol.StartedNode{}, protocol.Errorf(protocol.CodeNodeSpawnFailed,
 851: 			"node %d: not in a startable state", n.ID)
 852: 	}
 853: 
 854: 	var packID string
 855: 	if err := json.Unmarshal(n.Config["pack"], &packID); err != nil {
 856: 		nr.machine.To(node.StateCrashed)
 857: 		return protocol.StartedNode{}, protocol.Errorf(protocol.CodeBadRequest,
 858: 			"tool: node %d has invalid pack id: %v", n.ID, err)
 859: 	}
 860: 	pack, ok := s.toolPack(packID)
 861: 	if !ok {
 862: 		nr.machine.To(node.StateCrashed)
 863: 		return protocol.StartedNode{}, protocol.Errorf(protocol.CodeBadRequest,
 864: 			"tool: node %d references unknown pack %q", n.ID, packID)
 865: 	}
 866: 
 867: 	var options []byte
 868: 	if raw, exists := n.Config["options"]; exists {
 869: 		if !json.Valid(raw) {
 870: 			nr.machine.To(node.StateCrashed)
 871: 			return protocol.StartedNode{}, protocol.Errorf(protocol.CodeBadRequest,
 872: 				"tool: node %d has invalid options JSON", n.ID)
 873: 		}
 874: 		options = append([]byte(nil), raw...)
 875: 	}
 876: 
 877: 	// Optional static IP for GuestIface (eth1) â€” most packs don't need one
 878: 	// (they operate at L2 or forge their own L3 headers), so an absent/empty
 879: 	// "net.ip" leaves the interface unaddressed exactly as before this field
 880: 	// existed.
 881: 	var netCfg *tool.NetAddrConfig
 882: 	if raw, exists := n.Config["net"]; exists {
 883: 		var addr struct {
 884: 			IP        string `json:"ip"`
 885: 			PrefixLen int    `json:"prefixLen"`
 886: 			Gateway   string `json:"gateway"`
 887: 		}
 888: 		if err := json.Unmarshal(raw, &addr); err != nil {
 889: 			nr.machine.To(node.StateCrashed)
 890: 			return protocol.StartedNode{}, protocol.Errorf(protocol.CodeBadRequest,
 891: 				"tool: node %d has invalid net config: %v", n.ID, err)
 892: 		}
 893: 		if addr.IP != "" {
 894: 			if addr.PrefixLen <= 0 || addr.PrefixLen > 32 {
 895: 				addr.PrefixLen = 24
 896: 			}
 897: 			netCfg = &tool.NetAddrConfig{IP: addr.IP, PrefixLen: addr.PrefixLen, Gateway: addr.Gateway}
 898: 		}
 899: 	}
 900: 
 901: 	cfg := tool.Config{
 902: 		NodeID:   n.ID,
 903: 		Pack:     pack,
 904: 		Root:     s.toolRoot,
 905: 		StateDir: s.cfg.StateDir,
 906: 		RunDir:   s.cfg.RunDir,
 907: 		Options:  options,
 908: 		Net:      netCfg,
 909: 	}
 910: 	ep, err := tool.Start(cfg)
 911: 	if err != nil {
 912: 		nr.machine.To(node.StateCrashed)
 913: 		return protocol.StartedNode{}, protocol.Errorf(protocol.CodeNodeSpawnFailed,
 914: 			"tool: node %d: %v", n.ID, err)
 915: 	}
 916: 	nr.tool = ep
 917: 	nr.machine.To(node.StateRunning)
 918: 	// A tool started after its bridge exists must hot-connect immediately; this
 919: 	// is the same late-start seam used by the extnet endpoint.
 920: 	if err := s.attachFabricForNode(ll, n.ID); err != nil {
 921: 		_ = nr.tool.Stop()
 922: 		nr.tool = nil
 923: 		nr.machine.To(node.StateCrashed)
 924: 		return protocol.StartedNode{}, err
 925: 	}
 926: 	return protocol.StartedNode{Node: n.ID, State: string(nr.machine.State())}, nil
 927: }
 928: 
 929: // startPCNode starts the built-in netprobe pack with the same data-plane cage
 930: // as a tool, then bridges its private AF_UNIX CLI into the supervisor console
 931: // port. PC nodes never select config.pack and never enter node.Spawn.
 932: func (s *Server) startPCNode(ll *loadedLab, n *lab.Node, nr *nodeRuntime) (protocol.StartedNode, error) {
 933: 	if !s.toolCaps.Supports(tool.KindTool) {
 934: 		return protocol.StartedNode{}, protocol.Errorf(protocol.CodeUnsupported,
 935: 			"pc: runtime does not support PC nodes: %v", s.toolCaps.Reasons)
 936: 	}
 937: 	if !s.pcPackOK {
 938: 		return protocol.StartedNode{}, protocol.Errorf(protocol.CodeUnsupported,
 939: 			"pc: built-in netprobe pack is not installed")
 940: 	}
 941: 	if nr.tool != nil {
 942: 		return protocol.StartedNode{Node: n.ID, ConsolePort: nr.consolePort, State: string(nr.machine.State())}, nil
 943: 	}
 944: 	if !nr.machine.To(node.StateStarting) {
 945: 		return protocol.StartedNode{}, protocol.Errorf(protocol.CodeNodeSpawnFailed,
 946: 			"node %d: not in a startable state", n.ID)
 947: 	}
 948: 
 949: 	state := lab.PCState{SavedCommands: []string{}}
 950: 	if raw := n.Config["pc"]; len(raw) != 0 {
 951: 		if err := json.Unmarshal(raw, &state); err != nil {
 952: 			nr.machine.To(node.StateCrashed)
 953: 			return protocol.StartedNode{}, protocol.Errorf(protocol.CodeBadRequest,
 954: 				"pc: node %d has invalid pc state: %v", n.ID, err)
 955: 		}
 956: 	}
 957: 	options, _ := json.Marshal(pcStateEnvelope{PC: clonePCState(state)})
 958: 
 959: 	var netCfg *tool.NetAddrConfig
 960: 	if raw := n.Config["net"]; len(raw) != 0 {
 961: 		var addr struct {
 962: 			IP        string `json:"ip"`
 963: 			PrefixLen int    `json:"prefixLen"`
 964: 			Gateway   string `json:"gateway"`
 965: 		}
 966: 		if err := json.Unmarshal(raw, &addr); err != nil {
 967: 			nr.machine.To(node.StateCrashed)
 968: 			return protocol.StartedNode{}, protocol.Errorf(protocol.CodeBadRequest,
 969: 				"pc: node %d has invalid net config: %v", n.ID, err)
 970: 		}
 971: 		if addr.IP != "" {
 972: 			if addr.PrefixLen <= 0 || addr.PrefixLen > 32 {
 973: 				addr.PrefixLen = 24
 974: 			}
 975: 			netCfg = &tool.NetAddrConfig{IP: addr.IP, PrefixLen: addr.PrefixLen, Gateway: addr.Gateway}
 976: 		}
 977: 	}
 978: 
 979: 	cfg := tool.Config{
 980: 		NodeID: n.ID, Pack: s.pcPack, Root: s.toolRoot,
 981: 		StateDir: s.cfg.StateDir, RunDir: s.cfg.RunDir,
 982: 		Options: options, Net: netCfg, CLISocket: true,
 983: 	}
 984: 	ep, err := tool.Start(cfg)
 985: 	if err != nil {
 986: 		nr.machine.To(node.StateCrashed)
 987: 		return protocol.StartedNode{}, protocol.Errorf(protocol.CodeNodeSpawnFailed,
 988: 			"pc: node %d: %v", n.ID, err)
 989: 	}
 990: 	conn, err := dialPCConsole(ep.CLISocketPath())
 991: 	if err != nil {
 992: 		_ = ep.Stop()
 993: 		nr.machine.To(node.StateCrashed)
 994: 		return protocol.StartedNode{}, protocol.Errorf(protocol.CodeNodeSpawnFailed,
 995: 			"pc: node %d CLI socket: %v", n.ID, err)
 996: 	}
 997: 	bind := s.cfg.ConsoleBind
 998: 	if bind == "" {
 999: 		bind = "127.0.0.1"
1000: 	}
1001: 	ln, err := net.Listen("tcp", net.JoinHostPort(bind, strconv.Itoa(nr.consolePort)))
1002: 	if err != nil {
1003: 		_ = conn.Close()
1004: 		_ = ep.Stop()
1005: 		nr.machine.To(node.StateCrashed)
1006: 		return protocol.StartedNode{}, protocol.Errorf(protocol.CodePortUnavailable,
1007: 			"pc: node %d console :%d: %v", n.ID, nr.consolePort, err)
1008: 	}
1009: 	nr.tool = ep
1010: 	nr.proc = node.NewConsoleBridge(conn, n.Name, ln)
1011: 	nr.machine.To(node.StateRunning)
1012: 	if err := s.attachFabricForNode(ll, n.ID); err != nil {
1013: 		_ = nr.proc.Stop()
1014: 		_ = nr.tool.Stop()
1015: 		nr.proc, nr.tool = nil, nil
1016: 		nr.machine.To(node.StateCrashed)
1017: 		return protocol.StartedNode{}, err
1018: 	}
1019: 	s.emit(protocol.EventNodeConsole, protocol.NodeConsoleData{Node: n.ID, ConsolePort: nr.consolePort})
1020: 	return protocol.StartedNode{Node: n.ID, ConsolePort: nr.consolePort,
1021: 		PID: ep.PID(), State: string(nr.machine.State())}, nil
1022: }
1023: 
1024: func dialPCConsole(socket string) (net.Conn, error) {
1025: 	deadline := time.Now().Add(2 * time.Second)
1026: 	var last error
1027: 	for time.Now().Before(deadline) {
1028: 		conn, err := net.DialTimeout("unix", socket, 200*time.Millisecond)
1029: 		if err == nil {
1030: 			return conn, nil
1031: 		}
1032: 		last = err
1033: 		time.Sleep(50 * time.Millisecond)
1034: 	}
1035: 	return nil, last
1036: }
