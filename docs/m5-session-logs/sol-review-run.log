 603: }
 604: 
 605: // EndpointAttrib is the per-endpoint source-MAC attribution hint for one
 606: // fabric link. EndpointIndex is the lab document endpoint index, not the
 607: // position in EpAttrib: the slice is sparse when an endpoint has no tap.
 608: // "single" is the only state that licenses naming a node. "ambiguous" means
 609: // the endpoint forwarded more than one source MAC during the learning window,
 610: // so its MAC is intentionally withheld; "none" means no usable observation
 611: // remains. A MAC that appears on both endpoints is withheld from both sides.
 612: type EndpointAttrib struct {
 613: 	EndpointIndex int    `json:"endpointIndex"`
 614: 	State         string `json:"state"`
 615: 	MAC           string `json:"mac,omitempty"`
 616: }
 617: 
 618: // LinkStatsData is the link.stats event payload: per-link forwarded throughput
 619: // over the last sampling interval. Only bridged links have a relay and thus
 620: // stats; native (same-host IOL<->IOL) links produce none.
 621: type LinkStatsData struct {
 622: 	Link int     `json:"link"`
 623: 	FPS  float64 `json:"fps"`
 624: 	BPS  uint64  `json:"bps"`
 625: 	// Protos is the per-protocol frames/sec breakdown over the same interval,
 626: 	// keyed by protocol label (ARP, TCP, OSPF, STP, CDP, ...). Only non-zero
 627: 	// entries, capped to the top 6 by fps; omitted entirely (nil) when there is
 628: 	// nothing to report. Each value is rounded to one decimal like FPS. The
 629: 	// overlapping "DOT1Q" label is excluded here so Protos still sums to FPS.
 630: 	Protos map[string]float64 `json:"protos,omitempty"`
 631: 	// ProtosDir is the per-direction per-protocol frames/sec breakdown over the
 632: 	// same interval, keyed by protocol label. Each value is [fps sourced from
 633: 	// endpoint 0, fps sourced from endpoint 1], where endpoint order matches the
 634: 	// lab link's doc endpoints order. Populated for fabric links from the
 635: 	// always-on per-endpoint-tap classifier: a frame is attributed to the
 636: 	// endpoint whose tap received it (the node behind that tap sent it). Only
 637: 	// labels with a nonzero rate in either direction; one-decimal rounding. A
 638: 	// frame counts once, under one label, in one direction, so this map does NOT
 639: 	// sum to FPS in general. Omitted (nil) when there's nothing to report.
 640: 	ProtosDir map[string][2]float64 `json:"protosDir,omitempty"`
 641: 	// ProtosSubtypeDir is the same directional breakdown one level deeper: for
 642: 	// each label that carries a decodable packet-type subtype (BGP open/update/
 643: 	// notification/keepalive/route-refresh; ICMP echo-request/echo-reply/
 644: 	// unreachable/time-exceeded/redirect/other; OSPF hello/db-desc/ls-request/
 645: 	// ls-update/ls-ack; EIGRP hello/update/query/reply/request; ARP request/
 646: 	// reply), label -> subtype -> [ep0 fps, ep1 fps]. Only subtypes with a
 647: 	// nonzero rate; frames whose subtype couldn't be decoded contribute to
 648: 	// ProtosDir under the label but appear under no subtype here. Omitted (nil)
 649: 	// when there's nothing to report.
 650: 	ProtosSubtypeDir map[string]map[string][2]float64 `json:"protosSubtypeDir,omitempty"`
 651: 	// EpAttrib is omitted when the per-endpoint classifier could not be opened.
 652: 	// When present it contains explicit document endpoint indexes and the
 653: 	// singular-MAC learning state: single, ambiguous, or none. It is a hint,
 654: 	// never a general CAM table; the browser names a node only for a unique
 655: 	// single MAC match at event-creation time.
 656: 	EpAttrib []EndpointAttrib `json:"epAttrib,omitempty"`
 657: }
 658: 
 659: // HostStatsData is the host.stats event payload: the runtime VM's resource
 660: // utilisation, pushed every sampling interval so the GUI can show a live
 661: // CPU/RAM/disk monitor for the host actually executing the IOL processes.
 662: // CPUPct is aggregate 0-100 across all cores; memory/disk are bytes.
 663: type HostStatsData struct {
 664: 	CPUPct   float64 `json:"cpuPct"`
 665: 	MemUsed  uint64  `json:"memUsed"`
 666: 	MemTotal uint64  `json:"memTotal"`
 667: 	DiskUsed uint64  `json:"diskUsed"`
 668: 	DiskTot  uint64  `json:"diskTotal"`
 669: 	Cores    int     `json:"cores"`
 670: }
 671: 
 672: // LogData is the log event payload.
 673: type LogData struct {
 674: 	Level   string `json:"level"`
 675: 	Message string `json:"message"`
 676: 	Node    *int   `json:"node,omitempty"`
 677: }
 678: 
 679: // NewEvent builds an Event from a name and a payload value.
 680: func NewEvent(name string, data any) *Event {
 681: 	var raw json.RawMessage
 682: 	if data != nil {
 683: 		raw = mustMarshal(data)
 684: 	}
 685: 	return &Event{Event: name, Data: raw}
 686: }
FILE supervisor/cmd/supervisor/main.go
   1: // Command supervisor is the iolbox control + data plane daemon. It runs inside
   2: // the Linux runtime (WSL2 / VMware helper VM / remote / qemu) and speaks the
   3: // NDJSON control protocol (see docs/protocol.md) to the Windows GUI over a
   4: // loopback TCP connection.
   5: package main
   6: 
   7: import (
   8: 	"context"
   9: 	"encoding/binary"
  10: 	"flag"
  11: 	"fmt"
  12: 	"io"
  13: 	"log"
  14: 	"os"
  15: 	"os/exec"
  16: 	"os/signal"
  17: 	"strings"
  18: 	"sync"
  19: 	"syscall"
  20: 
  21: 	"github.com/rohanpunj/iolbox/supervisor/internal/iourc"
  22: 	"github.com/rohanpunj/iolbox/supervisor/internal/server"
  23: 	"github.com/rohanpunj/iolbox/supervisor/internal/wsbridge"
  24: )
  25: 
  26: // version is the supervisor build version reported in the hello handshake.
  27: // Overridden at build time via -ldflags "-X main.version=$(git describe ...)"
  28: // (see build-release.sh); "0.1.0" only shows up in an unstamped dev build.
  29: var version = "0.1.0"
  30: 
  31: func main() {
  32: 	controlAddr := flag.String("control-addr", "127.0.0.1:4000", "control API bind address (loopback only)")
  33: 	wsAddr := flag.String("ws-addr", "127.0.0.1:4001", "WebSocket bridge + GUI bind address (control + console over WS and the embedded browser GUI; use 0.0.0.0:4001 for browser access from the host; empty disables it)")
  34: 	imageDir := flag.String("image-dir", "/opt/iolbox/images", "directory holding IOL image files")
  35: 	runDir := flag.String("run-dir", "/run/iolbox", "base directory for per-lab working directories")
  36: 	labsDir := flag.String("labs-dir", "/opt/iolbox/labs", "directory for the durable lab-document store (lab.saveDoc/listDocs/getDoc/deleteDoc)")
  37: 	iourcPath := flag.String("iourc", "/opt/iolbox/iourc", "IOU license file copied into each lab's shared dir (generated at firstboot by -gen-iourc)")
  38: 	consoleBind := flag.String("console-bind", "127.0.0.1", "host the per-node IOL console listeners bind; 0.0.0.0 lets a native telnet client on the GUI host dial <vm-ip>:<consolePort>")
  39: 	captureBind := flag.String("capture-bind", "127.0.0.1", "host each link's pcapng capture tee listener binds; 0.0.0.0 lets a native Wireshark on the GUI host attach with `wireshark -k -i TCP@<vm-ip>:<capturePort>`")
  40: 	egressMode := flag.String("egress", "auto", "NAT internet-egress capability advertised in hello: auto (detect QEMU slirp signature), slirp (force ICMP-limited: DHCP/TCP only), or routed (force full ICMP/traceroute)")
  41: 	genIourc := flag.Bool("gen-iourc", false, "generate the IOU license file to stdout from this host's hostid+hostname, then exit (used by the runtime firstboot script)")
  42: 	showVersion := flag.Bool("version", false, "print the build version and exit (used by the console banner generator)")
  43: 	flag.Parse()
  44: 
  45: 	// Version-only mode: print the build version and exit without starting the
  46: 	// server. The runtime's console-banner generator (iolbox-issue.sh) reads
  47: 	// this; keep it side-effect-free so it's safe to call on a live appliance.
  48: 	if *showVersion {
  49: 		fmt.Println(version)
  50: 		return
  51: 	}
  52: 
  53: 	// Keygen-only mode: print ~/.iourc content and exit without starting the
  54: 	// server. The runtime's firstboot-iourc.sh relies on this exact flag.
  55: 	if *genIourc {
  56: 		if err := generateIourc(os.Stdout); err != nil {
  57: 			log.Fatalf("supervisor -gen-iourc: %v", err)
  58: 		}
  59: 		return
  60: 	}
  61: 
  62: 	srv := server.New(server.Config{
  63: 		ControlAddr: *controlAddr,
  64: 		ImageDir:    *imageDir,
  65: 		RunDir:      *runDir,
  66: 		LabsDir:     *labsDir,
  67: 		IourcPath:   *iourcPath,
  68: 		ConsoleBind: *consoleBind,
  69: 		CaptureBind: *captureBind,
  70: 		Version:     version,
  71: 		Egress:      *egressMode,
  72: 	})
  73: 	if err := srv.InitRuntime(); err != nil {
  74: 		log.Printf("supervisor: tool runtime unavailable: %v", err)
  75: 	}
  76: 
  77: 	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
  78: 	defer stop()
  79: 
  80: 	var wg sync.WaitGroup
  81: 	errCh := make(chan error, 2)
  82: 
  83: 	wg.Add(1)
  84: 	go func() {
  85: 		defer wg.Done()
  86: 		log.Printf("iolbox supervisor %s listening on %s (images=%s run=%s)", version, *controlAddr, *imageDir, *runDir)
  87: 		if err := srv.ListenAndServe(ctx); err != nil {
  88: 			errCh <- fmt.Errorf("control listener: %w", err)
  89: 		}
  90: 	}()
  91: 
  92: 	if *wsAddr != "" {
  93: 		bridge := wsbridge.New(wsbridge.Config{Addr: *wsAddr, ImageDir: *imageDir}, srv)
  94: 		wg.Add(1)
  95: 		go func() {
  96: 			defer wg.Done()
  97: 			log.Printf("iolbox supervisor ws bridge listening on %s (/control, /console/{nodeId})", *wsAddr)
  98: 			if err := bridge.ListenAndServe(ctx); err != nil {
  99: 				errCh <- fmt.Errorf("ws bridge: %w", err)
 100: 			}
 101: 		}()
 102: 	} else {
 103: 		log.Printf("iolbox supervisor ws bridge disabled (-ws-addr empty)")
 104: 	}
 105: 
 106: 	wg.Wait()
 107: 	// Stop immediately: a defer would be skipped if the error drain below calls log.Fatalf.
 108: 	srv.StopRuntime()
 109: 	close(errCh)
 110: 	for err := range errCh {
 111: 		if err != nil {
 112: 			log.Fatalf("supervisor: %v", err)
 113: 		}
 114: 	}
 115: 	log.Printf("iolbox supervisor shut down cleanly")
 116: }
 117: 
 118: // generateIourc writes the ~/.iourc license file content for this host to w.
 119: func generateIourc(w io.Writer) error {
 120: 	hostname, err := os.Hostname()
 121: 	if err != nil {
 122: 		return fmt.Errorf("hostname: %w", err)
 123: 	}
 124: 	hostid, err := hostID()
 125: 	if err != nil {
 126: 		return err
 127: 	}
 128: 	content, err := iourc.File(hostid, hostname)
 129: 	if err != nil {
 130: 		return err
 131: 	}
 132: 	_, err = io.WriteString(w, content)
 133: 	return err
 134: }
 135: 
 136: // hostID returns the 8-hex-digit host id used as the keygen input, matching the
 137: // output of the Linux `hostid` command (the community keygen's expected input).
 138: // Falls back to reading /etc/hostid (4 bytes, host-endian) if the command is
 139: // unavailable.
 140: func hostID() (string, error) {
 141: 	if out, err := exec.Command("hostid").Output(); err == nil {
 142: 		if s := strings.TrimSpace(string(out)); s != "" {
 143: 			return s, nil
 144: 		}
 145: 	}
 146: 	if b, err := os.ReadFile("/etc/hostid"); err == nil && len(b) >= 4 {
 147: 		return fmt.Sprintf("%08x", binary.LittleEndian.Uint32(b[:4])), nil
 148: 	}
 149: 	return "", fmt.Errorf("could not determine hostid (no `hostid` command and no /etc/hostid)")
 150: }
