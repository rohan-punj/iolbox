1871:   // ---- per-node / lab config extraction into the doc (feature 4) ----
1872: 
1873:   /** Extract NVRAM startup-config for one node into node.startupConfig. Runs on
1874:    *  the node's SAVED config, so the user must `write memory` first. */
1875:   async saveNodeConfig(nodeId: number) {
1876:     const nodeName = this.resolveNodeName(nodeId);
1877:     const ok = await this.guarded(`save config for node ${nodeId}`, async () => {
1878:       const res = await this.client.configExtract(this.lab.id, [nodeId]);
1879:       this.applyExtractedConfigs(res.configs);
1880:     });
1881:     this.scheduleAutosave();
1882:     if (ok) this.enqueueToast({ severity: "success", message: `Config saved â€” ${nodeName}` });
1883:   }
1884: 
1885:   /** Extract startup-configs for every running IOL node into the doc. */
1886:   async saveAllConfigs() {
1887:     const targets = this.lab.nodes
1888:       .filter((n) => n.kind === "iol" && this.nodeStates[n.id] === "running")
1889:       .map((n) => n.id);
1890:     if (targets.length === 0) {
1891:       this.pushLog("warn", "no running IOL nodes to extract config from");
1892:       return;
1893:     }
1894:     const ok = await this.guarded("save configs", async () => {
1895:       const res = await this.client.configExtract(this.lab.id, targets);
1896:       this.applyExtractedConfigs(res.configs);
1897:     });
1898:     this.scheduleAutosave();
1899:     if (ok) {
1900:       this.enqueueToast({
1901:         severity: "success",
1902:         message: `Configs saved â€” ${targets.length} ${targets.length === 1 ? "node" : "nodes"}`,
1903:       });
1904:     }
1905:   }
1906: 
1907:   private applyExtractedConfigs(configs: { node: number; startupConfig: string }[]) {
1908:     for (const c of configs ?? []) {
1909:       const node = this.lab.nodes.find((n) => n.id === c.node);
1910:       if (node) node.startupConfig = c.startupConfig;
1911:     }
1912:   }
1913: 
1914:   /** Extract NVRAM startup-config for one node (same as saveNodeConfig) and
1915:    *  trigger a browser download of it as a .txt file â€” for pulling a config
1916:    *  out of the lab entirely, not just into the doc. */
1917:   async exportNodeConfig(nodeId: number) {
1918:     const nodeName = this.resolveNodeName(nodeId);
1919:     const ok = await this.guarded(`export config for node ${nodeId}`, async () => {
1920:       const res = await this.client.configExtract(this.lab.id, [nodeId]);
1921:       this.applyExtractedConfigs(res.configs);
1922:     });
1923:     this.scheduleAutosave();
1924:     if (!ok) return;
1925:     const node = this.lab.nodes.find((n) => n.id === nodeId);
1926:     const text = node?.startupConfig ?? "";
1927:     const blob = new Blob([text], { type: "text/plain" });
1928:     const fname = `${nodeName}-startup-config.txt`.replace(/[^\w.\-]+/g, "_");
1929:     const url = URL.createObjectURL(blob);
1930:     try {
1931:       const a = document.createElement("a");
1932:       a.href = url;
1933:       a.download = fname;
1934:       document.body.appendChild(a);
1935:       a.click();
1936:       a.remove();
1937:     } finally {
1938:       setTimeout(() => URL.revokeObjectURL(url), 4000);
1939:     }
1940:     this.enqueueToast({ severity: "success", message: `Config exported â€” ${nodeName}` });
1941:   }
1942: 
1943:   /** Push a node's in-memory edits (config.pack, config.net, ram, ethernet,
1944:    *  serial, ...) to the supervisor's loaded lab. The Inspector's
1945:    *  update*() handlers (updatePack/updateNet/updateRam/updateEthernet/
1946:    *  updateSerial/...) only mutate the LOCAL doc â€” the supervisor keeps its
1947:    *  own copy from the last lab.load/node.add and never re-reads the
1948:    *  frontend's state on its own, so without this any of those edits was
1949:    *  pure UI with no effect on what actually starts. Re-sends the whole doc
1950:    *  via lab.load.
1951:    *
1952:    *  Most fields (pack, net, ram, name, icon, startupConfig, ...) aren't
1953:    *  part of the supervisor's sameNodeShape check, so the ADOPT path always
1954:    *  takes over server-side for them â€” it swaps in the new doc's fields in
1955:    *  place without touching any already-running node elsewhere in the lab
1956:    *  (see tryAdoptLoad). Ethernet/serial adapter COUNTS are part of
1957:    *  sameNodeShape, though: changing them is a real topology change, so
1958:    *  adoption is refused and the supervisor instead runs its normal
1959:    *  teardown-and-reload â€” which stops every node in the WHOLE lab, not
1960:    *  just this one. The two cases get distinctly different log messages
1961:    *  below so that isn't a silent surprise. */
1962:   async applyNodeConfig(nodeId: number) {
1963:     let adopted = true;
1964:     await this.guarded(`apply config for node ${nodeId}`, async () => {
1965:       const res = await this.client.labLoad($state.snapshot(this.lab) as LabDocument);
1966:       adopted = !!res.adopted;
1967:       if (!adopted) {
1968:         // Adapter-count change (or some other real topology change): the
1969:         // supervisor already ran the full teardown-and-reload server-side,
1970:         // stopping every node in the lab. Resync local state to match
1971:         // rather than let it drift from what's actually running now.
1972:         const status = await this.client.status();
1973:         const states: Record<number, NodeState> = {};
1974:         for (const n of status.nodes ?? []) states[n.id] = n.state;
1975:         for (const n of this.lab.nodes) if (!(n.id in states)) states[n.id] = "stopped";
1976:         this.nodeStates = states;
1977:       }
1978:     });
1979:     this.scheduleAutosave();
1980:     const running = this.nodeStates[nodeId] === "running" || this.nodeStates[nodeId] === "starting";
1981:     const name = this.lab.nodes.find((n) => n.id === nodeId)?.name ?? `#${nodeId}`;
1982:     if (!adopted) {
1983:       this.pushLog(
1984:         "warn",
1985:         `${name}: adapter count changed â€” this reloaded the WHOLE lab, every other node was stopped too`,
1986:         nodeId
1987:       );
1988:       return;
1989:     }
1990:     this.pushLog(
1991:       running ? "warn" : "info",
1992:       running
1993:         ? `${name}: changes saved â€” stop and restart the node to apply them`
1994:         : `${name}: changes applied`,
1995:       nodeId
1996:     );
1997:   }
1998: }
