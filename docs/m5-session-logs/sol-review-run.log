 291: check_http_ready() {
 292:     local status i
 293:     # This runs right after a systemd restart, so the listener may not be bound
 294:     # yet: curl then exits 7 and reports status 000. Poll instead of sleeping and
 295:     # hoping â€” earlier runs only passed because the supervisor happened to be up
 296:     # already, which made this a latent flake rather than a fixed bug.
 297:     # A 5xx is a real failure and fails immediately; only "not listening yet"
 298:     # (000) is retried.
 299:     i=0
 300:     while [ "$i" -lt 30 ]; do
 301:         status="$(guest_shell_capture http-root "curl --silent --show-error --output /dev/null --write-out '%{http_code}' http://127.0.0.1:4001/ || true")"
 302:         case "$status" in
 303:             ''|*[!0-9]*) status=000 ;;
 304:         esac
 305:         if [ "$status" != "000" ]; then
 306:             break
 307:         fi
 308:         i=$((i + 1))
 309:         sleep 2
 310:     done
 311:     case "$status" in ''|*[!0-9]*) die "GET / returned a non-numeric HTTP status: $status" ;; esac
 312:     if [ "$status" = "000" ]; then
 313:         die 'GET / never connected: the GUI port 4001 did not bind within 60s of the restart'
 314:     fi
 315:     if [ "$status" -lt 500 ]; then
 316:         printf 'ok: GET / readiness status is %s (< 500, after %ss)\n' "$status" "$((i * 2))"
 317:     else
 318:         die "GET / readiness status is $status (expected < 500)"
 319:     fi
 320: }
