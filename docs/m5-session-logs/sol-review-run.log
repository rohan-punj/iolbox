 255: func (s *Server) serializedHandler(h protocol.Handler) protocol.Handler {
 256: 	return func(raw json.RawMessage) (any, error) {
 257: 		s.labMu.Lock()
 258: 		defer s.labMu.Unlock()
 259: 		return h(raw)
 260: 	}
 261: }
