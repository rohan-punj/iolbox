1024: func dialPCConsole(socket string) (net.Conn, error) {
1025: 	deadline := time.Now().Add(2 * time.Second)
1026: 	var last error
1027: 	for time.Now().Before(deadline) {
1028: 		conn, err := net.DialTimeout("unix", socket, 200*time.Millisecond)
1029: 		if err == nil {
1030: 			return conn, nil
1031: 		}
1032: 		last = err
1033: 		time.Sleep(50 * time.Millisecond)
1034: 	}
1035: 	return nil, last
1036: }
