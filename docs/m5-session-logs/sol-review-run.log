1400:   /** Takes a link administratively down until explicitly resumed â€” a
1401:    *  one-click "unplug the cable" for testing STP convergence, DHCP
1402:    *  renewal, etc. Pair with resumeLink() to "replug" it. */
1403:   async terminateLink(linkId: number) {
1404:     await this.setLinkFault(linkId, { down: true });
1405:   }
1406: 
1407:   /** Clears an administrative-down fault set by terminateLink() (or the
1408:    *  "Administratively down" checkbox in the fault dialog) â€” the manual
1409:    *  "replug the cable" counterpart. */
1410:   async resumeLink(linkId: number) {
1411:     await this.setLinkFault(linkId, null);
1412:   }
1413: 
1414:   /** True when any link touching this node currently has an active fault
1415:    *  (admin-down or egress impairment) â€” drives the red indicator on the
1416:    *  node face so an impacted link is visible even when the edge itself
1417:    *  is off-screen or hard to notice at the current zoom level. */
1418:   nodeHasFault(nodeId: number): boolean {
1419:     for (const link of this.lab.links) {
1420:       if (link.endpoints.some((ep) => ep.node === nodeId) && this.linkFaults[link.id]?.active) {
1421:         return true;
1422:       }
1423:     }
1424:     return false;
1425:   }
1426: 
1427:   /** Deletes saved configs/state for every node in the lab. Destructive â€”
1428:    *  callers (UI) must confirm with the user before invoking this. Under the
1429:    *  mock transport lab.wipe isn't implemented, so a rejection here is logged
1430:    *  and swallowed rather than surfaced as a hard error. */
1431:   async wipeLab() {
1432:     let wipedCount = 0;
1433:     const ok = await this.guarded("wipe lab", async () => {
1434:       const result = await this.client.labWipe(this.lab.id, null);
1435:       wipedCount = result.wiped.length;
1436:     });
1437:     if (ok) {
1438:       this.enqueueToast({
1439:         severity: "danger",
1440:         message: `Lab wiped â€” saved state cleared for ${wipedCount} ${wipedCount === 1 ? "node" : "nodes"}`,
1441:       });
1442:     }
1443:   }
1444: 
1445:   /** Wipe saved configs/state for a single node. Destructive â€” the caller (UI)
1446:    *  must confirm with the user first. Mirrors wipeLab: mock lab.wipe isn't
1447:    *  implemented, so a rejection is logged + swallowed via guarded(). */
1448:   async wipeNode(nodeId: number) {
1449:     const nodeName = this.resolveNodeName(nodeId);
1450:     let wiped = false;
1451:     // RPC-ack only (no driving node.state) â†’ release when the awaited call
1452:     // settles (guarded never rethrows, so the finally always runs).
1453:     if (!this.acquireNodeLock(nodeId, "wiping")) return;
1454:     try {
1455:       const ok = await this.guarded(`wipe node ${nodeId}`, async () => {
1456:         const result = await this.client.labWipe(this.lab.id, [nodeId]);
1457:         wiped = result.wiped.includes(nodeId);
1458:       });
1459:       if (ok && wiped) {
1460:         this.enqueueToast({
1461:           severity: "danger",
1462:           message: `${nodeName} wiped â€” saved state cleared`,
1463:         });
1464:       }
1465:     } finally {
1466:       this.releaseNodeLock(nodeId);
1467:     }
1468:   }
1469: 
1470:   async startNode(nodeId: number) {
1471:     const nodeName = this.resolveNodeName(nodeId);
1472:     // Lock the node until its next node.state event (released in handleEvent) â€”
1473:     // that's the success path, left exactly as before. But when the RPC itself
1474:     // is REJECTED (e.g. a fabric-prep error that never reaches this node's own
1475:     // spawn/state-machine step, so no node.state event for it will ever come),
1476:     // nothing would otherwise clear the lock until the 60s safety timeout â€”
1477:     // release explicitly on that path only, same as wipeNode/restartNode below.
1478:     if (!this.acquireNodeLock(nodeId, "starting")) return;
1479:     let rpcRejected = false;
1480:     let result: LabStartResult | undefined;
1481:     const ok = await this.guarded(`start node ${nodeId}`, async () => {
1482:       try {
1483:         result = await this.client.nodeStart(this.lab.id, nodeId);
1484:       } catch (e) {
1485:         rpcRejected = true;
1486:         throw e;
1487:       }
1488:     });
1489:     if (rpcRejected) this.releaseNodeLock(nodeId);
1490:     if (ok && result?.started.some((started) => started.node === nodeId) &&
1491:       !result.failed?.some((failure) => failure.node === nodeId)) {
1492:       this.enqueueToast({ severity: "success", message: `${nodeName} started` });
1493:     }
1494:     this.reportStartFailures(`start node ${nodeId}`, result);
1495:     if (result?.failed?.some((failure) => failure.node === nodeId)) this.releaseNodeLock(nodeId);
1496:   }
1497: 
1498:   private reportStartFailures(action: string, result: LabStartResult | undefined) {
1499:     if (!result?.failed?.length) return;
1500:     const details = result.failed.map((failure) => `node ${failure.node}: ${failure.error}`).join("; ");
1501:     this.lastError = `${action}: ${result.failed.length} node(s) failed â€” ${details}`;
1502:     this.pushLog("error", this.lastError);
1503:   }
1504: 
1505:   async stopNode(nodeId: number) {
1506:     const nodeName = this.resolveNodeName(nodeId);
1507:     if (!this.acquireNodeLock(nodeId, "stopping")) return;
1508:     const ok = await this.guarded(`stop node ${nodeId}`, async () => {
1509:       await this.client.nodeStop(this.lab.id, nodeId);
1510:       this.openConsoleTabs = this.openConsoleTabs.filter((id) => id !== nodeId);
1511:       if (this.activeConsoleTab === nodeId) {
1512:         this.activeConsoleTab = this.openConsoleTabs[0] ?? null;
1513:       }
1514:     });
1515:     if (ok) this.enqueueToast({ severity: "danger", message: `${nodeName} stopped` });
1516:   }
1517: 
1518:   async restartNode(nodeId: number) {
1519:     const nodeName = this.resolveNodeName(nodeId);
1520:     if (!this.acquireNodeLock(nodeId, "restarting", { holdUntilSettled: true })) return;
1521:     let result: LabStartResult | undefined;
1522:     let ok = false;
1523:     try {
1524:       ok = await this.guarded(`restart node ${nodeId}`, async () => {
1525:         result = await this.client.nodeRestart(this.lab.id, nodeId);
1526:       });
1527:     } finally {
1528:       this.releaseNodeLock(nodeId);
1529:     }
1530:     if (ok && result?.started.some((started) => started.node === nodeId) &&
1531:       !result.failed?.some((failure) => failure.node === nodeId)) {
1532:       this.enqueueToast({ severity: "success", message: `${nodeName} restarted` });
1533:     }
1534:     this.reportStartFailures(`restart node ${nodeId}`, result);
1535:   }
1536: 
1537:   // ---- per-node action lock (WS1) ----
1538: 
1539:   /** Acquire the per-node action lock. Returns false if the node is already
1540:    *  locked (caller must no-op). Arms a 60s safety timeout so a lost driving
1541:    *  event can't wedge the node permanently. */
1542:   private acquireNodeLock(nodeId: number, action: string, options?: { holdUntilSettled?: boolean }): boolean {
1543:     if (this.nodeLocks[nodeId]) return false;
1544:     this.nodeLocks = { ...this.nodeLocks, [nodeId]: { action, startedAt: Date.now(), ...options } };
1545:     if (this.nodeLockTimers[nodeId]) clearTimeout(this.nodeLockTimers[nodeId]);
1546:     this.nodeLockTimers[nodeId] = setTimeout(() => {
1547:       this.pushLog("warn", `node ${nodeId}: ${action} did not settle in 60s â€” releasing lock`, nodeId);
1548:       this.releaseNodeLock(nodeId);
1549:     }, 60_000);
1550:     return true;
1551:   }
1552: 
1553:   /** Release the per-node action lock and clear its safety timeout. Idempotent. */
1554:   private releaseNodeLock(nodeId: number) {
1555:     if (this.nodeLockTimers[nodeId]) {
1556:       clearTimeout(this.nodeLockTimers[nodeId]);
1557:       delete this.nodeLockTimers[nodeId];
1558:     }
1559:     if (this.nodeLocks[nodeId]) {
1560:       const { [nodeId]: _drop, ...rest } = this.nodeLocks;
1561:       this.nodeLocks = rest;
1562:     }
1563:   }
1564: 
1565:   /** Run a supervisor action; surface failure in the top bar + log instead of
1566:    *  letting the rejection vanish into an unhandled promise. */
1567:   private async guarded(what: string, fn: () => Promise<unknown>): Promise<boolean> {
1568:     try {
1569:       await fn();
1570:       this.lastError = null;
1571:       return true;
1572:     } catch (e) {
1573:       this.lastError = `${what} failed: ${(e as Error).message}`;
1574:       this.pushLog("error", this.lastError);
1575:       return false;
1576:     }
1577:   }
1578: 
1579:   openConsole(nodeId: number) {
1580:     if (!this.openConsoleTabs.includes(nodeId)) {
1581:       this.openConsoleTabs = [...this.openConsoleTabs, nodeId];
1582:     }
1583:     this.activeConsoleTab = nodeId;
1584:   }
1585: 
1586:   /** Open a node's console in the OS telnet client via the telnet:// scheme,
1587:    *  WITHOUT opening a web tab. Uses a transient anchor click so the OS handler
1588:    *  is invoked without navigating the app: a `location=`/`window.open(_,"_self")`
1589:    *  navigation unloads the page and drops the supervisor WebSocket, which is
1590:    *  what previously broke every *other* console once one was opened natively. */
1591:   openNativeConsole(nodeId: number) {
1592:     const port = this.consolePorts[nodeId];
1593:     const name = this.lab.nodes.find((n) => n.id === nodeId)?.name ?? `#${nodeId}`;
1594:     if (!port) {
1595:       this.pushLog("warn", `${name}: console port not assigned yet`, nodeId);
1596:       return;
1597:     }
1598:     const host = location.hostname || "localhost";
1599:     const url = `telnet://${host}:${port}`;
1600:     try {
1601:       const a = document.createElement("a");
1602:       a.href = url;
1603:       a.style.display = "none";
1604:       document.body.appendChild(a);
1605:       a.click();
1606:       a.remove();
1607:     } catch {
1608:       /* no telnet:// handler registered â€” non-fatal; the log shows the address */
1609:     }
1610:     this.pushLog("info", `native console for ${name} â†’ ${url}`, nodeId);
1611:   }
1612: 
1613:   /** Open a node's console honouring the global console mode (consoleUiStore):
1614:    *  a web tab in "web" mode, the native telnet client in "native" mode. */
1615:   openConsoleByMode(nodeId: number) {
1616:     if (consoleUiStore.consoleMode === "native") this.openNativeConsole(nodeId);
1617:     else this.openConsole(nodeId);
1618:   }
1619: 
1620:   /** "Console all" (left pane): open a console for every currently-running node,
1621:    *  honouring the global console mode. In native mode this fires one
1622:    *  telnet:// anchor click per node â€” browsers throttle a burst of
1623:    *  programmatic external-protocol launches from a single click handler, so
1624:    *  the clicks are staggered ~300ms apart instead of firing synchronously. */
1625:   openAllConsoles() {
1626:     const ids = this.lab.nodes.filter((n) => this.nodeStates[n.id] === "running").map((n) => n.id);
1627:     ids.forEach((id, i) => {
1628:       if (i === 0) this.openConsoleByMode(id);
1629:       else setTimeout(() => this.openConsoleByMode(id), i * 300);
1630:     });
1631:   }
1632: 
1633:   closeConsole(nodeId: number) {
1634:     this.openConsoleTabs = this.openConsoleTabs.filter((id) => id !== nodeId);
1635:     if (this.activeConsoleTab === nodeId) {
1636:       this.activeConsoleTab = this.openConsoleTabs[0] ?? null;
1637:     }
1638:   }
1639: 
1640:   /** Close the whole console dock: every node console tab and every capture
1641:    *  tab (captures stop via the same per-tab close semantics). The dock hides
1642:    *  itself once no tabs remain (App.svelte's showConsole derivation). */
1643:   closeAllConsoles() {
1644:     this.openConsoleTabs = [];
1645:     this.activeConsoleTab = null;
1646:     for (const linkId of [...this.openCaptureTabs]) this.closeCapture(linkId);
1647:   }
1648: 
1649:   /** Add a node locally AND register it with the supervisor's loaded lab
1650:    *  (node.add) so it can start without a page refresh â€” the supervisor only
1651:    *  learns topology at lab.load otherwise, and a freshly dropped node was
1652:    *  "unknown node" to node.start (NAT was the visible victim: it's the kind
1653:    *  you drop and start mid-session). The returned promise resolves once the
1654:    *  supervisor ack'd (with the console port recorded); callers that want to
1655:    *  auto-start the node await it first. */
1656:   async addNode(node: LabNode): Promise<void> {
1657:     this.lab.nodes = [...this.lab.nodes, node];
1658:     this.nodeStates = { ...this.nodeStates, [node.id]: "stopped" };
1659:     this.scheduleAutosave();
1660:     await this.guarded(`add node ${node.name}`, async () => {
1661:       const res = await this.client.nodeAdd(this.lab.id, $state.snapshot(node) as LabNode);
1662:       if (res?.consolePort) {
1663:         this.consolePorts = { ...this.consolePorts, [node.id]: res.consolePort };
1664:       }
1665:     });
1666:   }
1667: 
1668:   removeNode(nodeId: number) {
1669:     this.lab.nodes = this.lab.nodes.filter((n) => n.id !== nodeId);
1670:     this.lab.links = this.lab.links.filter(
1671:       (l) => !l.endpoints.some((e) => e.node === nodeId)
1672:     );
1673:     if (this.selectedNodeId === nodeId) this.selectedNodeId = null;
1674:     if (this.inspectorNodeId === nodeId) this.inspectorNodeId = null;
1675:     this.scheduleAutosave();
1676:     // Mirror into the loaded lab (stops the node + drops its links there too).
1677:     // Fire-and-forget: the local doc is authoritative for the GUI either way.
1678:     void this.client.nodeRemove(this.lab.id, nodeId).catch(() => {});
1679:   }
1680: 
1681:   /** Clone a node: fresh id, same config, offset +40/+40, NO links. Names get a
1682:    *  numeric suffix â€” "R1" â†’ "R1-2", "R1-2" â†’ "R1-3" â€” incremented until unique.
1683:    *  Returns the new node id (selected by the caller), or null if src missing. */
1684:   duplicateNode(nodeId: number): number | null {
1685:     const src = this.lab.nodes.find((n) => n.id === nodeId);
1686:     if (!src) return null;
1687:     // Duplication does not touch the SOURCE node's runtime state at all (it
1688:     // stays whatever it was â€” running/stopped/etc.), so it must show no
1689:     // lock/progress effect on it. The clone is a brand-new node added via the
1690:     // normal addNode path (which itself does not lock), so no lock is needed
1691:     // on either node here.
1692:     const id = this.nextNodeId();
1693:     const clone: LabNode = {
1694:       ...structuredClone($state.snapshot(src)),
1695:       id,
1696:       name: this.uniqueDuplicateName(src.name),
1697:       x: src.x + 40,
1698:       y: src.y + 40,
1699:     };
1700:     void this.addNode(clone);
1701:     return id;
1702:   }
1703: 
1704:   /** Derive a unique duplicate name. Strips a trailing "-<n>" (or appends "-2"
1705:    *  when absent), then bumps the counter until the name is free in the lab. */
1706:   private uniqueDuplicateName(name: string): string {
1707:     const m = name.match(/^(.*?)-(\d+)$/);
1708:     const base = m ? m[1] : name;
1709:     let n = m ? parseInt(m[2], 10) + 1 : 2;
1710:     const taken = new Set(this.lab.nodes.map((x) => x.name));
1711:     let candidate = `${base}-${n}`;
1712:     while (taken.has(candidate)) {
1713:       n += 1;
1714:       candidate = `${base}-${n}`;
1715:     }
1716:     return candidate;
1717:   }
1718: 
1719:   addLink(link: LabLink) {
1720:     this.lab.links = [...this.lab.links, link];
1721:     this.scheduleAutosave();
1722:   }
1723: 
1724:   removeLink(linkId: number) {
1725:     this.lab.links = this.lab.links.filter((l) => l.id !== linkId);
1726:     if (this.selectedLinkId === linkId) this.selectedLinkId = null;
1727:     this.scheduleAutosave();
1728:   }
