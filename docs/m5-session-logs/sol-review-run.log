 591: // LinkFaultData is the authoritative, separate link.fault event payload.
 592: type LinkFaultData struct {
 593: 	Link   int            `json:"link"`
 594: 	Fault  *lab.LinkFault `json:"fault"`
 595: 	Active bool           `json:"active"`
 596: 	Reason string         `json:"reason,omitempty"`
 597: }
