1786:   // ---- lab tasks ----
1787: 
1788:   /** Replace the lab task text (from the Tasks pane editor / checkbox toggles). */
1789:   setTasks(text: string) {
1790:     this.lab.tasks = text;
1791:     this.scheduleAutosave();
1792:   }
1793: 
1794:   nextNodeId(): number {
1795:     return this.lab.nodes.length === 0 ? 0 : Math.max(...this.lab.nodes.map((n) => n.id)) + 1;
1796:   }
1797: 
1798:   nextLinkId(): number {
1799:     return this.lab.links.length === 0 ? 0 : Math.max(...this.lab.links.map((l) => l.id)) + 1;
1800:   }
