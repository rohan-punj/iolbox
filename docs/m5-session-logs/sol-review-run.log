1622: // handlePainterCollect scrapes live protocol-decision state (STP/OSPF/EIGRP/BGP)
1623: // from the running IOL nodes and returns a canvas-mappable result for the
1624: // Topology Painter overlay. The heavy lifting (console scrape + parse) is in the
1625: // platform-specific painterCollect (Linux does the real work; the Windows stub
1626: // reports not-running).
1627: func (s *Server) handlePainterCollect(raw json.RawMessage) (any, error) {
1628: 	var args protocol.PainterArgs
1629: 	if err := decode(raw, &args); err != nil {
1630: 		return nil, err
1631: 	}
1632: 	switch args.Proto {
1633: 	case "stp", "ospf", "eigrp", "bgp":
1634: 	default:
1635: 		return nil, protocol.Errorf(protocol.CodeBadRequest, "painter.collect: unknown proto %q (want stp|ospf|eigrp|bgp)", args.Proto)
1636: 	}
1637: 	if args.Proto == "stp" && args.VLAN <= 0 {
1638: 		// STP is per-VLAN with exactly one root per VLAN: a paint must target
1639: 		// one VLAN (chosen via painter.stpVlans) rather than falling back to
1640: 		// "whichever VLAN block came first", which is what produced the old
1641: 		// two-root-crowns bug.
1642: 		return nil, protocol.Errorf(protocol.CodeBadRequest, "painter.collect: proto \"stp\" requires a positive vlan (pick one via painter.stpVlans first)")
1643: 	}
1644: 	ll, err := s.currentLab(args.LabID)
1645: 	if err != nil {
1646: 		return nil, err
1647: 	}
1648: 	return s.painterCollect(context.Background(), ll, args)
1649: }
1650: 
1651: // handlePainterSTPVlans enumerates the STP-enabled VLAN instances on ONE node
1652: // â€” step 1 of the STP painter flow (pick a node -> pick a VLAN -> paint every
1653: // bridge's tree for that VLAN). The heavy lifting is in the platform-specific
1654: // painterSTPVlans (Linux scrapes the console; the Windows stub reports
1655: // Linux-only).
1656: func (s *Server) handlePainterSTPVlans(raw json.RawMessage) (any, error) {
1657: 	var args protocol.PainterVlansArgs
1658: 	if err := decode(raw, &args); err != nil {
1659: 		return nil, err
1660: 	}
1661: 	ll, err := s.currentLab(args.LabID)
1662: 	if err != nil {
1663: 		return nil, err
1664: 	}
1665: 	return s.painterSTPVlans(context.Background(), ll, args.NodeID)
1666: }
