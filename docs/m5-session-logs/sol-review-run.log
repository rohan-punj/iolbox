  12:   disabled?: string;
  13: }
  14: 
  15: // Pack manifests share a small icon vocabulary, so keep the catalog mapping
  16: // explicit where two packs would otherwise inherit the same generic glyph.
  17: const TOOL_PACK_ICONS: Record<string, string> = {
  18:   aaa: "firewall",
  19:   httpclient: "cloud",
  20:   netsvc: "services",
  21:   secbench: "l3-switch",
  22:   syslog: "syslog",
  23:   webserver: "server",
  24: };
  25: 
  26: const TOOL_PACK_SUBS: Record<string, string> = {
  27:   aaa: "Authentication",
  28:   httpclient: "HTTP requests",
  29:   netsvc: "DHCP Â· DNS Â· NTP",
  30:   secbench: "Security testing",
  31:   syslog: "Log collector",
  32:   webserver: "HTTP service",
  33: };
  34: 
  35: const TOOL_PACK_SEARCH_TERMS: Record<string, string> = {
  36:   aaa: "aaa server authentication authorization accounting radius tacacs",
  37:   httpclient: "http client requests web fetch curl",
  38:   netsvc: "network services dhcp dns ntp tftp",
  39:   secbench: "security bench reconnaissance arp spoof dhcp stp vlan fhrp",
  40:   syslog: "syslog server logging logs collector",
  41:   webserver: "web server http https service",
  42: };
  43: 
  44: function groupLabel(group: string): string {
  45:   return group.replace(/[-_]+/g, " ").replace(/\b\w/g, (letter) => letter.toUpperCase());
  46: }
  47: 
  48: function toolPackIcon(pack: { id: string; icon: string }): string {
  49:   return TOOL_PACK_ICONS[pack.id] ?? (pack.icon || "tool");
  50: }
  51: 
  52: export function nodeCatalog(): CatalogEntry[] {
  53:   const toolPacks = labStore.toolPacks;
  54:   const hasNat = labStore.features.includes("natgw");
  55:   const natSlirp = labStore.egress === "slirp";
  56:   const natEgressNote =
  57:     labStore.egressNote ||
  58:     "DHCP & TCP only â€” no ping/traceroute on this runtime (QEMU slirp). Use the bridged VMware/OVA appliance or WSL2 for real internet.";
  59: 
  60:   const entries: CatalogEntry[] = [
  61:     {
  62:       id: "vpcs",
  63:       group: "Endpoints",
  64:       name: "VPCS",
  65:       sub: "Virtual PC",
  66:       icon: "pc",
  67:       search: "vpcs virtual pc".toLowerCase(),
  68:       drag: { kind: "vpcs" },
  69:     },
  70:     {
  71:       id: "pc",
  72:       group: "Endpoints",
  73:       name: "PC",
  74:       sub: "Netprobe",
  75:       icon: "pc",
  76:       search: "pc netprobe virtual pc addressing ping traceroute dns tcp udp".toLowerCase(),
  77:       drag: { kind: "pc" },
  78:     },
  79:   ];
  80: 
  81:   for (const pack of toolPacks) {
  82:     if (pack.id === "stub") continue; // Internal test fixture, not user-facing.
  83:     const sub =
  84:       TOOL_PACK_SUBS[pack.id] ??
  85:       (pack.groups.length > 0 ? groupLabel(pack.groups[0]) : "Learning tool");
  86:     const searchTerms =
  87:       TOOL_PACK_SEARCH_TERMS[pack.id] ??
  88:       (pack.groups.length > 0 ? pack.groups.join(" ") : "learning tool");
  89:     entries.push({
  90:       id: `tool:${pack.id}`,
  91:       group: "Services",
  92:       name: pack.name,
  93:       sub,
  94:       icon: toolPackIcon(pack),
  95:       search: `${pack.name} ${searchTerms}`.toLowerCase(),
  96:       drag: { kind: "tool", packId: pack.id },
  97:     });
  98:   }
  99: 
 100:   if (hasNat) {
 101:     entries.push({
 102:       id: "nat",
 103:       group: "Services",
 104:       name: "NAT Gateway",
 105:       sub: natSlirp ? natEgressNote : "Internet egress",
 106:       icon: "nat",
 107:       search: `nat gateway ${natSlirp ? natEgressNote : "internet egress"}`.toLowerCase(),
 108:       drag: { kind: "nat" },
 109:     });
 110:   }
 111: 
 112:   for (const img of labStore.images) {
 113:     const isL2 = img.class === "l2";
 114:     const name = isL2 ? "Switch" : "Router";
 115:     const sub = `${img.class.toUpperCase()} Â· ${img.arch}`;
 116:     entries.push({
 117:       id: `iol:${img.id}`,
 118:       group: "IOL images",
 119:       name,
 120:       sub,
 121:       icon: isL2 ? "switch" : "router",
 122:       search: `${name} ${sub} ${img.filename} ${img.arch} ${img.class}`.toLowerCase(),
 123:       drag: { kind: "iol", imageId: img.id },
 124:     });
 125:   }
 126: 
 127:   return entries;
 128: }

