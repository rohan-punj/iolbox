   1: // Types for docs/protocol.md â€” the NDJSON control protocol spoken to the supervisor.
   2: import type { ImageClass, LabDocument, LabLink, LibraryImage, NodeState, LinkFault, PCState } from "./labTypes";
   3: 
   4: export interface Request<A = unknown> {
