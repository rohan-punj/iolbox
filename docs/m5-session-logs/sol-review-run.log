  68: }
  69: /** Per-link forwarded throughput over the last ~2s. Bridged (relay-backed)
  70:  *  links only â€” native IOLâ†”IOL links never emit this (see docs/protocol.md).
  71:  *  `protos` (Network Watcher) is a frames-per-second breakdown by protocol
  72:  *  label (e.g. "STP", "CDP", "ICMP", "OSPF", "TCP"); non-zero entries only,
  73:  *  capped at 6 by the sender â€” optional so older supervisors keep working.
  74:  *  `protosDir` is the directional variant: per label, [fps of frames sourced
  75:  *  from the link's doc endpoints[0], fps sourced from endpoints[1]] â€” nonzero
  76:  *  labels only. Drives the watcher's directional dash overlays.
  77:  *  `protosSubtypeDir` is the same directional breakdown one level deeper:
  78:  *  label â†’ subtype (e.g. BGP "keepalive", ICMP "echo-request") â†’ [ep0, ep1]
  79:  *  fps â€” nonzero only. Lets the watcher filter by packet type. */
  80: export interface LinkStatsEvent {
  81:   event: "link.stats";
  82:   data: {
  83:     link: number;
  84:     fps: number;
  85:     bps: number;
  86:     protos?: Record<string, number>;
  87:     protosDir?: Record<string, [number, number]>;
  88:     protosSubtypeDir?: Record<string, Record<string, [number, number]>>;
  89:   };
  90: }
  91: export interface LinkFaultEvent {
  92:   event: "link.fault";
  93:   data: { link: number; fault: LinkFault | null; active: boolean; reason?: string };
  94: }
  95: /** Runtime VM resource utilisation, pushed every ~2s for the host monitor. */
  96: export interface HostStatsEvent {
  97:   event: "host.stats";
  98:   data: {
  99:     cpuPct: number;
 100:     memUsed: number;
