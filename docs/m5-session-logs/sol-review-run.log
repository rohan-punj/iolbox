 106: func (s *Server) handleLabLoad(raw json.RawMessage) (any, error) {
 107: 	var args protocol.LabLoadArgs
 108: 	if err := decode(raw, &args); err != nil {
 109: 		return nil, err
 110: 	}
 111: 	doc := args.Lab
 112: 	if err := doc.Validate(); err != nil {
 113: 		return nil, protocol.Errorf(protocol.CodeSchemaInvalid, "%v", err)
 114: 	}
 115: 
 116: 	// T1.1 requires every tool node to name a known installed pack at load
 117: 	// time. internal/lab deliberately performs only the structural half of
 118: 	// that rule because importing internal/tool there would invert the package
 119: 	// layering; checking only in startToolNode would silently defer an invalid
 120: 	// document's failure until a later lifecycle operation.
 121: 	for _, n := range doc.Nodes {
 122: 		if n.Kind != lab.KindTool {
 123: 			continue
 124: 		}
 125: 		var packID string
 126: 		if err := json.Unmarshal(n.Config["pack"], &packID); err != nil {
 127: 			return nil, protocol.Errorf(protocol.CodeBadRequest,
 128: 				"tool: node %d has invalid pack id: %v", n.ID, err)
 129: 		}
 130: 		if _, ok := s.toolPack(packID); !ok {
 131: 			return nil, protocol.Errorf(protocol.CodeBadRequest,
 132: 				"tool: node %d references unknown pack %q", n.ID, packID)
 133: 		}
 134: 	}
 135: 
 136: 	// ADOPT PATH (WS2): a lab.load for the SAME id, SAME topology, while at
 137: 	// least one node of the currently-loaded lab is actually up, must NOT go
 138: 	// through the teardown-and-reload path below. This is what makes a
 139: 	// second browser tab (or a GUI refresh that still ends up here, e.g. the
 140: 	// labGetDoc-failed fallback) safe to open on top of a lab someone is
 141: 	// already running: without this, opening the SAME lab a second time
 142: 	// looked identical to loading a different one and evicted every running
 143: 	// node out from under the first tab. Cosmetic-only differences (name,
 144: 	// position, annotations, startupConfig text) do not block adoption but
 145: 	// DO get persisted into the stored doc, so edits made in the second tab
 146: 	// before the reload aren't silently dropped.
 147: 	if res, ok := s.tryAdoptLoad(&doc); ok {
 148: 		return res, nil
 149: 	}
 150: 
 151: 	ll := newLoadedLab(&doc, s.cfg.RunDir)
 152: 	nodes := []protocol.NodeConsole{}
 153: 	warnings := []string{}
 154: 
 155: 	for i := range doc.Nodes {
 156: 		n := &doc.Nodes[i]
 157: 		port, err := s.consolePorts.Next()
 158: 		if err != nil {
 159: 			return nil, protocol.Errorf(protocol.CodePortUnavailable, "%v", err)
 160: 		}
 161: 		nr := &nodeRuntime{
 162: 			id:          n.ID,
 163: 			consolePort: port,
 164: 			machine:     node.NewMachine(s.nodeStateCallback(n.ID)),
 165: 			ram:         n.RAM,
 166: 		}
 167: 		if n.Kind == lab.KindIOL && n.Image != nil {
 168: 			nr.imageID = n.Image.ID
 169: 			if _, ok := s.lookupImage(n.Image.ID); !ok {
 170: 				warnings = append(warnings, fmt.Sprintf("node %d references unregistered image %s", n.ID, n.Image.ID))
 171: 			}
 172: 		}
 173: 		ll.nodes[n.ID] = nr
 174: 		nodes = append(nodes, protocol.NodeConsole{ID: n.ID, ConsolePort: port})
 175: 	}
 176: 
 177: 	s.mu.Lock()
 178: 	old := s.lab
 179: 	s.mu.Unlock()
 180: 
 181: 	// Stop the outgoing lab's nodes BEFORE dropping the reference. Without this,
 182: 	// loading a new lab over a running one orphans the old nodes: they keep
 183: 	// running as untracked supervisor children (observed: stranded IOL holding
 184: 	// gigabytes of RAM and spinning VPCS), because nothing else ever holds a
 185: 	// handle to them again. Then tear down its fabric (taps/bridges/shims),
 186: 	// release its console ports, and release its capture ports â€” the old lab is
 187: 	// dropped without a rebuild, so nothing else would ever return those ports.
 188: 	if old != nil {
 189: 		for _, id := range old.nodeIDs() {
 190: 			s.stopNode(old, id)
 191: 		}
 192: 		s.teardownFabric(old)
 193: 		for _, id := range old.nodeIDs() {
 194: 			if nr := old.get(id); nr != nil {
 195: 				s.consolePorts.Release(nr.consolePort)
 196: 			}
 197: 		}
 198: 		s.releaseCaptures(old, false)
 199: 	}
 200: 
 201: 	// Publish only after the outgoing lab has released its children and
 202: 	// unscoped kernel objects. Tap/bridge names are not lab-scoped, so publishing
 203: 	// earlier allowed a concurrent start of the new lab to have this teardown
 204: 	// delete the new lab's devices by name.
 205: 	s.mu.Lock()
 206: 	s.lab = ll
 207: 	s.mu.Unlock()
 208: 
 209: 	return protocol.LabLoadResult{LabID: doc.ID, Nodes: nodes, Warnings: warnings}, nil
 210: }
 211: 
 212: // tryAdoptLoad services a lab.load WITHOUT any teardown when it targets the
 213: // SAME lab id as the one currently loaded, that lab has at least one node
 214: // that is actually up (not merely loaded-but-stopped â€” an idle lab gets the
 215: // normal reload path, which is cheap and correctness-neutral there), and the
 216: // new doc's topology is identical to the loaded one (see sameTopology). The
 217: // second return value is false when none of those hold, meaning the caller
 218: // must fall through to the ordinary teardown-and-reload path.
 219: //
 220: // On adoption: the stored doc's cosmetic fields (name/position/annotations/
 221: // startupConfig/description/canvas â€” everything sameTopology ignores) are
 222: // copied onto the RUNNING lab's doc so edits made before the reload are not
 223: // lost, but the runtime (nodes map, fabric, captures) is left completely
 224: // untouched. Console ports in the result come from the live nodeRuntimes,
 225: // never freshly allocated â€” a fresh allocation here would desync the GUI
 226: // (which still has the old ports) from the actual listening sockets.
 227: func (s *Server) tryAdoptLoad(doc *lab.Lab) (protocol.LabLoadResult, bool) {
 228: 	s.mu.Lock()
 229: 	ll := s.lab
 230: 	s.mu.Unlock()
 231: 	if ll == nil {
 232: 		return protocol.LabLoadResult{}, false
 233: 	}
 234: 	current := ll.docSnapshot()
 235: 	if current.ID != doc.ID {
 236: 		return protocol.LabLoadResult{}, false
 237: 	}
 238: 	ll.mu.Lock()
 239: 	anyUp := false
 240: 	for _, nr := range ll.nodes {
 241: 		if nr.machine.State() != node.StateStopped {
 242: 			anyUp = true
 243: 			break
 244: 		}
 245: 	}
 246: 	ll.mu.Unlock()
 247: 	if !anyUp {
 248: 		return protocol.LabLoadResult{}, false
 249: 	}
 250: 	if !sameTopology(current, doc) {
 251: 		return protocol.LabLoadResult{}, false
 252: 	}
 253: 
 254: 	// Swap in the new doc's cosmetic content while keeping the loaded lab's
 255: 	// runtime (ll.nodes/fabric/captures) â€” topology is identical so every
 256: 	// node id used by the runtime maps still lines up against the new doc.
 257: 	// Guard the swap with ll.mu (the same lock handleStatus/fabricStats hold
 258: 	// when they walk ll.doc.Links) so a concurrent stats/status reader can't
 259: 	// tear the ll.doc pointer; no s.mu is held here, so there's no lock nesting.
 260: 	ll.mu.Lock()
 261: 	ll.doc = doc
 262: 	ll.mu.Unlock()
 263: 
 264: 	var nodes []protocol.NodeConsole
 265: 	for i := range doc.Nodes {
 266: 		n := &doc.Nodes[i]
 267: 		nr := ll.get(n.ID)
 268: 		if nr == nil {
 269: 			// Should be unreachable (sameTopology guarantees identical node id
 270: 			// sets), but fall back to the teardown path rather than panic or
 271: 			// return a bogus port if it ever happens.
 272: 			return protocol.LabLoadResult{}, false
 273: 		}
 274: 		nodes = append(nodes, protocol.NodeConsole{ID: n.ID, ConsolePort: nr.consolePort})
 275: 	}
 276: 	return protocol.LabLoadResult{LabID: doc.ID, Nodes: nodes, Adopted: true}, true
 277: }
 278: 
 279: // sameTopology reports whether a and b describe the same runtime shape: the
 280: // same set of nodes (by id, kind, image id, ethernet/serial adapter counts)
 281: // and the same set of links (by id and its endpoints as an unordered set).
 282: // Names, positions, icons, annotations, canvas view state, and startupConfig
 283: // text are COSMETIC and deliberately excluded â€” changing them must not block
 284: // lab.load adoption (see tryAdoptLoad), since none of them affect the running
 285: // fabric/process set. Node and link ORDER is irrelevant (compared as sets),
 286: // only membership.
 287: func sameTopology(a, b *lab.Lab) bool {
 288: 	if len(a.Nodes) != len(b.Nodes) || len(a.Links) != len(b.Links) {
 289: 		return false
 290: 	}
 291: 	an := make(map[int]lab.Node, len(a.Nodes))
 292: 	for _, n := range a.Nodes {
 293: 		an[n.ID] = n
 294: 	}
 295: 	for _, nb := range b.Nodes {
 296: 		na, ok := an[nb.ID]
 297: 		if !ok || !sameNodeShape(na, nb) {
 298: 			return false
 299: 		}
 300: 	}
 301: 
 302: 	al := make(map[int]lab.Link, len(a.Links))
 303: 	for _, l := range a.Links {
 304: 		al[l.ID] = l
 305: 	}
 306: 	for _, lb := range b.Links {
 307: 		la, ok := al[lb.ID]
 308: 		if !ok || !sameEndpointSet(la.Endpoints, lb.Endpoints) {
 309: 			return false
 310: 		}
 311: 	}
 312: 	return true
 313: }
 314: 
 315: // sameNodeShape compares the runtime-relevant fields of two nodes sharing an
 316: // id: kind, image id (empty string when Image is nil, on both sides, for a
 317: // non-iol node), and ethernet/serial adapter counts (nil treated as the same
 318: // as an explicit 0 â€” buildSpec's intOr default â€” so a doc that never set the
 319: // field matches one that set it to the default explicitly).
 320: func sameNodeShape(a, b lab.Node) bool {
 321: 	if a.Kind != b.Kind {
 322: 		return false
 323: 	}
 324: 	if imageID(a) != imageID(b) {
 325: 		return false
 326: 	}
 327: 	return intOr(a.Ethernet, 1) == intOr(b.Ethernet, 1) && intOr(a.Serial, 1) == intOr(b.Serial, 1)
 328: }
 329: 
 330: func imageID(n lab.Node) string {
 331: 	if n.Image == nil {
 332: 		return ""
 333: 	}
 334: 	return n.Image.ID
 335: }
 336: 
 337: // sameEndpointSet compares two links' endpoints as an unordered set of
 338: // {node,interface} pairs (a link's two endpoints can be listed in either
 339: // order without changing its meaning).
 340: func sameEndpointSet(a, b []lab.Endpoint) bool {
 341: 	if len(a) != len(b) {
 342: 		return false
 343: 	}
 344: 	count := make(map[lab.Endpoint]int, len(a))
 345: 	for _, e := range a {
 346: 		count[e]++
 347: 	}
 348: 	for _, e := range b {
 349: 		count[e]--
 350: 	}
 351: 	for _, c := range count {
 352: 		if c != 0 {
 353: 			return false
 354: 		}
 355: 	}
 356: 	return true
 357: }
 358: 
 359: // nodeStateCallback returns a state-machine callback that emits node.state.
 360: func (s *Server) nodeStateCallback(nodeID int) func(node.State) {
 361: 	return func(st node.State) {
 362: 		s.emit(protocol.EventNodeState, protocol.NodeStateData{Node: nodeID, State: string(st)})
 363: 	}
 364: }
 365: 
 366: func (s *Server) lookupImage(id string) (image.Info, bool) {
 367: 	s.mu.Lock()
 368: 	defer s.mu.Unlock()
 369: 	info, ok := s.images[id]
 370: 	return info, ok
 371: }
 372: 
 373: // currentLab returns the loaded lab, verifying labId matches.
 374: func (s *Server) currentLab(labID string) (*loadedLab, error) {
 375: 	s.mu.Lock()
 376: 	ll := s.lab
 377: 	s.mu.Unlock()
 378: 	if ll == nil {
 379: 		return nil, protocol.NewError(protocol.CodeNotLoaded, "no lab loaded")
 380: 	}
 381: 	current := ll.docSnapshot()
 382: 	if labID != "" && labID != current.ID {
 383: 		return nil, protocol.Errorf(protocol.CodeNotLoaded, "lab %q is not loaded (current: %q)", labID, current.ID)
 384: 	}
 385: 	return ll, nil
 386: }
 387: 
 388: func (s *Server) handleLabStart(raw json.RawMessage) (any, error) {
 389: 	var args protocol.LabSelectArgs
 390: 	if err := decode(raw, &args); err != nil {
 391: 		return nil, err
 392: 	}
 393: 	ll, err := s.currentLab(args.LabID)
 394: 	if err != nil {
 395: 		return nil, err
 396: 	}
 397: 	ids := args.Nodes
 398: 	if ids == nil {
 399: 		for _, n := range ll.docSnapshot().Nodes {
 400: 			ids = append(ids, n.ID)
 401: 		}
 402: 	}
 403: 	out, err := s.startNodes(ll, ids)
 404: 	if err != nil {
 405: 		return nil, err
 406: 	}
 407: 	// Fault state is separate from link.stats and must be replayed even for an
 408: 	// idle/admin-down link that will never generate a stats tick.
 409: 	for _, l := range ll.docSnapshot().Links {
 410: 		if l.Fault != nil {
 411: 			s.emitLinkFault(ll, l.ID, "lab start")
 412: 		}
 413: 	}
 414: 	return out, nil
 415: }
 416: 
 417: func (s *Server) handleLabStop(raw json.RawMessage) (any, error) {
 418: 	var args protocol.LabSelectArgs
 419: 	if err := decode(raw, &args); err != nil {
 420: 		return nil, err
 421: 	}
 422: 	ll, err := s.currentLab(args.LabID)
 423: 	if err != nil {
 424: 		return nil, err
 425: 	}
 426: 	all := args.Nodes == nil
 427: 	ids := args.Nodes
 428: 	if ids == nil {
 429: 		for _, n := range ll.docSnapshot().Nodes {
 430: 			ids = append(ids, n.ID)
 431: 		}
 432: 	}
 433: 	for _, id := range ids {
 434: 		s.stopNode(ll, id)
 435: 	}
 436: 	// A full lab stop tears down the fabric too (taps/bridges/netio<->tap iouyaps/
 437: 	// VPCS shims; per-node stop leaves them up and they restart idempotently on
 438: 	// the next spawn), and releases every armed capture: the bridge captures are
 439: 	// stopped so the TCP capture ports actually free, capture.stopped is emitted
 440: 	// per link, and the ports return to the allocator. Links whose doc still says
 441: 	// capture.enabled re-arm automatically on the next lab start (see
 442: 	// armDocCaptures), with a fresh capture.started.
 443: 	if all {
 444: 		s.teardownFabric(ll)
 445: 		s.releaseCaptures(ll, true)
 446: 		// Full stop deactivates runtime faults during fabric teardown. Replay the
 447: 		// resulting inactive state so the canvas does not retain an admin-down or
 448: 		// impairment badge while the lab is stopped; the persisted definition is
 449: 		// still present and will be replayed/applied again only when appropriate at
 450: 		// the next lab.start.
 451: 		for _, l := range ll.docSnapshot().Links {
 452: 			if l.Fault != nil {
 453: 				s.emitLinkFault(ll, l.ID, "lab stop")
 454: 			}
 455: 		}
 456: 	}
 457: 	return protocol.StartResult{Started: []protocol.StartedNode{}}, nil
 458: }
 459: 
 460: // handleLabReap is the GUI "Force clean": it force-stops all runtime state
 461: // regardless of tracking so orphans (nodes the GUI still thinks are running, a
 462: // spinning console after an odd teardown) can be cleared from the GUI in one
 463: // click. It stops every node of the loaded lab and tears down its fabric
 464: // (taps/bridges/shims) and captures. Unlike lab.stop it takes no labId and
 465: // never errors on a mismatch.
 466: func (s *Server) handleLabReap(_ json.RawMessage) (any, error) {
 467: 	s.mu.Lock()
 468: 	ll := s.lab
 469: 	s.mu.Unlock()
 470: 	reaped := 0
 471: 	if ll != nil {
 472: 		for _, id := range ll.nodeIDs() {
 473: 			s.stopNode(ll, id)
 474: 			reaped++
 475: 		}
 476: 		s.teardownFabric(ll)
 477: 		s.releaseCaptures(ll, true)
 478: 	}
 479: 	return protocol.ReapResult{Reaped: reaped}, nil
 480: }
 481: 
 482: // handleLabWipe resets node state like PNetLab's wipe: for each targeted node
 483: // it stops the node (via the shared stop path, so consoles/relays clean up and
 484: // node.state events fire) then deletes the node's persisted nvram_<id> file from
 485: // the lab dir so the next boot starts from the injected startup-config again. A
 486: // missing nvram file is not an error. Nodes nil = all nodes.
 487: func (s *Server) handleLabWipe(raw json.RawMessage) (any, error) {
 488: 	var args protocol.LabWipeArgs
 489: 	if err := decode(raw, &args); err != nil {
 490: 		return nil, err
 491: 	}
 492: 	ll, err := s.currentLab(args.LabID)
 493: 	if err != nil {
 494: 		return nil, err
 495: 	}
 496: 	ids := args.Nodes
 497: 	if ids == nil {
 498: 		for _, n := range ll.docSnapshot().Nodes {
 499: 			ids = append(ids, n.ID)
 500: 		}
 501: 	}
 502: 	wiped := []int{}
 503: 	for _, id := range ids {
 504: 		if ll.get(id) == nil {
 505: 			return nil, protocol.Errorf(protocol.CodeBadRequest, "unknown node %d", id)
 506: 		}
 507: 		// Stop first so the process releases the nvram file before we delete it.
 508: 		s.stopNode(ll, id)
 509: 		path := filepath.Join(ll.labDir(), nvramFilename(id))
 510: 		if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
 511: 			return nil, protocol.Errorf(protocol.CodeNvramCodecFailed, "wipe nvram node %d: %v", id, err)
 512: 		}
 513: 		wiped = append(wiped, id)
 514: 	}
 515: 	return protocol.LabWipeResult{Wiped: wiped}, nil
 516: }
 517: 
 518: func (s *Server) handleNodeStart(raw json.RawMessage) (any, error) {
 519: 	var args protocol.NodeArgs
 520: 	if err := decode(raw, &args); err != nil {
 521: 		return nil, err
 522: 	}
 523: 	ll, err := s.currentLab(args.LabID)
 524: 	if err != nil {
 525: 		return nil, err
 526: 	}
 527: 	return s.startNodes(ll, []int{args.Node})
 528: }
 529: 
 530: func (s *Server) handleNodeStop(raw json.RawMessage) (any, error) {
 531: 	var args protocol.NodeArgs
 532: 	if err := decode(raw, &args); err != nil {
 533: 		return nil, err
 534: 	}
 535: 	ll, err := s.currentLab(args.LabID)
 536: 	if err != nil {
 537: 		return nil, err
 538: 	}
 539: 	s.stopNode(ll, args.Node)
 540: 	return protocol.StartResult{Started: []protocol.StartedNode{}}, nil
