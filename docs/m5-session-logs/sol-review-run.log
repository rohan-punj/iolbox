 187: // NodeMAC is one interface's link-layer address for a node, with the PROVENANCE
 188: // that licenses reporting it. There is no reading of this struct that yields a
 189: // MAC the supervisor did not either compute from a flag it passed or read from
 190: // the node/runtime.
 191: //
 192: // Source:
 193: //
 194: //	"derived" - computed from an argument this supervisor passed to the node
 195: //	            (VPCS -m; see node.VPCSMAC). Valid even while the node is stopped.
 196: //	"read"    - directly read from the running node/runtime: the kernel for a
 197: //	            device this supervisor created, or IOS console `show interfaces`
 198: //	            for an IOL node.
 199: //	""        - nothing is known; State says why.
 200: //
 201: // State:
 202: //
 203: //	"known"     - MAC is set and is the interface's address.
 204: //	"unknown"   - not knowable right now; Reason carries a short human phrase.
 205: type NodeMAC struct {
 206: 	Interface string `json:"interface"`        // the lab document's spelling: e0/0, eth0, eth1
 207: 	MAC       string `json:"mac,omitempty"`    // lowercase colon-separated; set iff State=="known"
 208: 	Source    string `json:"source,omitempty"` // "derived" | "read"
 209: 	State     string `json:"state"`            // "known" | "unknown"
 210: 	Reason    string `json:"reason,omitempty"` // short phrase for the UI, e.g. "node not running"
 211: }
 212: 
 213: type NodeMACsResult struct {
 214: 	Node int       `json:"node"`
 215: 	MACs []NodeMAC `json:"macs"`
 216: }
