1378:   async setLinkFault(linkId: number, fault: LinkFault | null, afterSec?: number, forSec?: number) {
1379:     const ok = await this.guarded(`set fault on link ${linkId}`, () =>
1380:       this.client.linkSetFault(this.lab.id, linkId, fault, afterSec, forSec)
1381:     );
1382:     if (!ok) return;
1383:     if (fault) {
1384:       this.enqueueToast({
1385:         key: `link-fault:${linkId}`,
1386:         severity: afterSec && afterSec > 0 ? "info" : "warning",
1387:         message: afterSec && afterSec > 0
1388:           ? `Link ${linkId} impairment scheduled`
1389:           : `Link ${linkId} impairment active`,
1390:       });
1391:     } else {
1392:       this.enqueueToast({
1393:         key: `link-fault:${linkId}`,
1394:         severity: "success",
1395:         message: `Link ${linkId} restored`,
1396:       });
1397:     }
1398:   }
