1237: func (s *Server) handleNodeSetImage(raw json.RawMessage) (any, error) {
1238: 	var args protocol.NodeSetImageArgs
1239: 	if err := decode(raw, &args); err != nil {
1240: 		return nil, err
1241: 	}
1242: 	ll, err := s.currentLab(args.LabID)
1243: 	if err != nil {
1244: 		return nil, err
1245: 	}
1246: 	nr := ll.get(args.Node)
1247: 	if nr == nil {
1248: 		return nil, protocol.Errorf(protocol.CodeBadRequest, "unknown node %d", args.Node)
1249: 	}
1250: 	info, ok := s.lookupImage(args.ImageID)
1251: 	if !ok {
1252: 		return nil, protocol.Errorf(protocol.CodeImageNotFound, "image %s not registered", args.ImageID)
1253: 	}
1254: 	nr.imageID = args.ImageID
1255: 	// Reflect into the lab doc so status/config carry it.
1256: 	ll.mu.Lock()
1257: 	for i := range ll.doc.Nodes {
1258: 		if ll.doc.Nodes[i].ID == args.Node && ll.doc.Nodes[i].Image != nil {
1259: 			ll.doc.Nodes[i].Image.ID = args.ImageID
1260: 			break
1261: 		}
1262: 	}
1263: 	ll.mu.Unlock()
1264: 	return protocol.NodeSetImageResult{
1265: 		Node:    args.Node,
1266: 		ImageID: args.ImageID,
1267: 		Class:   string(info.Class),
1268: 	}, nil
1269: }
