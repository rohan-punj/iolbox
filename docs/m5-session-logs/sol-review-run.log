  14: // TestHelloAdvertisesGatedFeatures confirms the hello features array carries the
  15: // base set and appends natgw exactly when the server's detected caps allow.
  16: func TestHelloAdvertisesGatedFeatures(t *testing.T) {
  17: 	s := newTestServer()
  18: 	// Inject caps directly (Detect returns all-false off Linux / without sudo).
  19: 	s.caps = extnet.Capabilities{NAT: true}
  20: 	resp := dispatch(t, s, "hello", protocol.HelloArgs{Client: "gui"})
  21: 	if !resp.OK {
  22: 		t.Fatalf("hello failed: %+v", resp.Error)
  23: 	}
  24: 	var r protocol.HelloResult
  25: 	if err := json.Unmarshal(resp.Result, &r); err != nil {
  26: 		t.Fatal(err)
  27: 	}
  28: 	has := map[string]bool{}
  29: 	for _, f := range r.Features {
  30: 		has[f] = true
  31: 	}
  32: 	for _, want := range []string{"nvram", "capture", "i386", "natgw"} {
  33: 		if !has[want] {
  34: 			t.Fatalf("hello features %v missing %q", r.Features, want)
  35: 		}
  36: 	}
  37: 
  38: 	// With no caps, natgw must be absent.
  39: 	s.caps = extnet.Capabilities{}
  40: 	resp = dispatch(t, s, "hello", protocol.HelloArgs{Client: "gui"})
  41: 	json.Unmarshal(resp.Result, &r)
  42: 	for _, f := range r.Features {
  43: 		if f == "natgw" {
  44: 			t.Fatalf("unsupported feature %q advertised", f)
  45: 		}
  46: 	}
  47: }
