 241:   constructor() {
 242:     const sel = selectTransport();
 243:     this.transportKind = sel.kind;
 244:     if (sel.kind === "mock") this.mock = sel.transport as MockTransport;
 245:     this.client = new SupervisorClient(sel.transport);
 246:     if (sel.kind === "ws") {
 247:       // Served by the supervisor itself: it already IS the runtime, so skip
 248:       // the desktop-only provider-detection modal and connect immediately.
 249:       this.showPreflight = false;
 250:       this.activeProvider = null;
 251:       void this.connect();
 252:     }
 253:     // Drive glow decay: bump a coarse clock every second so FloatingEdge
 254:     // re-evaluates staleness even when no new link.stats events arrive.
 255:     setInterval(() => {
 256:       this.nowTick = Date.now();
 257:     }, 1000);
 258:   }
