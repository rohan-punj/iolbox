 427:   private coalesceCapture(kind: "started" | "stopped", linkId: number) {
 428:     if (kind === "stopped" && this.labStopReplaySuppressed()) return;
 429:     const existing = this.captureBursts.get(kind);
 430:     if (existing) {
 431:       existing.links.add(linkId);
 432:       return;
 433:     }
 434:     const links = new Set([linkId]);
 435:     const timer = setTimeout(() => {
 436:       this.captureBursts.delete(kind);
 437:       const count = links.size;
 438:       const word = kind === "started" ? "started" : "stopped";
 439:       this.enqueueToast({
 440:         severity: "info",
 441:         message: count === 1 ? `Capture ${word} â€” link ${[...links][0]}` : `${count} captures ${word}`,
 442:         count: count > 1 ? count : undefined,
 443:       });
 444:     }, 750);
 445:     this.captureBursts.set(kind, { links, timer });
 446:   }
 447: 
 448:   private labStopReplaySuppressed(): boolean {
 449:     return this.labStopPending || Date.now() < this.labStopSuppressedUntil;
 450:   }
 451: 
 452:   async connect() {
 453:     this.providerStatus = "connecting";
 454:     // Subscribe before the handshake settles so no push (node.state etc.)
 455:     // arriving mid-connect is dropped.
 456:     this.client.onEvent((evt) => this.handleEvent(evt));
 457:     // A transport reconnect (network blip, or a burst of activity like Stop
 458:     // all + Start all tripping the WS) means every push event sent during the
 459:     // gap is gone for good â€” there's no server-side replay (see
 460:     // broadcaster.publish). Without this, nodeStates/consolePorts/
 461:     // capturePorts stay frozen at whatever they were right before the drop
 462:     // until the user manually reloads the page; a bulk stop-then-restart
 463:     // landing in that gap left every LED stuck non-green even though the
 464:     // nodes were actually running. Re-query status() and refresh them instead
 465:     // of waiting for a page reload to notice.
 466:     this.client.onReconnect(() => void this.resyncAfterReconnect());
 467:     try {
 468:       const hello = await this.client.connect();
 469:       this.features = hello.features ?? [];
 470:       this.supervisorVersion = hello.supervisor ?? "";
 471:       // WS6 â€” absent egress defaults to the permissive "routed" (no badge).
 472:       this.egress = hello.egress ?? "routed";
 473:       this.egressNote = hello.egressNote ?? "";
 474:       this.providerStatus = "connected";
 475:       // Real supervisor: the runtime provider is whatever process spawned it,
 476:       // not a Windows-side choice â€” leave activeProvider as Preflight (mock
 477:       // path) or unset (ws path) already set it, rather than hardcoding.
 478:       if (this.transportKind === "mock") this.activeProvider = "vmware";
 479:       this.imagesLoading = true;
 480:       try {
 481:         const { images } = await this.client.imageList();
 482:         this.images = images;
 483:       } finally {
 484:         this.imagesLoading = false;
 485:       }
 486:       this.toolPacksLoading = true;
 487:       this.toolPacksError = null;
 488:       try {
 489:         const { packs } = await this.client.listPacks();
 490:         this.toolPacks = packs;
 491:       } catch (e) {
 492:         this.toolPacksError = (e as Error).message;
 493:         this.pushLog("warn", `learning-tool packs unavailable: ${this.toolPacksError}`);
 494:       } finally {
 495:         this.toolPacksLoading = false;
 496:       }
 497:       // WS2 â€” "adopt, don't load": if the supervisor is already running a lab
 498:       // (survived our disconnect â€” e.g. this is a browser refresh, not a fresh
 499:       // supervisor boot), hydrate the GUI from its live status INSTEAD of
 500:       // calling lab.load, which deliberately tears down the previously-loaded
 501:       // lab first (the orphan-fix in handleLabLoad). Without this, every
 502:       // refresh killed the user's running IOL nodes. Only fall back to the
 503:       // restore/seed+load path when nothing is actually up.
 504:       const status = await this.client.status();
 505:       const anyUp = status.nodes.some((n) => n.state !== "stopped");
 506:       const adopted = status.labId && anyUp ? await this.adoptRunningLab(status) : false;
 507:       if (!adopted) {
 508:         // Reload the last lab the user was working on (so a browser refresh
 509:         // keeps their additions) instead of the throwaway seed. Falls back to
 510:         // the seed when there's no remembered lab or it's gone from the store.
 511:         const restored = await this.restoreLastActiveLab();
 512:         if (!restored) {
 513:           this.reconcileNodeImages();
 514:           await this.loadLab(this.lab);
 515:         }
 516:       }
 517:     } catch (e) {
 518:       this.providerStatus = "error";
 519:       this.lastError = `connect failed: ${(e as Error).message}`;
 520:       this.pushLog("error", `connect failed: ${(e as Error).message}`);
 521:     }
 522:   }
 523: 
 524:   /** Refresh live node/link runtime state after a transport reconnect (see
 525:    *  the onReconnect subscription in connect()). Only handles the common
 526:    *  case â€” the supervisor still has THIS lab loaded, which is true for any
 527:    *  network-level blip since the supervisor process itself never restarted.
 528:    *  If it reports a different (or no) lab â€” the supervisor process itself
 529:    *  restarted during the drop â€” this can't safely reconcile locally; ask for
 530:    *  a manual reload rather than guess. */
 531:   private async resyncAfterReconnect() {
 532:     try {
 533:       const status = await this.client.status();
 534:       if (!status.labId || status.labId !== this.lab.id) {
 535:         this.pushLog(
 536:           "warn",
 537:           "reconnected, but the supervisor is no longer tracking this lab (it may have restarted) â€” reload the page"
 538:         );
 539:         return;
 540:       }
 541:       const states: Record<number, NodeState> = {};
 542:       for (const n of status.nodes ?? []) states[n.id] = n.state;
 543:       for (const n of this.lab.nodes) if (!(n.id in states)) states[n.id] = "stopped";
 544:       this.nodeStates = states;
 545:       const consolePorts: Record<number, number> = {};
 546:       for (const n of status.nodes ?? []) if (n.consolePort) consolePorts[n.id] = n.consolePort;
 547:       this.consolePorts = consolePorts;
 548:       const capPorts: Record<number, number> = {};
 549:       for (const l of status.links ?? []) if (l.capturePort) capPorts[l.id] = l.capturePort;
 550:       this.capturePorts = capPorts;
 551:       this.pushLog("info", "reconnected to the supervisor â€” refreshed node/link state");
 552:     } catch (e) {
 553:       this.pushLog("warn", `reconnect: failed to refresh state: ${(e as Error).message}`);
 554:     }
 555:   }
 556: 
 557:   /**
 558:    * WS2 â€” hydrate the GUI from a lab the supervisor is ALREADY running,
 559:    * without calling lab.load (which tears the running lab down first). The
 560:    * target is always `status.labId` â€” if the supervisor is running a
 561:    * DIFFERENT lab than the one this browser last remembered, the supervisor
 562:    * wins (it reflects reality; the GUI's memory does not) and we adopt
 563:    * whatever it reports. Returns true on success; false only in the rare case
 564:    * the doc can't be fetched from the durable store (e.g. it was deleted from
 565:    * under a still-running lab), in which case the caller falls back to the
 566:    * normal restore/seed+load path â€” that path still calls loadLab, but there
 567:    * is no doc to adopt into, so there is nothing more graceful to do here.
 568:    */
 569:   private async adoptRunningLab(status: StatusResult): Promise<boolean> {
 570:     let lab: LabDocument;
 571:     try {
 572:       const res = await this.client.labGetDoc(status.labId!);
 573:       if (!res.lab || !Array.isArray(res.lab.nodes)) throw new Error("empty doc");
 574:       lab = res.lab;
 575:     } catch (e) {
 576:       this.pushLog(
 577:         "warn",
 578:         `lab ${status.labId} is running but its stored doc could not be read (${(e as Error).message}) â€” falling back to the normal load path`
 579:       );
 580:       return false;
 581:     }
 582: 
 583:     this.lab = lab;
 584:     this.reconcileNodeImages();
 585: 
 586:     // Clear stale per-lab UI state exactly like loadLab does, EXCEPT the live
 587:     // runtime maps (nodeStates/consolePorts/capturePorts), which we are about
 588:     // to populate from the supervisor's actual status instead of resetting.
 589:     this.linkStats = {};
 590:     this.linkFaults = {};
 591:     this.openConsoleTabs = [];
 592:     this.closeAllCaptureSessions();
 593:     this.openCaptureTabs = [];
 594:     this.openLensTabs = [];
 595:     this.captureBuffers.clear();
 596:     this.captureRecorded = {};
 597:     this.lensEvents = {};
 598:     this.activeConsoleTab = null;
 599: 
 600:     const states: Record<number, NodeState> = {};
 601:     const ports: Record<number, number> = {};
 602:     for (const n of status.nodes ?? []) {
 603:       states[n.id] = n.state;
 604:       if (n.consolePort) ports[n.id] = n.consolePort;
 605:     }
 606:     // A node in the doc that the supervisor didn't report (shouldn't happen â€”
 607:     // status always mirrors the loaded doc's node set â€” but keep the GUI from
 608:     // showing an undefined state) defaults to stopped.
 609:     for (const n of lab.nodes) {
 610:       if (!(n.id in states)) states[n.id] = "stopped";
 611:     }
 612:     this.nodeStates = states;
 613:     this.consolePorts = ports;
 614: 
 615:     const capPorts: Record<number, number> = {};
 616:     for (const l of status.links ?? []) {
 617:       if (l.capturePort) capPorts[l.id] = l.capturePort;
 618:     }
 619:     this.capturePorts = capPorts;
 620: 
 621:     this.savedDocIds.add(lab.id);
 622:     this.rememberActiveLab(lab.id);
 623:     this.pushLog("info", `adopted already-running lab "${lab.name}" â€” no restart`);
 624:     return true;
 625:   }
 626: 
 627:   /**
 628:    * Remap node image ids against the connected supervisor's registry. A lab
 629:    * doc can carry ids the backend doesn't know (the seeded demo topology's
 630:    * placeholder ids, a doc from another machine, an image since deleted):
 631:    * remap each unknown id to a registered image of the same class when one
 632:    * exists. When none exists the reference is KEPT: lab.load tolerates
 633:    * unknown image ids (only start resolves them) and the startLab pre-check
 634:    * names the node, while the ref's class is what a later pass â€” e.g. after
 635:    * the first upload on a fresh runtime â€” needs to remap by. Clearing it
 636:    * (the old behavior) made lab.load itself fail schema_invalid on a fresh
 637:    * runtime AND autosave persisted the damage.
 638:    * Returns the ids of nodes whose image binding changed.
 639:    */
 640:   private reconcileNodeImages(): number[] {
 641:     const changed: number[] = [];
 642:     for (const node of this.lab.nodes) {
 643:       if (node.kind !== "iol" || !node.image) continue;
 644:       if (this.images.some((i) => i.id === node.image!.id)) continue;
 645:       const substitute = this.images.find((i) => i.class === node.image!.class);
 646:       if (substitute) {
 647:         this.pushLog(
 648:           "info",
 649:           `node ${node.name}: image ${node.image.filename} not registered here â€” using ${substitute.filename}`
 650:         );
 651:         node.image = { id: substitute.id, filename: substitute.filename, class: substitute.class };
 652:         changed.push(node.id);
 653:       } else {
 654:         this.pushLog(
 655:           "warn",
 656:           `node ${node.name}: image ${node.image.filename} is not registered and no ${node.image.class} image is available yet â€” upload one (Images)`
 657:         );
 658:       }
 659:     }
 660:     return changed;
 661:   }
 662: 
 663:   /**
 664:    * Called after the image registry changed (upload/register): adopt the new
 665:    * list, heal any node refs that couldn't be mapped before, and push the
 666:    * result to the supervisor. On a fresh runtime the seed lab's placeholder
 667:    * ids only become startable at this moment â€” without this, starting kept
 668:    * failing until a full browser refresh (or forever, when the cleared refs
 669:    * had been autosaved).
 670:    */
 671:   async onImagesUpdated(images: LibraryImage[]) {
 672:     this.images = images;
 673:     const changed = this.reconcileNodeImages();
 674:     if (changed.length === 0) return;
 675:     this.scheduleAutosave();
 676:     const busy = this.lab.nodes.some(
 677:       (n) => this.nodeStates[n.id] === "running" || this.nodeStates[n.id] === "starting"
 678:     );
 679:     try {
 680:       if (!busy) {
 681:         // Nothing running: re-send the whole doc so the loaded lab (or a lab
 682:         // whose load failed earlier) carries the healed image ids.
 683:         await this.loadLab(this.lab);
 684:       } else {
 685:         // Something is running: hot-swap only the healed nodes (they were
 686:         // imageless, so they are not among the running ones).
 687:         for (const id of changed) {
 688:           const node = this.lab.nodes.find((n) => n.id === id);
 689:           if (node?.image) await this.client.nodeSetImage(this.lab.id, id, node.image.id);
 690:         }
 691:       }
 692:     } catch (e) {
 693:       this.lastError = `apply uploaded image: ${(e as Error).message}`;
 694:       this.pushLog("error", this.lastError);
 695:     }
 696:   }
 697: 
 698:   private handleEvent(evt: SupervisorEvent) {
 699:     switch (evt.event) {
 700:       case "node.state":
 701:         this.nodeStates = { ...this.nodeStates, [evt.data.node]: evt.data.state };
 702:         // Release a start/stop lock once the node reaches a TERMINAL state
 703:         // (WS1). The state machine (supervisor/internal/node/state.go) always
 704:         // fires an intermediate node.state="starting" event the instant a
 705:         // start begins â€” releasing on ANY node.state (as before) cleared the
 706:         // lock within milliseconds of clicking Start, long before the node
 707:         // actually finished booting. A user re-clicking Start in that window
 708:         // re-acquired the lock, but the node was already in "starting" so the
 709:         // backend's second start is a no-op state-machine transition that
 710:         // never fires another event â€” wedging that lock until the real
 711:         // running/crashed event (or the 60s safety timeout). Only "running",
 712:         // "stopped", and "crashed" are terminal; "starting" must NOT release.
 713:         if (evt.data.state !== "starting" && !this.nodeLocks[evt.data.node]?.holdUntilSettled) this.releaseNodeLock(evt.data.node);
 714:         if (evt.data.state === "crashed") {
 715:           this.enqueueToast({
 716:             key: `node-crashed:${evt.data.node}`,
 717:             severity: "error",
 718:             message: `${this.resolveNodeName(evt.data.node)} crashed`,
 719:           });
 720:         }
 721:         break;
 722:       case "node.console":
 723:         this.consolePorts = { ...this.consolePorts, [evt.data.node]: evt.data.consolePort };
 724:         break;
 725:       case "node.pcState": {
 726:         const n = this.lab.nodes.find((item) => item.id === evt.data.node);
 727:         if (n) n.config = { ...(n.config ?? {}), pc: { ...evt.data.state } };
 728:         break;
 729:       }
 730:       case "capture.started":
 731:         this.capturePorts = { ...this.capturePorts, [evt.data.link]: evt.data.capturePort };
 732:         this.coalesceCapture("started", evt.data.link);
 733:         break;
 734:       case "capture.stopped": {
 735:         const next = { ...this.capturePorts };
 736:         delete next[evt.data.link];
 737:         this.capturePorts = next;
 738:         this.coalesceCapture("stopped", evt.data.link);
 739:         break;
 740:       }
 741:       case "link.stats":
 742:         // Replace the whole record so $derived/$effect readers re-run; carry a
 743:         // receive timestamp so FloatingEdge can expire stale glow.
 744:         const stats = evt.data as typeof evt.data & { epAttrib?: EndpointAttribView[] };
 745:         this.linkStats = {
 746:           ...this.linkStats,
 747:           [evt.data.link]: {
 748:             fps: evt.data.fps,
 749:             bps: evt.data.bps,
 750:             ts: Date.now(),
 751:             protos: stats.protos,
 752:             protosDir: stats.protosDir,
 753:             protosSubtypeDir: stats.protosSubtypeDir,
 754:             epAttrib: stats.epAttrib,
 755:           },
 756:         };
 757:         break;
 758:       case "link.fault": {
 759:         this.linkFaults = {
 760:           ...this.linkFaults,
 761:           [evt.data.link]: {
 762:             fault: evt.data.fault,
 763:             active: evt.data.active,
 764:             reason: evt.data.reason,
 765:           },
 766:         };
 767:         // Fault definitions are part of the in-memory document so the normal
 768:         // lab.saveDoc path persists the same state the user sees. Active is
 769:         // deliberately runtime-only; inactive-on-reopen is represented by the
 770:         // persisted definition plus the absence of an active event.
 771:         const link = this.lab.links.find((l) => l.id === evt.data.link);
 772:         if (link) {
 773:           if (evt.data.fault) link.fault = { ...evt.data.fault };
 774:           else delete link.fault;
 775:         }
 776:         if (evt.data.active && evt.data.fault) {
 777:           this.enqueueToast({
 778:             key: `link-fault:${evt.data.link}`,
 779:             severity: "warning",
 780:             message: `Link ${evt.data.link} impairment active`,
 781:           });
 782:         } else if (!evt.data.active && !evt.data.fault && !this.labStopReplaySuppressed()) {
 783:           this.enqueueToast({
 784:             key: `link-fault:${evt.data.link}`,
 785:             severity: "success",
 786:             message: `Link ${evt.data.link} restored`,
 787:           });
 788:         }
 789:         break;
 790:       }
 791:       case "host.stats":
 792:         this.hostStats = { ...evt.data };
 793:         break;
 794:       case "log":
 795:         this.pushLog(evt.data.level, evt.data.message, evt.data.node);
 796:         break;
 797:       default:
 798:         break;
 799:     }
 800:   }
 801: 
 802:   pushLog(level: LogLine["level"], message: string, node?: number) {
 803:     this.logs = [...this.logs.slice(-199), { ts: Date.now(), level, message, node }];
 804:   }
 805: 
 806:   async loadLab(lab: LabDocument) {
 807:     // A pending autosave belongs to the PREVIOUS lab â€” left running, it fires
 808:     // ~1.2s from now and saves whatever this.lab has become by then (i.e. the
 809:     // lab we're about to switch to), silently persisting a brand-new/unedited
 810:     // lab the user never asked to save. Cancel it before swapping docs.
 811:     if (this.autosaveTimer) {
 812:       clearTimeout(this.autosaveTimer);
 813:       this.autosaveTimer = null;
 814:     }
 815:     this.labLoading = true;
 816:     try {
 817:       return await this.loadLabInner(lab);
 818:     } finally {
 819:       this.labLoading = false;
 820:     }
 821:   }
 822: 
 823:   private async loadLabInner(lab: LabDocument) {
 824:     this.lab = lab;
 825:     // Remap image ids against this supervisor's registry (same as connect()).
 826:     this.reconcileNodeImages();
 827:     // Clear any lingering runtime/glow state from the previous lab.
 828:     this.linkStats = {};
 829:     this.linkFaults = {};
 830:     this.openConsoleTabs = [];
 831:     this.closeAllCaptureSessions();
 832:     this.openCaptureTabs = [];
 833:     this.openLensTabs = [];
 834:     this.capturePorts = {};
 835:     this.captureBuffers.clear();
 836:     this.captureRecorded = {};
 837:     this.lensEvents = {};
 838:     this.activeConsoleTab = null;
 839:     const res = await this.client.labLoad(lab);
 840:     const ports: Record<number, number> = {};
 841:     for (const n of res.nodes ?? []) {
 842:       ports[n.id] = n.consolePort;
 843:     }
 844:     this.consolePorts = ports;
 845:     if (res.adopted) {
 846:       // Server-side adopt (WS2): this happened because the lab we just "loaded"
 847:       // was ALREADY running (e.g. a second browser tab opening the same lab) â€”
 848:       // the supervisor serviced it without any teardown and handed back the
 849:       // EXISTING console ports (already captured above). Resetting nodeStates
 850:       // to all-"stopped" here would lie to this tab about a lab that is
 851:       // actually up, so query real state instead.
 852:       try {
 853:         const status = await this.client.status();
 854:         const states: Record<number, NodeState> = {};
 855:         for (const n of status.nodes ?? []) states[n.id] = n.state;
 856:         for (const n of lab.nodes) if (!(n.id in states)) states[n.id] = "stopped";
 857:         this.nodeStates = states;
 858:         const capPorts: Record<number, number> = {};
 859:         for (const l of status.links ?? []) if (l.capturePort) capPorts[l.id] = l.capturePort;
 860:         this.capturePorts = capPorts;
 861:       } catch {
 862:         // status() failing here is unusual (we just got a reply from the same
 863:         // supervisor) â€” fall back to "stopped" rather than throw, same as the
 864:         // non-adopted path below would have shown anyway.
 865:         const states: Record<number, NodeState> = {};
 866:         for (const n of lab.nodes) states[n.id] = "stopped";
 867:         this.nodeStates = states;
 868:       }
 869:       return;
 870:     }
 871:     const states: Record<number, NodeState> = {};
 872:     for (const n of lab.nodes) {
 873:       states[n.id] = "stopped";
 874:     }
 875:     this.nodeStates = states;
 876:   }
 877: 
 878:   // ---- durable lab-document store (feature 3) ----
 879: 
 880:   /** True when the current lab has unsaved content: it has nodes and was
 881:    *  never saved to the durable store this session. Approximate (doesn't
 882:    *  detect edits made after a save within the same session), but matches
 883:    *  what the three former per-entry-point confirm() prompts already used â€”
 884:    *  now centralized for SwitchLabDialog. */
 885:   get currentLabDirty(): boolean {
 886:     return this.lab.nodes.length > 0 && !this.savedDocIds.has(this.lab.id);
 887:   }
 888: 
 889:   /** localStorage key holding the id of the lab the user last had open, so a
 890:    *  refresh reopens it rather than the throwaway seed. */
 891:   private static LAST_LAB_KEY = "iolbox.lastActiveLab";
 892: 
 893:   private rememberActiveLab(id: string) {
 894:     try {
 895:       localStorage.setItem(LabStore.LAST_LAB_KEY, id);
 896:     } catch {
 897:       /* private-mode / storage disabled â€” non-fatal */
 898:     }
 899:   }
 900: 
 901:   /** On (re)connect, reopen the lab the user last worked on from the durable
 902:    *  store. Returns true if a stored lab was loaded; false to fall back to the
 903:    *  seed. Any failure (no id, deleted, unreadable) falls back silently. */
 904:   private async restoreLastActiveLab(): Promise<boolean> {
 905:     let id: string | null = null;
 906:     try {
 907:       id = localStorage.getItem(LabStore.LAST_LAB_KEY);
 908:     } catch {
 909:       id = null;
 910:     }
 911:     if (!id) return false;
 912:     try {
 913:       const { lab } = await this.client.labGetDoc(id);
 914:       if (!lab || !Array.isArray(lab.nodes)) return false;
 915:       this.savedDocIds.add(lab.id);
 916:       await this.loadLab(lab);
 917:       this.reconcileNodeImages();
 918:       return true;
 919:     } catch {
 920:       return false;
 921:     }
 922:   }
 923: 
 924:   /** Persist the current doc, stamping `modified`. Returns true on success. */
 925:   async saveLab(notify = true): Promise<boolean> {
 926:     const labName = this.lab.name;
 927:     this.lab.modified = new Date().toISOString();
 928:     let ok = false;
 929:     await this.guarded("save lab", async () => {
 930:       const synced = await this.client.pcSyncState(this.lab.id);
 931:       for (const item of synced.states ?? []) {
 932:         const n = this.lab.nodes.find((candidate) => candidate.id === item.node);
 933:         if (n) n.config = { ...(n.config ?? {}), pc: { ...item.state } };
 934:       }
 935:       const res = await this.client.labSaveDoc($state.snapshot(this.lab) as LabDocument);
 936:       const id = res.id ?? this.lab.id;
 937:       this.savedDocIds.add(id);
 938:       this.rememberActiveLab(id);
 939:       this.lastSavedAt = Date.now();
 940:       ok = true;
 941:     });
 942:     if (ok && notify) this.enqueueToast({ severity: "success", message: `Lab saved â€” ${labName}` });
 943:     return ok;
 944:   }
 945: 
 946:   async listLabs(): Promise<LabDocument[]> {
 947:     const res = await this.client.labListDocs();
 948:     // Any doc that came back from disk is, by definition, already saved.
 949:     for (const l of res.labs) this.savedDocIds.add(l.id);
 950:     return res.labs;
 951:   }
 952: 
 953:   async deleteLab(labId: string, labName = labId) {
 954:     const ok = await this.guarded("delete lab", async () => {
 955:       await this.client.labDeleteDoc(labId);
 956:       this.savedDocIds.delete(labId);
 957:     });
 958:     if (ok) this.enqueueToast({ severity: "info", message: `Lab deleted â€” ${labName}` });
 959:   }
 960: 
 961:   /** Clone a stored lab under a fresh id + " (copy)" name and persist the copy,
 962:    *  so the original (e.g. a built-in starter lab) stays pristine while the user
 963:    *  edits the clone. Returns the new doc, or null on failure. Existing "copy"
 964:    *  names get a numeric suffix so repeated clones don't collide. */
 965:   async cloneLab(source: LabDocument): Promise<LabDocument | null> {
 966:     let out: LabDocument | null = null;
 967:     const ok = await this.guarded("clone lab", async () => {
 968:       const now = new Date().toISOString();
 969:       const existing = new Set((await this.client.labListDocs()).labs.map((l) => l.name));
 970:       let name = `${source.name} (copy)`;
 971:       for (let n = 2; existing.has(name); n++) name = `${source.name} (copy ${n})`;
 972:       const copy: LabDocument = {
 973:         ...structuredClone($state.snapshot(source) as LabDocument),
 974:         id: uuid(),
 975:         name,
 976:         created: now,
 977:         modified: now,
 978:       };
 979:       await this.client.labSaveDoc(copy);
 980:       this.savedDocIds.add(copy.id);
 981:       out = copy;
 982:     });
 983:     const copy = out as LabDocument | null;
 984:     if (ok && copy) this.enqueueToast({ severity: "success", message: `Lab copy created â€” ${copy.name}` });
 985:     return out;
 986:   }
 987: 
 988:   /** Set when openLab is blocked on the user resolving a lab switch (see
 989:    *  pendingSwitch doc below). Read by SwitchLabDialog to render itself. */
 990:   pendingSwitch = $state<{ lab: LabDocument; fromStore: boolean } | null>(null);
 991: 
 992:   /** Open a doc into the workspace (reuses loadLab's connect-time path). Pass
 993:    *  fromStore=true when the doc came from the durable store (so it's treated as
 994:    *  already-saved and eligible for autosave); false for New/Import of a doc the
 995:    *  user hasn't persisted yet.
 996:    *
 997:    *  iolbox runs exactly one lab at a time: switching to a DIFFERENT lab id
 998:    *  always closes/replaces whatever is currently loaded (the server's
 999:    *  lab.load already stops every node and tears down the old lab's fabric â€”
1000:    *  see handleLabLoad). Per product decision, that must never happen without
1001:    *  the user being warned and given the chance to save first, so any
1002:    *  cross-id call is intercepted here into pendingSwitch instead of
1003:    *  proceeding straight to loadLab; SwitchLabDialog resolves it via
1004:    *  resolveSwitch/cancelSwitch. This is the SINGLE funnel for every
1005:    *  lab-switch entry point (Labs browser open/clone, New, Import) â€” callers
1006:    *  should not roll their own confirm() before calling openLab. */
1007:   async openLab(lab: LabDocument, fromStore = false, decision?: "save" | "discard") {
1008:     // A load is already in flight (e.g. a double-click on New, or Open
1009:     // clicked again before the first one settled) â€” let it finish rather
1010:     // than interleaving two loadLab() calls, which can let a slow first
1011:     // response's runtime state overwrite the second lab's after the fact.
1012:     if (this.labLoading) return;
1013:     if (!decision && this.lab.id !== lab.id) {
1014:       this.pendingSwitch = { lab, fromStore };
1015:       return;
1016:     }
1017:     this.pendingSwitch = null;
1018:     await this.guarded("open lab", async () => {
1019:       if (fromStore) this.savedDocIds.add(lab.id);
1020:       else this.savedDocIds.delete(lab.id);
1021:       await this.loadLab(lab);
1022:       // This lab is now the workspace â€” a refresh should reopen it. (A brand-new
1023:       // unsaved lab isn't in the store yet; its first edit autosaves + records
1024:       // it, and New-lab intentionally isn't remembered until the user edits it.)
1025:       if (fromStore) this.rememberActiveLab(lab.id);
1026:     });
1027:   }
1028: 
1029:   /** Resolve a pending lab switch (see pendingSwitch/openLab). "save" saves
1030:    *  the OUTGOING lab first and aborts the switch if the save fails (the
1031:    *  dialog stays up so the user can retry or cancel); "discard" proceeds
1032:    *  straight to the switch, leaving the outgoing lab's unsaved edits
1033:    *  behind. Either way loadLab itself already cancels the outgoing lab's
1034:    *  pending autosave timer without flushing it, so "discard" can never be
1035:    *  turned into an accidental save by a debounce firing mid-switch. */
1036:   async resolveSwitch(decision: "save" | "discard") {
1037:     const pending = this.pendingSwitch;
1038:     if (!pending) return;
1039:     if (decision === "save") {
1040:       if (!(await this.saveLab())) return; // save failed: leave the dialog up
1041:     }
1042:     await this.openLab(pending.lab, pending.fromStore, decision);
1043:   }
1044: 
1045:   /** Dismiss a pending lab switch with no action; the current lab stays open. */
1046:   cancelSwitch() {
1047:     this.pendingSwitch = null;
1048:   }
1049: 
1050:   /** Debounced autosave after any topology/annotation edit (real supervisor
1051:    *  only â€” mock has no durable store). Unconditional: the FIRST edit to a
1052:    *  fresh working lab persists it too (and records it as the last-active lab),
1053:    *  so a browser refresh keeps the user's additions instead of reloading the
1054:    *  seed. Debounced so a burst of edits/drags coalesces into one save. */
1055:   scheduleAutosave() {
1056:     if (this.transportKind !== "ws") return;
1057:     if (!this.autoSaveEnabled) return;
1058:     if (this.autosaveTimer) clearTimeout(this.autosaveTimer);
1059:     this.autosaveTimer = setTimeout(() => {
1060:       this.autosaveTimer = null;
1061:       void this.saveLab(false);
1062:     }, 1200);
1063:   }
1064: 
1065:   setAutoSaveEnabled(value: boolean) {
1066:     this.autoSaveEnabled = value;
1067:     try {
1068:       localStorage.setItem(AUTOSAVE_STORAGE_KEY, String(value));
1069:     } catch {
1070:       /* localStorage may be unavailable (private mode) */
1071:     }
1072:     if (this.autosaveTimer) {
1073:       clearTimeout(this.autosaveTimer);
1074:       this.autosaveTimer = null;
1075:     }
1076:   }
1077: 
1078:   toggleAutoSaveEnabled() {
1079:     this.setAutoSaveEnabled(!this.autoSaveEnabled);
1080:   }
1081: 
1082:   // ---- live-capture console tabs (feature 1) ----
1083: 
1084:   private ensureCaptureSession(linkId: number) {
1085:     if (this.transportKind !== "ws" || this.captureSessions.has(linkId)) return;
1086:     let session: CaptureSession;
1087:     const transport = new CaptureTransport(linkId, {
1088:       onOpen: () => {
1089:         // Every reconnect starts at a new SHB, so parser-local index/tRel state
1090:         // must reset. The Lens ring intentionally does not reset.
1091:         session.parser = new PcapngParser();
1092:         for (const subscriber of [...session.subscribers]) subscriber.onReset?.();
1093:       },
1094:       onData: (bytes) => {
1095:         const packets = session.parser.push(bytes);
1096:         if (packets.length === 0) return;
1097:         this.appendCapturePackets(linkId, packets);
1098:         const firstSeq = consoleUiStore.advanceCaptureDelivery(linkId, packets.length);
1099:         this.pushLensPackets(linkId, packets, firstSeq);
1100:         for (const subscriber of [...session.subscribers]) subscriber.onPackets(packets);
1101:       },
1102:       onError: () => {
1103:         for (const subscriber of [...session.subscribers]) subscriber.onUnavailable?.();
1104:       },
1105:       onClose: () => {
1106:         for (const subscriber of [...session.subscribers]) subscriber.onUnavailable?.();
1107:       },
1108:     });
1109:     session = { transport, parser: new PcapngParser(), subscribers: new Set() };
1110:     this.captureSessions.set(linkId, session);
1111:     transport.connect();
1112:   }
1113: 
1114:   private closeCaptureSession(linkId: number) {
1115:     const session = this.captureSessions.get(linkId);
1116:     if (!session) return;
1117:     this.captureSessions.delete(linkId);
1118:     session.transport.disconnect();
1119:   }
1120: 
1121:   private closeAllCaptureSessions() {
1122:     for (const linkId of [...this.captureSessions.keys()]) this.closeCaptureSession(linkId);
1123:   }
1124: 
1125:   subscribeCapture(linkId: number, subscriber: CaptureSubscriber): () => void {
1126:     const session = this.captureSessions.get(linkId);
1127:     if (!session) return () => {};
1128:     session.subscribers.add(subscriber);
1129:     return () => session.subscribers.delete(subscriber);
1130:   }
1131: 
1132:   retryCapture(linkId: number) {
1133:     this.captureSessions.get(linkId)?.transport.retryNow();
1134:   }
1135: 
1136:   private lensAttribution(linkId: number): LensAttribution {
1137:     const link = this.lab.links.find((item) => item.id === linkId);
1138:     const stats = this.linkStats[linkId];
1139:     return {
1140:       endpoints: link?.endpoints.map((endpoint) => ({ node: endpoint.node })) ?? [],
1141:       epAttrib: stats?.epAttrib,
1142:       nodeName: (nodeId) => this.lab.nodes.find((node) => node.id === nodeId)?.name ?? `#${nodeId}`,
1143:     };
1144:   }
1145: 
1146:   private pushLensPackets(linkId: number, packets: readonly ParsedPacket[], firstSeq: number) {
1147:     const current = this.lensEvents[linkId] ?? [];
1148:     this.lensEvents = {
1149:       ...this.lensEvents,
1150:       [linkId]: appendLensEvents(current, packets, firstSeq, this.lensAttribution(linkId)),
1151:     };
1152:   }
1153: 
1154:   openLens(linkId: number) {
1155:     this.openCapture(linkId);
1156:     if (!this.openLensTabs.includes(linkId)) this.openLensTabs = [...this.openLensTabs, linkId];
1157:     consoleUiStore.setFocused({ kind: "lens", link: linkId });
1158:   }
1159: 
1160:   closeLens(linkId: number) {
1161:     this.openLensTabs = this.openLensTabs.filter((id) => id !== linkId);
1162:     const ref = { kind: "lens" as const, link: linkId };
1163:     if (consoleUiStore.pinned?.kind === "lens" && consoleUiStore.pinned.link === linkId) {
1164:       consoleUiStore.setPinned(null);
1165:     }
1166:     if (consoleUiStore.tiles.some((tile) => tile.kind === "lens" && tile.link === linkId)) {
1167:       consoleUiStore.toggleTile(ref);
1168:     }
1169:     if (consoleUiStore.focused?.kind === "lens" && consoleUiStore.focused.link === linkId) {
1170:       const capture = this.openCaptureTabs.includes(linkId);
1171:       consoleUiStore.setFocused(capture ? { kind: "capture", link: linkId } : null);
1172:     }
1173:   }
1174: 
1175:   openCapture(linkId: number) {
1176:     const link = this.lab.links.find((l) => l.id === linkId);
1177:     if (link) {
1178:       // Mark the link for capture so the next lab start bridges it. If it's not
1179:       // already enabled and the lab is running natively, traffic won't flow
1180:       // until restart â€” the tab surfaces that hint itself.
1181:       link.capture = { enabled: true, mode: "live" };
1182:     }
1183:     const alreadyOpen = this.openCaptureTabs.includes(linkId);
1184:     if (!alreadyOpen) {
1185:       this.openCaptureTabs = [...this.openCaptureTabs, linkId];
1186:       // Fresh recording and Lens ring for a newly opened capture session.
1187:       this.captureBuffers.delete(linkId);
1188:       const { [linkId]: _oldLens, ...restLens } = this.lensEvents;
1189:       this.lensEvents = restLens;
1190:     }
1191:     // Ask the supervisor to start teeing this link (idempotent; harmless when
1192:     // the lab is stopped â€” it'll bridge on next start).
1193:     if (this.lab.id) void this.client.captureStart(this.lab.id, linkId).catch(() => {});
1194:     this.ensureCaptureSession(linkId);
1195:     this.scheduleAutosave();
1196:   }
1197: 
1198:   // ---- capture recording (for "Save .pcapng" download) ----
1199:   // Wireshark's live `-i TCP@host:port` attach works, but requires wireshark on
1200:   // PATH; a downloaded .pcapng opens in Wireshark by double-click with zero
1201:   // setup. We buffer the PARSED packets (frame + absolute ts) â€” NOT the raw
1202:   // byte stream â€” because the live /capture WS spans reconnects (each restarts
1203:   // its own SHB) and can drop mid-block, so concatenated raw bytes produce a
1204:   // file Wireshark rejects. The download re-serializes one clean pcapng section
1205:   // from these packets (see encodePcapng). Plain Map (not reactive).
1206:   private captureBuffers = new Map<number, { packets: CapturedPacket[]; bytes: number }>();
1207:   private static CAPTURE_BUF_CAP = 64 * 1024 * 1024;
1208:   /** Reactive byte counter so the download button can show size / enable state. */
1209:   captureRecorded = $state<Record<number, number>>({});
1210: 
1211:   /** Append PARSED packets from a link's live capture stream (called by
1212:    *  CaptureTerm with the parser's output). Each packet's `data` is already a
1213:    *  copy (PcapngParser slices it). Caps total buffered bytes. */
1214:   appendCapturePackets(linkId: number, packets: CapturedPacket[]) {
1215:     if (packets.length === 0) return;
1216:     let b = this.captureBuffers.get(linkId);
1217:     if (!b) {
1218:       b = { packets: [], bytes: 0 };
1219:       this.captureBuffers.set(linkId, b);
1220:     }
1221:     if (b.bytes >= LabStore.CAPTURE_BUF_CAP) return;
1222:     for (const p of packets) {
1223:       b.packets.push({ data: p.data, tsMicros: p.tsMicros });
1224:       b.bytes += p.data.length;
1225:     }
1226:     this.captureRecorded = { ...this.captureRecorded, [linkId]: b.bytes };
1227:   }
1228: 
1229:   /** Trigger a browser download of the buffered pcapng for a link. The file
1230:    *  opens directly in Wireshark (no PATH/command needed). */
1231:   downloadCapture(linkId: number) {
1232:     const b = this.captureBuffers.get(linkId);
1233:     if (!b || b.packets.length === 0) {
1234:       this.pushLog("warn", "no packets captured yet â€” wait for traffic on this link");
1235:       return;
1236:     }
1237:     // Rebuild ONE clean pcapng section from the parsed packets (never a raw
1238:     // concat of the reconnect-spanning stream, which Wireshark rejects).
1239:     const bytes = encodePcapng(b.packets);
1240:     const blob = new Blob([bytes as BlobPart], { type: "application/vnd.tcpdump.pcap" });
1241:     const link = this.lab.links.find((l) => l.id === linkId);
1242:     const ep = link?.endpoints ?? [];
1243:     const nm = (i: number) => this.lab.nodes.find((n) => n.id === ep[i]?.node)?.name ?? `n${ep[i]?.node}`;
1244:     const base = link ? `${this.lab.name}-${nm(0)}-${nm(1)}` : `capture-link${linkId}`;
1245:     const fname = `${base}.pcapng`.replace(/[^\w.\-]+/g, "_");
1246:     const url = URL.createObjectURL(blob);
1247:     try {
1248:       const a = document.createElement("a");
1249:       a.href = url;
1250:       a.download = fname;
1251:       document.body.appendChild(a);
1252:       a.click();
1253:       a.remove();
1254:     } finally {
1255:       setTimeout(() => URL.revokeObjectURL(url), 4000);
1256:     }
1257:     this.pushLog("info", `saved ${fname} (${(b.bytes / 1024).toFixed(0)} KiB)`);
1258:   }
1259: 
1260:   closeCapture(linkId: number) {
1261:     this.openCaptureTabs = this.openCaptureTabs.filter((id) => id !== linkId);
1262:     this.openLensTabs = this.openLensTabs.filter((id) => id !== linkId);
1263:     this.closeCaptureSession(linkId);
1264:     this.captureBuffers.delete(linkId);
1265:     const { [linkId]: _dropLens, ...restLens } = this.lensEvents;
1266:     this.lensEvents = restLens;
1267:     if (this.captureRecorded[linkId] !== undefined) {
1268:       const { [linkId]: _drop, ...rest } = this.captureRecorded;
1269:       this.captureRecorded = rest;
1270:     }
1271:     // Withdraw the doc-level capture intent too (openCapture set it): the
1272:     // supervisor auto-arms every capture-enabled doc link on lab start, so
1273:     // leaving the flag behind would keep re-arming a capture whose tab the
1274:     // user closed. Symmetric with openCapture; autosaved like any doc edit.
1275:     const link = this.lab.links.find((l) => l.id === linkId);
1276:     if (link?.capture?.enabled) {
1277:       link.capture = { ...link.capture, enabled: false };
1278:       this.scheduleAutosave();
1279:     }
1280:     if (this.lab.id) void this.client.captureStop(this.lab.id, linkId).catch(() => {});
1281:   }
1282: 
1283:   async startLab() {
1284:     if (this.lab.nodes.length === 0) {
1285:       this.enqueueToast({ severity: "info", message: "Lab has no nodes to start" });
1286:       return;
1287:     }
1288:     // Pre-flight what the supervisor would reject anyway, with a message that
1289:     // names the node instead of an opaque image_not_found.
1290:     const missing = this.lab.nodes.find(
1291:       (n) => n.kind === "iol" && (!n.image || !this.images.some((i) => i.id === n.image!.id))
1292:     );
1293:     if (missing) {
1294:       this.lastError = `${missing.name} has no registered image â€” assign one (Images)`;
1295:       this.pushLog("error", this.lastError);
1296:       return;
1297:     }
1298:     let result: LabStartResult | undefined;
1299:     const ok = await this.guarded("start lab", async () => {
1300:       result = await this.client.labStart(this.lab.id);
1301:     });
1302:     if (ok && result) {
1303:       const failedCount = result.failed?.length ?? 0;
1304:       if (failedCount > 0) {
1305:         this.enqueueToast({
1306:           severity: "error",
1307:           message: `Lab start incomplete â€” ${failedCount} of ${this.lab.nodes.length} nodes failed`,
1308:         });
1309:       } else if (result.started.length > 0) {
1310:         const count = result.started.length;
1311:         this.enqueueToast({
1312:           severity: "success",
1313:           message: `Lab started â€” ${count} ${count === 1 ? "node" : "nodes"} running`,
1314:         });
1315:       }
1316:     }
1317:     this.reportStartFailures("start lab", result);
1318:   }
1319: 
1320:   /** Force-clean orphaned runtime state: ask the supervisor to stop every
1321:    *  tracked node + all relays/bridges/captures (regardless of labId), then
1322:    *  reset local runtime state so the GUI matches. Use when nodes still show
1323:    *  running or host CPU stays high after a normal stop. */
1324:   async forceClean() {
1325:     let reapedCount = 0;
1326:     const ok = await this.guarded("force clean", async () => {
1327:       const res = await this.client.labReap();
1328:       reapedCount = res?.reaped ?? 0;
1329:       // Reset local runtime view: everything is stopped now.
1330:       const states: Record<number, NodeState> = {};
1331:       for (const n of this.lab.nodes) states[n.id] = "stopped";
1332:       this.nodeStates = states;
1333:       this.openConsoleTabs = [];
1334:       this.activeConsoleTab = null;
1335:       this.closeAllCaptureSessions();
1336:       this.openCaptureTabs = [];
1337:       this.openLensTabs = [];
1338:       this.capturePorts = {};
1339:       this.captureBuffers.clear();
1340:       this.captureRecorded = {};
1341:       this.lensEvents = {};
1342:       this.linkStats = {};
1343:       this.linkFaults = {};
1344:       this.pushLog("info", `force clean: stopped ${reapedCount} node(s) and all relays`);
1345:     });
1346:     if (ok) {
1347:       this.enqueueToast({
1348:         severity: "danger",
1349:         message: `Force clean complete â€” stopped ${reapedCount} ${reapedCount === 1 ? "node" : "nodes"} and cleared relays`,
1350:       });
1351:     }
1352:   }
1353: 
1354:   async stopLab() {
1355:     const nodeCount = this.lab.nodes.length;
1356:     this.labStopPending = true;
1357:     let ok = false;
1358:     try {
1359:       ok = await this.guarded("stop lab", async () => {
1360:         await this.client.labStop(this.lab.id);
1361:         this.openConsoleTabs = [];
1362:         this.activeConsoleTab = null;
1363:       });
1364:     } finally {
1365:       this.labStopPending = false;
1366:     }
1367:     if (ok) {
1368:       this.labStopSuppressedUntil = Date.now() + 1_500;
1369:       this.enqueueToast({
1370:         severity: "danger",
1371:         message: nodeCount === 0
1372:           ? "Lab stopped â€” no nodes were running"
1373:           : `Lab stopped â€” all ${nodeCount} ${nodeCount === 1 ? "node" : "nodes"} stopped`,
1374:       });
1375:     }
1376:   }
