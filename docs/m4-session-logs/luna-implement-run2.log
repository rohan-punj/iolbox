main() {
    local target phase
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --machine) machine="$2"; shift 2 ;; --launcher) launcher_path="$2"; shift 2 ;;
            --test-binary) test_binary="$2"; shift 2 ;; --assets-dir) assets_dir="$2"; shift 2 ;;
            --image) image_path="$2"; shift 2 ;; --evidence-parent) evidence_parent="$2"; shift 2 ;;
