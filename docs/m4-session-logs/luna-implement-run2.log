    env IOLBOX_M4_PHASE=final IOLBOX_M4_EVIDENCE="$evidence_dir" IOLBOX_M4_RUN_ID="$run_id" IOLBOX_M4_MACHINE="$machine" IOLBOX_M4_GUI_PORT="$gui_port" IOLBOX_M4_PLAN_SHA256="$(env_or IOLBOX_M4_PLAN_SHA256 unknown)" IOLBOX_M4_PLAN_UNCHANGED="$(env_or IOLBOX_M4_PLAN_UNCHANGED 0)" IOLBOX_M4_BASE_COMMIT="$(env_or IOLBOX_M4_BASE_COMMIT unknown)" IOLBOX_M4_RUN_START_UTC="$(grep '^start_utc=' "$evidence_dir/README.txt" | cut -d= -f2)" "$test_binary" -test.run '^TestMacOSM4Hardware$' -test.v >"$evidence_dir/final-summary.log" 2>&1 || true
