		if err != nil {
			_ = conn.Close()
			lastErr = err
			time.Sleep(2 * time.Second)
			continue
		}
		return conn, prompt, nil
	}
	return nil, "", fmt.Errorf("no prompt within %s: %w", budget, lastErr)
