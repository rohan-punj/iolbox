func m3OpenConsoles(t *testing.T, ports darwinPortContract, nodes []int) map[int]*m3Console {
	t.Helper()
	result := make(map[int]*m3Console, len(nodes))
	var mu sync.Mutex
	var wg sync.WaitGroup
	errs := make(chan error, len(nodes))
	for _, node := range nodes {
		node := node
		wg.Add(1)
