			defer wg.Done()
			conn, prompt, err := m3OpenConsoleWithRetry(fmt.Sprintf("127.0.0.1:%d", ports.GUIPort), node, 150*time.Second)
			if err != nil {
				errs <- fmt.Errorf("node %d: %w", node, err)
