# systemd-networkd config, installed to
# /etc/systemd/network/01-no-default-route.network inside the rootfs.
#
# Matches every non-loopback interface. Brings it up with DHCP for address
# assignment ONLY (so the vmware host-only NIC / WSL2 vEthernet gets an IP
# and the control port is reachable from Windows) but explicitly refuses
# any gateway the DHCP server offers, and never adds a static default
# route. This is the concrete mechanism behind the "no default route"
# requirement in docs/providers.md and PLAN.md — see runtime/README.md's
# "Airgap / no-default-route rationale" section for the why (xml.cisco.com
# L2-IOL abort).
#
# Deliberately using systemd-networkd (not NetworkManager, not ifupdown)
# because it's already a systemd dependency in this image and its DHCP
# section has an explicit, well-documented UseGateway= knob — no need to
# fight a higher-level network manager's routing policy or write custom
# dhclient hooks.
[Match]
Name=en* eth*
# Matches typical VMware vmxnet3/e1000 guest NIC names (enoNN under
# predictable naming, ethN if the appliance kernel is built without it —
# see pack-vmware.sh for which naming scheme the shipped kernel produces)
# and WSL2's eth0. Loopback is handled separately by systemd-networkd's
# built-in default and is not matched here.

[Network]
DHCP=yes
# No [Route] section — no default route is ever configured, by omission.

[DHCPv4]
# The single most important line in this file: accept the address lease
# (and, if the DHCP server sends one, DNS servers we can safely ignore
# since we do no outbound name resolution) but throw away any offered
# default gateway instead of installing it as a route.
UseGateway=false
UseDNS=false
UseRoutes=false

[DHCPv6]
UseGateway=false
UseDNS=false
