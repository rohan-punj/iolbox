## iolbox-appliance.vmx.tmpl — templated VMware VMX for the runtime appliance.
## pack-vmware.sh substitutes the @@PLACEHOLDER@@ tokens below and writes the
## result to runtime/build/iolbox-appliance.vmx. Do not hand-edit the output;
## edit this template instead so rebuilds stay reproducible.
##
## Modeled on the PROVEN reference runtime VM (iolbox-rt: 4 vCPU / 4 GB,
## host-only + NAT e1000e NICs) rather than the original scaffold's 768 MB
## single-NIC guess — IOL nodes default to 1024 MB RAM each and the NAT
## node needs an outbound path.
##
## numvcpus / memsize are templated tokens (@@VCPUS@@ / @@RAM_MB@@) that
## pack-vmware.sh substitutes from runtime/resources.env — the single
## source of truth for vCPU/RAM across every deployment target.

.encoding = "UTF-8"
config.version = "8"
virtualHW.version = "19"
firmware = "bios"

displayName = "iolbox-appliance"
guestOS = "debian12-64"
annotation = "iolbox runtime appliance - autostarts the iolbox supervisor; GUI at http://<vm-ip>:4001 from the Windows host via the host-only NIC. Built by runtime/pack-vmware.sh. No Cisco software included."

numvcpus = "@@VCPUS@@"
cpuid.coresPerSocket = "1"
memsize = "@@RAM_MB@@"

## PCIe root ports — REQUIRED for the e1000e NICs below (e1000e is a PCIe
## device; without a pcieRootPort bridge there is "No PCIe slot available
## for Ethernet0" and Workstation hard-crashes at power-on instead of
## erroring). Same block the reference iolbox-rt vmx carries.
pciBridge0.present = "TRUE"
pciBridge4.present = "TRUE"
pciBridge4.virtualDev = "pcieRootPort"
pciBridge4.functions = "8"
pciBridge5.present = "TRUE"
pciBridge5.virtualDev = "pcieRootPort"
pciBridge5.functions = "8"

## Single disk: the vmdk produced by pack-vmware.sh (rootfs + kernel + grub,
## see that script's header comment for the partition layout).
scsi0.present = "TRUE"
scsi0.virtualDev = "lsilogic"
scsi0:0.present = "TRUE"
scsi0:0.fileName = "@@VMDK_FILENAME@@"
scsi0:0.deviceType = "disk"

## No CD/floppy — nothing to install interactively, the disk is already
## bootable when pack-vmware.sh hands it off.
ide1:0.present = "FALSE"
floppy0.present = "FALSE"

## NIC0: host-only — Windows <-> runtime control/GUI/console/capture plane.
## FIXED MAC (VMware's static range is 00:50:56:00:00:00-00:50:56:3F:FF:FF):
## the in-guest networkd config (10-hostonly.network, written by
## pack-vmware.sh) matches this MAC, and the Windows side can resolve the
## DHCP lease deterministically from C:\ProgramData\VMware\vmnetdhcp.leases
## by this MAC — the same discovery pattern the reference iolbox-rt VM uses.
## DHCP (not a baked static IP) because each Workstation install picks its
## own random host-only subnet; a hardcoded IP would only be right on the
## machine that built the appliance.
ethernet0.present = "TRUE"
ethernet0.connectionType = "hostonly"
ethernet0.virtualDev = "e1000e"
ethernet0.addressType = "static"
ethernet0.address = "00:50:56:3f:ab:01"
ethernet0.linkStatePropagation.enable = "TRUE"

## NIC1: NAT — the NAT node's (extnet) outbound path: lab traffic is
## MASQUERADEd out through the default route this NIC's DHCP provides.
## Also fixed-MAC so 20-nat.network matches it deterministically.
ethernet1.present = "TRUE"
ethernet1.connectionType = "nat"
ethernet1.virtualDev = "e1000e"
ethernet1.addressType = "static"
ethernet1.address = "00:50:56:3f:ab:02"

## No sound, no USB, no printer — nothing this appliance needs, and each
## omitted device is one less thing that can fail to attach headless.
sound.present = "FALSE"
usb.present = "FALSE"
usb_xhci.present = "FALSE"
serial0.present = "FALSE"
parallel0.present = "FALSE"

## Headless-friendly. `vmrun -T ws start iolbox-appliance.vmx nogui` is the
## documented lifecycle command (docs/providers.md).
gui.fullScreenAtPowerOn = "FALSE"
gui.viewModeAtPowerOn = "windowed"

## Nested virtualization is explicitly NOT requested — IOL is a userspace
## process, not an inner hypervisor guest. Do not add vhv.enable="TRUE"
## here (that's the PNetLab pattern for nested KVM; iolbox runs no inner VMs).

## Power-on niceties: skip the "moved or copied" prompt so
## `vmrun start ... nogui` never blocks on a hidden dialog.
msg.autoAnswer = "TRUE"
uuid.action = "create"

## open-vm-tools IS installed in this image (pack-vmware.sh) so
## `vmrun -T ws getGuestIPAddress <vmx> -wait` works as the primary
## host-only IP discovery; the vmnetdhcp.leases MAC lookup above is the
## no-tools fallback.
tools.syncTime = "TRUE"
