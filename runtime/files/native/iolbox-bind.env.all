# /etc/iolbox/bind.env — read by the iolbox-supervisor.service drop-in
# (/etc/systemd/system/iolbox-supervisor.service.d/10-bind.conf) to pick the
# listen addresses for the WS/GUI bridge, native telnet consoles, and
# native Wireshark capture tees.
#
# This is the "--bind all" variant: every listener binds 0.0.0.0, reachable
# from any host that can route to this machine (LAN, VPN, SSH tunnel
# endpoint, etc.). NONE of these listeners have authentication — see the
# warning install.sh prints and runtime/README.md / docs/install.md.
# Only use this on a network you trust (LAN/VPN/tunnel), never on a host
# with a public IP.
IOLBOX_WS_ADDR=0.0.0.0:4001
IOLBOX_CONSOLE_BIND=0.0.0.0
IOLBOX_CAPTURE_BIND=0.0.0.0
