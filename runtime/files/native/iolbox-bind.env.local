# /etc/iolbox/bind.env — read by the iolbox-supervisor.service drop-in
# (/etc/systemd/system/iolbox-supervisor.service.d/10-bind.conf) to pick the
# listen addresses for the WS/GUI bridge, native telnet consoles, and
# native Wireshark capture tees.
#
# This is the "--bind local" (default) variant: loopback-only. The GUI is
# reachable only from this machine itself (e.g. via an SSH tunnel, or a
# browser running locally). Safe default for a freshly installed server —
# nothing is exposed to the LAN until an operator explicitly asks for it.
IOLBOX_WS_ADDR=127.0.0.1:4001
IOLBOX_CONSOLE_BIND=127.0.0.1
IOLBOX_CAPTURE_BIND=127.0.0.1
