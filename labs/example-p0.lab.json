{
  "version": 1,
  "id": "p0-two-routers-one-pc",
  "name": "P0 — Two IOL routers + one VPCS",
  "description": "Minimal risk-retirement topology: R1<->R2 over a p2p link, PC1 on R1's LAN. Used to validate boot, console, wiring, and Wireshark capture end to end.",
  "canvas": { "zoom": 1, "pan": { "x": 0, "y": 0 }, "background": "dots" },
  "nodes": [
    {
      "id": 0,
      "kind": "iol",
      "name": "R1",
      "x": 240,
      "y": 200,
      "image": { "id": "REPLACE_WITH_IMAGE_ID", "filename": "L3-ADVENTERPRISE.bin", "class": "l3" },
      "ram": 256,
      "ethernet": 1,
      "serial": 1,
      "startupConfig": "hostname R1\n!\ninterface Ethernet0/0\n ip address 10.0.12.1 255.255.255.0\n no shutdown\n!\ninterface Ethernet0/1\n ip address 192.168.1.1 255.255.255.0\n no shutdown\n!\nend\n"
    },
    {
      "id": 1,
      "kind": "iol",
      "name": "R2",
      "x": 560,
      "y": 200,
      "image": { "id": "REPLACE_WITH_IMAGE_ID", "filename": "L3-ADVENTERPRISE.bin", "class": "l3" },
      "ram": 256,
      "ethernet": 1,
      "serial": 1,
      "startupConfig": "hostname R2\n!\ninterface Ethernet0/0\n ip address 10.0.12.2 255.255.255.0\n no shutdown\n!\nend\n"
    },
    {
      "id": 2,
      "kind": "vpcs",
      "name": "PC1",
      "x": 240,
      "y": 400,
      "ethernet": 1,
      "serial": 0,
      "config": { "commands": ["ip 192.168.1.10 192.168.1.1 24"] }
    }
  ],
  "links": [
    {
      "id": 0,
      "type": "p2p",
      "endpoints": [
        { "node": 0, "interface": "e0/0" },
        { "node": 1, "interface": "e0/0" }
      ],
      "capture": { "enabled": false, "mode": "live" }
    },
    {
      "id": 1,
      "type": "p2p",
      "endpoints": [
        { "node": 0, "interface": "e0/1" },
        { "node": 2, "interface": "eth0" }
      ]
    }
  ]
}
