# Bundled QEMU Windows build (staged for local smoke; distributed via release asset)
qemu/
# Disk images (release assets, never committed)
*.qcow2
# Built launcher exe (and stray editor/OS backups of it)
iolbox-launcher.exe
*.exe
*.exe~
# Folder-sync default data dirs (created next to the exe at runtime — user's
# dropped IOL images and persisted labs live here; never commit them)
/images/
/labs/
